<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:App.Maui"
             xmlns:components="clr-namespace:App.Maui.Components"
             x:Class="App.Maui.MainPage">

    <AbsoluteLayout x:Name="rootLayout">
        <BlazorWebView x:Name="blazorWebView"
                       HostPage="wwwroot/index.html"
                       AbsoluteLayout.LayoutBounds="0,0,1,1"
                       AbsoluteLayout.LayoutFlags="All">
            <BlazorWebView.RootComponents>
                <RootComponent Selector="#app" ComponentType="{x:Type components:Routes}" />
            </BlazorWebView.RootComponents>
        </BlazorWebView>

        <WebView x:Name="browserWebView"
                 IsVisible="False"
                 AbsoluteLayout.LayoutBounds="0,0,0,0"
                 AbsoluteLayout.LayoutFlags="None" />

        <WebView x:Name="browserSideWebView"
                 IsVisible="False"
                 AbsoluteLayout.LayoutBounds="0,0,0,0"
                 AbsoluteLayout.LayoutFlags="None" />

        <!-- Native URL embed (Home Assistant, etc.) — bypasses iframe X-Frame-Options -->
        <WebView x:Name="urlEmbedWebView"
                 IsVisible="False"
                 AbsoluteLayout.LayoutBounds="0,0,0,0"
                 AbsoluteLayout.LayoutFlags="None" />
    </AbsoluteLayout>

</ContentPage>
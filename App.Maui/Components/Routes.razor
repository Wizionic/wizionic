<Router AppAssembly="typeof(MauiProgram).Assembly"
        AdditionalAssemblies="new[] { typeof(App.Shared.SharedMarker).Assembly }"
        NotFoundPage="typeof(Pages.NotFound)">
    <Found Context="routeData">
        <RouteView RouteData="routeData" DefaultLayout="typeof(App.Shared.Layout.AppLayout)" />
        @* Projects and other workspace pages have no h1. Focusing a missing selector
           throws in the WebView and shows only the Reload bar. *@
        <FocusOnNavigate RouteData="routeData" Selector="h1, h4" />
    </Found>
</Router>
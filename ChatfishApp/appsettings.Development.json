{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  // Example global fallback keys (optional; primary keys are now per-user via /settings).
  // Prefer dotnet user-secrets or environment variables for real keys.
  // "AI": {
  //   "Groq": { "ApiKey": "gsk_..." },
  //   "Gemini": { "ApiKey": "AIza..." }
  // },
  // OpenRouter attribution (recommended for leaderboards/rankings on openrouter.ai; sent on every request).
  // These are *app-level*, not per-user key.
  "OpenRouter": {
    "Referer": "http://localhost",   // or your production site URL, e.g. "https://chatfish.me"
    "AppTitle": "Chatfish"
  },

  // SMTP settings for real magic link emails (Brevo relay).
  // The email body contains BOTH a prominent clickable "Log in to Chatfish" button
  // AND the raw URL (for copy-paste when the recipient is on a different device/browser).
  //
  // Non-secret values can live here. Secrets (SmtpUser, SmtpPass) MUST come from
  // dotnet user-secrets or environment variables — never committed.
  //
  // Setup for local dev (run these once in the ChatfishApp/ directory):
  //   dotnet user-secrets set "Email:SmtpUser" "ad9c81001@smtp-brevo.com"
  //   dotnet user-secrets set "Email:SmtpPass" "xsmtpsib-72631b8623be9aa7332dd279639dbac71845b1517ee26422e107f33b78faa4b1-wjy0NI2hYmiO79Bb"
  //
  // You can also use environment variables (e.g. in PowerShell or your shell):
  //   $env:Email__SmtpUser = "ad9c81001@smtp-brevo.com"
  //   $env:Email__SmtpPass = "xsmtpsib-..."
  //
  // IMPORTANT:
  // - "From" must be a verified sender in your Brevo account (Brevo dashboard → Senders).
  // - The project has <UserSecretsId> so `dotnet user-secrets` works automatically in Development.
  // - Configuration merges: user-secrets / env vars override values in this JSON.
  // - For CI / production: use proper secrets management (Azure Key Vault, etc.) and a different
  //   email provider or Brevo API key with tighter scopes.
  "Email": {
    "SmtpHost": "smtp-relay.brevo.com",
    "SmtpPort": 587,
    "From": "no-reply@chatfish.me",
    "UseStartTls": true
    // SmtpUser and SmtpPass are intentionally omitted here.
    // Set them with the commands above (or equivalent env vars using double-underscore: Email__SmtpUser / Email__SmtpPass).
  }
}

@using ChatfishApp.Data
@using ChatfishApp.Services
@using Microsoft.AspNetCore.Components.Authorization

@inject ConversationService Conversations
@inject NavigationManager Nav


<div class="nav-scrollable"  @onclick="CloseMenu">
    <nav class="cf-nav cf-column">
        <!-- AI Chat Section -->
        <div class="cf-item px-3 mt-4">
            <span class="cf-link small">
                AI Chats
                <button class="menu-button"><i class="cf-icon bi-plus-circle"></i></button>
            </span>
        </div>

        @foreach (var convo in aiConversations.OrderByDescending(c => c.LastUpdatedAt))
        {
            var isActive = activeConversationId == convo.Id;

            <div class="conversation-item @(isActive ? "active" : "")"
                @onclick="() => { CloseMenu(); SelectConversation(convo.Id); }">

                <div class="row-top">
                    <div class="title">@conversationTitles[convo.Id]</div>

                    <div class="menu" @onclick:stopPropagation>
                        <button class="menu-button" 
                                @onclick="() => ToggleMenu(convo.Id)" 
                                @onclick:stopPropagation>⋮</button>

                        @if (openMenuId == convo.Id)
                        {
                            <div class="menu-popup" @onclick:stopPropagation>
                                <div @onclick="() => DeleteConversation(convo.Id)" 
                                    @onclick:stopPropagation>
                                    <button class="menu-button">
                                        <i class="cf-icon bi-trash3-fill"></i>
                                    </button>
                                    Delete
                                </div>
                            </div>

                            <!-- NEW: Full-screen transparent overlay that catches ANY click outside the popup -->
                            <div class="menu-overlay" @onclick="CloseMenu"></div>
                        }
                    </div>
                </div>

                <div class="date">@convo.LastUpdatedAt.ToLocalTime().ToString("MMM d")</div>
            </div>
        }

    </nav>
    </div>


@code {
    List<Conversation> aiConversations = new();
    Guid? activeConversationId;

    [CascadingParameter] public required Task<AuthenticationState>? AuthStateTask { get; set; }

    Guid? openMenuId = null;

    void ToggleMenu(Guid id)
    {
        openMenuId = openMenuId == id ? null : id;
    }

    Dictionary<Guid, string> conversationTitles = new();
    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask is null)
        {
            // No auth state available yet (first load)
            aiConversations = new();
            activeConversationId = null;
            return;
        }

        var authState = await AuthStateTask;
        var user = authState.User;

        if (!user.Identity?.IsAuthenticated ?? true)
        {
            aiConversations = new();
            activeConversationId = null;
            return;
        }

        aiConversations = await Conversations.GetUserConversationsAsync();
        activeConversationId = aiConversations.FirstOrDefault()?.Id;


        foreach (var convo in aiConversations)
        {
            conversationTitles[convo.Id] = await Conversations.GetConversationTitleAsync(convo.Id);
        }

    }


    async Task SelectConversation(Guid id)
    {
        activeConversationId = id;
        Nav.NavigateTo($"/chat/{id}");
    }

    async Task NewConversation()
    {
        var id = await Conversations.StartNewConversationAsync();
        aiConversations = await Conversations.GetUserConversationsAsync();
        activeConversationId = id;

        Nav.NavigateTo($"/chat/{id}");
    }

    async Task DeleteConversation(Guid id)
    {
         openMenuId = null;                    // ← ensures it closes immediately

            await Conversations.DeleteConversationAsync(id);

            aiConversations = await Conversations.GetUserConversationsAsync();

            if (activeConversationId == id)
            {
                activeConversationId = aiConversations.FirstOrDefault()?.Id;

                if (activeConversationId.HasValue)
                    Nav.NavigateTo($"/chat/{activeConversationId}", replace: true);
                else
                    Nav.NavigateTo("/chat", replace: true);
            }
    }

    void CloseMenu()
    {
        openMenuId = null;
    }

}


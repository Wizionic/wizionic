@inherits LayoutComponentBase

<div class="page">




    <div class="sidebar @(sidebarVisible ? "show" : "hide")">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">

            <div class="top-left">
                <a class="cf-brand" href=""><img width="50" src="/images/chatfish.png" title="Chatfish" alt="Chatfish" /></a>


                <button @onclick="ToggleSidebar" class="sidebar-toggle">
                    @if (sidebarVisible)
                    {
                        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"  opacity="0.55">
                        <rect x="3" y="3" width="18" height="18" rx="2" />
                        <rect x="3" y="3" width="6" height="18" rx="2" fill="currentColor" />
                        </svg>
                    }
                    else
                    {
                        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"  opacity="0.55">
                        <rect x="3" y="3" width="18" height="18" rx="2" />
                        <rect x="3" y="3" width="6" height="18" rx="2" fill="none" />
                        </svg>
                    }
                </button>
            </div>
            <a href="https://learn.microsoft.com/aspnet/core/" target="_blank">About</a>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@if (sidebarVisible)
{
    <div class="overlay" @onclick="ToggleSidebar"></div>
}


@code {
    private bool sidebarVisible = true;

    private void ToggleSidebar()
    {
        sidebarVisible = !sidebarVisible;
    }
}

<script>
    window.scrollChatToBottom = () => {
        const container = document.getElementById('chat-container');
        if (container) {
            container.scrollTop = container.scrollHeight;
        }
    };

    // Auto-growing textarea helpers (used by Chat page)
    window.resizeChatTextarea = (el) => {
        if (!el) return;
        el.style.height = 'auto';
        const minH = 86;   // ~3 lines visible by default
        const maxH = 110;  // scrollbar appears after three lines
        const target = Math.max(minH, Math.min(el.scrollHeight, maxH));
        el.style.height = target + 'px';
    };

    window.resetChatTextarea = (el) => {
        if (!el) return;
        el.style.height = '86px';   // snap back to the comfortable 3-line default height
    };
</script>
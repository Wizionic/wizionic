@page "/chat"
@page "/chat/{ConversationId:guid?}"

@rendermode @(new InteractiveServerRenderMode(prerender: false))

@using Markdig
@using ChatfishApp.Contracts
@using ChatfishApp.Services
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Authorization
@inject ConversationService Conversations
@inject AuthenticationStateProvider Auth
@inject Microsoft.JSInterop.IJSRuntime JS
@inject AiProviderService AiProviders
@attribute [Authorize]

<link href="css/chat.css" rel="stylesheet" />

<div class="chat-wrapper">
    <div class="chat-container" @ref="chatContainer" id="chat-container">
        @foreach (var msg in messages)
        {
            <div class="message-row">
                @if (msg.User == currentUserEmail)
                {
                    <div class="message-me">
                        @((MarkupString)msg.Content)
                        @if (msg.Timestamp.HasValue)
                        {
                            <div style="font-size: 0.6em; color: #888; text-align: right; margin-top: 2px; opacity: 0.7;">
                                @msg.Timestamp.Value.ToLocalTime().ToString("MMM d, HH:mm")
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="message-bot">
                        <div class="chat-markdown">
                            @((MarkupString)msg.Content)
                        </div>
                        @if (!string.IsNullOrWhiteSpace(msg.ModelUsed))
                        {
                            <div class="model-label" style="font-size: 0.6em; color: #888; text-align: right; margin-top: 2px; opacity: 0.7;">
                                via @msg.ModelUsed
                            </div>
                        }
                    </div>
                }
            </div>
        }

        @if (isTyping)
        {
            <div class="message-row">
                <div class="message-bot typing">ChatFish is thinking<span class="dots">...</span></div>
            </div>
        }
    </div>

    <!-- === COMPACT SEAMLESS INPUT BAR === -->
    <div class="input-area">
        <div class="input-container">
            <button class="action-btn" @onclick="NewConversation" title="New Chat">
                <i class="bi bi-plus-circle"></i>
            </button>

            <select @bind="selectedModel" class="model-selector">
                @foreach (var group in modelList.GroupBy(m => m.ProviderName))
                {
                    <optgroup label="@group.Key">
                        @foreach (var m in group)
                        {
                            <option value="@m.Id">@m.Icon @m.Label</option>
                        }
                    </optgroup>
                }
            </select>

            @if (CurrentModelSupportsTools)
            {
                <small style="font-size:0.65em; color:#888; margin-left:0.4rem; white-space:nowrap;" title="This model supports tool calling (e.g. web search, page summarization). The model can use available tools when it needs fresh or external information.">
                    tools enabled
                </small>
            }

            <div class="message-wrapper flex-grow-1">
                <textarea @ref="messageTextarea"
                          @bind="message"
                          @onkeydown="HandleKey"
                          @oninput="ResizeTextarea"
                          placeholder="Message ChatFish..."
                          class="message-input"
                          rows="3" />
            </div>

            <button class="send-btn" @onclick="Send" disabled="@(isSending || string.IsNullOrWhiteSpace(message))">
                <i class="bi bi-arrow-up-circle-fill"></i>
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter] public Guid? ConversationId { get; set; }

    Guid? activeConversationId;

    string? currentUserEmail;
    string message = "";
    string selectedModel = "";
    bool isTyping = false;
    bool isSending = false;  // guard against double-sends from rapid Enter presses etc.

    private bool CurrentModelSupportsTools =>
        !string.IsNullOrEmpty(selectedModel) &&
        (ProviderCatalog.GetModel(selectedModel)?.Model.SupportsTools ?? false);

    private ElementReference chatContainer;
    private ElementReference messageTextarea;
    private bool _hasRendered = false;

    List<ChatMessage> messages = new();

    record ChatMessage(string User, string Content, string? ModelUsed = null, DateTime? Timestamp = null);

    // Local projection for the select (populated from AiProviderService for the current user)
    class ModelInfo
    {
        public string Id { get; set; } = "";
        public string Icon { get; set; } = "";
        public string Label { get; set; } = "";
        public string ProviderName { get; set; } = "";
    }

    List<ModelInfo> modelList = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await Auth.GetAuthenticationStateAsync();
        currentUserEmail = authState.User.Identity?.Name;

        // Load only the models for providers the current user has keys for.
        // This drives the grouped selector and ensures we only offer usable models.
        var available = await AiProviders.GetAvailableModelsForCurrentUserAsync();
        modelList = available
            .Select(m => new ModelInfo
            {
                Id = m.Id,
                Icon = m.Icon,
                Label = m.Label,
                ProviderName = m.ProviderName
            })
            .ToList();

        if (!string.IsNullOrEmpty(selectedModel) && modelList.All(m => m.Id != selectedModel))
            selectedModel = modelList.FirstOrDefault()?.Id ?? "";

        if (string.IsNullOrEmpty(selectedModel) && modelList.Any())
            selectedModel = modelList.First().Id;

        if (ConversationId.HasValue)
        {
            activeConversationId = ConversationId.Value;
            await LoadConversation(activeConversationId.Value);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (ConversationId.HasValue && ConversationId.Value != activeConversationId)
        {
            await LoadConversation(ConversationId.Value);
        }
    }

    async Task LoadConversation(Guid id)
    {
        activeConversationId = id;

        var msgs = await Conversations.GetConversationMessagesAsync(id);

        messages = msgs
            .OrderBy(m => m.Timestamp)
            .Select(m =>
            {
                var user = m.Role == "user" ? currentUserEmail! : "ChatFish";
                return new ChatMessage(user, FormatMessage(m.Content), m.Model, m.Timestamp);
            })
            .ToList();

        StateHasChanged();           // let the UI render first
        await ScrollToBottom();      // safe scroll after render
    }

    async Task HandleKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey && !isSending)
            await Send();
    }

    async Task ResizeTextarea()
    {
        try { await JS.InvokeVoidAsync("resizeChatTextarea", messageTextarea); }
        catch { /* ignore during initial render */ }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        _hasRendered = true;
        if (firstRender || messages.Any() || isTyping)
            await ScrollToBottom();
    }

    async Task Send()
    {
        if (isSending || string.IsNullOrWhiteSpace(message))
            return;

        isSending = true;

        // Capture and clear immediately to prevent double-sends from rapid Enter key presses
        // (common cause of "burst" requests that exhaust tiny free tier RPM buckets)
        var currentMessage = message;
        message = "";

        if (!activeConversationId.HasValue)
        {
            activeConversationId = await Conversations.StartNewConversationAsync();
        }

        var convoId = activeConversationId.Value;

        var formattedUser = FormatMessage(currentMessage);
        messages.Add(new ChatMessage(currentUserEmail!, formattedUser, null, DateTime.UtcNow));

        // Placeholder bot message
        var botIndex = messages.Count;
        messages.Add(new ChatMessage("ChatFish", "", selectedModel, DateTime.UtcNow));

        isTyping = true;
        StateHasChanged();

        var accumulated = "";

        try
        {
            await foreach (var partial in Conversations.StreamMessageAsync(convoId, currentMessage, selectedModel))
            {
                accumulated = partial;
                // Preserve the model and timestamp for this response (set at placeholder time)
                var currentModel = messages[botIndex].ModelUsed;
                var currentTs = messages[botIndex].Timestamp;
                messages[botIndex] = new ChatMessage("ChatFish", FormatMessage(accumulated), currentModel, currentTs);
                StateHasChanged();
                await ScrollToBottom();   // scroll during streaming
            }
        }
        finally
        {
            isTyping = false;
            isSending = false;
            try { await JS.InvokeVoidAsync("resetChatTextarea", messageTextarea); } catch { }
            await ScrollToBottom();
            StateHasChanged();
        }
    }

    async Task NewConversation()
    {
        activeConversationId = await Conversations.StartNewConversationAsync();
        messages.Clear();
        isTyping = false;
        message = "";
        try { await JS.InvokeVoidAsync("resetChatTextarea", messageTextarea); } catch { }
        StateHasChanged();
        await ScrollToBottom();
    }

    async Task ScrollToBottom()
    {
        if (!_hasRendered) return;
        await Task.Delay(80);
        try
        {
            await JS.InvokeVoidAsync("scrollChatToBottom");
        }
        catch { /* ignore during hot reload / initial render */ }
    }

    string FormatMessage(string raw)
    {
        if (string.IsNullOrWhiteSpace(raw))
            return "";

        var pipeline = new MarkdownPipelineBuilder()
            .UseAdvancedExtensions()
            .UseEmojiAndSmiley()
            .Build();

        return Markdown.ToHtml(raw, pipeline);
    }
}
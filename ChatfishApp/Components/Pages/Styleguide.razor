@page "/styleguide"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
<style>
.title {
    margin-bottom: 20px;
    font-size: 32px;
    font-weight: 600;
}

.color-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 20px;
    margin-top: 20px;
}

.color-card {
    background: white;
    border: 1px solid #D9E0E7;
    border-radius: 8px;
    padding: 12px;
    text-align: center;
    font-family: sans-serif;
}

.swatch {
    width: 100%;
    height: 70px;
    border-radius: 6px;
    margin-bottom: 10px;
    border: 1px solid #C3CCD6;
    display: flex;
    align-items: center;
    justify-content: center;
}

.sample-text {
    font-size: 14px;
    font-weight: 600;
    color: #1F2A37;
}

.sample-text.light {
    color: white;
}

.code {
    font-family: monospace;
    font-size: 14px;
    color: #5A6470;
}

/* Typography */
.typography-section {
    margin-top: 40px;
}

.type-card {
    margin-bottom: 30px;
}

.type-label {
    font-weight: 600;
    margin-bottom: 6px;
    color: #5A6470;
}

.h1 {
    font-size: 32px;
    font-weight: 600;
}

.h2 {
    font-size: 24px;
    font-weight: 600;
}

.body {
    font-size: 16px;
    line-height: 1.5;
}


</style>
<h1 class="title">Chatfish Style Guide</h1>

<h2>Color Palette</h2>

<div class="color-grid">

    <!-- Primary Blues -->
    <div class="color-card">
        <div class="swatch" style="background:#3BA7FF;">
            <span class="sample-text">Primary Blue</span>
        </div>
        <div class="code">#3BA7FF</div>
    </div>

    <div class="color-card">
        <div class="swatch" style="background:#1F7FCC;">
            <span class="sample-text light">Primary Dark</span>
        </div>
        <div class="code">#1F7FCC</div>
    </div>

    <div class="color-card">
        <div class="swatch" style="background:#7CCBFF;">
            <span class="sample-text">Primary Light</span>
        </div>
        <div class="code">#7CCBFF</div>
    </div>

    <div class="color-card">
        <div class="swatch" style="background:#D1E7FF;">
            <span class="sample-text">Chat Bubble Blue</span>
        </div>
        <div class="code">#D1E7FF</div>
    </div>

    <!-- New Light Blues -->
    <div class="color-card">
        <div class="swatch" style="background:#E6F2FF;">
            <span class="sample-text">Light Blue 1</span>
        </div>
        <div class="code">#E6F2FF</div>
    </div>

    <div class="color-card">
        <div class="swatch" style="background:#F0F7FF;">
            <span class="sample-text">Light Blue 2</span>
        </div>
        <div class="code">#F0F7FF</div>
    </div>

    <div class="color-card">
        <div class="swatch" style="background:#F7FBFF;">
            <span class="sample-text">Light Blue 3</span>
        </div>
        <div class="code">#F7FBFF</div>
    </div>

    <!-- Greys -->
    <div class="color-card">
        <div class="swatch" style="background:#F7F9FC;">
            <span class="sample-text">Grey 50</span>
        </div>
        <div class="code">#F7F9FC</div>
    </div>

    <div class="color-card">
        <div class="swatch" style="background:#EEF2F6;">
            <span class="sample-text">Grey 100</span>
        </div>
        <div class="code">#EEF2F6</div>
    </div>

    <div class="color-card">
        <div class="swatch" style="background:#D9E0E7;">
            <span class="sample-text">Grey 200</span>
        </div>
        <div class="code">#D9E0E7</div>
    </div>

    <div class="color-card">
        <div class="swatch" style="background:#C3CCD6;">
            <span class="sample-text">Grey 300</span>
        </div>
        <div class="code">#C3CCD6</div>
    </div>

    <div class="color-card">
        <div class="swatch" style="background:#A5AFBA;">
            <span class="sample-text light">Grey 400</span>
        </div>
        <div class="code">#A5AFBA</div>
    </div>

    <div class="color-card">
        <div class="swatch" style="background:#7E8894;">
            <span class="sample-text light">Grey 500</span>
        </div>
        <div class="code">#7E8894</div>
    </div>

    <div class="color-card">
        <div class="swatch" style="background:#5A6470;">
            <span class="sample-text light">Grey 600</span>
        </div>
        <div class="code">#5A6470</div>
    </div>

    <!-- Accents -->

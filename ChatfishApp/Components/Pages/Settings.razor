@page "/settings"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using ChatfishApp.Contracts
@using ChatfishApp.Data
@using ChatfishApp.Services
@using Microsoft.AspNetCore.Authorization
@inject ProviderKeyService KeyService
@inject AiProviderService AiProviders
@attribute [Authorize]

<PageTitle>API Keys - Chatfish.me</PageTitle>

<div style="max-width: 720px; margin: 2rem auto; padding: 0 1rem;">
    <h1>API Keys</h1>
    <p style="color:#666;">Keys are stored per your account. Add a key for a provider to enable its models in the chat selector.</p>

    <div style="margin: 1.5rem 0; padding: 1rem; border: 1px solid #ddd; border-radius: 8px;">
        <h3 style="margin-top:0;">Add or update a key</h3>

        <div style="display:flex; gap:0.5rem; align-items:flex-end; flex-wrap:wrap;">
            <div>
                <label style="display:block; font-size:0.85rem;">Provider</label>
                <select @bind="selectedProviderId" style="padding:0.4rem;">
                    @foreach (var p in ProviderCatalog.Providers)
                    {
                        <option value="@p.Id">@p.DisplayName</option>
                    }
                </select>
            </div>
            <div style="flex:1; min-width:220px;">
                <label style="display:block; font-size:0.85rem;">API Key <span style="font-size:0.7em; color:#888;">(visible text for accurate pasting — check the full key ends correctly before saving)</span></label>
                <input type="text" @bind="newKeyValue" placeholder="sk-... or your provider key" style="width:100%; padding:0.4rem;" />
            </div>
            <button @onclick="SaveKey" disabled="@string.IsNullOrWhiteSpace(newKeyValue)" style="padding:0.45rem 1rem;">Save Key</button>
            <button @onclick="ClearSelected" style="padding:0.45rem 1rem;">Clear for Provider</button>
        </div>

        @if (selectedProviderId == "groq")
        {
            <div style="margin-top:0.5rem; font-size:0.8rem; color:#666;">
                Get your Groq API key from <a href="https://console.groq.com/keys" target="_blank">console.groq.com/keys</a>. Free keys have good limits on many models.
            </div>
        }
        else if (selectedProviderId == "gemini")
        {
            <div style="margin-top:0.5rem; font-size:0.8rem; color:#666;">
                Go to <a href="https://aistudio.google.com/app/apikey" target="_blank">aistudio.google.com/app/apikey</a>, 
                create a free API key in a <strong>new project</strong> (not the "Default Gemini Project" — this avoids shared rate limit buckets). 
                <strong>DO NOT set up billing</strong> if you want to keep the free tier. 
                Free tier has low limits (typically ~10-15 requests per minute); check the Rate Limit tab in AI Studio after creating the key.
            </div>
        }
        else if (selectedProviderId == "openrouter")
        {
            <div style="margin-top:0.5rem; font-size:0.8rem; color:#666;">
                Get your API key at <a href="https://openrouter.ai/keys" target="_blank">openrouter.ai/keys</a>. 
                One key unlocks 400+ models from many providers (including strong tool-calling ones like Claude, GPT-4o, Llama, Gemini, and many free-tier options). 
                <strong>Recommended:</strong> create a dedicated key (helps with rate limits and attribution). 
                OpenRouter is OpenAI-compatible, so it works great with our agent/tool features (web search, page summarization, etc.).<br/>
                <span style="font-size:0.75em;">Tip: Some models require credits even on free keys. Use exact model IDs from <a href="https://openrouter.ai/models" target="_blank">openrouter.ai/models</a> (the catalog has common ones; 404 usually means wrong slug or no access on your key).</span>
            </div>
        }

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div style="color:#c00; font-size:0.85rem; margin-top:0.3rem;">@errorMessage</div>
        }
    </div>

    <h3>Your configured keys</h3>
    @if (currentKeys.Any())
    {
        <ul style="list-style:none; padding:0;">
            @foreach (var k in currentKeys)
            {
                var providerId = k.ProviderId; // local copy to avoid foreach capture issues in onclick
                var prov = ProviderCatalog.GetProvider(providerId);
                <li style="padding:0.5rem 0; border-bottom:1px solid #eee; display:flex; justify-content:space-between; align-items:center; gap: 0.5rem;">
                    <label style="display:flex; align-items:center; gap:0.4rem; cursor:pointer;">
                        <input type="checkbox" checked="@k.Enabled" @onchange="async e => await ToggleEnabled(providerId, (bool)(e.Value ?? false))" />
                        <span>
                            <strong>@(prov?.DisplayName ?? providerId)</strong>
                            <span style="color:#888; font-size:0.85rem;"> (set @k.UpdatedAt.ToLocalTime().ToString("g"))</span>
                        </span>
                    </label>
                    <button @onclick="() => ClearKey(providerId)" title="Remove key" 
                            style="color:#c00; background:none; border:none; cursor:pointer; padding:0; font-size:1rem; line-height:1; margin-left:auto;">
                        <i class="bi bi-trash3"></i>
                    </button>
                </li>
            }
        </ul>
    }
    else
    {
        <p style="color:#666;">No keys configured yet. Add one above to unlock models in Chat.</p>
    }

    <p style="margin-top:2rem; font-size:0.85rem;">
        <a href="/chat">Back to chat</a> &nbsp; • &nbsp; After adding keys, refresh or go to /chat to see the updated model list.
    </p>
</div>

@code {
    private List<UserProviderKey> currentKeys = new();
    private string selectedProviderId = "groq";
    private string newKeyValue = "";
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadKeys();
        if (ProviderCatalog.Providers.Any())
            selectedProviderId = ProviderCatalog.Providers[0].Id;
    }

    private async Task LoadKeys()
    {
        currentKeys = await KeyService.GetUserKeysAsync();
    }

    private async Task SaveKey()
    {
        errorMessage = null;
        if (string.IsNullOrWhiteSpace(selectedProviderId) || string.IsNullOrWhiteSpace(newKeyValue)) return;

        try
        {
            await KeyService.SetKeyAsync(selectedProviderId, newKeyValue.Trim());
            newKeyValue = "";
            await LoadKeys();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to save key: {ex.Message}";
        }
    }

    private async Task ClearKey(string providerId)
    {
        errorMessage = null;
        try
        {
            await KeyService.DeleteKeyAsync(providerId);
            await LoadKeys();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to remove key: {ex.Message}";
        }
    }

    private async Task ClearSelected()
    {
        errorMessage = null;
        if (!string.IsNullOrWhiteSpace(selectedProviderId))
        {
            try
            {
                await KeyService.DeleteKeyAsync(selectedProviderId);
                await LoadKeys();
            }
            catch (Exception ex)
            {
                errorMessage = $"Failed to clear key: {ex.Message}";
            }
        }
    }

    private async Task ToggleEnabled(string providerId, bool enabled)
    {
        errorMessage = null;
        try
        {
            await KeyService.ToggleEnabledAsync(providerId, enabled);
            await LoadKeys();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to update provider: {ex.Message}";
        }
    }
}

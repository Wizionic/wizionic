<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
    <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <!-- Always trim this WASM client for production size. Code must stay free of trim-hostile
         APIs (no FormattableString.Invariant, OperatingSystem in UI, AsyncLocal, catch MissingMethodException). -->
    <PublishTrimmed>true</PublishTrimmed>
  </PropertyGroup>

  <!-- Re-assert trim if a parent publish set PublishTrimmed=false as a global property. -->
  <Target Name="ForceClientWasmTrim" BeforeTargets="PrepareForILLink;_InitializeBasicAppProperties">
    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
      <PublishTrimmed>true</PublishTrimmed>
    </PropertyGroup>
  </Target>

  <ItemGroup>
    <ServiceWorker Include="wwwroot\service-worker.js"
                   PublishedContent="wwwroot\service-worker.published.js" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.8" />
    <PackageReference Include="Markdig" Version="1.2.0" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.6.0" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.6.0" />
    <PackageReference Include="OpenAI" Version="2.10.0" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.8" />
    <ProjectReference Include="..\ChatfishApp.Core\ChatfishApp.Core.csproj" />
    <ProjectReference Include="..\ChatfishApp.Shared\ChatfishApp.Shared.csproj" />
  </ItemGroup>

</Project>
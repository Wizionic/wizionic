@page "/"
@page "/account"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@layout ChatfishApp.Client.Shared.WasmLayout

@inject ChatfishApp.Client.Services.WasmAuthService AuthService
@inject HttpClient Http
@inject NavigationManager Nav

<div class="settings-content" style="max-width: 520px; margin: 2rem auto; padding: 0 1rem;">
    <h2>Chatfish</h2>
            <div style="margin: 1rem 0; padding: 0.75rem 1rem; background:var(--bubble-blue); border: 1px solid var(--primary-dark); border-radius: 6px;">
                Connect to local AI and keep all your data private!
        </div>
    <p style="color:#555;">Chat history and settings are stored entirely in your browser / on device. Log in with an email <em>only</em> if you want:
        <ul style="margin:0.5rem 0 0.5rem 1.25rem; color:#555;">
            <li>  to sync your encrypted chat history and settings across browsers or devices  </li>
            <li>  one of your devices (connected to your local AI) to act as a chat server for your other devices  </li>
        </ul>
     </p>

    @if (AuthService.IsAuthenticated && !string.IsNullOrEmpty(AuthService.Email))
    {
        <div style="margin: 1rem 0; padding: 0.75rem 1rem; background:var(--success); border: 1px solid #0a0; border-radius: 6px;">
            Logged in as <strong>@AuthService.Email</strong>.<br />
            <span style="font-size:0.9em;">You can now sync your encrypted chat history across browsers or devices.</span>
        </div>

        <div style="display:flex; gap:0.5rem; flex-wrap:wrap;">
            <button class="btn btn-primary" @onclick='() => Nav.NavigateTo("/chat")'>Continue to Chat</button>
            <button class="btn btn-outline-secondary" @onclick='() => Nav.NavigateTo("/settings")'>Settings</button>
            <button class="btn btn-outline-secondary" @onclick="DoLogout">Sign out</button>
        </div>
    }
    else
    {
        @if (!string.IsNullOrEmpty(error))
        {
            <div style="color:#c00; margin: 0.25rem 0 0.5rem; font-size:0.9em;">@error</div>
        }

        @if (magicSent)
        {
            <div style="margin: 0.75rem 0; padding: 0.75rem 1rem; background: #f0f7ff; border: 1px solid #3BA7FF; border-radius: 6px;">
                <p style="margin:0 0 0.25rem 0;"><strong>Magic link sent!</strong></p>
                <p style="margin:0; font-size:0.95em;">
                    We've emailed a login link to <strong>@email</strong>. Open your inbox (and check spam).
                    The email contains a big clickable "Log in to Chatfish" button <em>and</em> the raw URL
                    so you can copy-paste it if you're reading email on a different device or browser.
                </p>
            </div>

            <button class="btn btn-outline-secondary" @onclick="Reset">Use a different email</button>
        }
        else
        {
            <div style="display:flex; gap:0.5rem; align-items:flex-end; flex-wrap:wrap;">
                <div style="flex:1; min-width:220px;">
                    <input type="email" 
                           @bind-value="email" 
                           @bind-value:event="oninput" 
                           placeholder="email address" 
                           class="form-control" />
                </div>
                <button class="btn btn-primary" 
                        @onclick="SendMagic" 
                        disabled="@(!IsValidEmail(email))">
                    Send Magic Login Link
                </button>
            </div>
        }

        <div style="margin-top: 1.5rem; padding-top: 1rem; border-top: 1px solid #ddd; font-size:0.95em;">
            You can also continue without logging in but all your chat history and settings will only be stored locally and encrypted on this device.
            <div style="margin-top:0.35rem;">
                <a href="/chat" style="text-decoration:none; color:var(--primary-dark); font-weight:500;">Chat Now</a>
                &nbsp;•&nbsp;
                <a href="/local-ai" style="text-decoration:none; color:var(--primary-dark); font-weight:500;">Setup your local AI</a>
            </div>
        </div>

        <p style="margin-top:1rem; font-size:0.8em; color:#666;">
             All chat history is only stored locally on your device(s) and is never sent through a server.
        </p>
    }
</div>

@code {
    string email = "";
    bool magicSent = false;
    string? error;

    protected override async Task OnInitializedAsync()
    {
        await AuthService.LoadAsync();

        // Determine if the user explicitly navigated to the account view (e.g. via the profile icon).
        // When on /account (or /account/), we want to show the "Logged in as ... Sign out" UI
        // even for already-authenticated users, instead of auto-redirecting to chat.
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        string path = uri.AbsolutePath.TrimEnd('/');
        bool isExplicitAccountView = path.Equals("/account", StringComparison.OrdinalIgnoreCase);

        if (!AuthService.IsAuthenticated && isExplicitAccountView)
        {
            // Non-logged-in users clicking the profile icon should see the login form at the clean root URL.
            Nav.NavigateTo("/", replace: true);
            return;
        }

        if (AuthService.IsAuthenticated && !isExplicitAccountView)
        {
            Nav.NavigateTo("/chat", replace: true);
            return;
        }
    }

    async Task SendMagic()
    {
        error = null;
        if (!IsValidEmail(email)) return;

        try
        {
            var payload = new { Email = email.Trim() };
            var resp = await Http.PostAsJsonAsync("/api/auth/request-magic-link", payload);

            if (resp.IsSuccessStatusCode)
            {
                // We no longer receive (or display) the raw magic link here.
                // The only way the user gets the link is via the real email that was just sent.
                // The email body includes both a nice clickable button and the raw URL for copy/paste.
                await resp.Content.ReadFromJsonAsync<MagicLinkResponse>(); // consume response
                magicSent = true;
            }
            else
            {
                var txt = await resp.Content.ReadAsStringAsync();
                error = $"Could not send magic link ({resp.StatusCode}): {txt}";
            }
        }
        catch (Exception ex)
        {
            error = "Network or unexpected error: " + ex.Message;
        }
    }

    void Reset()
    {
        magicSent = false;
        error = null;
        // keep the typed email value so the user can quickly correct it
    }

    void DoLogout()
    {
        // Force load so the cookie is cleared by the server handler and we come back to a fresh "/"
        Nav.NavigateTo("/logout", forceLoad: true);
    }

    private bool IsValidEmail(string? e)
    {
        if (string.IsNullOrWhiteSpace(e))
            return false;

        var email = e.Trim();

        // Basic but effective checks for real-world use:
        // - Must contain exactly one @ (or at least one, but not starting/ending with it)
        // - Must have a dot after the @
        // - Local part and domain part must be non-empty
        int atIndex = email.IndexOf('@');
        if (atIndex <= 0 || atIndex == email.Length - 1)
            return false;

        int dotIndex = email.LastIndexOf('.');
        if (dotIndex <= atIndex + 1 || dotIndex == email.Length - 1)
            return false;

        // Optional: very light additional sanity (no spaces, reasonable length)
        if (email.Contains(' ') || email.Length < 5 || email.Length > 254)
            return false;

        return true;
    }

    private record MagicLinkResponse(bool Sent, string? Message);
}

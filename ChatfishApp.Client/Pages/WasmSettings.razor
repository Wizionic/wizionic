@page "/wasm-settings"
@layout ChatfishApp.Client.Shared.WasmLayout
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@inject ChatfishApp.Client.Services.WasmKeyStore KeyStore
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject HttpClient Http
@inject ChatfishApp.Client.Services.WasmAuthService AuthService

<div class="settings-content" style="padding: 1rem 2rem; max-width: 800px; margin: 0 auto;">

    <p style="color: #666; font-size: 0.9em;">Provider keys and Ollama configuration are stored only in your browser. Conversation history is stored in IndexedDB (encrypted at rest for both guest and logged-in sessions).</p>


    @if (true==false)
    {
        <button @onclick="ImportKeysFromAccount" class="btn btn-outline-secondary" style="margin-top: 0.75rem; margin-left: 0.5rem;">
            Import keys from my account
        </button>
        <small style="margin-left: 0.5rem; color:#666;">(pulls your server-side keys for use in this WASM client)</small>
    }

    <!-- Ollama Settings -->
    <h3>Ollama - Local AI on your computer</h3>
    <div style="max-width: 500px;">
<div class="ollama-instructions">
  <p>
    Ollama lets you run AI models privately on your own computer —
    no internet required, no API costs, no data leaving your machine.
  </p>
  <p>
    Download and install Ollama from 
    <a href="https://www.ollama.com/" target="_blank" rel="noopener">ollama.com</a>, 
    then run one of these commands in your terminal to download a model:
  </p>

  <div class="model-commands">
    <div class="model-command">
      <span class="model-desc">Fast and lightweight — great for most computers (2.5GB)</span>
      <pre><code>ollama pull qwen3:4b</code></pre>
    </div>
    <div class="model-command">
      <span class="model-desc">Google's efficient model — excellent quality for the size (3GB)</span>
      <pre><code>ollama pull gemma3:4b</code></pre>
    </div>
    <div class="model-command">
      <span class="model-desc">Very fast, minimal hardware requirements (2GB)</span>
      <pre><code>ollama pull llama3.2:3b</code></pre>
    </div>
    <div class="model-command">
      <span class="model-desc">Liquid AI's efficient architecture — strong tool use (5GB)</span>
      <pre><code>ollama pull lfm2.5</code></pre>
    </div>
  </div>

  <p>
    Once downloaded, click <strong>Refresh Models from Ollama</strong> — 
    Chatfish will detect your models automatically. All of these models 
    support agentic tools like web search and summarization.
  </p>
  <p style="font-size:0.85em; color:#666; margin-top:0.25rem;">
    <strong>On https://chatfish.me:</strong> Browser security blocks direct http:// calls to your local Ollama (mixed content).
    Use manual "Add custom model tag" below, or expose Ollama over https (tunnel/proxy) + set <code>OLLAMA_ORIGINS=https://chatfish.me</code> (or <code>*</code>) and enter the https base URL.
    Refresh works seamlessly when running the app locally over http.
  </p>
</div>


        <label>Base URL</label>
        <input type="text" @bind="ollamaBaseUrl" placeholder="http://localhost:11434" class="form-control" />
        <div style="font-size:0.75em; color:#888; margin:2px 0 4px;">For remote/network Ollama (with expose enabled), change to your LAN IP or https URL. http:// from this https site will be blocked by the browser.</div>

        <button @onclick="RefreshOllamaModels" class="btn btn-outline-primary" style="margin-top: 0.25rem;">Refresh Models from Ollama</button>
        <div style="font-size:0.72em; color:#888; margin-top:2px;">If this fails with a network/CORS error, add models by name manually instead (works everywhere).</div>

        <div class="model-list">
            <label>Available Ollama Models (click to remove)</label>
            @if (ollamaModels.Any())
            {
                <div style="display: flex; flex-wrap: wrap; gap: 4px;">
                    @foreach (var m in ollamaModels)
                    {
                        <span class="model-chip" @onclick="() => RemoveOllamaModel(m)">
                            @m ✕
                        </span>
                    }
                </div>
            }
            else
            {
                <div style="font-size: 0.8em; color: #888;">No models loaded. Use refresh (local http only) or add model names manually below.</div>
            }
        </div>

        <div style="margin-top: 0.5rem;">
            <label>Add custom model tag</label>
            <div style="display: flex; gap: 4px;">
                <input type="text" @bind="newOllamaModel" placeholder="" class="form-control" style="flex:1;" />
                <button @onclick="AddCustomOllamaModel" class="btn btn-outline-secondary">Add</button>
            </div>
        </div>
    </div>

    <!-- Provider Keys -->
    <h3>Cloud Provider Keys with a generous Free Tier</h3>
    <div style="display: grid; gap: 0.75rem; max-width: 500px;">
        <div>
            <label>Groq API Key</label>
            <input type="text" @bind="groqKey" placeholder="Get an API key from https://console.groq.com/ for access to multiple free models" class="form-control" />
        </div>
        <div>
            <label>Gemini API Key</label>
            <input type="text" @bind="geminiKey" placeholder="Get an API key from https://aistudio.google.com/" class="form-control" />
        </div>
        <div>
            <label>OpenRouter API Key</label>
            <input type="text" @bind="openrouterKey" placeholder="Get an API key from https://openrouter.ai/ for access to multiple free models" class="form-control" />
        </div>
    </div>
    <button @onclick="SaveKeys" class="btn btn-primary" style="margin-top: 0.75rem;">Save Keys</button>

    <div style="margin-top: 1.5rem;">
        <button @onclick="@(() => Nav.NavigateTo("/wasm-chat"))" class="btn btn-outline-secondary">Back to Chat</button>
    </div>
</div>

@code {
    string groqKey = "";
    string geminiKey = "";
    string openrouterKey = "";

    string ollamaBaseUrl = "http://localhost:11434";
    List<string> ollamaModels = new();
    string newOllamaModel = "";

    protected override async Task OnInitializedAsync()
    {
        await KeyStore.LoadAsync(JS);
        await AuthService.LoadAsync();

        groqKey = KeyStore.GetKey("groq");
        geminiKey = KeyStore.GetKey("gemini");
        openrouterKey = KeyStore.GetKey("openrouter");

        ollamaBaseUrl = KeyStore.OllamaBaseUrl;
        ollamaModels = new List<string>(KeyStore.OllamaModels);
    }

    async Task SaveKeys()
    {
        await KeyStore.SaveAllKeysAsync(JS, groqKey, geminiKey, openrouterKey);
        // UI fields are already bound; store is updated
    }

    async Task RefreshOllamaModels()
    {
        try
        {
            await KeyStore.RefreshOllamaModelsFromServerAsync(JS, Http);
            ollamaModels = new List<string>(KeyStore.OllamaModels);
        }
        catch (Exception ex)
        {
            var msg = ex.Message;
            // Common browser blocks when using the hosted https site against a local http Ollama.
            if (msg.Contains("CORS", StringComparison.OrdinalIgnoreCase) ||
                msg.Contains("fetch", StringComparison.OrdinalIgnoreCase) ||
                msg.Contains("blocked", StringComparison.OrdinalIgnoreCase) ||
                msg.Contains("Mixed Content", StringComparison.OrdinalIgnoreCase) ||
                msg.Contains("Failed to refresh", StringComparison.OrdinalIgnoreCase))
            {
                msg += "\n\nTip: On https://chatfish.me this is expected for http Ollama. Add the model name(s) manually in the box below instead, or configure your Ollama for https + OLLAMA_ORIGINS.";
            }
            await JS.InvokeVoidAsync("alert", msg);
        }
    }

    async Task AddCustomOllamaModel()
    {
        await KeyStore.AddOllamaModelAsync(JS, newOllamaModel);
        ollamaModels = new List<string>(KeyStore.OllamaModels);
        newOllamaModel = "";
    }

    async Task RemoveOllamaModel(string model)
    {
        await KeyStore.RemoveOllamaModelAsync(JS, model);
        ollamaModels = new List<string>(KeyStore.OllamaModels);
    }

    async Task ImportKeysFromAccount()
    {
        try
        {
            var serverKeys = await Http.GetFromJsonAsync<List<ImportedKey>>("/api/keys");
            if (serverKeys != null)
            {
                bool importedAny = false;
                foreach (var k in serverKeys)
                {
                    if (!string.IsNullOrWhiteSpace(k.ProviderId) && !string.IsNullOrWhiteSpace(k.Key))
                    {
                        await KeyStore.SetKeyAsync(JS, k.ProviderId, k.Key);
                        importedAny = true;
                    }
                }
                if (importedAny)
                {
                    // Refresh the bound fields
                    groqKey = KeyStore.GetKey("groq");
                    geminiKey = KeyStore.GetKey("gemini");
                    openrouterKey = KeyStore.GetKey("openrouter");
                    await JS.InvokeVoidAsync("alert", "Keys imported from your account and stored locally (encrypted with your sync key).");
                }
                else
                {
                    await JS.InvokeVoidAsync("alert", "No keys with actual values were returned (or you have none configured on the server yet).");
                }
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", "Could not import keys: " + ex.Message);
        }
    }

    private record ImportedKey(string ProviderId, bool Enabled, string? Key);
}

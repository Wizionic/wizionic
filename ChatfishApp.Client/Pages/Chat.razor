@page "/chat"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@layout ChatfishApp.Client.Shared.WasmLayout
@implements IDisposable

@using Markdig
@using ChatfishApp.Contracts
@using Microsoft.JSInterop
@using ChatfishApp.Client.Services
@using ChatMessage = ChatfishApp.Client.Services.WasmConversationStore.ChatMessage
@using Attachment = ChatfishApp.Client.Services.WasmConversationStore.Attachment
@using LocalConvo = ChatfishApp.Client.Services.WasmConversationStore.LocalConvo
@using Microsoft.Extensions.AI
@using AiChatMessage = Microsoft.Extensions.AI.ChatMessage
@using AIContent = Microsoft.Extensions.AI.AIContent
@using TextContent = Microsoft.Extensions.AI.TextContent
@using DataContent = Microsoft.Extensions.AI.DataContent
@using Microsoft.AspNetCore.Components.Forms

@inject IJSRuntime JS
@inject ChatfishApp.Client.Services.WasmKeyStore KeyStore
@inject ChatfishApp.Client.Services.WasmConversationStore ConversationStore
@inject ChatfishApp.Client.Services.WasmAiProviderService AiProviderService
@inject ChatfishApp.Client.Services.WasmAuthService AuthService
@inject ChatfishApp.Services.Tools.IToolProvider ToolProvider
@inject ChatfishApp.Client.Services.WasmSyncService SyncService
@inject ChatfishApp.Client.Services.WasmChatCompletionService ChatCompletionService

<div class="page @(SidebarState.IsCollapsed ? "sidebar-collapsed" : "")">
    <!-- Sidebar toggle button is here (in Chat.razor) so @onclick + StateHasChanged reliably update the .page class binding and icon.
         Positioned absolutely (via WasmLayout body container) to overlay the top bar near the fish logo (user's red box location).
         See .sidebar-toggle rule in chatfish.css for the absolute top/left/z-index values. -->
    <button @onclick="ToggleSidebar" class="sidebar-toggle" title="Toggle sidebar">
        @if (SidebarState.IsCollapsed)
        {
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" opacity="0.55">
                <rect x="3" y="3" width="18" height="18" rx="2" />
                <rect x="3" y="3" width="6" height="18" rx="2" fill="none" />
            </svg>
        }
        else
        {
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" opacity="0.55">
                <rect x="3" y="3" width="18" height="18" rx="2" />
                <rect x="3" y="3" width="6" height="18" rx="2" fill="currentColor" />
            </svg>
        }
    </button>

    <!-- Sidebar -->
    <div class="sidebar">
        <nav class="cf-nav cf-column">
            <!-- AI Chats header -->
            <div class="cf-item">
                <span class="cf-link small">
                    AI Chats
                    <button class="menu-button" @onclick="NewConversation" title="New chat">
                        <i class="cf-icon bi bi-plus-circle"></i>
                    </button>
                </span>
            </div>

            <!-- Local convos list -->
            @foreach (var c in localConvos.OrderByDescending(x => x.LastUpdated))
            {
                var isActive = activeConvoId == c.Id;
                <div class="conversation-item @(isActive ? "active" : "")" @onclick="() => SwitchConvo(c.Id)">
                    <div class="row-top">
                        <div class="title">@c.Title</div>
                        <div class="menu" @onclick:stopPropagation>
                            <button id="menu-btn-@c.Id" class="menu-button" @onclick:stopPropagation @onclick="() => ToggleMenu(c.Id)">⋮</button>
                        </div>
                    </div>
                    <div class="date">@c.LastUpdated.ToLocalTime().ToString("MMM d")</div>
                </div>
            }
            @if (!localConvos.Any())
            {
                <div class="cf-item" style="font-size:0.75em; color:#888; padding-left:12px;">No local conversations yet.</div>
            }
        </nav>
    </div>

    <!-- Main content -->
    <main>
        <div class="chat-wrapper" style="flex: 1; display: flex; flex-direction: column;">
            @if (!string.IsNullOrEmpty(SyncService.AiServerDeviceId))
            {
                <div style="padding: 0.35rem 1rem; background: #f0fdf4; border-bottom: 1px solid #bbf7d0; font-size: 0.85em; color: #166534;">
                    AI via <strong>@(SyncService.GetAiServerDeviceName() ?? "remote device")</strong>
                    @if (SyncService.IsAiProxyConnected)
                    {
                        <span> — connected</span>
                    }
                    else
                    {
                        <span> — connecting…</span>
                    }
                    @if (!string.IsNullOrEmpty(SyncService.AiProxyError))
                    {
                        <span style="color:#b45309;"> (@SyncService.AiProxyError)</span>
                    }
                </div>
            }
            <div class="chat-container" @ref="chatContainer" id="chat-container">
                @foreach (var msg in messages)
                {
                    <div class="message-row">
                        @if ((msg.User == currentUser) || msg.Role == "user")
                        {
                            <div class="message-me">
                                @((MarkupString)FormatMessage(msg.Content ?? ""))
                                @if (msg.Attachments != null && msg.Attachments.Any())
                                {
                                    <div class="message-attachments" style="display:flex; gap:4px; flex-wrap:wrap; margin-top:4px;">
                                        @foreach (var att in msg.Attachments)
                                        {
                                            <div style="width:52px; height:52px; border:1px solid #ccc; border-radius:4px; overflow:hidden; background:#f8f8f8; position:relative; flex-shrink:0;">
                                                @{
                                                    var thumbSrc = att.DataUrl;
                                                    if (thumbSrc == null && att.ContentType != null && att.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase) && !string.IsNullOrWhiteSpace(att.DataBase64))
                                                    {
                                                        thumbSrc = $"data:{att.ContentType};base64,{att.DataBase64}";
                                                    }
                                                }
                                                @if (thumbSrc != null)
                                                {
                                                    <img src="@thumbSrc" alt="@att.Name" style="width:100%; height:100%; object-fit:cover;" title="@att.Name" />
                                                }
                                                else
                                                {
                                                    <div style="font-size:9px; display:flex; align-items:center; justify-content:center; height:100%; color:#555; text-align:center; padding:2px;">
                                                        📄<br /><span style="font-size:6px; word-break:break-all; line-height:1;">@att.Name</span>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                                @if (msg.Timestamp.HasValue)
                                {
                                    <div style="font-size: 0.6em; color: #888; text-align: right; margin-top: 2px; opacity: 0.7;">
                                        @msg.Timestamp.Value.ToLocalTime().ToString("MMM d, HH:mm")
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="message-bot">
                                @if (!string.IsNullOrWhiteSpace(msg.ToolTrace))
                                {
                                    <details style="margin-bottom: 2px; font-size: 0.7em;">
                                        <summary style="cursor:pointer; color:#888;">Thinking / tool calls</summary>
                                        <pre style="white-space:pre-wrap; font-size:0.85em; background:#f4f4f4; padding:4px; border-radius:3px; margin:2px 0;">@msg.ToolTrace</pre>
                                    </details>
                                }
                                <div class="chat-markdown">
                                    @((MarkupString)FormatMessage(msg.Content ?? ""))
                                </div>
                                @if (!string.IsNullOrWhiteSpace(msg.ModelUsed))
                                {
                                    <div class="model-label" style="font-size: 0.6em; color: #888; text-align: right; margin-top: 2px; opacity: 0.7;">
                                        via @msg.ModelUsed
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }

                @if (isTyping)
                {
                    <div class="message-row">
                        <div class="message-bot typing">ChatFish is thinking<span class="dots">...</span></div>
                    </div>
                }
            </div>

            <!-- === COMPACT SEAMLESS INPUT BAR === -->
            <div class="input-area">
                <div class="input-container">
                    <!-- Plus menu replaced New Chat (new chat is in sidebar). Opens attach actions. -->
                    <div style="position: relative; display: inline-block;">
                        <button class="action-btn" @onclick:stopPropagation @onclick="ToggleAttachMenu" title="Attach file or more">
                            <i class="bi bi-plus-circle"></i>
                        </button>

                        @if (showAttachMenu)
                        {
                            <div class="menu-popup" style="position: absolute; bottom: 100%; left: 0; margin-bottom: 4px; min-width: 160px;" @onclick:stopPropagation>
                                <div @onclick="async () => { showAttachMenu = false; await TriggerFileUpload(); }">
                                    <i class="bi bi-upload" style="margin-right:4px;"></i> Upload a file
                                </div>
                                <!-- Future items (e.g. from URL, camera) can go here -->
                            </div>
                            <div class="menu-overlay" @onclick="() => showAttachMenu = false"></div>
                        }
                    </div>

                    <div class="message-wrapper flex-grow-1">
                        @if (pendingFiles.Any())
                        {
                            <div class="pending-attachments" style="display:flex; gap:4px; flex-wrap:wrap; margin-bottom:4px; padding-bottom:2px; border-bottom:1px solid #f0f0f0;">
                                @foreach (var f in pendingFiles)
                                {
                                    <div style="position:relative; width:42px; height:42px; border:1px solid #ddd; border-radius:4px; overflow:hidden; background:#fafafa; flex-shrink:0;">
                                        @{
                                            var thumbSrc = f.DataUrl;
                                            if (thumbSrc == null && f.ContentType != null && f.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase) && !string.IsNullOrWhiteSpace(f.DataBase64))
                                            {
                                                thumbSrc = $"data:{f.ContentType};base64,{f.DataBase64}";
                                            }
                                        }
                                        @if (thumbSrc != null)
                                        {
                                            <img src="@thumbSrc" alt="@f.Name" style="width:100%; height:100%; object-fit:cover;" />
                                        }
                                        else
                                        {
                                            <div style="font-size:9px; height:100%; display:flex; align-items:center; justify-content:center; color:#666; text-align:center; padding:1px; line-height:1.1;">
                                                📄<br /><span style="font-size:7px; word-break:break-all;">@f.Name</span>
                                            </div>
                                        }
                                        <button @onclick:stopPropagation @onclick="() => RemovePendingFile(f)" 
                                                style="position:absolute; top:-1px; right:-1px; background:#e11d48; color:white; border:none; border-radius:50%; width:13px; height:13px; font-size:8px; line-height:11px; cursor:pointer;">×</button>
                                    </div>
                                }
                            </div>
                        }

                        <textarea @ref="messageTextarea"
                                  @bind="message"
                                  @onkeydown="HandleKey"
                                  @oninput="ResizeTextarea"
                                  placeholder="Message ChatFish..."
                                  class="message-input"
                                  rows="3" />
                    </div>

                    <select @bind="selectedModel" class="model-selector">
                        @foreach (var group in modelList.GroupBy(m => m.ProviderName))
                        {
                            <optgroup label="@group.Key">
                                @foreach (var m in group)
                                {
                                    <option value="@m.Id">@m.Icon @m.Label</option>
                                }
                            </optgroup>
                        }
                    </select>

                    @if (CurrentModelSupportsTools)
                    {
                        <i class="bi bi-tools" style="font-size:0.9em; color:#888; margin-left:0.4rem; cursor:default;" title="This model supports tool calling (e.g. web search, page summarization). The model can use available tools when it needs fresh or external information."></i>
                    }
                    @if (CurrentModelSupportsVision)
                    {
                        <i class="bi bi-image" style="font-size:0.9em; color:#888; margin-left:0.4rem; cursor:default;" title="This model supports vision (images and PDFs). Upload files using the + menu to have the model analyze them."></i>
                    }

                    <button class="send-btn" @onclick="Send" disabled="@(isSending || (string.IsNullOrWhiteSpace(message) && !pendingFiles.Any()))">
                        <i class="bi bi-arrow-up-circle-fill"></i>
                    </button>
                </div>

                <!-- Hidden file picker for attachments (triggered by the + menu) -->
                <InputFile id="file-attach-input" style="display:none;" OnChange="OnFileSelected" />
            </div>
        </div>
    </main>

    @if (openMenuId != null)
    {
        <div class="menu-popup" style="@activePopupStyle" @onclick:stopPropagation>
            <div @onclick="async () => { await DeleteConvo(openMenuId); CloseMenu(); }">
                <button class="menu-button"><i class="cf-icon bi bi-trash3-fill"></i></button>
                Delete
            </div>
        </div>
        <div class="menu-overlay" @onclick="CloseMenu"></div>
    }
</div>

@code {
    string currentUser = "LocalUser";
    string message = "";
    string selectedModel = ""; // will be set to a valid model from the current list in OnInitializedAsync
    bool isTyping = false;
    bool isSending = false;

    // Captured during the current CallProvider for the just-generated bot message.
    private string _pendingToolTrace = "";

    private bool CurrentModelSupportsTools
    {
        get
        {
            if (string.IsNullOrEmpty(selectedModel)) return false;
            var mi = modelList.FirstOrDefault(m => m.Id == selectedModel);
            if (mi != null) return mi.SupportsTools;
            return false;
        }
    }

    private bool CurrentModelSupportsVision
    {
        get
        {
            if (string.IsNullOrEmpty(selectedModel)) return false;
            var mi = modelList.FirstOrDefault(m => m.Id == selectedModel);
            if (mi != null) return mi.SupportsVision;
            return false;
        }
    }

    private ElementReference chatContainer;
    private ElementReference messageTextarea;
    private bool _hasRendered = false;

    private DotNetObjectReference<object>? dotNetRef;

    List<ChatMessage> messages = new();

    List<WasmAiProviderService.ModelInfo> modelList = new();

    // Local history via store (types come from WasmConversationStore)
    List<LocalConvo> localConvos = new();
    string? activeConvoId;

    string? openMenuId;

    private List<Attachment> pendingFiles = new();
    private bool showAttachMenu = false;

    [Inject]
    public ChatfishApp.Client.Services.SidebarState SidebarState { get; set; } = default!;

    private string activePopupStyle = "";

    private class PopupPosition
    {
        public double top { get; set; }
        public double left { get; set; }
    }

    private Action? _sidebarStateChangedHandler;
    private Action? _syncChangedHandler;

    protected override async Task OnInitializedAsync()
    {
        await KeyStore.LoadAsync(JS);
        await AuthService.LoadAsync();               // fetch email + encryption key from server (if cookie present)
        await ConversationStore.LoadIndexAsync(JS);  // triggers any legacy cleaning (now respects auth for prefix/encryption)

        if (AuthService.IsAuthenticated && !string.IsNullOrEmpty(AuthService.Email))
        {
            currentUser = AuthService.Email; // use real email instead of the old "LocalUser" sentinel
            await SyncService.EnsureConnectedAndRegisteredAsync();
            if (!string.IsNullOrEmpty(SyncService.AiServerDeviceId))
                await SyncService.EnsureAiProxyConnectionAsync();
        }

        RefreshModelList();
        EnsureValidModelSelection();

        // Load history via store (will be under the per-email encrypted bucket if authed)
        localConvos = await ConversationStore.LoadIndexAsync(JS);
        var lastId = await ConversationStore.GetLastConvoIdAsync(JS);

        if (!string.IsNullOrEmpty(lastId) && localConvos.Any(c => c.Id == lastId))
        {
            activeConvoId = lastId;
            await LoadConversation(lastId);
        }
        else if (localConvos.Any())
        {
            activeConvoId = localConvos.OrderByDescending(c => c.LastUpdated).First().Id;
            await LoadConversation(activeConvoId);
        }
        else
        {
            await NewConversation();
        }

        _sidebarStateChangedHandler = () => InvokeAsync(StateHasChanged);
        SidebarState.OnChanged += _sidebarStateChangedHandler;

        // Subscribe so the conversation sidebar auto-refreshes when a sync arrives
        // while the user is on the chat page (even if they weren't on the sync page).
        SyncService.OnConversationsChanged += OnConversationsChangedFromSync;

        _syncChangedHandler = () => InvokeAsync(() =>
        {
            RefreshModelList();
            EnsureValidModelSelection();
            StateHasChanged();
        });
        SyncService.OnChanged += _syncChangedHandler;
    }

    private void RefreshModelList()
    {
        if (!string.IsNullOrEmpty(SyncService.AiServerDeviceId) && SyncService.RemoteModels.Any())
            modelList = SyncService.RemoteModels.ToList();
        else if (!string.IsNullOrEmpty(SyncService.AiServerDeviceId))
            modelList = new List<WasmAiProviderService.ModelInfo>();
        else
            modelList = AiProviderService.GetAvailableModels().ToList();
    }

    private void EnsureValidModelSelection()
    {
        bool hasValidSelection = !string.IsNullOrEmpty(selectedModel) &&
                                 modelList.Any(m => m.Id == selectedModel);

        if (!hasValidSelection && modelList.Any())
            selectedModel = modelList.First().Id;
    }

    public void Dispose()
    {
        if (_sidebarStateChangedHandler != null)
        {
            SidebarState.OnChanged -= _sidebarStateChangedHandler;
        }

        SyncService.OnConversationsChanged -= OnConversationsChangedFromSync;

        if (_syncChangedHandler != null)
            SyncService.OnChanged -= _syncChangedHandler;

        dotNetRef?.Dispose();
    }

    private async void OnConversationsChangedFromSync()
    {
        // A sync arrived (via WebRTC, while on this page or in background).
        // Reload the conversation list so the sidebar automatically reflects the new/updated chat.
        localConvos = await ConversationStore.LoadIndexAsync(JS);
        StateHasChanged();
    }

    private async Task ToggleSidebar()
    {
        SidebarState.Toggle();
        StateHasChanged();  // immediate re-render of this component (including .page class and button icon) since handler is local
        try
        {
            // Pass the target state so JS can *set* (not toggle) the class exactly; avoids parity issues with Blazor render timing.
            await JS.InvokeVoidAsync("toggleWasmSidebar", SidebarState.IsCollapsed);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Chat] toggleSidebar failed: {ex.Message}");
        }
    }

    void ToggleAttachMenu()
    {
        showAttachMenu = !showAttachMenu;
        StateHasChanged();
    }

    async Task TriggerFileUpload()
    {
        showAttachMenu = false;
        StateHasChanged();
        await Task.Delay(30); // allow menu to close in render
        try
        {
            await JS.InvokeVoidAsync("eval", "document.getElementById('file-attach-input').click()");
        }
        catch { /* ignore */ }
    }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        const long maxSize = 15 * 1024 * 1024; // 15 MB limit for attachments for now
        if (file.Size > maxSize)
        {
            await JS.InvokeVoidAsync("alert", $"File is too large ({file.Size / 1024 / 1024}MB). Max 15MB supported for attachments currently.");
            return;
        }

        try
        {
            using var stream = file.OpenReadStream(maxAllowedSize: maxSize + 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            var bytes = ms.ToArray();
            var base64 = Convert.ToBase64String(bytes);

            var att = new Attachment(
                Name: file.Name,
                ContentType: string.IsNullOrWhiteSpace(file.ContentType) ? "application/octet-stream" : file.ContentType,
                DataBase64: base64,
                Size: file.Size
            );

            pendingFiles.Add(att);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", "Could not read file: " + ex.Message);
        }
    }

    void RemovePendingFile(Attachment att)
    {
        pendingFiles.Remove(att);
        StateHasChanged();
    }

    [JSInvokable]
    public void OnImagePasted(string base64, string mimeType, string? fileName, long size)
    {
        if (string.IsNullOrWhiteSpace(base64)) return;

        // Normalize to a proper image content type. Some paste sources (especially "copy image")
        // can report odd types or the interop can be picky.
        string contentType = mimeType;
        if (string.IsNullOrWhiteSpace(contentType) || !contentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase))
        {
            contentType = "image/png";
        }

        var name = string.IsNullOrWhiteSpace(fileName)
            ? $"pasted-image.{(contentType.Split('/').LastOrDefault() ?? "png")}"
            : fileName;

        var att = new Attachment(
            Name: name,
            ContentType: contentType,
            DataBase64: base64,
            Size: size > 0 ? size : (long)(base64.Length * 0.75)
        );

        pendingFiles.Add(att);
        StateHasChanged();
    }

    async Task LoadConversation(string id)
    {
        activeConvoId = id;
        messages = await ConversationStore.LoadConversationAsync(JS, id);
        pendingFiles.Clear();
        StateHasChanged();
        await ScrollToBottom();
    }

    async Task HandleKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey && !isSending)
            await Send();
    }

    async Task ResizeTextarea()
    {
        try { await JS.InvokeVoidAsync("resizeChatTextarea", messageTextarea); }
        catch { }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        _hasRendered = true;

        if (firstRender)
        {
            dotNetRef = DotNetObjectReference.Create<object>(this);

            // Register helper (array buffer to base64)
            await JS.InvokeVoidAsync("eval", @"
                if (!window.__chatfishArrayBufferToBase64) {
                    window.__chatfishArrayBufferToBase64 = function(buffer) {
                        let binary = '';
                        const bytes = new Uint8Array(buffer);
                        const len = bytes.byteLength;
                        for (let i = 0; i < len; i++) {
                            binary += String.fromCharCode(bytes[i]);
                        }
                        return window.btoa(binary);
                    };
                }
            ");

            // Register the paste handler setup
            await JS.InvokeVoidAsync("eval", @"
                if (!window.__chatfishPasteHandlerInstalled) {
                    window.__chatfishPasteHandlerInstalled = true;
                    window.setupChatImagePaste = function (dotnetHelper, textareaEl) {
                        if (!textareaEl || !dotnetHelper) return;
                        textareaEl.addEventListener('paste', function (ev) {
                            let processed = false;
                            const dtFiles = ev.clipboardData && ev.clipboardData.files;
                            if (dtFiles && dtFiles.length > 0) {
                                for (let i = 0; i < dtFiles.length; i++) {
                                    const file = dtFiles[i];
                                    if (file && file.type && file.type.indexOf('image/') === 0) {
                                        const reader = new FileReader();
                                        reader.onload = function (e) {
                                            const base64 = window.__chatfishArrayBufferToBase64(e.target.result);
                                            const ext = (file.type.split('/')[1] || 'png');
                                            const fileName = file.name || ('pasted-image-' + Date.now() + '.' + ext);
                                            dotnetHelper.invokeMethodAsync('OnImagePasted', base64, file.type, fileName, file.size || 0);
                                        };
                                        reader.readAsArrayBuffer(file);
                                        ev.preventDefault();
                                        processed = true;
                                        break;
                                    }
                                }
                            }
                            if (!processed) {
                                const items = ev.clipboardData && ev.clipboardData.items;
                                if (items) {
                                    for (let i = 0; i < items.length; i++) {
                                        const item = items[i];
                                        if (item.kind === 'file' && item.type && item.type.indexOf('image/') === 0) {
                                            const file = item.getAsFile();
                                            if (!file) continue;
                                            const reader = new FileReader();
                                            reader.onload = function (e) {
                                                const base64 = window.__chatfishArrayBufferToBase64(e.target.result);
                                                const ext = (item.type.split('/')[1] || 'png');
                                                const fileName = file.name || ('pasted-image-' + Date.now() + '.' + ext);
                                                dotnetHelper.invokeMethodAsync('OnImagePasted', base64, item.type, fileName, file.size || 0);
                                            };
                                            reader.readAsArrayBuffer(file);
                                            ev.preventDefault();
                                            break;
                                        }
                                    }
                                }
                            }
                        });
                    };
                }
            ");

            await JS.InvokeVoidAsync("setupChatImagePaste", dotNetRef, messageTextarea);
        }

        if (firstRender || messages.Any() || isTyping)
            await ScrollToBottom();
    }

    async Task Send()
    {
        if (isSending || (string.IsNullOrWhiteSpace(message) && !pendingFiles.Any()))
            return;

        isSending = true;

        var currentMessage = message;
        message = "";

        if (string.IsNullOrEmpty(activeConvoId))
        {
            activeConvoId = Guid.NewGuid().ToString();
            await ConversationStore.SetLastConvoIdAsync(JS, activeConvoId);
        }

        // Store *raw* text (markdown/plain) for persistence, LLM history, and tool use.
        // Rendering always applies FormatMessage for display.
        var rawUser = currentMessage;
        var attachmentsForThisTurn = pendingFiles.Any() ? pendingFiles.ToList() : null;
        messages.Add(new ChatMessage(Role: "user", Content: rawUser, ModelUsed: null, Timestamp: DateTime.UtcNow, User: currentUser, Attachments: attachmentsForThisTurn));

        var botIndex = messages.Count;
        messages.Add(new ChatMessage(Role: "assistant", Content: "", ModelUsed: selectedModel, Timestamp: DateTime.UtcNow));

        isTyping = true;
        StateHasChanged();

        var accumulated = "";

        try
        {
            accumulated = await CallProvider();  // history (incl. attachments on the last user msg) is built from the messages list
            
            var currentModel = messages[botIndex].ModelUsed;
            var currentTs = messages[botIndex].Timestamp;
            messages[botIndex] = new ChatMessage(Role: "assistant", Content: accumulated, ModelUsed: currentModel, Timestamp: currentTs, ToolTrace: _pendingToolTrace);
            _pendingToolTrace = ""; // consumed
            StateHasChanged();
            await ScrollToBottom();

            // Save to local
            await SaveCurrentConvo();
        }
        finally
        {
            isTyping = false;
            isSending = false;
            pendingFiles.Clear();   // attachments consumed into the saved user message
            try { await JS.InvokeVoidAsync("resetChatTextarea", messageTextarea); } catch { }
            await ScrollToBottom();
            StateHasChanged();
        }
    }

    async Task<string> CallProvider(string? userMsg = null)
    {
        if (string.IsNullOrEmpty(selectedModel))
            return "No model selected.";

        try
        {
            if (!string.IsNullOrEmpty(SyncService.AiServerDeviceId))
            {
                await SyncService.EnsureAiProxyConnectionAsync();
                var (text, toolTrace) = await SyncService.SendChatRequestAsync(selectedModel, messages);
                _pendingToolTrace = toolTrace;
                return text;
            }

            var result = await ChatCompletionService.CompleteAsync(selectedModel, messages, currentUser);
            _pendingToolTrace = result.ToolTrace;

            if (!string.IsNullOrEmpty(result.Error))
            {
                _pendingToolTrace = string.IsNullOrEmpty(result.ToolTrace) ? "" : result.ToolTrace;
                return result.Error.StartsWith("Error calling provider", StringComparison.OrdinalIgnoreCase)
                    ? result.Error
                    : $"Error calling provider: {result.Error}";
            }

            return result.Text;
        }
        catch (Exception ex)
        {
            _pendingToolTrace = "";
            return $"Error calling provider: {ex.Message}";
        }
    }

    async Task NewConversation()
    {
        activeConvoId = Guid.NewGuid().ToString();
        await ConversationStore.SetLastConvoIdAsync(JS, activeConvoId);
        messages.Clear();
        pendingFiles.Clear();
        isTyping = false;
        message = "";
        try { await JS.InvokeVoidAsync("resetChatTextarea", messageTextarea); } catch { }
        StateHasChanged();
        await ScrollToBottom();
        await SaveCurrentConvo();
    }

    async Task SwitchConvo(string id)
    {
        if (activeConvoId != id)
        {
            await SaveCurrentConvo(); // save current first
            await LoadConversation(id);
        }
    }

    async Task ScrollToBottom()
    {
        if (!_hasRendered) return;
        await Task.Delay(80);
        try
        {
            await JS.InvokeVoidAsync("scrollChatToBottom");
        }
        catch { }
    }

    string FormatMessage(string raw)
    {
        if (string.IsNullOrWhiteSpace(raw))
            return "";

        var pipeline = new MarkdownPipelineBuilder()
            .UseAdvancedExtensions()
            .UseEmojiAndSmiley()
            .Build();

        return Markdown.ToHtml(raw, pipeline);
    }

    async Task SaveCurrentConvo()
    {
        if (string.IsNullOrEmpty(activeConvoId)) return;
        await ConversationStore.SaveConversationAsync(JS, activeConvoId, messages);
        await ConversationStore.UpdateIndexAfterSaveAsync(JS, activeConvoId, messages, localConvos);
        localConvos = await ConversationStore.LoadIndexAsync(JS);
    }

    async Task DeleteConvo(string id)
    {
        await ConversationStore.DeleteConversationAsync(JS, id);
        localConvos = await ConversationStore.LoadIndexAsync(JS);

        if (activeConvoId == id)
        {
            if (localConvos.Any())
            {
                activeConvoId = localConvos.OrderByDescending(c => c.LastUpdated).First().Id;
                await LoadConversation(activeConvoId);
            }
            else
            {
                await NewConversation();
            }
        }
        StateHasChanged();
    }

    void ToggleMenu(string id)
    {
        if (openMenuId == id)
        {
            openMenuId = null;
            activePopupStyle = "";
        }
        else
        {
            openMenuId = id;
            _ = PositionPopup(id);
        }
    }

    void CloseMenu()
    {
        openMenuId = null;
        activePopupStyle = "";
    }

    private async Task PositionPopup(string id)
    {
        try
        {
            var pos = await JS.InvokeAsync<PopupPosition>("getMenuPopupPosition", $"menu-btn-{id}");
            activePopupStyle = $"position: fixed; top: {pos.top}px; left: {pos.left}px; z-index: 10000;";
            StateHasChanged();
        }
        catch
        {
            activePopupStyle = "position: fixed; top: 120px; left: 260px; z-index: 10000;";
            StateHasChanged();
        }
    }

}

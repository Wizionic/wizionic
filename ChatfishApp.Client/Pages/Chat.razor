@page "/chat"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@layout ChatfishApp.Client.Shared.WasmLayout
@implements IDisposable

@using Markdig
@using ChatfishApp.Contracts
@using Microsoft.JSInterop
@using ChatfishApp.Client.Services
@using ChatMessage = ChatfishApp.Client.Services.WasmConversationStore.ChatMessage
@using LocalConvo = ChatfishApp.Client.Services.WasmConversationStore.LocalConvo
@using Microsoft.Extensions.AI
@using AiChatMessage = Microsoft.Extensions.AI.ChatMessage

@inject IJSRuntime JS
@inject ChatfishApp.Client.Services.WasmKeyStore KeyStore
@inject ChatfishApp.Client.Services.WasmConversationStore ConversationStore
@inject ChatfishApp.Client.Services.WasmAiProviderService AiProviderService
@inject ChatfishApp.Client.Services.WasmAuthService AuthService
@inject ChatfishApp.Services.Tools.IToolProvider ToolProvider
@inject ChatfishApp.Client.Services.WasmSyncService SyncService

<div class="page @(SidebarState.IsCollapsed ? "sidebar-collapsed" : "")">
    <!-- Sidebar toggle button is here (in Chat.razor) so @onclick + StateHasChanged reliably update the .page class binding and icon.
         Positioned absolutely (via WasmLayout body container) to overlay the top bar near the fish logo (user's red box location).
         See .sidebar-toggle rule in chatfish.css for the absolute top/left/z-index values. -->
    <button @onclick="ToggleSidebar" class="sidebar-toggle" title="Toggle sidebar">
        @if (SidebarState.IsCollapsed)
        {
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" opacity="0.55">
                <rect x="3" y="3" width="18" height="18" rx="2" />
                <rect x="3" y="3" width="6" height="18" rx="2" fill="none" />
            </svg>
        }
        else
        {
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" opacity="0.55">
                <rect x="3" y="3" width="18" height="18" rx="2" />
                <rect x="3" y="3" width="6" height="18" rx="2" fill="currentColor" />
            </svg>
        }
    </button>

    <!-- Sidebar -->
    <div class="sidebar">
        <nav class="cf-nav cf-column">
            <!-- AI Chats header -->
            <div class="cf-item">
                <span class="cf-link small">
                    AI Chats
                    <button class="menu-button" @onclick="NewConversation" title="New chat">
                        <i class="cf-icon bi bi-plus-circle"></i>
                    </button>
                </span>
            </div>

            <!-- Local convos list -->
            @foreach (var c in localConvos.OrderByDescending(x => x.LastUpdated))
            {
                var isActive = activeConvoId == c.Id;
                <div class="conversation-item @(isActive ? "active" : "")" @onclick="() => SwitchConvo(c.Id)">
                    <div class="row-top">
                        <div class="title">@c.Title</div>
                        <div class="menu" @onclick:stopPropagation>
                            <button id="menu-btn-@c.Id" class="menu-button" @onclick:stopPropagation @onclick="() => ToggleMenu(c.Id)">⋮</button>
                        </div>
                    </div>
                    <div class="date">@c.LastUpdated.ToLocalTime().ToString("MMM d")</div>
                </div>
            }
            @if (!localConvos.Any())
            {
                <div class="cf-item" style="font-size:0.75em; color:#888; padding-left:12px;">No local conversations yet.</div>
            }
        </nav>
    </div>

    <!-- Main content -->
    <main>
        <div class="chat-wrapper" style="flex: 1; display: flex; flex-direction: column;">
            <div class="chat-container" @ref="chatContainer" id="chat-container">
                @foreach (var msg in messages)
                {
                    <div class="message-row">
                        @if ((msg.User == currentUser) || msg.Role == "user")
                        {
                            <div class="message-me">
                                @((MarkupString)FormatMessage(msg.Content ?? ""))
                                @if (msg.Timestamp.HasValue)
                                {
                                    <div style="font-size: 0.6em; color: #888; text-align: right; margin-top: 2px; opacity: 0.7;">
                                        @msg.Timestamp.Value.ToLocalTime().ToString("MMM d, HH:mm")
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="message-bot">
                                @if (!string.IsNullOrWhiteSpace(msg.ToolTrace))
                                {
                                    <details style="margin-bottom: 2px; font-size: 0.7em;">
                                        <summary style="cursor:pointer; color:#888;">Thinking / tool calls</summary>
                                        <pre style="white-space:pre-wrap; font-size:0.85em; background:#f4f4f4; padding:4px; border-radius:3px; margin:2px 0;">@msg.ToolTrace</pre>
                                    </details>
                                }
                                <div class="chat-markdown">
                                    @((MarkupString)FormatMessage(msg.Content ?? ""))
                                </div>
                                @if (!string.IsNullOrWhiteSpace(msg.ModelUsed))
                                {
                                    <div class="model-label" style="font-size: 0.6em; color: #888; text-align: right; margin-top: 2px; opacity: 0.7;">
                                        via @msg.ModelUsed
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }

                @if (isTyping)
                {
                    <div class="message-row">
                        <div class="message-bot typing">ChatFish is thinking<span class="dots">...</span></div>
                    </div>
                }
            </div>

            <!-- === COMPACT SEAMLESS INPUT BAR === -->
            <div class="input-area">
                <div class="input-container">
                    <button class="action-btn" @onclick="NewConversation" title="New Chat">
                        <i class="bi bi-plus-circle"></i>
                    </button>

                    <div class="message-wrapper flex-grow-1">
                        <textarea @ref="messageTextarea"
                                  @bind="message"
                                  @onkeydown="HandleKey"
                                  @oninput="ResizeTextarea"
                                  placeholder="Message ChatFish..."
                                  class="message-input"
                                  rows="3" />
                    </div>

                    <select @bind="selectedModel" class="model-selector">
                        @foreach (var group in modelList.GroupBy(m => m.ProviderName))
                        {
                            <optgroup label="@group.Key">
                                @foreach (var m in group)
                                {
                                    <option value="@m.Id">@m.Icon @m.Label</option>
                                }
                            </optgroup>
                        }
                    </select>

                    @if (CurrentModelSupportsTools)
                    {
                        <i class="bi bi-tools" style="font-size:0.9em; color:#888; margin-left:0.4rem; cursor:default;" title="This model supports tool calling (e.g. web search, page summarization). The model can use available tools when it needs fresh or external information."></i>
                    }

                    <button class="send-btn" @onclick="Send" disabled="@(isSending || string.IsNullOrWhiteSpace(message))">
                        <i class="bi bi-arrow-up-circle-fill"></i>
                    </button>
                </div>
            </div>
        </div>
    </main>

    @if (openMenuId != null)
    {
        <div class="menu-popup" style="@activePopupStyle" @onclick:stopPropagation>
            <div @onclick="async () => { await DeleteConvo(openMenuId); CloseMenu(); }">
                <button class="menu-button"><i class="cf-icon bi bi-trash3-fill"></i></button>
                Delete
            </div>
        </div>
        <div class="menu-overlay" @onclick="CloseMenu"></div>
    }
</div>

@code {
    string currentUser = "LocalUser";
    string message = "";
    string selectedModel = ""; // will be set to a valid model from the current list in OnInitializedAsync
    bool isTyping = false;
    bool isSending = false;

    // Captured during the current CallProvider for the just-generated bot message.
    private string _pendingToolTrace = "";

    private bool CurrentModelSupportsTools
    {
        get
        {
            if (string.IsNullOrEmpty(selectedModel)) return false;
            if (selectedModel.StartsWith("ollama/")) return true;
            var modelPart = selectedModel.Contains('/') ? selectedModel.Split('/', 2)[1] : selectedModel;
            var entry = ProviderCatalog.GetModel(modelPart);
            return entry?.Model.SupportsTools ?? true;
        }
    }

    private ElementReference chatContainer;
    private ElementReference messageTextarea;
    private bool _hasRendered = false;

    List<ChatMessage> messages = new();

    List<WasmAiProviderService.ModelInfo> modelList = new();

    // Local history via store (types come from WasmConversationStore)
    List<LocalConvo> localConvos = new();
    string? activeConvoId;

    string? openMenuId;

    [Inject]
    public ChatfishApp.Client.Services.SidebarState SidebarState { get; set; } = default!;

    private string activePopupStyle = "";

    private class PopupPosition
    {
        public double top { get; set; }
        public double left { get; set; }
    }

    private Action? _sidebarStateChangedHandler;

    protected override async Task OnInitializedAsync()
    {
        await KeyStore.LoadAsync(JS);
        await AuthService.LoadAsync();               // fetch email + encryption key from server (if cookie present)
        await ConversationStore.LoadIndexAsync(JS);  // triggers any legacy cleaning (now respects auth for prefix/encryption)

        if (AuthService.IsAuthenticated && !string.IsNullOrEmpty(AuthService.Email))
        {
            currentUser = AuthService.Email; // use real email instead of the old "LocalUser" sentinel
        }

        // Build model list from provider service (respects what keys/config are in the KeyStore)
        var available = AiProviderService.GetAvailableModels();
        modelList = available.ToList();  // already the service's ModelInfo

        // Ensure we have a valid selectedModel that actually exists in the current available list.
        // This prevents using stale defaults like "ollama/llama3" when the user only has gemma (or other models) configured in Settings.
        bool hasValidSelection = !string.IsNullOrEmpty(selectedModel) &&
                                 modelList.Any(m => m.Id == selectedModel);

        if (!hasValidSelection && modelList.Any())
        {
            selectedModel = modelList.First().Id;
        }

        // Load history via store (will be under the per-email encrypted bucket if authed)
        localConvos = await ConversationStore.LoadIndexAsync(JS);
        var lastId = await ConversationStore.GetLastConvoIdAsync(JS);

        if (!string.IsNullOrEmpty(lastId) && localConvos.Any(c => c.Id == lastId))
        {
            activeConvoId = lastId;
            await LoadConversation(lastId);
        }
        else if (localConvos.Any())
        {
            activeConvoId = localConvos.OrderByDescending(c => c.LastUpdated).First().Id;
            await LoadConversation(activeConvoId);
        }
        else
        {
            await NewConversation();
        }

        _sidebarStateChangedHandler = () => InvokeAsync(StateHasChanged);
        SidebarState.OnChanged += _sidebarStateChangedHandler;

        // Subscribe so the conversation sidebar auto-refreshes when a sync arrives
        // while the user is on the chat page (even if they weren't on the sync page).
        SyncService.OnConversationsChanged += OnConversationsChangedFromSync;
    }

    public void Dispose()
    {
        if (_sidebarStateChangedHandler != null)
        {
            SidebarState.OnChanged -= _sidebarStateChangedHandler;
        }

        SyncService.OnConversationsChanged -= OnConversationsChangedFromSync;
    }

    private async void OnConversationsChangedFromSync()
    {
        // A sync arrived (via WebRTC, while on this page or in background).
        // Reload the conversation list so the sidebar automatically reflects the new/updated chat.
        localConvos = await ConversationStore.LoadIndexAsync(JS);
        StateHasChanged();
    }

    private async Task ToggleSidebar()
    {
        SidebarState.Toggle();
        StateHasChanged();  // immediate re-render of this component (including .page class and button icon) since handler is local
        try
        {
            // Pass the target state so JS can *set* (not toggle) the class exactly; avoids parity issues with Blazor render timing.
            await JS.InvokeVoidAsync("toggleWasmSidebar", SidebarState.IsCollapsed);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Chat] toggleSidebar failed: {ex.Message}");
        }
    }

    async Task LoadConversation(string id)
    {
        activeConvoId = id;
        messages = await ConversationStore.LoadConversationAsync(JS, id);
        StateHasChanged();
        await ScrollToBottom();
    }

    async Task HandleKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey && !isSending)
            await Send();
    }

    async Task ResizeTextarea()
    {
        try { await JS.InvokeVoidAsync("resizeChatTextarea", messageTextarea); }
        catch { }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        _hasRendered = true;
        if (firstRender || messages.Any() || isTyping)
            await ScrollToBottom();
    }

    async Task Send()
    {
        if (isSending || string.IsNullOrWhiteSpace(message))
            return;

        isSending = true;

        var currentMessage = message;
        message = "";

        if (string.IsNullOrEmpty(activeConvoId))
        {
            activeConvoId = Guid.NewGuid().ToString();
            await ConversationStore.SetLastConvoIdAsync(JS, activeConvoId);
        }

        // Store *raw* text (markdown/plain) for persistence, LLM history, and tool use.
        // Rendering always applies FormatMessage for display.
        var rawUser = currentMessage;
        messages.Add(new ChatMessage(Role: "user", Content: rawUser, ModelUsed: null, Timestamp: DateTime.UtcNow, User: currentUser));

        var botIndex = messages.Count;
        messages.Add(new ChatMessage(Role: "assistant", Content: "", ModelUsed: selectedModel, Timestamp: DateTime.UtcNow));

        isTyping = true;
        StateHasChanged();

        var accumulated = "";

        try
        {
            accumulated = await CallProvider(currentMessage);
            
            var currentModel = messages[botIndex].ModelUsed;
            var currentTs = messages[botIndex].Timestamp;
            messages[botIndex] = new ChatMessage(Role: "assistant", Content: accumulated, ModelUsed: currentModel, Timestamp: currentTs, ToolTrace: _pendingToolTrace);
            _pendingToolTrace = ""; // consumed
            StateHasChanged();
            await ScrollToBottom();

            // Save to local
            await SaveCurrentConvo();
        }
        finally
        {
            isTyping = false;
            isSending = false;
            try { await JS.InvokeVoidAsync("resetChatTextarea", messageTextarea); } catch { }
            await ScrollToBottom();
            StateHasChanged();
        }
    }

    async Task<string> CallProvider(string userMsg)
    {
        if (string.IsNullOrEmpty(selectedModel))
            return "No model selected.";

        try
        {
            // Build proper conversation history from our message list (raw Content).
            // This enables context + tool calling (the model sees previous turns).
            var chatHistory = new List<AiChatMessage>();
            foreach (var m in messages)
            {
                if (string.IsNullOrWhiteSpace(m.Content)) continue;

                var roleStr = m.Role ?? (m.User == currentUser ? "user" : "assistant");
                var aiRole = roleStr.Equals("user", StringComparison.OrdinalIgnoreCase) ? ChatRole.User : ChatRole.Assistant;

                // Send clean text to the LLM (strip any legacy HTML from old persisted messages).
                string clean = CleanTextForLlm(m.Content);
                chatHistory.Add(new AiChatMessage(aiRole, clean));
            }
            // Add the current user turn (raw)
            chatHistory.Add(new AiChatMessage(ChatRole.User, userMsg));

            // Always start with a clean trace for this turn (populated by native tools and/or MCP tools during execution).
            ChatfishApp.Services.Tools.ToolExecutionTrace.Clear();

            // Get base client from our pluggable service (same as server).
            var baseClient = AiProviderService.GetChatClientForModel(selectedModel);

            IChatClient client = baseClient;
            ChatOptions? chatOptions = null;

            // Wire agentic tool calling exactly like the interactive server version.
            // Only for models that declare SupportsTools (or all Ollama, as local models are usually capable).
            if (CurrentModelSupportsTools)
            {
                client = baseClient
                    .AsBuilder()
                    .UseFunctionInvocation()   // M.E.AI middleware: model emits tool call -> we execute -> feed result -> repeat
                    .Build();

                // Make sure we have a fresh trace for this generation (native tools + any enabled remote MCP tools).
                ChatfishApp.Services.Tools.ToolExecutionTrace.Clear();

                // This now includes both the classic native tools AND any remote MCP servers the user enabled
                // on the Tools page (with their tokens applied via McpToolSource).
                // McpToolSource.GetCurrentMcpTools() (called inside) will auto-trigger a background refresh
                // the first time it sees enabled servers.
                chatOptions = new ChatOptions { Tools = ToolProvider.GetTools().ToList() };
            }

            // Simple retry with backoff for transient provider rate limits (429) during the agentic loop.
            // Each tool call can trigger multiple completions requests; cloud providers (Groq, Gemini, etc.) are rate-limited.
            const int maxAttempts = 3;
            Exception? lastEx = null;

            for (int attempt = 1; attempt <= maxAttempts; attempt++)
            {
                try
                {
                    var response = await client.GetResponseAsync(chatHistory, chatOptions ?? new ChatOptions());

                    // Capture the tool / thinking trace that was recorded by the tools during this generation.
                    _pendingToolTrace = string.Join("\n", ChatfishApp.Services.Tools.ToolExecutionTrace.GetCurrentTrace());

                    string responseText = response.Text ?? string.Empty;

                    // Many local reasoning models (e.g. LFM 2.5, certain Qwen, DeepSeek-R1 distilled, etc.)
                    // when called via Ollama's OpenAI-compatible /v1 endpoint put the final answer in a
                    // non-standard field ("reasoning", "reasoning_content", etc.) on the message instead of
                    // the normal "content". ME.AI's response.Text only sees standard content.
                    if (string.IsNullOrWhiteSpace(responseText))
                    {
                        var lastAssistant = response.Messages?
                            .LastOrDefault(m => m.Role == ChatRole.Assistant);

                        if (lastAssistant?.AdditionalProperties != null)
                        {
                            // Dump available keys into the trace so we can see exactly what this model/Ollama
                            // is surfacing for this particular run.
                            var availableKeys = string.Join(", ", lastAssistant.AdditionalProperties.Keys);
                            ChatfishApp.Services.Tools.ToolExecutionTrace.Record($"[debug] AdditionalProperties keys on assistant message: [{availableKeys}]");

                            // Try to find any key that looks like a reasoning field (case-insensitive contains "reason")
                            foreach (var key in lastAssistant.AdditionalProperties.Keys)
                            {
                                if (key.Contains("reason", StringComparison.OrdinalIgnoreCase))
                                {
                                    var value = lastAssistant.AdditionalProperties[key];

                                    string? reasonText = value as string;

                                    // Some integrations leave it as JsonElement instead of a plain string
                                    if (reasonText is null && value is System.Text.Json.JsonElement jsonEl && jsonEl.ValueKind == System.Text.Json.JsonValueKind.String)
                                    {
                                        reasonText = jsonEl.GetString();
                                    }

                                    if (!string.IsNullOrWhiteSpace(reasonText))
                                    {
                                        responseText = reasonText!;
                                        ChatfishApp.Services.Tools.ToolExecutionTrace.Record($"ℹ️ Extracted final response from non-standard field '{key}'.");
                                        break;
                                    }
                                }
                            }
                        }
                    }

                    return string.IsNullOrWhiteSpace(responseText) ? "No response." : responseText;
                }
                catch (Exception ex) when (attempt < maxAttempts)
                {
                    lastEx = ex;
                    string msg = ex.Message.ToLowerInvariant();
                    if (msg.Contains("429") || msg.Contains("too many requests") || msg.Contains("rate limit"))
                    {
                        int delayMs = attempt * 1200; // 1.2s, 2.4s, ...
                        ChatfishApp.Services.Tools.ToolExecutionTrace.Record($"⚠️ Provider rate limit (429) on attempt {attempt}. Waiting {delayMs}ms before retry...");
                        await Task.Delay(delayMs);
                        continue;
                    }
                    // non-rate-limit error → don't retry
                    throw;
                }
            }

            // If we exhausted retries
            _pendingToolTrace = string.Join("\n", ChatfishApp.Services.Tools.ToolExecutionTrace.GetCurrentTrace());
            return $"Error calling provider after retries: {lastEx?.Message ?? "unknown"}";
        }
        catch (Exception ex)
        {
            // Keep error messages actionable for the user (missing key, Ollama not running, CORS, rate limits, etc.)
            _pendingToolTrace = ""; // clear on error
            return $"Error calling provider: {ex.Message}";
        }
    }

    async Task NewConversation()
    {
        activeConvoId = Guid.NewGuid().ToString();
        await ConversationStore.SetLastConvoIdAsync(JS, activeConvoId);
        messages.Clear();
        isTyping = false;
        message = "";
        try { await JS.InvokeVoidAsync("resetChatTextarea", messageTextarea); } catch { }
        StateHasChanged();
        await ScrollToBottom();
        await SaveCurrentConvo();
    }

    async Task SwitchConvo(string id)
    {
        if (activeConvoId != id)
        {
            await SaveCurrentConvo(); // save current first
            await LoadConversation(id);
        }
    }

    async Task ScrollToBottom()
    {
        if (!_hasRendered) return;
        await Task.Delay(80);
        try
        {
            await JS.InvokeVoidAsync("scrollChatToBottom");
        }
        catch { }
    }

    string FormatMessage(string raw)
    {
        if (string.IsNullOrWhiteSpace(raw))
            return "";

        var pipeline = new MarkdownPipelineBuilder()
            .UseAdvancedExtensions()
            .UseEmojiAndSmiley()
            .Build();

        return Markdown.ToHtml(raw, pipeline);
    }

    async Task SaveCurrentConvo()
    {
        if (string.IsNullOrEmpty(activeConvoId)) return;
        await ConversationStore.SaveConversationAsync(JS, activeConvoId, messages);
        await ConversationStore.UpdateIndexAfterSaveAsync(JS, activeConvoId, messages, localConvos);
        localConvos = await ConversationStore.LoadIndexAsync(JS);
    }

    async Task DeleteConvo(string id)
    {
        await ConversationStore.DeleteConversationAsync(JS, id);
        localConvos = await ConversationStore.LoadIndexAsync(JS);

        if (activeConvoId == id)
        {
            if (localConvos.Any())
            {
                activeConvoId = localConvos.OrderByDescending(c => c.LastUpdated).First().Id;
                await LoadConversation(activeConvoId);
            }
            else
            {
                await NewConversation();
            }
        }
        StateHasChanged();
    }

    void ToggleMenu(string id)
    {
        if (openMenuId == id)
        {
            openMenuId = null;
            activePopupStyle = "";
        }
        else
        {
            openMenuId = id;
            _ = PositionPopup(id);
        }
    }

    void CloseMenu()
    {
        openMenuId = null;
        activePopupStyle = "";
    }

    private async Task PositionPopup(string id)
    {
        try
        {
            var pos = await JS.InvokeAsync<PopupPosition>("getMenuPopupPosition", $"menu-btn-{id}");
            activePopupStyle = $"position: fixed; top: {pos.top}px; left: {pos.left}px; z-index: 10000;";
            StateHasChanged();
        }
        catch
        {
            activePopupStyle = "position: fixed; top: 120px; left: 260px; z-index: 10000;";
            StateHasChanged();
        }
    }

    // Strip any legacy HTML so we send clean text to the LLM (and tools).
    private static string CleanTextForLlm(string? text)
    {
        if (string.IsNullOrWhiteSpace(text)) return "";
        if (!text.Contains('<')) return text;
        var plain = System.Text.RegularExpressions.Regex.Replace(text, "<.*?>", string.Empty);
        return System.Net.WebUtility.HtmlDecode(plain).Trim();
    }
}

@inject NavigationManager Nav

<div class="top-row px-4">
    <div class="top-left">
        <a class="cf-brand" href="/wasm-chat">
            <img width="50" src="/images/chatfish.png" title="Chatfish" alt="Chatfish" />
        </a>
    </div>
    <div style="display: flex; align-items: center; gap: 0.6rem;">
        <a href="/wasm-settings" title="Settings" style="color: var(--primary-dark); text-decoration: none; display: flex; align-items: center;">
            <i class="bi bi-gear" style="font-size: 1.35rem;"></i>
        </a>
        <a href="/account" title="Account / Login" style="color: var(--primary-dark); text-decoration: none; display: flex; align-items: center;">
            <i class="bi bi-person-circle" style="font-size: 1.35rem;"></i>
        </a>
    </div>
</div>


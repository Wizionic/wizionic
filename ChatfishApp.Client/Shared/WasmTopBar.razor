@inject NavigationManager Nav
@inject ChatfishApp.Client.Services.SidebarState SidebarState

<div class="top-row px-4">
    <div class="top-left">
        <a class="cf-brand" href="/wasm-chat">
            <img width="40" src="/images/chatfish.png" title="Chatfish WASM" alt="Chatfish" />
            Chatfish 
        </a>
        <button @onclick="ToggleSidebar" class="sidebar-toggle" title="Toggle sidebar">
            @if (SidebarState.IsCollapsed)
            {
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" opacity="0.55">
                    <rect x="3" y="3" width="18" height="18" rx="2" />
                    <rect x="3" y="3" width="6" height="18" rx="2" fill="none" />
                </svg>
            }
            else
            {
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" opacity="0.55">
                    <rect x="3" y="3" width="18" height="18" rx="2" />
                    <rect x="3" y="3" width="6" height="18" rx="2" fill="currentColor" />
                </svg>
            }
        </button>
    </div>
    <a href="/wasm-settings" style="text-decoration: none; color: var(--primary-dark); font-size: 0.9em;">Settings</a>
</div>

@code {
    protected override void OnInitialized()
    {
        SidebarState.OnChanged += StateHasChanged;
    }

    private void ToggleSidebar() => SidebarState.Toggle();
}

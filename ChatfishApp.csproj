<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <RootNamespace>ChatfishApp</RootNamespace>
    <UserSecretsId>a8d4cf06-2e6d-4968-9752-b26c847c8502</UserSecretsId>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <!-- No debug symbols in production -->
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <!-- Enable trimming for smaller Blazor WASM output -->
    <PublishTrimmed>true</PublishTrimmed>
    <!-- Optional: More aggressive trimming (use with caution, test thoroughly) -->
    <!-- <TrimMode>full</TrimMode> -->
  </PropertyGroup>

  <!-- Exclude development config files from publish -->
  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <Content Remove="appsettings.Development.json" />
    <Content Remove="**\appsettings.Development.json" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="appsettings*.json">
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>

  <!-- Exclude the supporting Client project sources from this main project's default globs.
       The main .csproj lives at repo root for flatter Railway-friendly publish commands.
       The Client project (sibling dir) is still referenced for its WASM components, services,
       and static web assets (css, etc.). Without this exclude, the root .csproj would
       compile the Client's *.cs + *.razor files as part of itself, causing duplicate type
       definitions (e.g. the ChatfishApp.Services.Tools copies) and top-level statement conflicts. -->
  <ItemGroup>
    <Compile Remove="ChatfishApp.Client\**" />
    <Content Remove="ChatfishApp.Client\**" />
    <EmbeddedResource Remove="ChatfishApp.Client\**" />
    <None Remove="ChatfishApp.Client\**" />
    <!-- Razor components, view imports, etc. from the Client must only be compiled by the Client project. -->
    <RazorComponent Remove="ChatfishApp.Client\**" />
    <RazorGenerate Remove="ChatfishApp.Client\**" />
    <Compile Remove="ChatfishApp.Maui\**" />
    <Content Remove="ChatfishApp.Maui\**" />
    <EmbeddedResource Remove="ChatfishApp.Maui\**" />
    <None Remove="ChatfishApp.Maui\**" />
    <RazorComponent Remove="ChatfishApp.Maui\**" />
    <RazorGenerate Remove="ChatfishApp.Maui\**" />
    <Compile Remove="ChatfishApp.Core\**" />
    <Content Remove="ChatfishApp.Core\**" />
    <EmbeddedResource Remove="ChatfishApp.Core\**" />
    <None Remove="ChatfishApp.Core\**" />
    <RazorComponent Remove="ChatfishApp.Core\**" />
    <RazorGenerate Remove="ChatfishApp.Core\**" />
    <Compile Remove="ChatfishApp.Shared\**" />
    <Content Remove="ChatfishApp.Shared\**" />
    <EmbeddedResource Remove="ChatfishApp.Shared\**" />
    <None Remove="ChatfishApp.Shared\**" />
    <RazorComponent Remove="ChatfishApp.Shared\**" />
    <RazorGenerate Remove="ChatfishApp.Shared\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.2.0" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.8" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.8">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.6.0" />
    <!-- For robust parsing of search results in the free web_search tool (DDG HTML) -->
    <PackageReference Include="HtmlAgilityPack" Version="1.11.70" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.8" />
    <!-- Real email sending for magic links (SMTP via MailKit). Configure in appsettings under "Email" section (use user-secrets for passwords in real deploys). -->
    <PackageReference Include="MailKit" Version="4.8.0" />
    <PackageReference Include="SIPSorcery" Version="10.0.10" />
    <ProjectReference Include="ChatfishApp.Client\ChatfishApp.Client.csproj" />
    <ProjectReference Include="ChatfishApp.Core\ChatfishApp.Core.csproj" />
    <ProjectReference Include="ChatfishApp.Shared\ChatfishApp.Shared.csproj" />
  </ItemGroup>

</Project>

@implements IDisposable
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject ISidebarState SidebarState
@inject IBrowserPanelState BrowserPanel
@using ChatfishApp.Core.UI
@using ChatfishApp.Shared.Services

<div class="top-row px-4">
    <div class="top-left">
        <a class="cf-brand" href="/chat">
            <img width="50" src="_content/ChatfishApp.Shared/images/chatfish.png" title="Chatfish" alt="Chatfish" />
        </a>
        <a href="/notes" title="Notes">
            <i class="bi bi-journal-text" style="font-size: 24px;"></i>
        </a>
        @if (AppEnvironment.IsMaui)
        {
            <button type="button" @onclick="ToggleBrowser" title="Browser"
                    class="browser-toggle-btn @(BrowserPanel.IsOpen ? "active" : "")">
                <i class="bi bi-globe" style="font-size: 24px;"></i>
            </button>
        }
    </div>
    <div class="top-row-right">
        <a href="/local-ai" title="Local AI Setup">
            <i class="bi bi-cpu"></i>
        </a>
        <a href="/cloud-providers" title="Cloud Providers">
            <i class="bi bi-cloud"></i>
        </a>
        @if (AppEnvironment.IsMaui)
        {
            <a href="/home-assistant" title="Home Assistant">
                <i class="bi bi-house-gear"></i>
            </a>
        }
        <a href="/settings" title="Settings">
            <i class="bi bi-gear"></i>
        </a>
        <a href="/sync" title="Devices & Sync">
            <i class="bi bi-arrow-repeat"></i>
        </a>
        <a href="/tools" title="Tools (MCP Servers)">
            <i class="bi bi-tools"></i>
        </a>
        <a href="/account" title="Account / Login">
            <i class="bi bi-person-circle"></i>
        </a>
    </div>
</div>

@code {
    private Action? _browserPanelChangedHandler;

    protected override void OnInitialized()
    {
        _browserPanelChangedHandler = () => InvokeAsync(StateHasChanged);
        BrowserPanel.OnChanged += _browserPanelChangedHandler;
    }

    private async Task ToggleBrowser()
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        if (!uri.AbsolutePath.TrimEnd('/').Equals("/chat", StringComparison.OrdinalIgnoreCase))
        {
            if (!BrowserPanel.IsOpen)
                BrowserPanel.IsOpen = true;
            Nav.NavigateTo("/chat");
            await CollapseSidebarIfNeededAsync();
            return;
        }

        BrowserPanel.Toggle();
        if (BrowserPanel.IsOpen)
            await CollapseSidebarIfNeededAsync();
    }

    private async Task CollapseSidebarIfNeededAsync()
    {
        if (!SidebarState.IsCollapsed)
        {
            SidebarState.IsCollapsed = true;
            try
            {
                await JS.InvokeVoidAsync("toggleWasmSidebar", true);
            }
            catch
            {
                // JS interop may be unavailable during static render passes.
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            await ThemeInterop.ApplySavedAsync(JS);
        }
        catch
        {
            // JS interop may be unavailable during static render passes.
        }
    }

    public void Dispose()
    {
        if (_browserPanelChangedHandler != null)
            BrowserPanel.OnChanged -= _browserPanelChangedHandler;
    }
}
@code {
    string currentUser = "LocalUser";
    string selectedModel = ""; // will be set to a valid model from the current list in OnInitializedAsync
    bool isTyping = false;
    bool isSending = false;
    string typingLabel = "ChatFish is thinking…";

    // Lemonade image gen / edit panel
    bool showImagePanel;
    string imagePanelMode = "generate"; // generate | edit
    string imagePrompt = "";
    string imageModel = "";
    int imageSteps = 4;
    double imageCfg = 1.0;
    string imageWidth = "512";
    string imageHeight = "512";
    string imageSeedText = "";
    string imageUpscale = "off";
    bool imageBusy;
    string? imagePanelError;
    byte[]? imageEditSourceBytes;
    string? imageEditPreviewUrl;
    string? imagePreviewUrl;
    string? imagePreviewName;
    string? imagePreviewBase64;
    string? imagePreviewContentType;
    string? imageActionFeedback;
    CancellationTokenSource? _imageCts;

    // Speech-to-text (Lemonade Whisper)
    bool isMicRecording;
    bool isMicTranscribing;
    string? micStatusMessage;
    bool micStatusIsError;
    CancellationTokenSource? _micCts;

    // Text-to-speech (Lemonade Kokoro)
    bool autoSpeakReplies;
    int? ttsBusyIndex;
    string? ttsStatusMessage;
    CancellationTokenSource? _ttsCts;

    string ImageSizeString => $"{imageWidth}x{imageHeight}";

    long? ParsedImageSeed
    {
        get
        {
            if (string.IsNullOrWhiteSpace(imageSeedText)) return null;
            return long.TryParse(imageSeedText.Trim(), out var s) ? s : null;
        }
    }

    // Captured during the current CallProvider for the just-generated bot message.
    private string _pendingToolTrace = "";
    private List<Attachment>? _pendingResultAttachments;
    private string? _pendingStatsLine;
    private CancellationTokenSource? _sendCts;

    // Context window indicator + compact
    int? _contextUsed;
    int? _contextLimit;
    bool isCompacting;
    string? contextStatusMessage;
    bool contextStatusIsError;
    const int ContextWarnPercent = 80;
    const int ContextDangerPercent = 90;
    /// <summary>Keep this many newest visible messages after compact.</summary>
    const int CompactKeepRecentMessages = 6;

    private ChatModelInfo? CurrentModelInfo =>
        string.IsNullOrEmpty(selectedModel)
            ? null
            : modelList.FirstOrDefault(m => m.Id == selectedModel);

    /// <summary>Selected Lemonade image model — Send generates an image instead of chat.</summary>
    private bool IsImageGenerationModel => CurrentModelInfo?.IsImageGeneration == true;

    /// <summary>Selected model is served by Lemonade (chat, image, omni, etc.).</summary>
    private bool IsLemonadeModelSelected =>
        !string.IsNullOrEmpty(selectedModel) &&
        selectedModel.StartsWith("lemonade/", StringComparison.OrdinalIgnoreCase);

    /// <summary>
    /// Lemonade image toolbar / + menu — only when a Lemonade model is selected
    /// (chat, image, or omni). Hidden for Ollama and cloud models.
    /// </summary>
    private bool ShowLemonadeImageActions =>
        LemonadeImages.IsGenerateAvailable && IsLemonadeModelSelected;

    private bool ShowLemonadeImageEditActions =>
        LemonadeImages.IsEditAvailable && IsLemonadeModelSelected;

    /// <summary>
    /// Mic / TTS toolbar — Lemonade speech is model-agnostic input/output, but hide
    /// on pure image-generation models where chat text is not the primary flow.
    /// </summary>
    private bool ShowLemonadeSpeechActions => !IsImageGenerationModel;

    private bool CurrentModelSupportsTools
    {
        get
        {
            if (IsImageGenerationModel) return false;
            return CurrentModelInfo?.SupportsTools ?? false;
        }
    }

    private bool HasVisionProxyConfigured =>
        !string.IsNullOrWhiteSpace(KeyStore.GetVisionProxyModelName()) ||
        modelList.Any(m => !string.IsNullOrWhiteSpace(m.VisionProxyModelId));

    private string? CurrentVisionProxyModelName
    {
        get
        {
            if (string.IsNullOrEmpty(selectedModel) || IsImageGenerationModel) return null;
            var mi = CurrentModelInfo;
            if (mi != null && !mi.SupportsVision && !string.IsNullOrWhiteSpace(mi.VisionProxyModelId))
                return mi.VisionProxyModelId;
            return KeyStore.GetVisionProxyModelName();
        }
    }

    private bool CurrentModelSupportsVision
    {
        get
        {
            if (IsImageGenerationModel) return false;
            if (CurrentModelInfo is { SupportsVision: true }) return true;
            return !string.IsNullOrWhiteSpace(CurrentVisionProxyModelName);
        }
    }

    private int ResolvedContextLimit
    {
        get
        {
            if (CurrentModelInfo is { ContextSize: > 0 } mi)
                return mi.ContextSize;
            return _contextLimit is > 0 ? _contextLimit.Value : 0;
        }
    }

    private int ResolvedContextUsed
    {
        get
        {
            if (_contextUsed is int used and > 0)
                return used;
            return EstimateVisibleMessagesTokens();
        }
    }

    private int ContextUsagePercent
    {
        get
        {
            var limit = ResolvedContextLimit;
            if (limit <= 0) return 0;
            return Math.Min(100, (int)Math.Round(100.0 * ResolvedContextUsed / limit));
        }
    }

    private bool ShowContextButton =>
        !IsImageGenerationModel &&
        ResolvedContextLimit > 0 &&
        messages.Any(m => m.DeletedAt is null && (!string.IsNullOrWhiteSpace(m.Content) || m.Attachments is { Count: > 0 }));

    private bool CanCompactConversation
    {
        get
        {
            if (isCompacting || isSending || IsImageGenerationModel)
                return false;
            var visible = messages.Where(m => m.DeletedAt is null &&
                (!string.IsNullOrWhiteSpace(m.Content) || m.Attachments is { Count: > 0 })).ToList();
            return visible.Count > CompactKeepRecentMessages;
        }
    }

    private string ContextButtonLabel
    {
        get
        {
            var used = FormatTokenCount(ResolvedContextUsed);
            var limit = FormatTokenCount(ResolvedContextLimit);
            return $"{used}/{limit}";
        }
    }

    private string ContextButtonCssClass
    {
        get
        {
            var pct = ContextUsagePercent;
            if (pct >= ContextDangerPercent) return "ctx-btn--danger";
            if (pct >= ContextWarnPercent) return "ctx-btn--warn";
            return "ctx-btn--ok";
        }
    }

    private string ContextButtonTitle
    {
        get
        {
            var pct = ContextUsagePercent;
            var baseText =
                $"Context {ContextButtonLabel} ({pct}%). " +
                "Click to compact: summarize older turns into a short memory and keep recent messages.";
            if (pct >= ContextDangerPercent)
                return baseText + " Window is nearly full — compact recommended.";
            if (pct >= ContextWarnPercent)
                return baseText + " Window is filling up.";
            if (!CanCompactConversation)
                return $"Context {ContextButtonLabel} ({pct}%). Not enough older messages to compact yet.";
            return baseText;
        }
    }

    private ElementReference chatContainer;
    private ElementReference messageTextarea;
    private bool _hasRendered = false;
    private bool _pendingScroll = false;

    private DotNetObjectReference<object>? dotNetRef;

    List<ChatMessage> messages = new();

    List<ChatModelInfo> modelList = new();

    // Local history via store (types come from WasmConversationStore)
    List<LocalConvo> localConvos = new();
    string? activeConvoId;
    bool _chatIndexLoading;
    /// <summary>Chat IDs unlocked for this page session only.</summary>
    private readonly HashSet<string> unlockedChatIds = new(StringComparer.OrdinalIgnoreCase);
    bool showChatUnlockDialog;
    string? unlockTargetChatId;
    string chatUnlockPassword = "";
    string? chatUnlockError;
    bool chatUnlockBusy;
    string? pendingRemoveChatProtectionId;

    private bool IsActiveChatLocked =>
        !string.IsNullOrEmpty(activeConvoId)
        && localConvos.FirstOrDefault(c => c.Id == activeConvoId)?.IsPasswordProtected == true
        && !unlockedChatIds.Contains(activeConvoId);

    private string? _dragConvoId;
    private string? _dragOverConvoId;
    private DotNetObjectReference<ChatPage>? _reorderDotNetRef;

    string? openMenuId;
    string? renameConvoId;
    string renameConvoTitle = "";
    bool showDeleteConfirm;
    string deleteConfirmTitle = "";
    string deleteConfirmMessage = "";
    string? pendingDeleteConvoId;
    string? pendingDeleteMessageMenuKey;
    const string BotMenuPrefix = "bot-";
    const string UserMenuPrefix = "user-";

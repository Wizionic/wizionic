    bool MessageHasImageAttachment(int index)
    {
        if (index < 0 || index >= messages.Count) return false;
        var atts = messages[index].Attachments;
        return atts != null && atts.Any(IsImageAttachment);
    }

    static bool IsImageAttachment(Attachment att) =>
        att.ContentType != null &&
        att.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase) &&
        !string.IsNullOrWhiteSpace(att.DataBase64);

    Attachment? FindLatestImageAttachment()
    {
        for (int i = messages.Count - 1; i >= 0; i--)
        {
            var atts = messages[i].Attachments;
            if (atts == null) continue;
            var img = atts.LastOrDefault(IsImageAttachment);
            if (img != null) return img;
        }

        return pendingFiles.LastOrDefault(IsImageAttachment);
    }


    static string? AttachmentDataUrl(Attachment att)
    {
        if (att.DataUrl != null)
            return att.DataUrl;
        if (att.ContentType != null &&
            att.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase) &&
            !string.IsNullOrWhiteSpace(att.DataBase64))
        {
            return $"data:{att.ContentType};base64,{att.DataBase64}";
        }
        return null;
    }


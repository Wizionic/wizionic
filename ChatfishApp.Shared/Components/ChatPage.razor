        {
            imagePanelError =
                "No edit-capable Lemonade models found. Install a model with the “edit” label (e.g. Flux-2-Klein) and refresh Local AI. " +
                "Generate-only models like Z-Image-Turbo cannot edit.";
            imagePanelMode = "edit";
            showImagePanel = true;
            imageEditSourceBytes = null;
            imageEditPreviewUrl = null;
            return;
        }

        Attachment? source = null;
        if (messageIndex is int idx && idx >= 0 && idx < messages.Count)
            source = messages[idx].Attachments?.LastOrDefault(IsImageAttachment);
        source ??= FindLatestImageAttachment();

        if (source == null)
        {
            imagePanelError = "No image found to edit. Generate or attach an image first.";
            imagePanelMode = "edit";
            showImagePanel = true;
            imageEditSourceBytes = null;
            imageEditPreviewUrl = null;
            return;
        }

        try
        {
            imageEditSourceBytes = Convert.FromBase64String(source.DataBase64);
        }
        catch
        {
            imagePanelError = "Could not decode the source image.";
            showImagePanel = true;
            return;
        }

        imagePanelMode = "edit";
        imagePanelError = null;
        imageEditPreviewUrl = AttachmentDataUrl(source);
        imagePrompt = "";
        imageModel = LemonadeImages.DefaultEditModel ?? LemonadeImages.EditModelNames.FirstOrDefault() ?? "";
        ApplyImageParamsFromModel(imageModel);
        showImagePanel = true;
    }

    void CloseImagePanel()
    {
        if (imageBusy) return;
        showImagePanel = false;
        imagePanelError = null;
        imageEditSourceBytes = null;
        imageEditPreviewUrl = null;
        _imageCts?.Cancel();
    }

    async Task SubmitImagePanel()
    {
        if (imageBusy) return;
        imagePanelError = null;

        if (string.IsNullOrWhiteSpace(imagePrompt))
        {
            imagePanelError = "Enter a prompt.";
            return;
        }

        if (string.IsNullOrWhiteSpace(imageModel))
        {
            imagePanelError = "Select a Lemonade image model. Refresh models on Local AI if the list is empty.";
            return;
        }

        if (imagePanelMode == "edit" && !LemonadeImages.ModelSupportsEdit(imageModel))
        {
            imagePanelError =
                $"{imageModel} does not support editing. Choose a model labeled edit (e.g. Flux-2-Klein).";
            return;
        }

        imageBusy = true;
        isSending = true;
        isTyping = true;
        typingLabel = imagePanelMode == "edit" ? "Editing image…" : "Generating image…";
        StateHasChanged();

        _imageCts?.Cancel();
        _imageCts = new CancellationTokenSource();
        var ct = _imageCts.Token;

        LemonadeImageResult result;
        try
        {
            if (imagePanelMode == "edit")
            {
                if (imageEditSourceBytes is not { Length: > 0 })
                {
                    imagePanelError = "No source image for edit.";
                    return;
                }

                result = await LemonadeImages.EditAsync(new LemonadeImageEditRequest(
                    Prompt: imagePrompt.Trim(),
                    ImagePngBytes: imageEditSourceBytes,
                    Model: imageModel,
                    Size: ImageSizeString,
                    Steps: imageSteps > 0 ? imageSteps : null,
                    CfgScale: imageCfg,
                    Seed: ParsedImageSeed), ct);
            }
            else
            {
                result = await LemonadeImages.GenerateAsync(new LemonadeImageGenerateRequest(
                    Prompt: imagePrompt.Trim(),
                    Model: imageModel,
                    Size: ImageSizeString,
                    Steps: imageSteps > 0 ? imageSteps : null,
                    CfgScale: imageCfg,
                    Seed: ParsedImageSeed), ct);
            }

            if (result.Success && !string.IsNullOrWhiteSpace(result.Base64Png) &&
                !string.Equals(imageUpscale, "off", StringComparison.OrdinalIgnoreCase))
            {
                typingLabel = "Upscaling…";
                StateHasChanged();
                result = await MaybeUpscaleAsync(result);
            }
        }
        catch (Exception ex)
        {
            result = LemonadeImageResult.Fail(ex.Message);
        }
        finally
        {
            imageBusy = false;
            isSending = false;
            isTyping = false;
            typingLabel = "ChatFish is thinking…";
        }

        if (!result.Success || string.IsNullOrWhiteSpace(result.Base64Png))
        {
            imagePanelError = result.Error ?? "Image request failed.";
            StateHasChanged();
            return;
        }

        await AppendGeneratedImageMessageAsync(
            imagePrompt.Trim(),
            result.Base64Png,
            result.Model ?? imageModel,
            isEdit: imagePanelMode == "edit");

        showImagePanel = false;
        imageEditSourceBytes = null;
        imageEditPreviewUrl = null;
        imagePrompt = "";
        StateHasChanged();
    }

    async Task AppendGeneratedImageMessageAsync(string prompt, string base64Png, string modelName, bool isEdit)
    {
        if (string.IsNullOrEmpty(activeConvoId))
        {
            activeConvoId = Guid.NewGuid().ToString();
            await ConversationStore.SetLastConvoIdAsync(activeConvoId);
        }

        var now = DateTime.UtcNow;
        var userLine = isEdit
            ? $"(Edit image) {prompt}"
            : $"(Generate image) {prompt}";

        messages.Add(new ChatMessage(
            Role: "user",
            Content: userLine,
            Timestamp: now,
            User: currentUser,
            ItemId: Guid.NewGuid().ToString("N"),
            ModifiedAt: now));

        var fileName = isEdit
            ? $"edited-{now:yyyyMMdd-HHmmss}.png"
            : $"generated-{now:yyyyMMdd-HHmmss}.png";
        var att = new Attachment(fileName, "image/png", base64Png, EstimateBase64Bytes(base64Png));
        var caption = isEdit
            ? $"Edited image for: {prompt}"
            : $"Generated image for: {prompt}";

        messages.Add(new ChatMessage(
            Role: "assistant",
            Content: caption,
            ModelUsed: $"lemonade/{modelName}",
            Timestamp: now,
            Attachments: new List<Attachment> { att },
            ItemId: Guid.NewGuid().ToString("N"),
            ModifiedAt: now));

        RequestScrollToBottom();
        await SaveCurrentConvo();
    }

    static long EstimateBase64Bytes(string b64)
    {
        // Approx decoded size; enough for UI/storage metadata.
        return (long)(b64.Length * 3L / 4L);
    }

    async Task SaveCurrentConvo()
    {
        if (string.IsNullOrEmpty(activeConvoId)) return;
        // Never overwrite a locked chat — body is not loaded until unlock this session.
        if (IsActiveChatLocked)
            return;
        await ConversationStore.SaveConversationAsync(activeConvoId, messages);
        await ConversationStore.UpdateIndexAfterSaveAsync(activeConvoId, messages, localConvos);
        localConvos = await ConversationStore.LoadIndexAsync();
        SyncService.ScheduleAutoSyncConvoAfterLocalSave(activeConvoId);
    }

    void OpenRenameConvoDialog(string? convoId)
    {
        if (string.IsNullOrEmpty(convoId))
            return;

        CloseMenu();
        renameConvoId = convoId;
        var convo = localConvos.FirstOrDefault(c => c.Id == convoId);
        renameConvoTitle = convo?.Title ?? "";
    }

    void CancelRenameConvo()
    {
        renameConvoId = null;
        renameConvoTitle = "";
    }

    async Task ConfirmRenameConvo()
    {
        if (renameConvoId is null || string.IsNullOrWhiteSpace(renameConvoTitle))
            return;

        var title = renameConvoTitle.Trim();
        await ConversationStore.SetConversationTitleAsync(renameConvoId, title);
        localConvos = await ConversationStore.LoadIndexAsync();
        SyncService.ScheduleAutoSyncConvoAfterLocalSave(renameConvoId, title);
        CancelRenameConvo();
        StateHasChanged();
    }

    async Task RenameConvoKeyHandler(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(renameConvoTitle))
            await ConfirmRenameConvo();
        else if (e.Key == "Escape")
            CancelRenameConvo();
    }

    void PromptDeleteConvo(string? convoId)
    {
        if (string.IsNullOrEmpty(convoId))
            return;

        CloseMenu();
        pendingDeleteConvoId = convoId;
        pendingDeleteMessageMenuKey = null;
        deleteConfirmTitle = "Delete conversation?";
        deleteConfirmMessage = "This permanently removes the entire chat history on this device and syncs the delete to your other devices.";
        showDeleteConfirm = true;
    }

    void PromptDeleteMessage(string? menuKey)
    {
        if (string.IsNullOrEmpty(menuKey))
            return;

        CloseMenu();
        pendingDeleteMessageMenuKey = menuKey;
        pendingDeleteConvoId = null;
        deleteConfirmTitle = "Delete message?";
        deleteConfirmMessage = "This message will be removed from the conversation and the change will sync to your other devices.";
        showDeleteConfirm = true;
    }

    void CancelPendingDelete()
    {
        showDeleteConfirm = false;
        pendingDeleteConvoId = null;
        pendingDeleteMessageMenuKey = null;
    }

    async Task ConfirmPendingDelete()
    {
        if (!string.IsNullOrEmpty(pendingDeleteConvoId))
            await DeleteConvo(pendingDeleteConvoId);
        else if (!string.IsNullOrEmpty(pendingDeleteMessageMenuKey))
            await DeleteMessageFromMenu(pendingDeleteMessageMenuKey);

        CancelPendingDelete();
    }

    async Task DeleteConvo(string id)
    {
        var deletedAt = await ConversationStore.DeleteConversationAsync(id);
        localConvos = await ConversationStore.LoadIndexAsync();
        SyncService.ScheduleAutoSyncConvoDeleteAfterLocalDelete(id, deletedAt);

        if (activeConvoId == id)
        {
            if (localConvos.Any())
            {
                activeConvoId = localConvos.OrderBy(c => c.SortOrder).ThenByDescending(c => c.LastUpdated).First().Id;
                await LoadConversation(activeConvoId);
            }
            else
            {
                await NewConversation();
            }
        }
        StateHasChanged();
    }

    void ToggleMenu(string id)
    {
        if (openMenuId == id)
        {
            CloseMenu();
        }
        else
        {
            openMenuId = id;
            _ = PositionPopupAtButton($"menu-btn-{id}");
        }
    }

    void CloseMenu()
    {
        _ = NoteDebugLog("CloseMenu");
        openMenuId = null;
        activePopupStyle = "";
        _botMenuMessageIndex = null;
        _userMenuMessageIndex = null;
    }

    void ToggleUserMenu(int index)
    {
        var menuKey = $"{UserMenuPrefix}{index}";
        if (openMenuId == menuKey)
        {
            CloseMenu();
        }
        else
        {
            openMenuId = menuKey;
            _userMenuMessageIndex = index;
            // MAUI: pin under ⋮ with right edges flush (menu sits just left of the dots).
            // WASM keeps getMenuPopupPosition via default alignMessageMenu=false path below.
            _ = PositionPopupAtButton($"user-menu-btn-{index}", alignMessageMenu: AppEnvironment.IsMaui);
        }
    }

    void ToggleBotMenu(int index)
    {
        var menuKey = $"{BotMenuPrefix}{index}";
        _ = NoteDebugLog($"ToggleBotMenu index={index} key={menuKey} openMenuId={openMenuId ?? "null"}");
        if (openMenuId == menuKey)
        {
            CloseMenu();
        }
        else
        {
            openMenuId = menuKey;
            _botMenuMessageIndex = index;
            _ = PositionPopupAtButton($"bot-menu-btn-{index}", alignMessageMenu: AppEnvironment.IsMaui);
        }
    }

    async Task DeleteMessageFromMenu(string? menuKey)
    {
        if (string.IsNullOrEmpty(menuKey))
            return;

        int? index = null;
        if (menuKey.StartsWith(BotMenuPrefix, StringComparison.Ordinal))
            index = int.TryParse(menuKey.Substring(BotMenuPrefix.Length), out var botIdx) ? botIdx : null;
        else if (menuKey.StartsWith(UserMenuPrefix, StringComparison.Ordinal))
            index = int.TryParse(menuKey.Substring(UserMenuPrefix.Length), out var userIdx) ? userIdx : null;

        if (index is null || index < 0 || index >= messages.Count)
            return;

        var i = index.Value;
        messages[i] = ChatMessageHelper.SoftDelete(messages[i]);
        await SaveCurrentConvo();
        StateHasChanged();
    }

    async Task OpenAddToNotesFromMenu(string? menuKey)
    {
        await NoteDebugLog($"OpenAddToNotesFromMenu called menuKey={menuKey ?? "null"}");

        if (string.IsNullOrEmpty(menuKey) || !menuKey.StartsWith(BotMenuPrefix, StringComparison.Ordinal))
        {
            await NoteDebugLog("ABORT: not a bot menu key");
            return;
        }

        if (!int.TryParse(menuKey.AsSpan(BotMenuPrefix.Length), out var index))
        {
            await NoteDebugLog("ABORT: could not parse message index from menu key");
            return;
        }

        if (index < 0 || index >= messages.Count)
        {
            await NoteDebugLog($"ABORT: index {index} out of range (messages.Count={messages.Count})");
            return;
        }

        _noteSourceMessage = messages[index];
        _noteSelectedId = "";
        _newNoteName = "";
        _noteTargetId = "";
        _noteTargetName = "";
        _noteConfirming = false;
        _noteShowExisting = false;
        _noteShowNewInput = false;
        _noteDialogNotes = new();

        showNewNote = true;
        await NoteDebugLog($"showNewNote=true, message length={_noteSourceMessage.Content?.Length ?? 0}");
        StateHasChanged();

        _ = LoadNoteDialogAsync();
    }

    async Task NoteDebugLog(string message)
    {
        Console.WriteLine($"[Chat.AddToNotes] {message}");
        try { await JS.InvokeVoidAsync("console.log", $"[Chat.AddToNotes] {message}"); } catch { }
    }

    async Task LoadNoteDialogAsync()
    {
        await NoteDebugLog("LoadNoteDialogAsync started");
        try
        {
            _noteDialogNotes = await NoteStore.LoadIndexAsync();
            await NoteDebugLog($"LoadNoteDialogAsync loaded {_noteDialogNotes.Count} notes");
        }
        catch (Exception ex)
        {
            await NoteDebugLog($"LoadNoteDialogAsync FAILED: {ex.Message}");
            _noteDialogNotes = new();
        }

        if (_noteDialogNotes.Any())
        {
            _noteSelectedId = "";
            _noteShowNewInput = false;
            _noteShowExisting = true;
        }
        else
        {
            _noteShowExisting = false;
            _noteShowNewInput = true;
        }

        await InvokeAsync(StateHasChanged);
        await NoteDebugLog($"LoadNoteDialogAsync done showExisting={_noteShowExisting} showNewInput={_noteShowNewInput}");
    }

    void NotePickExisting()
    {
        if (string.IsNullOrEmpty(_noteSelectedId)) return;
        var note = _noteDialogNotes.FirstOrDefault(n => n.Id == _noteSelectedId);
        _noteTargetId = _noteSelectedId;
        _noteTargetName = note?.Title ?? "this note";
        _noteShowExisting = false;
        _noteConfirming = true;
        StateHasChanged();
    }

    void NoteShowNewInput()
    {
        _noteShowExisting = false;
        _noteShowNewInput = true;
        StateHasChanged();
    }

    void NoteBackToPicker()
    {
        _noteSelectedId = "";
        _newNoteName = "";
        _noteShowNewInput = false;
        _noteShowExisting = true;
        StateHasChanged();
    }

    async Task NoteConfirmAdd()
    {
        if (_noteSourceMessage == null || string.IsNullOrEmpty(_noteTargetId)) return;
        var entries = await NoteStore.LoadNoteAsync(_noteTargetId);
        entries.Add(_noteSourceMessage);
        await NoteStore.SaveNoteAsync(_noteTargetId, entries);
        var note = _noteDialogNotes.FirstOrDefault(n => n.Id == _noteTargetId);
        await NoteStore.UpdateIndexAfterSaveAsync(_noteTargetId, note?.Title ?? _noteTargetName);
        CloseNewNote();
    }

    async Task NoteCreateAndSave()
    {
        if (_noteSourceMessage == null || string.IsNullOrWhiteSpace(_newNoteName)) return;
        var id = Guid.NewGuid().ToString();
        var title = _newNoteName.Trim();
        await NoteStore.SaveNoteAsync(id, new List<ChatMessage> { _noteSourceMessage });
        await NoteStore.UpdateIndexAfterSaveAsync(id, title);
        CloseNewNote();
    }

    async Task NoteNameKeyHandler(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_newNoteName))
            await NoteCreateAndSave();
    }

    void CloseNewNote()
    {
        showNewNote = false;
        _noteSourceMessage = null;
        _noteShowExisting = false;
        _noteShowNewInput = false;
        _noteConfirming = false;
        _noteSelectedId = "";
        _newNoteName = "";
        _noteTargetId = "";
        _noteTargetName = "";
        StateHasChanged();
    }

    private async Task PositionPopupAtButton(string buttonId, bool alignMessageMenu = false)
    {
        try
        {
            // Message ⋮ menus on MAUI use right-edge alignment under the button.
            // Sidebar/other menus (and all WASM menus) keep getMenuPopupPosition.
            var fn = alignMessageMenu ? "getBotMenuPopupPosition" : "getMenuPopupPosition";
            var pos = await JS.InvokeAsync<PopupPosition>(fn, buttonId);
            activePopupStyle = $"position: fixed; top: {pos.top}px; left: {pos.left}px; z-index: 10000;";
            StateHasChanged();
        }
        catch
        {
            activePopupStyle = "position: fixed; top: 120px; left: 260px; z-index: 10000;";
            StateHasChanged();
        }
    }

}

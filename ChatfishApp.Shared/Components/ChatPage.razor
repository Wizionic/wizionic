    void ApplyImageParamsFromModel(string modelIdOrName)
    {
        var bare = modelIdOrName.StartsWith("lemonade/", StringComparison.OrdinalIgnoreCase)
            ? modelIdOrName.Split('/', 2)[1]
            : modelIdOrName;
        var settings = KeyStore.GetLemonadeModelSettings(bare);
        if (settings == null)
            return;

        if (settings.DefaultSteps is > 0)
            imageSteps = settings.DefaultSteps.Value;
        if (settings.DefaultCfgScale is not null)
            imageCfg = settings.DefaultCfgScale.Value;
        if (settings.DefaultWidth is > 0)
            imageWidth = settings.DefaultWidth.Value.ToString();
        if (settings.DefaultHeight is > 0)
            imageHeight = settings.DefaultHeight.Value.ToString();
    }


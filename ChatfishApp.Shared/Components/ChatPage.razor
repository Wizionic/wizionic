    static bool IsImageOnlyAssistantMessage(ChatMessage msg)
    {
        if (string.IsNullOrWhiteSpace(msg.Content))
            return msg.Attachments?.Any() == true;
        var c = msg.Content.Trim();
        return c.StartsWith("Generated image for:", StringComparison.OrdinalIgnoreCase)
               || c.StartsWith("Edited image for:", StringComparison.OrdinalIgnoreCase);
    }

    static string StripMarkdownForSpeech(string raw)
    {
        if (string.IsNullOrWhiteSpace(raw)) return "";
        // Light cleanup so TTS doesn't read markdown noise.
        var s = System.Text.RegularExpressions.Regex.Replace(raw, @"!\[.*?\]\(.*?\)", " ");
        s = System.Text.RegularExpressions.Regex.Replace(s, @"\[([^\]]+)\]\([^)]+\)", "$1");
        s = System.Text.RegularExpressions.Regex.Replace(s, "[`*_#>]+", " ");
        s = System.Text.RegularExpressions.Regex.Replace(s, @"\s+", " ").Trim();
        return s;
    }

    async Task SpeakLastAssistantMessageAsync()
    {
        for (int i = messages.Count - 1; i >= 0; i--)
        {
            var m = messages[i];
            if (m.DeletedAt != null) continue;
            if (m.Role == "user" || m.User == currentUser) continue;
            if (string.IsNullOrWhiteSpace(m.Content)) continue;
            if (IsImageOnlyAssistantMessage(m)) continue;
            await SpeakMessageAsync(i);
            return;
        }
        ttsStatusMessage = "No assistant message to read.";
        StateHasChanged();
    }

    async Task SpeakMessageAsync(int index)
    {
        if (!LemonadeSpeech.IsTtsAvailable)
            return;
        if (index < 0 || index >= messages.Count)
            return;
        if (ttsBusyIndex != null)
            return;

        var msg = messages[index];
        var text = StripMarkdownForSpeech(msg.Content ?? "");
        if (string.IsNullOrWhiteSpace(text))
        {
            ttsStatusMessage = "Nothing to speak in that message.";
            return;
        }

        ttsBusyIndex = index;
        ttsStatusMessage = null;
        StateHasChanged();

        _ttsCts?.Cancel();
        _ttsCts = new CancellationTokenSource();
        var ct = _ttsCts.Token;

        try
        {
            try { await JS.InvokeVoidAsync("chatfishStopAudio"); } catch { }

            var result = await LemonadeSpeech.SpeakAsync(new LemonadeSpeechRequest(
                Input: text,
                Model: LemonadeSpeech.DefaultTtsModel,
                Voice: LemonadeSpeech.DefaultVoice,
                Speed: 1.0,
                ResponseFormat: "mp3"), ct);

            if (!result.Success || result.AudioBytes is not { Length: > 0 })
            {
                ttsStatusMessage = result.Error ?? "Text-to-speech failed.";
                return;
            }

            var b64 = result.ToBase64();
            var play = await JS.InvokeAsync<string>("chatfishPlayAudioBase64", b64, result.ContentType ?? "audio/mpeg");
            if (play != "ok")
                ttsStatusMessage = "Playback failed: " + play;
        }
        catch (Exception ex)
        {
            ttsStatusMessage = "Text-to-speech error: " + ex.Message;
        }
        finally
        {
            ttsBusyIndex = null;
            StateHasChanged();
            if (!string.IsNullOrEmpty(ttsStatusMessage))
            {
                try
                {
                    await Task.Delay(5000);
                    ttsStatusMessage = null;
                    await InvokeAsync(StateHasChanged);
                }
                catch { }
            }
        }
    }

    async Task PlayAttachmentAudio(Attachment att)
    {
        try
        {
            await JS.InvokeAsync<string>("chatfishPlayAudioBase64", att.DataBase64, att.ContentType ?? "audio/mpeg");
        }
        catch (Exception ex)
        {
            ttsStatusMessage = "Audio playback failed: " + ex.Message;
        }
    }


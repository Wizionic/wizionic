        _reorderDotNetRef ??= DotNetObjectReference.Create(this);

        try
        {
            await JS.InvokeVoidAsync(
                "chatfishNotesReorder.start",
                _reorderDotNetRef,
                convoId,
                e.ClientX,
                e.ClientY);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Chat] Reorder gesture start failed: {ex.Message}");
            await SwitchConvo(convoId);
        }
    }


@implements IAsyncDisposable
@using ChatfishApp.Core.Auth
@using ChatfishApp.Core.Storage
@using ChatfishApp.Core.UI
@using ChatfishApp.Shared.Services
@using Microsoft.AspNetCore.Components.Routing
@using System.Text

@inject IJSRuntime JS
@inject NavigationManager Nav
@inject INoteStore NoteStore
@inject IAuthService AuthService
@inject IGuestDataMigrationService GuestMigration
@inject INotesSyncBridge SyncBridge
@inject ISidebarState SidebarState

<WasmSidebarSync />

<div class="page @(SidebarState.IsCollapsed ? "sidebar-collapsed" : "")">
    <div class="sidebar">
        <nav class="cf-nav cf-column">
            <div class="cf-item">
                <span class="cf-link small">
                   <h4>Notebooks</h4>
                    <div class="menu" @onclick:stopPropagation>
                        <button id="notebooks-menu-btn" class="menu-button" @onclick:stopPropagation @onclick="() => ToggleExportAllMenu()" title="Notebook options">⋮</button>
                    </div>
                    <button class="menu-button" @onclick="OpenCreateNoteDialog" title="New notebook">
                        <i class="cf-icon bi bi-plus-circle" style="font-size: 30px;"></i>
                    </button>
                </span>
            </div>

            @foreach (var n in notes.OrderByDescending(x => x.LastUpdated))
            {
                var isActive = activeNoteId == n.Id;
                <div class="conversation-item @(isActive ? "active" : "")" @onclick="() => SwitchNote(n.Id)">
                    <div class="row-top">
                        <div class="title">@n.Title</div>
                        <div class="menu" @onclick:stopPropagation>
                            <button id="menu-btn-@n.Id" class="menu-button" @onclick:stopPropagation @onclick="() => ToggleMenu(n.Id)">⋮</button>
                        </div>
                    </div>
                    <div class="date">@n.LastUpdated.ToLocalTime().ToString("MMM d")</div>
                </div>
            }
            @if (!notes.Any())
            {
                <div class="cf-item" style="font-size:0.75em; color:var(--cf-text-muted); padding-left:12px;">No notes yet.</div>
            }
        </nav>
    </div>

    <main>
        <div class="chat-wrapper" style="flex: 1; display: flex; flex-direction: column;">
            <div class="chat-container" @ref="chatContainer">
                @for (var i = 0; i < currentNoteMessages.Count; i++)
                {
                    var msg = currentNoteMessages[i];
                    var capturedIndex = i;
                    var isEditing = editingMessageIndex == capturedIndex;

                    @if (msg.DeletedAt is null)
                    {
                        <div class="message-row" style="margin-bottom: 32px; display: flex; justify-content:  flex-start;">
                                <div style="position: relative; display: inline-flex; flex-direction: column; align-items: flex-end; max-width: 100%;margin-bottom: 10px;">
                                <div class="note-response-actions" style="position: absolute; top: -20px; right: 8px;  padding: 4px 10px; border-radius: 8px; display: flex; gap: 8px; z-index: 2; border: 1px solid rgba(0,0,0,0.05);">
                                    @if (isEditing)
                                    {
                                        <button type="button" class="menu-button note-action-btn" @onclick="() => SaveEdit(capturedIndex)" title="Save">
                                            <i class="cf-icon bi bi-check-lg"></i>
                                        </button>
                                        <button type="button" class="menu-button note-action-btn" @onclick="CancelEdit" title="Cancel">
                                            <i class="cf-icon bi bi-x-lg"></i>
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" class="menu-button note-action-btn" @onclick="async () => await StartEdit(capturedIndex)" title="Edit">
                                            <i class="cf-icon bi bi-pencil"></i>
                                        </button>
                                         @if (capturedIndex > 0)
                                         {
                                             <button type="button" class="menu-button note-action-btn" @onclick="() => MoveNoteEntryUp(capturedIndex)" title="Move up">
                                                 <i class="cf-icon bi bi-arrow-up"></i>
                                             </button>
                                         }
                                         @if (capturedIndex < currentNoteMessages.Count - 1)
                                         {
                                             <button type="button" class="menu-button note-action-btn" @onclick="() => MoveNoteEntryDown(capturedIndex)" title="Move down">
                                                 <i class="cf-icon bi bi-arrow-down"></i>
                                             </button>
                                         }
                                        <div class="menu" @onclick:stopPropagation style="position:relative;">
                                            @if (openEntryMenuIndex == capturedIndex)
                                            {
                                                <div class="menu-popup" style="@entryPopupStyle" @onclick:stopPropagation>
                                                    <div @onclick="() => { CloseEntryMenu(); PromptDeleteNoteEntry(capturedIndex); }">
                                                        <button type="button" class="menu-button"><i class="cf-icon bi bi-trash3-fill"></i></button>
                                                        Delete note entry
                                                    </div>
                                                    <div @onclick="() => OpenMoveNotebookDialog(capturedIndex)">
                                                        <button type="button" class="menu-button"><i class="cf-icon bi bi-arrow-right-square"></i></button>
                                                        Move note entry
                                                    </div>
                                                </div>
                                                <div class="menu-overlay" @onclick="CloseEntryMenu"></div>
                                            }
                                            @if (openMoveNotebookDialog)
                                            {
                                                <div class="newnote-overlay" @onclick:stopPropagation>
                                                    <div class="newnote-modal move-notebook-modal" @onclick:stopPropagation>
                                                        <h4 style="margin:0 0 12px 0;font-size:1.1rem;color:var(--color-text);">Move Note to Notebook</h4>
                                                        @if (moveTargetNotebooks.Count == 0)
                                                        {
                                                            <p style="font-size:0.85rem;color:var(--cf-text-muted);margin:12px 0 0 0;">No other notebooks available.</p>
                                                        }
                                                        else
                                                        {
                                                            @foreach (var target in moveTargetNotebooks)
                                                            {
                                                                var t = target;
                                                                <div class="move-notebook-item" @onclick="() => ConfirmMoveEntry(t.Id)" @onclick:stopPropagation>
                                                                    <i class="cf-icon bi bi-journal" style="font-size:1.1em;color:var(--cf-text-muted);margin-right:8px;"></i>
                                                                    <span>@t.Title</span>
                                                                </div>
                                                            }
                                                        }
                                                        <div style="margin-top:16px;display:flex;gap:8px;justify-content:flex-end;">
                                                            <button type="button" class="newnote-btn newnote-btn-secondary" @onclick="CloseMoveNotebookDialog">Cancel</button>
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                            <button type="button" id="@($"entry-menu-btn-{capturedIndex}")" class="menu-button note-action-btn" style="background:none;border:none;padding:4px;cursor:pointer;" @onclick="() => ToggleEntryMenu(capturedIndex)" title="More options">
                                                <i class="cf-icon bi bi-three-dots-vertical"></i>
                                            </button>
                                        </div>
                                    }
                                </div>
                                <div class="message-bot @(isEditing ? "note-editing" : "")">
                                    @if (isEditing)
                                    {
                                        <QuillEditor @ref="quillEditor"
                                                     @key="@($"note-edit-{activeNoteId}-{capturedIndex}-{editSessionKey}")"
                                                     InitialHtml="@editingInitialHtml"
                                                     HtmlChanged="OnEditHtmlChanged" />
                                    }
                                    else if (NoteContentFormatter.IsHtml(msg.ContentFormat))
                                    {
                                        <div class="ql-snow note-quill-display">
                                            <div class="ql-editor">
                                                @((MarkupString)msg.Content)
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="chat-markdown">
                                            @((MarkupString)NoteContentFormatter.ToDisplayHtml(msg.Content, msg.ContentFormat))
                                        </div>
                                    }

                                    @if (!IsUserNoteEntry(msg) && !string.IsNullOrWhiteSpace(msg.ModelUsed))
                                    {
                                        <div class="model-label" style="font-size:0.6em;color:var(--cf-text-muted);text-align:right;margin-top:2px;opacity:0.7">
                                            via @msg.ModelUsed
                                        </div>
                                    }
                                    @if (msg.Timestamp.HasValue)
                                    {
                                        <div style="font-size:0.6em;color:var(--cf-text-muted);text-align:right;margin-top:2px;opacity:0.7">
                                            @(msg.Timestamp.Value.ToLocalTime().ToString("MMM d, HH:mm"))
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                    

                }
            </div>
        </div>
    </main>

    @if (!string.IsNullOrEmpty(activeNoteId) && nameDialogMode == NoteNameDialogMode.None)
    {
        <button type="button"
                class="menu-button notes-fab"
                title="Add note entry"
                @onclick="AddEntryToCurrentNote">
            <i class="cf-icon bi bi-plus-circle"></i>
        </button>
    }

    @if (openMenuId != null)
    {
        <div class="menu-popup" style="@activePopupStyle" @onclick:stopPropagation>
            <div @onclick="async () => { await AddNoteEntry(openMenuId); }">
                <button type="button" class="menu-button"><i class="cf-icon bi bi-plus-lg"></i></button>
                Add
            </div>
            <div @onclick="() => OpenRenameDialog(openMenuId)">
                <button type="button" class="menu-button"><i class="cf-icon bi bi-pencil-square"></i></button>
                Rename
            </div>
            <div @onclick="() => ExportNotebook(openMenuId)">
                <button type="button" class="menu-button"><i class="cf-icon bi bi-file-earmark-arrow-down"></i></button>
                Export
            </div>
            <div @onclick="() => PromptDeleteNote(openMenuId)">
                <button type="button" class="menu-button"><i class="cf-icon bi bi-trash3-fill"></i></button>
                Delete Notebook
            </div>
        </div>
        <div class="menu-overlay" @onclick="CloseMenu"></div>
    }

    @if (openExportAllMenuId != null)
    {
        <div class="menu-popup" style="@exportAllPopupStyle" @onclick:stopPropagation>
            <div @onclick="() => ExportAllNotebooks()">
                <button type="button" class="menu-button"><i class="cf-icon bi bi-file-earmark-arrow-down"></i></button>
                Export all
            </div>
        </div>
        <div class="menu-overlay" @onclick="CloseExportAllMenu"></div>
    }

    <ConfirmDialog IsVisible="showDeleteConfirm"
                   Title="@deleteConfirmTitle"
                   Message="@deleteConfirmMessage"
                   OnConfirm="ConfirmPendingDelete"
                   OnCancel="CancelPendingDelete" />

    @if (nameDialogMode != NoteNameDialogMode.None)
    {
        <div class="newnote-overlay" @onclick="CancelNameDialog">
            <div class="newnote-modal" @onclick:stopPropagation>
                <h4 style="margin:0 0 12px 0;font-size:1.1rem;color:var(--color-text);">
                    @(nameDialogMode == NoteNameDialogMode.Create ? "New Notebook" : "Rename Note")
                </h4>
                @if (nameDialogMode == NoteNameDialogMode.Create)
                {
                    <p style="font-size:0.85rem;color:var(--cf-text-muted);margin:0 0 12px 0;">Enter a name for your notebook. A first note entry will be added automatically.</p>
                }
                <input type="text"
                       @bind="nameDialogTitle"
                       @bind:event="oninput"
                       placeholder="Notebook name..."
                       class="newnote-input"
                       @onkeydown="NameDialogKeyHandler" />
                <div style="margin-top:12px;display:flex;gap:8px;justify-content:flex-end;">
                    <button type="button" class="newnote-btn newnote-btn-secondary" @onclick="CancelNameDialog">Cancel</button>
                    <button type="button" class="newnote-btn newnote-btn-primary" @onclick="ConfirmNameDialog" disabled="@(string.IsNullOrWhiteSpace(nameDialogTitle))">
                        @(nameDialogMode == NoteNameDialogMode.Create ? "Create" : "Save")
                    </button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<LocalNote> notes = new();
    private string? activeNoteId;
    private List<ChatMessage> currentNoteMessages = new();
    private string? openMenuId;
    private string? openExportAllMenuId;
    private string activePopupStyle = "";
    private string exportAllPopupStyle = "";
    private ElementReference chatContainer;

    private int? editingMessageIndex;
    private string editingInitialHtml = "";
    private string? _activeEditDraftHtml;
    private int editSessionKey;
    private QuillEditor? quillEditor;

    private enum NoteNameDialogMode { None, Create, Rename }

    private NoteNameDialogMode nameDialogMode = NoteNameDialogMode.None;
    private string? nameDialogNoteId;
    private string nameDialogTitle = "";

    private bool showDeleteConfirm;
    private string deleteConfirmTitle = "";
    private string deleteConfirmMessage = "";
    private string? pendingDeleteNoteId;
    private int? pendingDeleteEntryIndex;

    private int? openEntryMenuIndex;
    private string entryPopupStyle = "";
    private bool openMoveNotebookDialog;
    private string moveSourceNoteId = "";
    private int moveSourceEntryIndex = -1;
    private List<LocalNote> moveTargetNotebooks = new();

    private class PopupPosition
    {
        public double top { get; set; }
        public double left { get; set; }
    }

    private Action? _sidebarStateChangedHandler;
    private Action? _notesSyncChangedHandler;

    protected override async Task OnInitializedAsync()
    {
        await AuthService.LoadAsync();
        if (AuthService.IsAuthenticated)
            await GuestMigration.MigrateIfNeededAsync();

        notes = await NoteStore.LoadIndexAsync();

        if (notes.Any())
        {
            activeNoteId = notes.OrderByDescending(n => n.LastUpdated).First().Id;
            await LoadNote(activeNoteId);
        }
        else
        {
            await OpenCreateNoteDialog();
        }

        _sidebarStateChangedHandler = () => InvokeAsync(StateHasChanged);
        SidebarState.OnChanged += _sidebarStateChangedHandler;

        _notesSyncChangedHandler = () => _ = RefreshNotesFromSyncAsync();
        SyncBridge.OnNotesChanged += _notesSyncChangedHandler;

        // Autosave when navigating away. Use LocationChanged only — do not catch
        // MissingMethodException (that type can be stripped under WASM trim and crash OnInitialized).
        Nav.LocationChanged += OnLocationChanged;
    }

    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        try
        {
            await CommitActiveEditAsync(persistToStore: true);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Notes] Failed to autosave after navigation: {ex.Message}");
        }
    }

    private async Task RefreshNotesFromSyncAsync()
    {
        notes = await NoteStore.LoadIndexAsync();

        if (!string.IsNullOrEmpty(activeNoteId) && notes.Any(n => n.Id == activeNoteId))
            currentNoteMessages = await NoteStore.LoadNoteAsync(activeNoteId);

        await InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !AppEnvironment.IsMaui)
            return;

        try
        {
            if (SidebarState.IsCollapsed)
            {
                await SidebarState.SetCollapsedAsync(false, JS);
                StateHasChanged();
            }
        }
        catch { /* sidebar init may be unavailable during static render */ }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await CommitActiveEditAsync(persistToStore: true);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Notes] Failed to autosave on dispose: {ex.Message}");
        }

        Nav.LocationChanged -= OnLocationChanged;

        if (_sidebarStateChangedHandler != null)
            SidebarState.OnChanged -= _sidebarStateChangedHandler;

        if (_notesSyncChangedHandler != null)
            SyncBridge.OnNotesChanged -= _notesSyncChangedHandler;
    }

    private void CancelEdit()
    {
        editingMessageIndex = null;
        editingInitialHtml = "";
        _activeEditDraftHtml = null;
        quillEditor = null;
        editSessionKey++;
    }

    private void OnEditHtmlChanged(string html) => _activeEditDraftHtml = html;

    private async Task CommitActiveEditAsync(bool persistToStore = false)
    {
        if (editingMessageIndex is not int index || index < 0 || index >= currentNoteMessages.Count)
            return;

        string? html = _activeEditDraftHtml;
        if (html is null && quillEditor is not null)
            html = await quillEditor.GetHTML();

        if (html is null)
            return;

        if (IsBlankQuillHtml(html))
            html = "";

        currentNoteMessages[index] = ChatMessageHelper.TouchModified(
            currentNoteMessages[index],
            content: html,
            contentFormat: NoteContentFormatter.FormatHtml);

        CancelEdit();

        if (persistToStore)
            await SaveCurrent();
    }

    private async Task StartEdit(int index)
    {
        if (index < 0 || index >= currentNoteMessages.Count)
            return;

        if (editingMessageIndex != index)
            await CommitActiveEditAsync(persistToStore: true);

        var msg = currentNoteMessages[index];
        editingMessageIndex = index;
        editingInitialHtml = NoteContentFormatter.ToEditorHtml(msg.Content, msg.ContentFormat);
        _activeEditDraftHtml = editingInitialHtml;
        editSessionKey++;
    }

    private async Task SaveEdit(int index)
    {
        if (editingMessageIndex != index)
            return;

        await CommitActiveEditAsync(persistToStore: true);
    }

    private void PromptDeleteNoteEntry(int index)
    {
        if (index < 0 || index >= currentNoteMessages.Count)
            return;

        pendingDeleteNoteId = null;
        pendingDeleteEntryIndex = index;
        deleteConfirmTitle = "Delete note entry?";
        deleteConfirmMessage = "This entry will be removed from the note and the change will sync to your other devices.";
        showDeleteConfirm = true;
    }

    private void PromptDeleteNote(string? noteId)
    {
        if (string.IsNullOrEmpty(noteId))
            return;

        CloseMenu();
        pendingDeleteNoteId = noteId;
        pendingDeleteEntryIndex = null;
        var note = notes.FirstOrDefault(n => n.Id == noteId);
        deleteConfirmTitle = "Delete note?";
        deleteConfirmMessage = $"This permanently removes \"{note?.Title ?? "this note"}\" and all its entries on this device, and syncs the delete to your other devices.";
        showDeleteConfirm = true;
    }

    private void CancelPendingDelete()
    {
        showDeleteConfirm = false;
        pendingDeleteNoteId = null;
        pendingDeleteEntryIndex = null;
    }

    private async Task ConfirmPendingDelete()
    {
        if (!string.IsNullOrEmpty(pendingDeleteNoteId))
            await DeleteNote(pendingDeleteNoteId);
        else if (pendingDeleteEntryIndex is int index)
            await DeleteNoteEntry(index);

        CancelPendingDelete();
    }

    private async Task MoveNoteEntryUp(int index)
    {
        if (index <= 0 || index >= currentNoteMessages.Count) return;

        await CommitActiveEditAsync(persistToStore: true);

        var item = currentNoteMessages[index];
        currentNoteMessages.RemoveAt(index);
        currentNoteMessages.Insert(index - 1, item);
        
        await SaveCurrent();
        StateHasChanged();
    }

    private async Task MoveNoteEntryDown(int index)
    {
        if (index < 0 || index >= currentNoteMessages.Count - 1) return;

        await CommitActiveEditAsync(persistToStore: true);

        var item = currentNoteMessages[index];
        currentNoteMessages.RemoveAt(index);
        currentNoteMessages.Insert(index + 1, item);

        await SaveCurrent();
        StateHasChanged();
    }

    private void ToggleEntryMenu(int index)
    {
        if (openEntryMenuIndex == index)
        {
            CloseEntryMenu();
        }
        else
        {
            openEntryMenuIndex = index;
            _ = PositionEntryPopup(index);
            StateHasChanged();
        }
    }

    private void CloseEntryMenu()
    {
        openEntryMenuIndex = null;
        entryPopupStyle = "";
        StateHasChanged();
    }

    private async Task PositionEntryPopup(int index)
    {
        try
        {
            var pos = await JS.InvokeAsync<PopupPosition>("getMenuPopupPosition", $"entry-menu-btn-{index}");
            // Use the raw position from JS — no extra offsets. The JS function already
            // handles overflow (positions left if no room on the right edge).
            entryPopupStyle = $"position: fixed; top: {pos.top:F0}px; left: {pos.left:F0}px; z-index: 15000;";
            StateHasChanged();
        }
        catch
        {
            entryPopupStyle = "position: fixed; top: 80px; right: 20px; z-index: 15000;";
            StateHasChanged();
        }
    }

    private void OpenMoveNotebookDialog(int entryIndex)
    {
        CloseEntryMenu();
        moveSourceNoteId = activeNoteId ?? "";
        moveSourceEntryIndex = entryIndex;
        moveTargetNotebooks = notes.Where(n => n.Id != moveSourceNoteId).ToList();
        openMoveNotebookDialog = true;
        StateHasChanged();
    }

    private void CloseMoveNotebookDialog()
    {
        openMoveNotebookDialog = false;
        moveSourceNoteId = "";
        moveSourceEntryIndex = -1;
        moveTargetNotebooks.Clear();
        StateHasChanged();
    }

    private async Task ConfirmMoveEntry(string targetNoteId)
    {
        openMoveNotebookDialog = false;
        StateHasChanged();

        await CommitActiveEditAsync(persistToStore: true);

        var sourceEntries = await NoteStore.LoadNoteAsync(moveSourceNoteId);
        if (moveSourceEntryIndex < 0 || moveSourceEntryIndex >= sourceEntries.Count) return;

        var msg = sourceEntries[moveSourceEntryIndex] with
        {
            ItemId = Guid.NewGuid().ToString("N"),
            ModifiedAt = DateTime.UtcNow
        };

        // Remove from source
        sourceEntries.RemoveAt(moveSourceEntryIndex);
        await NoteStore.SaveNoteAsync(moveSourceNoteId, sourceEntries);

        // Add to target
        var targetEntries = await NoteStore.LoadNoteAsync(targetNoteId);
        targetEntries.Add(msg);
        await NoteStore.SaveNoteAsync(targetNoteId, targetEntries);

        // Update indexes for both
        notes = await NoteStore.LoadIndexAsync();
        SyncBridge.ScheduleAutoSyncNoteAfterLocalSave(moveSourceNoteId, notes.FirstOrDefault(n => n.Id == moveSourceNoteId)?.Title ?? "");
        SyncBridge.ScheduleAutoSyncNoteAfterLocalSave(targetNoteId, notes.FirstOrDefault(n => n.Id == targetNoteId)?.Title ?? "");

        // Reload current view
        await LoadNote(activeNoteId!);
        StateHasChanged();
    }

    private async Task DeleteNoteEntry(int index)
    {
        if (index < 0 || index >= currentNoteMessages.Count)
            return;

        if (editingMessageIndex == index)
            CancelEdit();
        else
            await CommitActiveEditAsync(persistToStore: true);

        currentNoteMessages[index] = ChatMessageHelper.SoftDelete(currentNoteMessages[index]);
        await SaveCurrent();
        StateHasChanged();
    }

    private async Task OpenCreateNoteDialog()
    {
        await CommitActiveEditAsync(persistToStore: true);
        CloseMenu();
        nameDialogMode = NoteNameDialogMode.Create;
        nameDialogNoteId = null;
        nameDialogTitle = "";
        await SidebarState.CollapseIfMobileAsync(JS);
    }

    private async Task ConfirmCreateNote()
    {
        if (string.IsNullOrWhiteSpace(nameDialogTitle))
            return;

        await CommitActiveEditAsync(persistToStore: true);
        var title = nameDialogTitle.Trim();
        var id = Guid.NewGuid().ToString();
        var now = DateTime.UtcNow;
        var firstEntry = new ChatMessage(
            Role: "user",
            Content: "<p><br></p>",
            Timestamp: now,
            ModifiedAt: now,
            ItemId: Guid.NewGuid().ToString("N"),
            ContentFormat: NoteContentFormatter.FormatHtml);

        activeNoteId = id;
        currentNoteMessages = new List<ChatMessage> { firstEntry };
        await NoteStore.SaveNoteAsync(id, currentNoteMessages);
        await NoteStore.UpdateIndexAfterSaveAsync(id, title, currentNoteMessages);
        notes = await NoteStore.LoadIndexAsync();
        SyncBridge.ScheduleAutoSyncNoteAfterLocalSave(id, title);

        CancelNameDialog();
        await StartEdit(0);
        StateHasChanged();
    }

    private async Task SwitchNote(string id)
    {
        if (activeNoteId != id)
        {
            await CommitActiveEditAsync(persistToStore: true);
            await LoadNote(id);
        }
        await SidebarState.CollapseIfMobileAsync(JS);
    }

    private async Task LoadNote(string id)
    {
        activeNoteId = id;
        currentNoteMessages = await NoteStore.LoadNoteAsync(id);
        StateHasChanged();
    }

    private async Task SaveCurrent()
    {
        if (string.IsNullOrEmpty(activeNoteId)) return;
        var note = notes.FirstOrDefault(n => n.Id == activeNoteId);
        var title = note?.Title ?? "Untitled";
        await NoteStore.SaveNoteAsync(activeNoteId, currentNoteMessages);
        await NoteStore.UpdateIndexAfterSaveAsync(activeNoteId, title, currentNoteMessages);
        notes = await NoteStore.LoadIndexAsync();
        SyncBridge.ScheduleAutoSyncNoteAfterLocalSave(activeNoteId, title);
    }

    private async Task DeleteNote(string id)
    {
        var deletedAt = await NoteStore.DeleteNoteAsync(id);
        notes = await NoteStore.LoadIndexAsync();
        SyncBridge.ScheduleAutoSyncNoteDeleteAfterLocalDelete(id, deletedAt);

        if (activeNoteId == id)
        {
            activeNoteId = null;
            currentNoteMessages = new();
            if (notes.Any())
            {
                activeNoteId = notes.OrderByDescending(n => n.LastUpdated).First().Id;
                await LoadNote(activeNoteId);
            }
        }
        StateHasChanged();
    }

    private async Task AddEntryToCurrentNote()
    {
        if (string.IsNullOrEmpty(activeNoteId))
            return;

        await AddNoteEntry(activeNoteId);
    }

    private async Task AddNoteEntry(string noteId)
    {
        CloseMenu();
        await CommitActiveEditAsync(persistToStore: true);

        if (activeNoteId != noteId)
            await LoadNote(noteId);

        var now = DateTime.UtcNow;
        var newEntry = new ChatMessage(
            Role: "user",
            Content: "<p><br></p>",
            Timestamp: now,
            ModifiedAt: now,
            ItemId: Guid.NewGuid().ToString("N"),
            ContentFormat: NoteContentFormatter.FormatHtml);

        currentNoteMessages.Add(newEntry);
        await SaveCurrent();
        await StartEdit(currentNoteMessages.Count - 1);
        StateHasChanged();
    }

    private void OpenRenameDialog(string noteId)
    {
        CloseMenu();
        nameDialogMode = NoteNameDialogMode.Rename;
        nameDialogNoteId = noteId;
        var note = notes.FirstOrDefault(n => n.Id == noteId);
        nameDialogTitle = note?.Title ?? "";
    }

    private void CancelNameDialog()
    {
        nameDialogMode = NoteNameDialogMode.None;
        nameDialogNoteId = null;
        nameDialogTitle = "";
    }

    private async Task ConfirmNameDialog()
    {
        if (nameDialogMode == NoteNameDialogMode.Create)
            await ConfirmCreateNote();
        else
            await ConfirmRename();
    }

    private async Task ConfirmRename()
    {
        if (nameDialogNoteId is null || string.IsNullOrWhiteSpace(nameDialogTitle))
            return;

        var title = nameDialogTitle.Trim();
        await NoteStore.UpdateIndexAfterSaveAsync(nameDialogNoteId, title);
        notes = await NoteStore.LoadIndexAsync();
        SyncBridge.ScheduleAutoSyncNoteAfterLocalSave(nameDialogNoteId, title);
        CancelNameDialog();
        StateHasChanged();
    }

    private async Task NameDialogKeyHandler(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(nameDialogTitle))
            await ConfirmNameDialog();
        else if (e.Key == "Escape")
            CancelNameDialog();
    }

    private static bool IsUserNoteEntry(ChatMessage msg) =>
        string.Equals(msg.Role, "user", StringComparison.OrdinalIgnoreCase);

    private static bool IsBlankQuillHtml(string? html) =>
        string.IsNullOrWhiteSpace(html) || string.Equals(html.Trim(), "<p><br></p>", StringComparison.OrdinalIgnoreCase);

    private async Task ExportNotebook(string? noteId)
    {
        CloseMenu();

        if (string.IsNullOrEmpty(noteId))
            return;

        var allNotes = await NoteStore.LoadIndexAsync();
        var targetNote = allNotes.FirstOrDefault(n => n.Id == noteId);
        if (targetNote == null)
            return;

        var entries = (await NoteStore.LoadNoteAsync(targetNote.Id))
                      .Where(e => e.DeletedAt is null)
                      .ToList();
        if (!entries.Any())
            return;

        await BuildAndDownloadHtml(targetNote, entries, sanitizeFileName(targetNote.Title));
    }

    private async Task ExportAllNotebooks()
    {
        CloseExportAllMenu();

        var allNotes = await NoteStore.LoadIndexAsync();
        var notesToExport = new List<(LocalNote Note, List<ChatMessage> Entries)>();

        foreach (var n in allNotes.OrderByDescending(x => x.LastUpdated))
        {
            var entries = (await NoteStore.LoadNoteAsync(n.Id))
                          .Where(e => e.DeletedAt is null)
                          .ToList();
            if (entries.Any())
            {
                notesToExport.Add((n, entries));
            }
        }

        if (!notesToExport.Any())
            return;

        await BuildAndDownloadAllNotesHtml(notesToExport);
    }

    private static string EncodeHtml(string s) =>
        s.Replace("&", "&amp;").Replace("<", "&lt;").Replace(">", "&gt;").Replace("\"", "&quot;");

    // Hardcoded to avoid System.IO.Path.GetInvalidFileNameChars() which gets trimmed in Blazor WASM release builds.
    private static readonly char[] InvalidFileNameChars = { '<', '>', ':', '"', '|', '?', '*', '\\', '/' };

    private static string sanitizeFileName(string name) =>
        new string(name.Select(c => InvalidFileNameChars.Contains(c) ? '_' : c).ToArray())
                      .Replace(" ", "_");

    private void ToggleExportAllMenu()
    {
        if (openExportAllMenuId != null)
        {
            openExportAllMenuId = null;
            exportAllPopupStyle = "";
        }
        else
        {
            openExportAllMenuId = "export-all";
            _ = PositionExportAllPopup();
        }
    }

    private void CloseExportAllMenu()
    {
        openExportAllMenuId = null;
        exportAllPopupStyle = "";
    }

    private async Task PositionExportAllPopup()
    {
        try
        {
            var pos = await JS.InvokeAsync<PopupPosition>("getMenuPopupPosition", "notebooks-menu-btn");
            exportAllPopupStyle = $"position: fixed; top: {pos.top}px; left: {pos.left}px; z-index: 10000;";
            StateHasChanged();
        }
        catch
        {
            exportAllPopupStyle = "position: fixed; top: 80px; left: 140px; z-index: 10000;";
            StateHasChanged();
        }
    }

    private async Task BuildAndDownloadHtml(LocalNote note, List<ChatMessage> entries, string filename)
    {
        var sb = new StringBuilder();
        sb.AppendLine("<!DOCTYPE html>");
        sb.AppendLine("<html lang=\"en\"><head>");
        sb.AppendLine("<meta charset=\"utf-8\">");
        sb.AppendLine("<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">");
        string titleLine = $"<title>{EncodeHtml(note.Title)} — Chatfish Notes Export</title>";
        sb.AppendLine(titleLine);
        sb.AppendLine("<style>");
        sb.AppendLine("  body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; max-width: 900px; margin: 40px auto; padding: 0 20px; color: #1a1a1a; background: #fff; }");
        sb.AppendLine("  h1 { border-bottom: 2px solid #2563eb; padding-bottom: 8px; color: #1e3a5f; }");
        sb.AppendLine("  .note-entry { background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 16px; margin: 16px 0; }");
        sb.AppendLine("  .note-entry p { margin: 0 0 8px 0; }");
        sb.AppendLine("  .note-entry img { max-width: 100%; height: auto; border-radius: 4px; }");
        sb.AppendLine("  .meta { font-size: 0.75rem; color: #94a3b8; margin-bottom: 8px; }");
        sb.AppendLine("</style>");
        sb.AppendLine("</head><body>");
        string h1Line = $"<h1>{EncodeHtml(note.Title)}</h1>";
        sb.AppendLine(h1Line);

        foreach (var entry in entries)
        {
            sb.AppendLine("<div class=\"note-entry\">");
            sb.AppendLine("<div class=\"meta\">" + (entry.Timestamp?.ToLocalTime().ToString("MMM d, yyyy HH:mm") ?? "no date"));
            if (!string.IsNullOrWhiteSpace(entry.ModelUsed))
                sb.Append(" &middot; via " + EncodeHtml(entry.ModelUsed));
            sb.AppendLine("</div>");

            var html = entry.Content;
            var contentFormat = entry.ContentFormat;
            if (!string.IsNullOrWhiteSpace(html) && !NoteContentFormatter.IsHtml(contentFormat))
            {
                var paragraphs = html.Split(new[] { "\r\n", "\n" }, StringSplitOptions.None);
                foreach (var p in paragraphs.Where(p => !string.IsNullOrWhiteSpace(p)))
                {
                    string pLine = $"<p>{EncodeHtml(p)}</p>";
                    sb.AppendLine(pLine);
                }
            }
            else if (!string.IsNullOrWhiteSpace(html))
            {
                sb.AppendLine(html);
            }

            sb.AppendLine("</div>");
        }

        sb.AppendLine("</body></html>");

        var htmlContent = sb.ToString();
        var bytes = System.Text.Encoding.UTF8.GetBytes(htmlContent);
        await JS.InvokeVoidAsync("cfDownloadHtml", $"{filename}.html", Convert.ToBase64String(bytes));
    }

    private async Task BuildAndDownloadAllNotesHtml(List<(LocalNote Note, List<ChatMessage> Entries)> notesToExport)
    {
        var sb = new StringBuilder();
        sb.AppendLine("<!DOCTYPE html>");
        sb.AppendLine("<html lang=\"en\"><head>");
        sb.AppendLine("<meta charset=\"utf-8\">");
        sb.AppendLine("<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">");
        sb.AppendLine("<title>Chatfish Notes Export — All Notebooks</title>");
        sb.AppendLine("<style>");
        sb.AppendLine("  body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; max-width: 900px; margin: 40px auto; padding: 0 20px; color: #1a1a1a; background: #fff; }");
        sb.AppendLine("  h1 { border-bottom: 2px solid #2563eb; padding-bottom: 8px; color: #1e3a5f; }");
        sb.AppendLine("  h2 { margin-top: 40px; color: #2563eb; border-bottom: 1px solid #dbeafe; padding-bottom: 4px; }");
        sb.AppendLine("  .note-entry { background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 16px; margin: 16px 0; }");
        sb.AppendLine("  .note-entry p { margin: 0 0 8px 0; }");
        sb.AppendLine("  .note-entry img { max-width: 100%; height: auto; border-radius: 4px; }");
        sb.AppendLine("  .meta { font-size: 0.75rem; color: #94a3b8; margin-bottom: 8px; }");
        sb.AppendLine("</style>");
        sb.AppendLine("</head><body>");
        sb.AppendLine("<h1>Chatfish Notes Export</h1>");

        foreach (var (note, entries) in notesToExport)
        {
            string h2Line = $"<h2>{EncodeHtml(note.Title)} <span style=\"font-size:0.7em;color:#94a3b8\">({note.LastUpdated.ToLocalTime():yyyy-MM-dd HH:mm})</span></h2>";
            sb.AppendLine(h2Line);

            foreach (var entry in entries)
            {
                sb.AppendLine("<div class=\"note-entry\">");
                sb.AppendLine("<div class=\"meta\">" + (entry.Timestamp?.ToLocalTime().ToString("MMM d, yyyy HH:mm") ?? "no date"));
                if (!string.IsNullOrWhiteSpace(entry.ModelUsed))
                    sb.Append(" &middot; via " + EncodeHtml(entry.ModelUsed));
                sb.AppendLine("</div>");

                var html = entry.Content;
                var contentFormat = entry.ContentFormat;
                if (!string.IsNullOrWhiteSpace(html) && !NoteContentFormatter.IsHtml(contentFormat))
                {
                    var paragraphs = html.Split(new[] { "\r\n", "\n" }, StringSplitOptions.None);
                    foreach (var p in paragraphs.Where(p => !string.IsNullOrWhiteSpace(p)))
                    {
                        string pLine = $"<p>{EncodeHtml(p)}</p>";
                        sb.AppendLine(pLine);
                    }
                }
                else if (!string.IsNullOrWhiteSpace(html))
                {
                    sb.AppendLine(html);
                }

                sb.AppendLine("</div>");
            }
        }

        sb.AppendLine("</body></html>");

        var htmlContent = sb.ToString();
        var bytes = System.Text.Encoding.UTF8.GetBytes(htmlContent);
        await JS.InvokeVoidAsync("cfDownloadHtml", "chatfish-notes-export-all.html", Convert.ToBase64String(bytes));
    }

    private void ToggleMenu(string id)
    {
        if (openMenuId == id)
        {
            openMenuId = null;
            activePopupStyle = "";
        }
        else
        {
            openMenuId = id;
            _ = PositionPopup(id);
        }
    }

    private void CloseMenu()
    {
        openMenuId = null;
        activePopupStyle = "";
    }

    private async Task PositionPopup(string id)
    {
        try
        {
            var pos = await JS.InvokeAsync<PopupPosition>("getMenuPopupPosition", $"menu-btn-{id}");
            activePopupStyle = $"position: fixed; top: {pos.top}px; left: {pos.left}px; z-index: 10000;";
            StateHasChanged();
        }
        catch
        {
            activePopupStyle = "position: fixed; top: 120px; left: 260px; z-index: 10000;";
            StateHasChanged();
        }
    }

@implements IDisposable
@using ChatfishApp.Core.Auth
@using ChatfishApp.Core.Storage
@using ChatfishApp.Core.UI
@using ChatfishApp.Shared.Services

@inject IJSRuntime JS
@inject INoteStore NoteStore
@inject IAuthService AuthService
@inject IGuestDataMigrationService GuestMigration
@inject INotesSyncBridge SyncBridge
@inject ISidebarState SidebarState

<div class="page @(SidebarState.IsCollapsed ? "sidebar-collapsed" : "")">
    <button @onclick="ToggleSidebar" class="sidebar-toggle" title="Toggle sidebar">
        @if (SidebarState.IsCollapsed)
        {
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" opacity="0.55">
                <rect x="3" y="3" width="18" height="18" rx="2" />
                <rect x="3" y="3" width="6" height="18" rx="2" fill="none" />
            </svg>
        }
        else
        {
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" opacity="0.55">
                <rect x="3" y="3" width="18" height="18" rx="2" />
                <rect x="3" y="3" width="6" height="18" rx="2" fill="currentColor" />
            </svg>
        }
    </button>

    <div class="sidebar">
        <nav class="cf-nav cf-column">
            <div class="cf-item">
                <span class="cf-link small">
                   <h4>Notebooks</h4>
                    <button class="menu-button" @onclick="OpenCreateNoteDialog" title="New notebook">
                        <i class="cf-icon bi bi-plus-circle" style="font-size: 30px;"></i>
                    </button>
                </span>
            </div>

            @foreach (var n in notes.OrderByDescending(x => x.LastUpdated))
            {
                var isActive = activeNoteId == n.Id;
                <div class="conversation-item @(isActive ? "active" : "")" @onclick="() => SwitchNote(n.Id)">
                    <div class="row-top">
                        <div class="title">@n.Title</div>
                        <div class="menu" @onclick:stopPropagation>
                            <button id="menu-btn-@n.Id" class="menu-button" @onclick:stopPropagation @onclick="() => ToggleMenu(n.Id)">⋮</button>
                        </div>
                    </div>
                    <div class="date">@n.LastUpdated.ToLocalTime().ToString("MMM d")</div>
                </div>
            }
            @if (!notes.Any())
            {
                <div class="cf-item" style="font-size:0.75em; color:#888; padding-left:12px;">No notes yet.</div>
            }
        </nav>
    </div>

    <main>
        <div class="chat-wrapper" style="flex: 1; display: flex; flex-direction: column;">
            <div class="chat-container" @ref="chatContainer">
                @for (var i = 0; i < currentNoteMessages.Count; i++)
                {
                    var msg = currentNoteMessages[i];
                    var capturedIndex = i;
                    var isEditing = editingMessageIndex == capturedIndex;

                    @if (msg.DeletedAt is null)
                    {
                    <div class="message-row">
                        <div class="message-bot @(isEditing ? "note-editing" : "")">
                            <div class="note-response-actions">
                                @if (isEditing)
                                {
                                    <button type="button" class="menu-button note-action-btn" @onclick="() => SaveEdit(capturedIndex)" title="Save">
                                        <i class="cf-icon bi bi-check-lg"></i>
                                    </button>
                                    <button type="button" class="menu-button note-action-btn" @onclick="CancelEdit" title="Cancel">
                                        <i class="cf-icon bi bi-x-lg"></i>
                                    </button>
                                }
                                else
                                {
                                    <button type="button" class="menu-button note-action-btn" @onclick="() => StartEdit(capturedIndex)" title="Edit">
                                        <i class="cf-icon bi bi-pencil"></i>
                                    </button>
                                    <button type="button" class="menu-button note-action-btn" @onclick="() => PromptDeleteNoteEntry(capturedIndex)" title="Delete entry">
                                        <i class="cf-icon bi bi-trash3-fill"></i>
                                    </button>
                                }
                            </div>

                            @if (isEditing)
                            {
                                <QuillEditor @ref="quillEditor"
                                             @key="@($"note-edit-{activeNoteId}-{capturedIndex}-{editSessionKey}")"
                                             InitialHtml="@editingInitialHtml" />
                            }
                            else if (NoteContentFormatter.IsHtml(msg.ContentFormat))
                            {
                                <div class="ql-snow note-quill-display">
                                    <div class="ql-editor">
                                        @((MarkupString)msg.Content)
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="chat-markdown">
                                    @((MarkupString)NoteContentFormatter.ToDisplayHtml(msg.Content, msg.ContentFormat))
                                </div>
                            }

                            @if (!IsUserNoteEntry(msg) && !string.IsNullOrWhiteSpace(msg.ModelUsed))
                            {
                                <div class="model-label" style="font-size:0.6em;color:#888;text-align:right;margin-top:2px;opacity:0.7">
                                    via @msg.ModelUsed
                                </div>
                            }
                            @if (msg.Timestamp.HasValue)
                            {
                                <div style="font-size:0.6em;color:#888;text-align:right;margin-top:2px;opacity:0.7">
                                    @(msg.Timestamp.Value.ToLocalTime().ToString("MMM d, HH:mm"))
                                </div>
                            }
                        </div>
                    </div>
                    }
                }
            </div>
        </div>
    </main>

    @if (!string.IsNullOrEmpty(activeNoteId) && nameDialogMode == NoteNameDialogMode.None)
    {
        <button type="button"
                class="menu-button notes-fab"
                title="Add note entry"
                @onclick="AddEntryToCurrentNote">
            <i class="cf-icon bi bi-plus-circle"></i>
        </button>
    }

    @if (openMenuId != null)
    {
        <div class="menu-popup" style="@activePopupStyle" @onclick:stopPropagation>
            <div @onclick="async () => { await AddNoteEntry(openMenuId); }">
                <button type="button" class="menu-button"><i class="cf-icon bi bi-plus-lg"></i></button>
                Add
            </div>
            <div @onclick="() => OpenRenameDialog(openMenuId)">
                <button type="button" class="menu-button"><i class="cf-icon bi bi-pencil-square"></i></button>
                Rename
            </div>
            <div @onclick="() => PromptDeleteNote(openMenuId)">
                <button type="button" class="menu-button"><i class="cf-icon bi bi-trash3-fill"></i></button>
                Delete note
            </div>
        </div>
        <div class="menu-overlay" @onclick="CloseMenu"></div>
    }

    <ConfirmDialog IsVisible="showDeleteConfirm"
                   Title="@deleteConfirmTitle"
                   Message="@deleteConfirmMessage"
                   OnConfirm="ConfirmPendingDelete"
                   OnCancel="CancelPendingDelete" />

    @if (nameDialogMode != NoteNameDialogMode.None)
    {
        <div class="newnote-overlay" @onclick="CancelNameDialog">
            <div class="newnote-modal" @onclick:stopPropagation>
                <h4 style="margin:0 0 12px 0;font-size:1.1rem;color:#1F2A37;">
                    @(nameDialogMode == NoteNameDialogMode.Create ? "New Notebook" : "Rename Note")
                </h4>
                @if (nameDialogMode == NoteNameDialogMode.Create)
                {
                    <p style="font-size:0.85rem;color:#64748b;margin:0 0 12px 0;">Enter a name for your notebook. A first note entry will be added automatically.</p>
                }
                <input type="text"
                       @bind="nameDialogTitle"
                       @bind:event="oninput"
                       placeholder="Notebook name..."
                       class="newnote-input"
                       @onkeydown="NameDialogKeyHandler" />
                <div style="margin-top:12px;display:flex;gap:8px;justify-content:flex-end;">
                    <button type="button" class="newnote-btn newnote-btn-secondary" @onclick="CancelNameDialog">Cancel</button>
                    <button type="button" class="newnote-btn newnote-btn-primary" @onclick="ConfirmNameDialog" disabled="@(string.IsNullOrWhiteSpace(nameDialogTitle))">
                        @(nameDialogMode == NoteNameDialogMode.Create ? "Create" : "Save")
                    </button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<LocalNote> notes = new();
    private string? activeNoteId;
    private List<ChatMessage> currentNoteMessages = new();
    private string? openMenuId;
    private string activePopupStyle = "";
    private ElementReference chatContainer;

    private int? editingMessageIndex;
    private string editingInitialHtml = "";
    private int editSessionKey;
    private QuillEditor? quillEditor;

    private enum NoteNameDialogMode { None, Create, Rename }

    private NoteNameDialogMode nameDialogMode = NoteNameDialogMode.None;
    private string? nameDialogNoteId;
    private string nameDialogTitle = "";

    private bool showDeleteConfirm;
    private string deleteConfirmTitle = "";
    private string deleteConfirmMessage = "";
    private string? pendingDeleteNoteId;
    private int? pendingDeleteEntryIndex;

    private class PopupPosition
    {
        public double top { get; set; }
        public double left { get; set; }
    }

    private Action? _sidebarStateChangedHandler;
    private Action? _notesSyncChangedHandler;

    protected override async Task OnInitializedAsync()
    {
        await AuthService.LoadAsync();
        if (AuthService.IsAuthenticated)
            await GuestMigration.MigrateIfNeededAsync();

        notes = await NoteStore.LoadIndexAsync();

        if (notes.Any())
        {
            activeNoteId = notes.OrderByDescending(n => n.LastUpdated).First().Id;
            await LoadNote(activeNoteId);
        }
        else
        {
            await OpenCreateNoteDialog();
        }

        _sidebarStateChangedHandler = () => InvokeAsync(StateHasChanged);
        SidebarState.OnChanged += _sidebarStateChangedHandler;

        _notesSyncChangedHandler = () => _ = RefreshNotesFromSyncAsync();
        SyncBridge.OnNotesChanged += _notesSyncChangedHandler;
    }

    private async Task RefreshNotesFromSyncAsync()
    {
        notes = await NoteStore.LoadIndexAsync();

        if (!string.IsNullOrEmpty(activeNoteId) && notes.Any(n => n.Id == activeNoteId))
            currentNoteMessages = await NoteStore.LoadNoteAsync(activeNoteId);

        await InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var collapsedForMobile = await JS.InvokeAsync<bool>("initWasmSidebarForViewport");
                if (collapsedForMobile)
                {
                    SidebarState.IsCollapsed = true;
                    StateHasChanged();
                }
            }
            catch { /* WASM-only sidebar init */ }
        }
    }

    public void Dispose()
    {
        if (_sidebarStateChangedHandler != null)
            SidebarState.OnChanged -= _sidebarStateChangedHandler;

        if (_notesSyncChangedHandler != null)
            SyncBridge.OnNotesChanged -= _notesSyncChangedHandler;
    }

    private async Task ToggleSidebar()
    {
        SidebarState.Toggle();
        StateHasChanged();
        try
        {
            await JS.InvokeVoidAsync("toggleWasmSidebar", SidebarState.IsCollapsed);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Notes] toggleSidebar failed: {ex.Message}");
        }
    }

    private void CancelEdit()
    {
        editingMessageIndex = null;
        editingInitialHtml = "";
        quillEditor = null;
        editSessionKey++;
    }

    private void StartEdit(int index)
    {
        if (index < 0 || index >= currentNoteMessages.Count)
            return;

        CancelEdit();

        var msg = currentNoteMessages[index];
        editingMessageIndex = index;
        editingInitialHtml = NoteContentFormatter.ToEditorHtml(msg.Content, msg.ContentFormat);
        editSessionKey++;
    }

    private async Task SaveEdit(int index)
    {
        if (editingMessageIndex != index || quillEditor is null)
            return;

        var html = await quillEditor.GetHTML();
        if (string.IsNullOrWhiteSpace(html) || html == "<p><br></p>")
            html = "";

        currentNoteMessages[index] = ChatMessageHelper.TouchModified(
            currentNoteMessages[index],
            content: html,
            contentFormat: NoteContentFormatter.FormatHtml);

        CancelEdit();
        await SaveCurrent();
    }

    private void PromptDeleteNoteEntry(int index)
    {
        if (index < 0 || index >= currentNoteMessages.Count)
            return;

        pendingDeleteNoteId = null;
        pendingDeleteEntryIndex = index;
        deleteConfirmTitle = "Delete note entry?";
        deleteConfirmMessage = "This entry will be removed from the note and the change will sync to your other devices.";
        showDeleteConfirm = true;
    }

    private void PromptDeleteNote(string? noteId)
    {
        if (string.IsNullOrEmpty(noteId))
            return;

        CloseMenu();
        pendingDeleteNoteId = noteId;
        pendingDeleteEntryIndex = null;
        var note = notes.FirstOrDefault(n => n.Id == noteId);
        deleteConfirmTitle = "Delete note?";
        deleteConfirmMessage = $"This permanently removes \"{note?.Title ?? "this note"}\" and all its entries on this device, and syncs the delete to your other devices.";
        showDeleteConfirm = true;
    }

    private void CancelPendingDelete()
    {
        showDeleteConfirm = false;
        pendingDeleteNoteId = null;
        pendingDeleteEntryIndex = null;
    }

    private async Task ConfirmPendingDelete()
    {
        if (!string.IsNullOrEmpty(pendingDeleteNoteId))
            await DeleteNote(pendingDeleteNoteId);
        else if (pendingDeleteEntryIndex is int index)
            await DeleteNoteEntry(index);

        CancelPendingDelete();
    }

    private async Task DeleteNoteEntry(int index)
    {
        if (index < 0 || index >= currentNoteMessages.Count)
            return;

        CancelEdit();
        currentNoteMessages[index] = ChatMessageHelper.SoftDelete(currentNoteMessages[index]);
        await SaveCurrent();
        StateHasChanged();
    }

    private async Task OpenCreateNoteDialog()
    {
        CancelEdit();
        CloseMenu();
        nameDialogMode = NoteNameDialogMode.Create;
        nameDialogNoteId = null;
        nameDialogTitle = "";
        await SidebarState.CollapseIfMobileAsync(JS);
    }

    private async Task ConfirmCreateNote()
    {
        if (string.IsNullOrWhiteSpace(nameDialogTitle))
            return;

        CancelEdit();
        var title = nameDialogTitle.Trim();
        var id = Guid.NewGuid().ToString();
        var now = DateTime.UtcNow;
        var firstEntry = new ChatMessage(
            Role: "user",
            Content: "<p><br></p>",
            Timestamp: now,
            ModifiedAt: now,
            ItemId: Guid.NewGuid().ToString("N"),
            ContentFormat: NoteContentFormatter.FormatHtml);

        activeNoteId = id;
        currentNoteMessages = new List<ChatMessage> { firstEntry };
        await NoteStore.SaveNoteAsync(id, currentNoteMessages);
        await NoteStore.UpdateIndexAfterSaveAsync(id, title, currentNoteMessages);
        notes = await NoteStore.LoadIndexAsync();
        SyncBridge.ScheduleAutoSyncNoteAfterLocalSave(id, title);

        CancelNameDialog();
        StartEdit(0);
        StateHasChanged();
    }

    private async Task SwitchNote(string id)
    {
        if (activeNoteId != id)
        {
            CancelEdit();
            await SaveCurrent();
            await LoadNote(id);
        }
        await SidebarState.CollapseIfMobileAsync(JS);
    }

    private async Task LoadNote(string id)
    {
        CancelEdit();
        activeNoteId = id;
        currentNoteMessages = await NoteStore.LoadNoteAsync(id);
        StateHasChanged();
    }

    private async Task SaveCurrent()
    {
        if (string.IsNullOrEmpty(activeNoteId)) return;
        var note = notes.FirstOrDefault(n => n.Id == activeNoteId);
        var title = note?.Title ?? "Untitled";
        await NoteStore.SaveNoteAsync(activeNoteId, currentNoteMessages);
        await NoteStore.UpdateIndexAfterSaveAsync(activeNoteId, title, currentNoteMessages);
        notes = await NoteStore.LoadIndexAsync();
        SyncBridge.ScheduleAutoSyncNoteAfterLocalSave(activeNoteId, title);
    }

    private async Task DeleteNote(string id)
    {
        var deletedAt = await NoteStore.DeleteNoteAsync(id);
        notes = await NoteStore.LoadIndexAsync();
        SyncBridge.ScheduleAutoSyncNoteDeleteAfterLocalDelete(id, deletedAt);

        if (activeNoteId == id)
        {
            activeNoteId = null;
            currentNoteMessages = new();
            if (notes.Any())
            {
                activeNoteId = notes.OrderByDescending(n => n.LastUpdated).First().Id;
                await LoadNote(activeNoteId);
            }
        }
        StateHasChanged();
    }

    private async Task AddEntryToCurrentNote()
    {
        if (string.IsNullOrEmpty(activeNoteId))
            return;

        await AddNoteEntry(activeNoteId);
    }

    private async Task AddNoteEntry(string noteId)
    {
        CloseMenu();
        CancelEdit();

        if (activeNoteId != noteId)
        {
            await SaveCurrent();
            await LoadNote(noteId);
        }

        var now = DateTime.UtcNow;
        var newEntry = new ChatMessage(
            Role: "user",
            Content: "<p><br></p>",
            Timestamp: now,
            ModifiedAt: now,
            ItemId: Guid.NewGuid().ToString("N"),
            ContentFormat: NoteContentFormatter.FormatHtml);

        currentNoteMessages.Add(newEntry);
        await SaveCurrent();
        StartEdit(currentNoteMessages.Count - 1);
        StateHasChanged();
    }

    private void OpenRenameDialog(string noteId)
    {
        CloseMenu();
        nameDialogMode = NoteNameDialogMode.Rename;
        nameDialogNoteId = noteId;
        var note = notes.FirstOrDefault(n => n.Id == noteId);
        nameDialogTitle = note?.Title ?? "";
    }

    private void CancelNameDialog()
    {
        nameDialogMode = NoteNameDialogMode.None;
        nameDialogNoteId = null;
        nameDialogTitle = "";
    }

    private async Task ConfirmNameDialog()
    {
        if (nameDialogMode == NoteNameDialogMode.Create)
            await ConfirmCreateNote();
        else
            await ConfirmRename();
    }

    private async Task ConfirmRename()
    {
        if (nameDialogNoteId is null || string.IsNullOrWhiteSpace(nameDialogTitle))
            return;

        var title = nameDialogTitle.Trim();
        await NoteStore.UpdateIndexAfterSaveAsync(nameDialogNoteId, title);
        notes = await NoteStore.LoadIndexAsync();
        SyncBridge.ScheduleAutoSyncNoteAfterLocalSave(nameDialogNoteId, title);
        CancelNameDialog();
        StateHasChanged();
    }

    private async Task NameDialogKeyHandler(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(nameDialogTitle))
            await ConfirmNameDialog();
        else if (e.Key == "Escape")
            CancelNameDialog();
    }

    private static bool IsUserNoteEntry(ChatMessage msg) =>
        string.Equals(msg.Role, "user", StringComparison.OrdinalIgnoreCase);

    private void ToggleMenu(string id)
    {
        if (openMenuId == id)
        {
            openMenuId = null;
            activePopupStyle = "";
        }
        else
        {
            openMenuId = id;
            _ = PositionPopup(id);
        }
    }

    private void CloseMenu()
    {
        openMenuId = null;
        activePopupStyle = "";
    }

    private async Task PositionPopup(string id)
    {
        try
        {
            var pos = await JS.InvokeAsync<PopupPosition>("getMenuPopupPosition", $"menu-btn-{id}");
            activePopupStyle = $"position: fixed; top: {pos.top}px; left: {pos.left}px; z-index: 10000;";
            StateHasChanged();
        }
        catch
        {
            activePopupStyle = "position: fixed; top: 120px; left: 260px; z-index: 10000;";
            StateHasChanged();
        }
    }
}
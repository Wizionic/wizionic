@*
  Embed a URL with no address bar.
  - MAUI: native WebView overlay (works for Home Assistant — bypasses X-Frame-Options).
  - WASM / host: iframe (requires the target to allow framing).
*@
@using ChatfishApp.Core.UI
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IUrlEmbedOverlay EmbedOverlay
@inject IJSRuntime JS

@if (EmbedOverlay.IsNative)
{
    <div @ref="_hostRef"
         class="simple-url-embed-host"
         data-url-embed="native">
        @if (string.IsNullOrWhiteSpace(NormalizedUrl) || NormalizedUrl == "about:blank")
        {
            <div class="simple-url-embed-placeholder">No URL</div>
        }
    </div>
}
else
{
    @* No sandbox: HA and other SPAs break under restrictive sandbox. *@
    <iframe class="simple-url-embed"
            src="@NormalizedUrl"
            title="@Title"
            referrerpolicy="no-referrer-when-downgrade"
            allow="clipboard-read; clipboard-write; microphone; autoplay; fullscreen">
    </iframe>
}

@code {
    [Parameter] public string? Url { get; set; }
    [Parameter] public string Title { get; set; } = "Embedded page";

    private ElementReference _hostRef;
    private DotNetObjectReference<SimpleUrlEmbed>? _dotNetRef;
    private bool _jsAttached;
    private string _lastShownUrl = "";

    private string NormalizedUrl
    {
        get
        {
            var u = (Url ?? "").Trim();
            if (string.IsNullOrWhiteSpace(u))
                return "about:blank";
            if (!u.StartsWith("http://", StringComparison.OrdinalIgnoreCase)
                && !u.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
                u = "http://" + u;
            return u.TrimEnd('/');
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!EmbedOverlay.IsNative)
            return;

        var url = NormalizedUrl;
        if (url == "about:blank")
        {
            EmbedOverlay.Hide();
            _lastShownUrl = "";
            return;
        }

        if (!string.Equals(_lastShownUrl, url, StringComparison.OrdinalIgnoreCase))
        {
            EmbedOverlay.Show(url);
            _lastShownUrl = url;
        }

        await MeasureAndReportAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!EmbedOverlay.IsNative)
            return;

        if (firstRender || !_jsAttached)
        {
            try
            {
                _dotNetRef ??= DotNetObjectReference.Create(this);
                await JS.InvokeVoidAsync("chatfishUrlEmbed.attach", _hostRef, _dotNetRef);
                _jsAttached = true;
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[UrlEmbed] attach failed: {ex.Message}");
            }
        }

        await MeasureAndReportAsync();
    }

    private async Task MeasureAndReportAsync()
    {
        if (!EmbedOverlay.IsNative || !_jsAttached)
            return;
        try
        {
            await JS.InvokeVoidAsync("chatfishUrlEmbed.measure", _hostRef);
        }
        catch
        {
            // host may not be in DOM yet
        }
    }

    [JSInvokable]
    public void OnBounds(double x, double y, double width, double height)
    {
        EmbedOverlay.UpdateBounds(x, y, width, height);
    }

    public async ValueTask DisposeAsync()
    {
        if (EmbedOverlay.IsNative)
        {
            try
            {
                if (_jsAttached)
                    await JS.InvokeVoidAsync("chatfishUrlEmbed.detach", _hostRef);
            }
            catch
            {
                // ignore
            }

            EmbedOverlay.Hide();
        }

        _dotNetRef?.Dispose();
        _dotNetRef = null;
    }
}

@implements IDisposable
@using ChatfishApp.Core.Auth
@using ChatfishApp.Core.Storage
@using ChatfishApp.Core.Sync

@inject ISyncService SyncService
@inject IAuthService AuthService
@inject IConversationStore ConversationStore
@inject INoteStore NoteStore
@inject NavigationManager Nav

<div class="settings-content" style="padding: 1rem 2rem; max-width: 860px; margin: 0 auto;">
    <h4 style="margin: 0;">Sync</h4>
    <p style="color: #666; font-size: 0.9em;">
        Cross-device sync requires email login. The server only helps devices find each other and exchange small signaling messages.
        Encrypted chat history and notes travel directly between your devices — never through the server.
    </p>

    @if (!string.IsNullOrEmpty(PendingDataSyncMessage))
    {
        <div style="margin: 1rem 0; padding: 0.75rem 1rem; background: #eff6ff; border: 1px solid #bfdbfe; border-radius: 6px; font-size: 0.9em;">
            @PendingDataSyncMessage
        </div>
    }

    @if (!AuthService.IsAuthenticated)
    {
        <div style="margin: 2rem 0; padding: 1rem 1.25rem; background: #fff3cd; border: 1px solid #ffeaa7; border-radius: 6px;">
            <strong>Login required.</strong>
            <div style="margin-top: 0.5rem;">
                Sign in with your email to see your other devices and sync chats between browsers and native apps.
            </div>
            <div style="margin-top: 0.75rem;">
                <button @onclick="@(() => Nav.NavigateTo("/login"))" class="btn btn-outline-secondary btn-sm">Go to login</button>
                @if (ShowBackToChat)
                {
                    <button @onclick="@(() => Nav.NavigateTo("/chat"))" class="btn btn-outline-secondary btn-sm" style="margin-left: 0.5rem;">Back to Chat</button>
                }
            </div>
        </div>
    }
    else
    {
        <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.5rem;">
            <h3 style="margin: 0;">Devices</h3>
            <button @onclick="RefreshDevices" class="btn btn-outline-primary btn-sm" disabled="@isRefreshing">
                @(isRefreshing ? "Refreshing..." : "Refresh")
            </button>
            <span style="font-size: 0.8em; color: #888; margin-left: auto;">
                @(SyncService.IsConnected ? "Connected for live updates" : "Connecting…")
            </span>
        </div>

        @if (devices.Any())
        {
            <div style="border: 1px solid #e5e5e5; border-radius: 6px; overflow: hidden; margin-bottom: 1rem;">
                <table style="width: 100%; border-collapse: collapse; font-size: 0.95em;">
                    <thead>
                        <tr style="background: #f8f9fa;">
                            <th style="text-align: left; padding: 0.5rem 0.75rem; border-bottom: 1px solid #e5e5e5;">Device Name</th>
                            <th style="text-align: left; padding: 0.5rem 0.75rem; border-bottom: 1px solid #e5e5e5;">Last Active</th>
                            @if (ShowAiServerOptions)
                            {
                                <th style="text-align: left; padding: 0.5rem 0.75rem; border-bottom: 1px solid #e5e5e5;">AI Server</th>
                            }
                            else
                            {
                                <th style="text-align: left; padding: 0.5rem 0.75rem; border-bottom: 1px solid #e5e5e5;">Status</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var d in devices.OrderByDescending(x => x.IsOnline).ThenByDescending(x => x.LastActiveUtc))
                        {
                            var isSelf = SyncService.IsSelf(d.DeviceId);
                            <tr style="@(isSelf ? "background:#f0f7ff;" : "")">
                                <td style="padding: 0.5rem 0.75rem; border-bottom: 1px solid #f0f0f0;">
                                    <span style="color: @(d.IsOnline ? "#22c55e" : "#888"); font-size: 0.9em; margin-right: 6px;">●</span>
                                    <strong>@d.Name</strong>
                                    @if (isSelf)
                                    {
                                        <span style="font-size: 0.7em; color: #1F7FCC; margin-left: 6px;">(this device)</span>
                                    }
                                    @if (d.IsOnline)
                                    {
                                        <span style="font-size: 0.7em; color: #22c55e; margin-left: 8px;">online</span>
                                    }
                                </td>
                                <td style="padding: 0.5rem 0.75rem; border-bottom: 1px solid #f0f0f0; color: #555;">
                                    @FormatLastActive(d.LastActiveUtc, d.IsOnline)
                                </td>
                                <td style="padding: 0.5rem 0.75rem; border-bottom: 1px solid #f0f0f0;">
                                    @if (ShowAiServerOptions && !isSelf)
                                    {
                                        var canUse = d.IsOnline;
                                        var isAiServer = string.Equals(SyncService.AiServerDeviceId, d.DeviceId, StringComparison.OrdinalIgnoreCase);
                                        var aiHint = d.CanRelayAi && d.AiModelCount > 0
                                            ? $"{d.AiModelCount} model(s) advertised"
                                            : "Models discovered after connecting";
                                        <label style="display:flex; align-items:center; gap:0.35rem; font-size:0.85em; @(canUse ? "cursor:pointer;" : "color:#aaa;")" title="@(canUse ? $"Route chat completions through this device ({aiHint})" : "Device must be online")">
                                            <input type="checkbox"
                                                   checked="@isAiServer"
                                                   disabled="@(!canUse)"
                                                   @onchange="(e) => ToggleAiServer(d.DeviceId, e)" />
                                            <span>Use this device for my chats</span>
                                        </label>
                                        @if (canUse && !isAiServer && d.CanRelayAi && d.AiModelCount > 0)
                                        {
                                            <div style="font-size:0.75em; color:#555; margin-top:2px;">@d.AiModelCount model(s) available</div>
                                        }
                                        @if (isAiServer)
                                        {
                                            <div style="font-size:0.75em; color:#555; margin-top:2px;">
                                                @(SyncService.IsAiProxyConnected ? "Connected" : "Connecting…")
                                                @if (!string.IsNullOrEmpty(SyncService.AiProxyError))
                                                {
                                                    <span style="color:#b45309;"> — @SyncService.AiProxyError</span>
                                                }
                                            </div>
                                        }
                                    }
                                    else if (!ShowAiServerOptions)
                                    {
                                        @if (d.IsOnline)
                                        {
                                            <span style="color: #22c55e; font-size: 0.85em;">Online</span>
                                        }
                                        else
                                        {
                                            <span style="font-size: 0.85em; color: #555;">Offline</span>
                                        }
                                        @if (d.CanRelayAi && d.AiModelCount > 0)
                                        {
                                            <span style="font-size: 0.85em; color: #555;"> · @d.AiModelCount AI model(s)</span>
                                        }
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (ShowAiServerOptions && !string.IsNullOrEmpty(SyncService.AiServerDeviceId))
            {
                var aiServer = devices.FirstOrDefault(d => string.Equals(d.DeviceId, SyncService.AiServerDeviceId, StringComparison.OrdinalIgnoreCase));
                <div style="margin-bottom: 0.75rem; padding: 0.5rem 0.75rem; background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 6px; font-size: 0.9em;">
                    Chat AI is routed through <strong>@(aiServer?.Name ?? "selected device")</strong>.
                    @if (SyncService.RemoteModels.Any())
                    {
                        <span> @SyncService.RemoteModels.Count model(s) available on Chat.</span>
                    }
                </div>
            }

            <div style="margin-bottom: 1rem; display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap;">
                <label style="font-size: 0.9em; color: #555;">Rename this device:</label>
                <input type="text" @bind="newDeviceName" placeholder="@SyncService.MyDeviceName" style="flex: 1; min-width: 220px; max-width: 320px;" class="form-control form-control-sm" />
                <button @onclick="SaveDeviceName" class="btn btn-outline-secondary btn-sm">Save</button>
            </div>

            <div style="margin: 1rem 0 0.5rem;">
                <div style="font-weight: 600; margin-bottom: 0.35rem;">Sync to these devices</div>
                @{
                    var others = SyncService.GetOtherDevices().ToList();
                }
                @if (others.Any())
                {
                    <div style="display: flex; flex-direction: column; gap: 0.35rem;">
                        @foreach (var d in others)
                        {
                            var selected = selectedTargetDeviceIds.Contains(d.DeviceId);
                            <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer; font-size: 0.92em;">
                                <input type="checkbox"
                                       checked="@selected"
                                       @onchange="async (e) => await ToggleTarget(d.DeviceId, e)" />
                                <span style="color: @(d.IsOnline ? "#22c55e" : "#888");">●</span>
                                <span>@d.Name</span>
                                @if (d.IsOnline)
                                {
                                    <span style="font-size: 0.7em; color: #22c55e;">(online now)</span>
                                }
                                else
                                {
                                    <span style="font-size: 0.7em; color: #888;">(last seen @FormatLastActive(d.LastActiveUtc, false))</span>
                                }
                            </label>
                        }
                    </div>
                }
                else
                {
                    <div style="color: #888; font-size: 0.9em;">No other devices are known for this account yet. Open Chatfish on another browser or device and log in with the same email.</div>
                }
            </div>
        }
        else
        {
            <div style="color:#666; padding: 0.75rem 0;">
                Loading device list…
            </div>
        }

        <div style="display: flex; align-items: center; gap: 0.5rem; margin-top: 1.25rem; margin-bottom: 0.4rem; flex-wrap: wrap;">
            <h3 style="margin: 0;">Chat history</h3>
            <button @onclick="SyncAllConversations"
                    class="btn btn-outline-primary btn-sm"
                    disabled="@(!selectedTargetDeviceIds.Any() || !localConvos.Any() || isBulkSyncing)">
                @(isBulkSyncing ? "Syncing…" : "Sync All")
            </button>
            <label style="font-size: 0.85em; color: #555; display: flex; align-items: center; gap: 0.35rem; margin-left: auto; cursor: pointer;"
                   title="When a selected device comes online, sync all conversations to it">
                <input type="checkbox"
                       checked="@SyncService.AutoSyncChatHistory"
                       @onchange="ToggleAutoSyncChat" />
                Auto sync
            </label>
        </div>
        <p style="color:#666; font-size:0.85em; margin-bottom:0.5rem;">
            Select one or more target devices above, then click Sync or Sync All.
        </p>

        @if (localConvos.Any())
        {
            <div style="display: flex; flex-direction: column; gap: 0.4rem;">
                @foreach (var c in localConvos.OrderByDescending(x => x.LastUpdated))
                {
                    <div style="display: flex; align-items: center; gap: 0.6rem; border: 1px solid #e5e5e5; border-radius: 6px; padding: 0.4rem 0.6rem; background: white;">
                        <div style="flex: 1; min-width: 0;">
                            <div style="font-weight: 500;">@c.Title</div>
                            <div style="font-size: 0.75em; color: #888;">@c.LastUpdated.ToLocalTime().ToString("MMM d, HH:mm")</div>
                        </div>
                        <button @onclick="() => SyncConversation(c)"
                                class="btn btn-outline-primary btn-sm"
                                disabled="@(!selectedTargetDeviceIds.Any())">
                            Sync
                        </button>
                    </div>
                }
            </div>
        }
        else
        {
            <div style="color:#888; font-size:0.9em;">No conversations yet on this device.</div>
        }

        <div style="display: flex; align-items: center; gap: 0.5rem; margin-top: 1.25rem; margin-bottom: 0.4rem; flex-wrap: wrap;">
            <h3 style="margin: 0;">Notes</h3>
            <button @onclick="SyncAllNotes"
                    class="btn btn-outline-primary btn-sm"
                    disabled="@(!selectedTargetDeviceIds.Any() || !localNotes.Any() || isBulkSyncing)">
                @(isBulkSyncing ? "Syncing…" : "Sync All")
            </button>
            <label style="font-size: 0.85em; color: #555; display: flex; align-items: center; gap: 0.35rem; margin-left: auto; cursor: pointer;"
                   title="When a selected device comes online, sync all notes to it">
                <input type="checkbox"
                       checked="@SyncService.AutoSyncNotes"
                       @onchange="ToggleAutoSyncNotes" />
                Auto sync
            </label>
        </div>
        <p style="color:#666; font-size:0.85em; margin-bottom:0.5rem;">
            Select one or more target devices above, then click Sync or Sync All.
        </p>

        @if (localNotes.Any())
        {
            <div style="display: flex; flex-direction: column; gap: 0.4rem;">
                @foreach (var n in localNotes.OrderByDescending(x => x.LastUpdated))
                {
                    <div style="display: flex; align-items: center; gap: 0.6rem; border: 1px solid #e5e5e5; border-radius: 6px; padding: 0.4rem 0.6rem; background: white;">
                        <div style="flex: 1; min-width: 0;">
                            <div style="font-weight: 500;">@n.Title</div>
                            <div style="font-size: 0.75em; color: #888;">@n.LastUpdated.ToLocalTime().ToString("MMM d, HH:mm")</div>
                        </div>
                        <button @onclick="() => SyncNote(n)"
                                class="btn btn-outline-primary btn-sm"
                                disabled="@(!selectedTargetDeviceIds.Any())">
                            Sync
                        </button>
                    </div>
                }
            </div>
        }
        else
        {
            <div style="color:#888; font-size:0.9em;">No notes yet on this device.</div>
        }

        @if (!string.IsNullOrEmpty(statusMessage))
        {
            <div style="margin-top: 1rem; padding: 0.5rem 0.75rem; background: #e6f2ff; border: 1px solid #b3d9ff; border-radius: 4px; font-size: 0.9em;">
                @statusMessage
            </div>
        }

        @if (ShowBackToChat)
        {
            <div style="margin-top: 1.5rem; display: flex; gap: 0.5rem; align-items: center;">
                <button @onclick="@(() => Nav.NavigateTo("/chat"))" class="btn btn-outline-secondary">Back to Chat</button>
            </div>
        }
    }
</div>

@code {
    [Parameter]
    public string? PendingDataSyncMessage { get; set; }

    [Parameter]
    public bool ShowAiServerOptions { get; set; } = true;

    [Parameter]
    public bool ShowBackToChat { get; set; } = true;

    private List<SyncDeviceInfo> devices = new();
    private List<LocalConvo> localConvos = new();
    private List<LocalNote> localNotes = new();

    private HashSet<string> selectedTargetDeviceIds = new(StringComparer.OrdinalIgnoreCase);

    private string newDeviceName = "";
    private string? statusMessage;
    private bool isRefreshing;
    private bool isBulkSyncing;

    private Action? _syncChangedHandler;
    private Action? _authChangedHandler;
    private Action? _conversationsChangedHandler;
    private Action? _notesChangedHandler;

    protected override async Task OnInitializedAsync()
    {
        await AuthService.LoadAsync();
        await SyncService.InitializeAsync();
        localConvos = await ConversationStore.LoadIndexAsync();
        localNotes = await NoteStore.LoadIndexAsync();

        _syncChangedHandler = () =>
        {
            devices = SyncService.Devices.ToList();
            InvokeAsync(StateHasChanged);
        };
        SyncService.OnChanged += _syncChangedHandler;

        _authChangedHandler = () => InvokeAsync(StateHasChanged);
        AuthService.OnChanged += _authChangedHandler;

        _conversationsChangedHandler = () => _ = RefreshConversationsAsync();
        SyncService.OnConversationsChanged += _conversationsChangedHandler;

        _notesChangedHandler = () => _ = RefreshNotesAsync();
        SyncService.OnNotesChanged += _notesChangedHandler;

        SyncService.OnSyncPayloadReceived += HandleIncomingSyncPayload;
        SyncService.OnSyncAckReceived += HandleSyncAckReceived;
        SyncService.OnNoteSyncPayloadReceived += HandleIncomingNoteSyncPayload;
        SyncService.OnNoteSyncAckReceived += HandleNoteSyncAckReceived;

        if (AuthService.IsAuthenticated)
        {
            await SyncService.EnsureConnectedAndRegisteredAsync();
            devices = SyncService.Devices.ToList();
            selectedTargetDeviceIds = SyncService.SyncTargetDeviceIds.ToHashSet(StringComparer.OrdinalIgnoreCase);
            newDeviceName = SyncService.MyDeviceName;
        }
    }

    private async Task RefreshConversationsAsync()
    {
        localConvos = await ConversationStore.LoadIndexAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task RefreshNotesAsync()
    {
        localNotes = await NoteStore.LoadIndexAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task RefreshDevices()
    {
        isRefreshing = true;
        StateHasChanged();

        try
        {
            await SyncService.RefreshAsync();
            devices = SyncService.Devices.ToList();
        }
        finally
        {
            isRefreshing = false;
            StateHasChanged();
        }
    }

    private async Task SaveDeviceName()
    {
        var name = (newDeviceName ?? "").Trim();
        if (string.IsNullOrWhiteSpace(name)) return;

        await SyncService.SetDeviceNameAsync(name);
        newDeviceName = SyncService.MyDeviceName;
        devices = SyncService.Devices.ToList();
        StateHasChanged();
    }

    private async Task ToggleTarget(string deviceId, ChangeEventArgs e)
    {
        var isChecked = e.Value is bool b && b;
        if (isChecked)
            selectedTargetDeviceIds.Add(deviceId);
        else
            selectedTargetDeviceIds.Remove(deviceId);

        await SyncService.SetSyncTargetDevicesAsync(selectedTargetDeviceIds);
        StateHasChanged();
    }

    private async Task ToggleAutoSyncChat(ChangeEventArgs e)
    {
        var enabled = e.Value is bool b && b;
        await SyncService.SetAutoSyncChatHistoryAsync(enabled);
        StateHasChanged();
    }

    private async Task ToggleAutoSyncNotes(ChangeEventArgs e)
    {
        var enabled = e.Value is bool b && b;
        await SyncService.SetAutoSyncNotesAsync(enabled);
        StateHasChanged();
    }

    private async Task SyncAllConversations()
    {
        if (!selectedTargetDeviceIds.Any())
        {
            statusMessage = "Select at least one target device above first.";
            StateHasChanged();
            return;
        }

        isBulkSyncing = true;
        StateHasChanged();

        try
        {
            await SyncService.EnsureConnectedAndRegisteredAsync();
            if (!SyncService.IsConnected)
            {
                statusMessage = "Not connected to sync server. Try Refresh on the Devices section, then sync again.";
                return;
            }

            var queued = await SyncService.SyncAllConversationsToDevicesAsync(selectedTargetDeviceIds);
            var targetNames = devices
                .Where(d => selectedTargetDeviceIds.Contains(d.DeviceId))
                .Select(d => d.Name)
                .ToList();

            statusMessage = $"Checking {queued} device(s) for conversations that need sync ({string.Join(", ", targetNames)}). Only changed items are transferred.";
        }
        finally
        {
            isBulkSyncing = false;
            StateHasChanged();
        }
    }

    private async Task SyncAllNotes()
    {
        if (!selectedTargetDeviceIds.Any())
        {
            statusMessage = "Select at least one target device above first.";
            StateHasChanged();
            return;
        }

        isBulkSyncing = true;
        StateHasChanged();

        try
        {
            await SyncService.EnsureConnectedAndRegisteredAsync();
            if (!SyncService.IsConnected)
            {
                statusMessage = "Not connected to sync server. Try Refresh on the Devices section, then sync again.";
                return;
            }

            var queued = await SyncService.SyncAllNotesToDevicesAsync(selectedTargetDeviceIds);
            var targetNames = devices
                .Where(d => selectedTargetDeviceIds.Contains(d.DeviceId))
                .Select(d => d.Name)
                .ToList();

            statusMessage = $"Checking {queued} device(s) for notes that need sync ({string.Join(", ", targetNames)}). Only changed items are transferred.";
        }
        finally
        {
            isBulkSyncing = false;
            StateHasChanged();
        }
    }

    private async Task ToggleAiServer(string deviceId, ChangeEventArgs e)
    {
        var isChecked = e.Value is bool b && b;
        if (isChecked)
            await SyncService.SetAiServerDeviceAsync(deviceId);
        else if (string.Equals(SyncService.AiServerDeviceId, deviceId, StringComparison.OrdinalIgnoreCase))
            await SyncService.SetAiServerDeviceAsync(null);

        StateHasChanged();
    }

    private async Task SyncNote(LocalNote note)
    {
        if (!selectedTargetDeviceIds.Any())
        {
            statusMessage = "Select at least one target device above first.";
            StateHasChanged();
            return;
        }

        var targetDevices = devices
            .Where(d => selectedTargetDeviceIds.Contains(d.DeviceId))
            .ToList();

        await SyncService.EnsureConnectedAndRegisteredAsync();
        if (!SyncService.IsConnected)
        {
            statusMessage = "Not connected to sync server. Try Refresh on the Devices section, then sync again.";
            StateHasChanged();
            return;
        }

        var entries = await NoteStore.LoadNoteAsync(note.Id);

        foreach (var targetId in selectedTargetDeviceIds)
            await SyncService.StartWebRtcNoteSyncAsync(targetId, note.Id, note.Title, entries);

        var targetNames = targetDevices.Select(d => d.Name).ToList();
        var serialized = System.Text.Json.JsonSerializer.Serialize(entries);
        var payloadSize = System.Text.Encoding.UTF8.GetByteCount(serialized);

        statusMessage = $"Initiated WebRTC DataChannel sync for note \"{note.Title}\" " +
                        $"({entries.Count} entries, {payloadSize} bytes) to: {string.Join(", ", targetNames)}. " +
                        "Waiting for peer acknowledgement...";

        StateHasChanged();
        ScheduleAckTimeout();
    }

    private async Task SyncConversation(LocalConvo convo)
    {
        if (!selectedTargetDeviceIds.Any())
        {
            statusMessage = "Select at least one target device above first.";
            StateHasChanged();
            return;
        }

        var targetDevices = devices
            .Where(d => selectedTargetDeviceIds.Contains(d.DeviceId))
            .ToList();

        await SyncService.EnsureConnectedAndRegisteredAsync();
        if (!SyncService.IsConnected)
        {
            statusMessage = "Not connected to sync server. Try Refresh on the Devices section, then sync again.";
            StateHasChanged();
            return;
        }

        var messages = await ConversationStore.LoadConversationAsync(convo.Id);

        foreach (var targetId in selectedTargetDeviceIds)
            await SyncService.StartWebRtcSyncAsync(targetId, convo.Id, messages);

        var targetNames = targetDevices.Select(d => d.Name).ToList();
        var serialized = System.Text.Json.JsonSerializer.Serialize(messages);
        var payloadSize = System.Text.Encoding.UTF8.GetByteCount(serialized);

        statusMessage = $"Initiated WebRTC DataChannel sync for \"{convo.Title}\" " +
                        $"({messages.Count} messages, {payloadSize} bytes) to: {string.Join(", ", targetNames)}. " +
                        "Waiting for peer acknowledgement...";

        StateHasChanged();
        ScheduleAckTimeout();
    }

    private void ScheduleAckTimeout()
    {
        _ = Task.Run(async () =>
        {
            await Task.Delay(15000);
            await InvokeAsync(() =>
            {
                if (statusMessage != null && statusMessage.Contains("Waiting for peer acknowledgement"))
                {
                    statusMessage = "Sync initiated. No acknowledgement received (peer may have closed or network issue).";
                    StateHasChanged();
                }
            });
        });
    }

    private static string FormatLastActive(DateTime utc, bool isOnline)
    {
        if (isOnline)
            return "Now";

        var ago = DateTime.UtcNow - utc;
        if (ago.TotalMinutes < 1) return "Just now";
        if (ago.TotalMinutes < 60) return $"{(int)ago.TotalMinutes}m ago";
        if (ago.TotalHours < 24) return $"{(int)ago.TotalHours}h ago";
        if (ago.TotalDays < 7) return $"{(int)ago.TotalDays}d ago";
        return utc.ToLocalTime().ToString("MMM d");
    }

    private async void HandleIncomingSyncPayload(string convoId, string json, string fromDeviceId)
    {
        try
        {
            await RefreshConversationsAsync();
            statusMessage = $"Received sync for convo \"{GetConvoTitle(convoId)}\" from {fromDeviceId}.";
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Sync] Failed to refresh after incoming sync payload: {ex.Message}");
        }
    }

    private void HandleSyncAckReceived(string convoId, string fromPeerId)
    {
        statusMessage = $"Peer confirmed receipt of conversation \"{GetConvoTitle(convoId)}\".";
        StateHasChanged();
        ScheduleStatusClear("confirmed receipt");
    }

    private async void HandleIncomingNoteSyncPayload(string noteId, string json, string fromDeviceId)
    {
        try
        {
            await RefreshNotesAsync();
            statusMessage = $"Received sync for note \"{GetNoteTitle(noteId)}\" from {fromDeviceId}.";
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Sync] Failed to refresh after incoming note sync payload: {ex.Message}");
        }
    }

    private void HandleNoteSyncAckReceived(string noteId, string fromPeerId)
    {
        statusMessage = $"Peer confirmed receipt of note \"{GetNoteTitle(noteId)}\".";
        StateHasChanged();
        ScheduleStatusClear("confirmed receipt");
    }

    private string GetConvoTitle(string convoId) =>
        localConvos.FirstOrDefault(c => c.Id == convoId)?.Title ?? convoId;

    private string GetNoteTitle(string noteId) =>
        localNotes.FirstOrDefault(n => n.Id == noteId)?.Title ?? noteId;

    private void ScheduleStatusClear(string marker)
    {
        _ = Task.Run(async () =>
        {
            await Task.Delay(4000);
            await InvokeAsync(() =>
            {
                if (statusMessage != null && statusMessage.Contains(marker))
                {
                    statusMessage = null;
                    StateHasChanged();
                }
            });
        });
    }

    public void Dispose()
    {
        if (_syncChangedHandler is not null)
            SyncService.OnChanged -= _syncChangedHandler;
        if (_authChangedHandler is not null)
            AuthService.OnChanged -= _authChangedHandler;
        if (_conversationsChangedHandler is not null)
            SyncService.OnConversationsChanged -= _conversationsChangedHandler;
        if (_notesChangedHandler is not null)
            SyncService.OnNotesChanged -= _notesChangedHandler;

        SyncService.OnSyncPayloadReceived -= HandleIncomingSyncPayload;
        SyncService.OnSyncAckReceived -= HandleSyncAckReceived;
        SyncService.OnNoteSyncPayloadReceived -= HandleIncomingNoteSyncPayload;
        SyncService.OnNoteSyncAckReceived -= HandleNoteSyncAckReceived;
    }
}
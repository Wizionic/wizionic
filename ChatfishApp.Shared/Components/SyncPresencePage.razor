@implements IDisposable
@using ChatfishApp.Core.Auth
@using ChatfishApp.Core.Storage
@using ChatfishApp.Core.Sync

@inject ISyncService SyncService
@inject IAuthService AuthService
@inject IConversationStore ConversationStore
@inject INoteStore NoteStore
@inject NavigationManager Nav

<div class="settings-content sync-wrapper">
    @if (!string.IsNullOrEmpty(PendingDataSyncMessage))
    {
        <div class="cf-sync-info-box">@PendingDataSyncMessage</div>
    }

    @if (!AuthService.IsAuthenticated)
    {
        <div class="cf-sync-warning sync-login-box">
            <strong>Login required.</strong>
            <div class="mt-2">
                Sign in with your email to see your other devices and sync chats between browsers and native apps.
            </div>
            <div class="mt-2">
                <button @onclick="@(() => Nav.NavigateTo("/account"))" class="btn btn-outline-secondary btn-sm">Go to login</button>
                @if (ShowBackToChat)
                {
                    <button @onclick="@(() => Nav.NavigateTo("/chat"))" class="btn btn-outline-secondary btn-sm ms-2">Back to Chat</button>
                }
            </div>
        </div>
    }
    else
    {
        @if (devices.Any())
        {
            <div class="sync-title-row">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <h3 style="margin:0">Devices</h3>
                    <button @onclick="RefreshDevices" class="btn btn-outline-primary btn-sm" disabled="@isRefreshing">
                        @(isRefreshing ? "Refreshing..." : "Refresh")
                    </button>
                    <span class="sync-connection-status ms-auto @(SyncService.IsConnected ? "cf-status-online" : "cf-status-offline")" style="font-size:0.85em">
                        @(SyncService.IsConnected ? "Connected for live updates" : "Connecting…")
                    </span>
                </div>
            </div>

            <div class="cf-sync-table-wrapper">
                <table class="cf-sync-table">
                    <thead>
                        <tr>
                            <th class="cf-sync-cell">Device Name</th>
                            <th class="cf-sync-cell">Last Active</th>
                            @if (ShowAiServerOptions)
                            {
                                <th class="cf-sync-cell">AI Server</th>
                            }
                            else
                            {
                                <th class="cf-sync-cell">Status</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var d in devices.OrderByDescending(x => x.IsOnline).ThenByDescending(x => x.LastActiveUtc))
                        {
                            var isSelf = SyncService.IsSelf(d.DeviceId);
                            <tr class="@(isSelf ? "sync-self-row" : "")">
                                <td class="cf-sync-cell">
                                    <span class="@(d.IsOnline ? "cf-status-online" : "cf-status-offline")" title="@(d.IsOnline ? "Online" : "Offline")">&#9679;</span>
                                    <strong>@d.Name</strong>
                                    @if (isSelf)
                                    {
                                        <span class="sync-self-label">(this device)</span>
                                    }
                                    @if (d.IsOnline)
                                    {
                                        <span class="online-text">online</span>
                                    }
                                </td>
                                <td class="cf-sync-cell">
                                    @FormatLastActive(d.LastActiveUtc, d.IsOnline)
                                </td>
                                <td class="cf-sync-cell">
                                    @if (ShowAiServerOptions && !isSelf)
                                    {
                                        var canUse = d.IsOnline;
                                        var isAiServerLabel = string.Equals(SyncService.AiServerDeviceId, d.DeviceId, StringComparison.OrdinalIgnoreCase);
                                        var aiHint = d.CanRelayAi && d.AiModelCount > 0
                                            ? $"{d.AiModelCount} model(s) advertised"
                                            : "Models discovered after connecting";
                                        if (canUse)
                                        {
                                            <label class="ai-server-label" title="@($"Route chat completions through this device ({aiHint})")">
                                                <input type="checkbox" checked="@isAiServerLabel" @onchange="(e) => ToggleAiServer(d.DeviceId, e)" />
                                                <span>Use this device for my chats</span>
                                            </label>
                                        }
                                        else
                                        {
                                            <label class="ai-server-label-disabled" title="Device must be online">
                                                <input type="checkbox" checked="@isAiServerLabel" disabled />
                                                <span>Use this device for my chats</span>
                                            </label>
                                        }
                                        if (canUse && !isAiServerLabel && d.CanRelayAi && d.AiModelCount > 0)
                                        {
                                            @:<div class="ai-hint-text">@d.AiModelCount model(s) available</div>
                                        }
                                        if (isAiServerLabel)
                                        {
                                            <span>@(SyncService.IsAiProxyConnected ? "Connected" : "Connecting")</span>
                                            @if (!string.IsNullOrEmpty(SyncService.AiProxyError))
                                            {
                                                @:<span class="sync-warning-text"> &#8212; @SyncService.AiProxyError</span>
                                            }
                                        }
                                    }
                                    else if (!ShowAiServerOptions)
                                    {
                                        if (d.IsOnline)
                                        {
                                            @:<span class="cf-status-online">Online</span>
                                        }
                                        else
                                        {
                                            @:<span class="cf-status-offline">Offline</span>
                                        }
                                        if (d.CanRelayAi && d.AiModelCount > 0)
                                        {
                                            @:<span class="ai-hint-text">&#183; @d.AiModelCount AI model(s)</span>
                                        }
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (ShowAiServerOptions && !string.IsNullOrEmpty(SyncService.AiServerDeviceId))
            {
                var aiServer = devices.FirstOrDefault(d => string.Equals(d.DeviceId, SyncService.AiServerDeviceId, StringComparison.OrdinalIgnoreCase));
                <div class="cf-sync-success">Chat AI is routed through <strong>@(aiServer?.Name ?? "selected device")</strong>@if (SyncService.RemoteModels.Any()) { <span> @SyncService.RemoteModels.Count model(s) available on Chat.</span> }</div>
            }

            <div class="sync-device-name-row">
                <label class="form-label mb-0 sync-form-label">Rename this device:</label>
                <input type="text" @bind="newDeviceName" placeholder="@SyncService.MyDeviceName" class="form-control form-control-sm sync-input-field mx-2" style="flex:1; min-width:220px; max-width:320px;" />
                <button @onclick="SaveDeviceName" class="btn btn-outline-secondary btn-sm">Save</button>
            </div>

            <div class="sync-target-section mt-3">
                <div class="fw-semibold mb-1">Sync to these devices</div>
                @{
                    var others = SyncService.GetOtherDevices().ToList();
                }
                @if (others.Any())
                {
                    foreach (var d in others)
                    {
                        var selected = selectedTargetDeviceIds.Contains(d.DeviceId);
                        <label class="sync-target-label @(d.IsOnline ? "" : "sync-target-muted")">
                            <input type="checkbox" checked="@selected" @onchange="async (e) => await ToggleTarget(d.DeviceId, e)" />
                            <span class="@(d.IsOnline ? "cf-status-online" : "cf-status-offline")">&#9679;</span>
                            <span>@d.Name</span>
                            @if (d.IsOnline) { <span class="online-now">(online now)</span> }
                            else { <span>(last seen @FormatLastActive(d.LastActiveUtc, false))</span> }
                        </label>
                    }
                }
                else
                {
                    <div class="sync-muted-text">No other devices are known for this account yet. Open Chatfish on another browser or device and log in with the same email.</div>
                }
            </div>
        }
        else
        {
            <div class="sync-muted-text py-2">Loading device list…</div>
        }

        @* Chat history section *@
        <div class="d-flex align-items-center gap-2 mt-3 mb-1 flex-wrap sync-section-header">
            <h3 style="margin:0">Chat history</h3>
            <button @onclick="SyncAllConversations"
                    class="btn btn-outline-primary btn-sm"
                    disabled="@(!selectedTargetDeviceIds.Any() || !localConvos.Any() || isBulkSyncing)">
                @(isBulkSyncing ? "Syncing…" : "Sync All")
            </button>
            <label class="sync-auto-sync-label ms-auto">
                <input type="checkbox" checked="@SyncService.AutoSyncChatHistory" @onchange="ToggleAutoSyncChat" />
                Auto sync
            </label>
        </div>
        <p class="sync-desc-text mb-2">Select one or more target devices above, then click Sync or Sync All.</p>

        @if (localConvos.Any())
        {
            <div class="sync-items-list">
                @foreach (var c in localConvos.OrderByDescending(x => x.LastUpdated))
                {
                    <div class="cf-sync-card sync-item-row">
                        <div class="sync-item-info">
                            <div class="sync-item-title">@c.Title</div>
                            <div class="sync-item-date">@c.LastUpdated.ToLocalTime().ToString("MMM d, HH:mm")</div>
                        </div>
                        <button @onclick="() => SyncConversation(c)"
                                class="btn btn-outline-primary btn-sm"
                                disabled="@(!selectedTargetDeviceIds.Any())">Sync</button>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="sync-muted-text">No conversations yet on this device.</div>
        }

        @* Notes section *@
        <div class="d-flex align-items-center gap-2 mt-3 mb-1 flex-wrap sync-section-header">
            <h3 style="margin:0">Notes</h3>
            <button @onclick="SyncAllNotes"
                    class="btn btn-outline-primary btn-sm"
                    disabled="@(!selectedTargetDeviceIds.Any() || !localNotes.Any() || isBulkSyncing)">
                @(isBulkSyncing ? "Syncing…" : "Sync All")
            </button>
            <label class="sync-auto-sync-label ms-auto">
                <input type="checkbox" checked="@SyncService.AutoSyncNotes" @onchange="ToggleAutoSyncNotes" />
                Auto sync
            </label>
        </div>
        <p class="sync-desc-text mb-2">Select one or more target devices above, then click Sync or Sync All.</p>

        @if (localNotes.Any())
        {
            <div class="sync-items-list">
                @foreach (var n in localNotes.OrderByDescending(x => x.LastUpdated))
                {
                    <div class="cf-sync-card sync-item-row">
                        <div class="sync-item-info">
                            <div class="sync-item-title">@n.Title</div>
                            <div class="sync-item-date">@n.LastUpdated.ToLocalTime().ToString("MMM d, HH:mm")</div>
                        </div>
                        <button @onclick="() => SyncNote(n)"
                                class="btn btn-outline-primary btn-sm"
                                disabled="@(!selectedTargetDeviceIds.Any())">Sync</button>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="sync-muted-text">No notes yet on this device.</div>
        }

        @if (!string.IsNullOrEmpty(statusMessage))
        {
            <div class="cf-sync-info-card mt-3">@statusMessage</div>
        }

        @if (ShowBackToChat)
        {
            <div class="mt-3 d-flex gap-2 align-items-center">
                <button @onclick="@(() => Nav.NavigateTo("/chat"))" class="btn btn-outline-secondary">Back to Chat</button>
            </div>
        }
    }
</div>

@code {
    [Parameter] public string? PendingDataSyncMessage { get; set; }
    [Parameter] public bool ShowAiServerOptions { get; set; } = true;
    [Parameter] public bool ShowBackToChat { get; set; } = true;

    private List<SyncDeviceInfo> devices = new();
    private List<LocalConvo> localConvos = new();
    private List<LocalNote> localNotes = new();
    private HashSet<string> selectedTargetDeviceIds = new(StringComparer.OrdinalIgnoreCase);
    private string newDeviceName = "";
    private string? statusMessage;
    private bool isRefreshing;
    private bool isBulkSyncing;

    private Action? _syncChangedHandler, _authChangedHandler, _conversationsChangedHandler, _notesChangedHandler;

    protected override async Task OnInitializedAsync()
    {
        await AuthService.LoadAsync();
        await SyncService.InitializeAsync();
        localConvos = await ConversationStore.LoadIndexAsync();
        localNotes = await NoteStore.LoadIndexAsync();

        _syncChangedHandler = () => { devices = SyncService.Devices.ToList(); InvokeAsync(StateHasChanged); };
        SyncService.OnChanged += _syncChangedHandler;
        _authChangedHandler = () => InvokeAsync(StateHasChanged);
        AuthService.OnChanged += _authChangedHandler;
        _conversationsChangedHandler = () => _ = RefreshConversationsAsync();
        SyncService.OnConversationsChanged += _conversationsChangedHandler;
        _notesChangedHandler = () => _ = RefreshNotesAsync();
        SyncService.OnNotesChanged += _notesChangedHandler;

        SyncService.OnSyncPayloadReceived += HandleIncomingSyncPayload;
        SyncService.OnSyncAckReceived += HandleSyncAckReceived;
        SyncService.OnNoteSyncPayloadReceived += HandleIncomingNoteSyncPayload;
        SyncService.OnNoteSyncAckReceived += HandleNoteSyncAckReceived;

        if (AuthService.IsAuthenticated)
        {
            await SyncService.EnsureConnectedAndRegisteredAsync();
            devices = SyncService.Devices.ToList();
            selectedTargetDeviceIds = SyncService.SyncTargetDeviceIds.ToHashSet(StringComparer.OrdinalIgnoreCase);
            newDeviceName = SyncService.MyDeviceName;
        }
    }

    private async Task RefreshConversationsAsync() { localConvos = await ConversationStore.LoadIndexAsync(); await InvokeAsync(StateHasChanged); }
    private async Task RefreshNotesAsync() { localNotes = await NoteStore.LoadIndexAsync(); await InvokeAsync(StateHasChanged); }

    private async Task RefreshDevices()
    {
        isRefreshing = true; StateHasChanged();
        try { await SyncService.RefreshAsync(); devices = SyncService.Devices.ToList(); }
        finally { isRefreshing = false; StateHasChanged(); }
    }

    private async Task SaveDeviceName()
    {
        var name = (newDeviceName ?? "").Trim();
        if (string.IsNullOrWhiteSpace(name)) return;
        await SyncService.SetDeviceNameAsync(name);
        newDeviceName = SyncService.MyDeviceName; devices = SyncService.Devices.ToList(); StateHasChanged();
    }

    private async Task ToggleTarget(string deviceId, ChangeEventArgs e)
    {
        if (e.Value is bool b && b) selectedTargetDeviceIds.Add(deviceId); else selectedTargetDeviceIds.Remove(deviceId);
        await SyncService.SetSyncTargetDevicesAsync(selectedTargetDeviceIds); StateHasChanged();
    }

    private async Task ToggleAutoSyncChat(ChangeEventArgs e) { var enabled = e.Value is bool b2 && b2; await SyncService.SetAutoSyncChatHistoryAsync(enabled); StateHasChanged(); }
    private async Task ToggleAutoSyncNotes(ChangeEventArgs e) { var enabled = e.Value is bool b3 && b3; await SyncService.SetAutoSyncNotesAsync(enabled); StateHasChanged(); }

    private async Task SyncAllConversations()
    {
        if (!selectedTargetDeviceIds.Any()) { statusMessage = "Select at least one target device above first."; StateHasChanged(); return; }
        isBulkSyncing = true; StateHasChanged();
        try
        {
            await SyncService.EnsureConnectedAndRegisteredAsync();
            if (!SyncService.IsConnected) { statusMessage = "Not connected to sync server. Try Refresh on the Devices section, then sync again."; return; }
            var queued = await SyncService.SyncAllConversationsToDevicesAsync(selectedTargetDeviceIds);
            var targetNames = devices.Where(d => selectedTargetDeviceIds.Contains(d.DeviceId)).Select(d => d.Name).ToList();
            statusMessage = $"Checking {queued} device(s) for conversations that need sync ({string.Join(", ", targetNames)}). Only changed items are transferred.";
        }
        finally { isBulkSyncing = false; StateHasChanged(); }
    }

    private async Task SyncAllNotes()
    {
        if (!selectedTargetDeviceIds.Any()) { statusMessage = "Select at least one target device above first."; StateHasChanged(); return; }
        isBulkSyncing = true; StateHasChanged();
        try
        {
            await SyncService.EnsureConnectedAndRegisteredAsync();
            if (!SyncService.IsConnected) { statusMessage = "Not connected to sync server. Try Refresh on the Devices section, then sync again."; return; }
            var queued = await SyncService.SyncAllNotesToDevicesAsync(selectedTargetDeviceIds);
            var targetNames = devices.Where(d => selectedTargetDeviceIds.Contains(d.DeviceId)).Select(d => d.Name).ToList();
            statusMessage = $"Checking {queued} device(s) for notes that need sync ({string.Join(", ", targetNames)}). Only changed items are transferred.";
        }
        finally { isBulkSyncing = false; StateHasChanged(); }
    }

    private async Task ToggleAiServer(string deviceId, ChangeEventArgs e)
    {
        if (e.Value is bool b4 && b4) await SyncService.SetAiServerDeviceAsync(deviceId);
        else if (string.Equals(SyncService.AiServerDeviceId, deviceId, StringComparison.OrdinalIgnoreCase)) await SyncService.SetAiServerDeviceAsync(null);
        StateHasChanged();
    }

    private async Task SyncNote(LocalNote note)
    {
        if (!selectedTargetDeviceIds.Any()) { statusMessage = "Select at least one target device above first."; StateHasChanged(); return; }
        var tds = devices.Where(d => selectedTargetDeviceIds.Contains(d.DeviceId)).ToList();
        await SyncService.EnsureConnectedAndRegisteredAsync();
        if (!SyncService.IsConnected) { statusMessage = "Not connected to sync server. Try Refresh on the Devices section, then sync again."; StateHasChanged(); return; }
        var entries = await NoteStore.LoadNoteAsync(note.Id);
        foreach (var tid in selectedTargetDeviceIds) await SyncService.StartWebRtcNoteSyncAsync(tid, note.Id, note.Title, entries);
        var tNames = tds.Select(d => d.Name).ToList();
        var serialized = System.Text.Json.JsonSerializer.Serialize(entries);
        statusMessage = $"Initiated WebRTC DataChannel sync for note \"{note.Title}\" ({entries.Count} entries, {System.Text.Encoding.UTF8.GetByteCount(serialized)} bytes) to: {string.Join(", ", tNames)}. Waiting for peer acknowledgement...";
        StateHasChanged(); ScheduleAckTimeout();
    }

    private async Task SyncConversation(LocalConvo convo)
    {
        if (!selectedTargetDeviceIds.Any()) { statusMessage = "Select at least one target device above first."; StateHasChanged(); return; }
        var tds = devices.Where(d => selectedTargetDeviceIds.Contains(d.DeviceId)).ToList();
        await SyncService.EnsureConnectedAndRegisteredAsync();
        if (!SyncService.IsConnected) { statusMessage = "Not connected to sync server. Try Refresh on the Devices section, then sync again."; StateHasChanged(); return; }
        var msgs = await ConversationStore.LoadConversationAsync(convo.Id);
        foreach (var tid in selectedTargetDeviceIds) await SyncService.StartWebRtcSyncAsync(tid, convo.Id, msgs);
        var tNames = tds.Select(d => d.Name).ToList();
        var serialized = System.Text.Json.JsonSerializer.Serialize(msgs);
        statusMessage = $"Initiated WebRTC DataChannel sync for \"{convo.Title}\" ({msgs.Count} messages, {System.Text.Encoding.UTF8.GetByteCount(serialized)} bytes) to: {string.Join(", ", tNames)}. Waiting for peer acknowledgement...";
        StateHasChanged(); ScheduleAckTimeout();
    }

    private void ScheduleAckTimeout()
    {
        _ = Task.Run(async () =>
        {
            await Task.Delay(15000);
            await InvokeAsync(() =>
            {
                if (statusMessage != null && statusMessage.Contains("Waiting for peer acknowledgement"))
                { statusMessage = "Sync initiated. No acknowledgement received (peer may have closed or network issue)."; StateHasChanged(); }
            });
        });
    }

    private static string FormatLastActive(DateTime utc, bool isOnline)
    {
        if (isOnline) return "Now";
        var ago = DateTime.UtcNow - utc;
        if (ago.TotalMinutes < 1) return "Just now";
        if (ago.TotalMinutes < 60) return $"{(int)ago.TotalMinutes}m ago";
        if (ago.TotalHours < 24) return $"{(int)ago.TotalHours}h ago";
        if (ago.TotalDays < 7) return $"{(int)ago.TotalDays}d ago";
        return utc.ToLocalTime().ToString("MMM d");
    }

    private async void HandleIncomingSyncPayload(string convoId, string json, string fromDeviceId)
    {
        try { await RefreshConversationsAsync(); statusMessage = $"Received sync for convo \"{GetConvoTitle(convoId)}\" from {fromDeviceId}."; StateHasChanged(); }
        catch (Exception ex) { Console.WriteLine($"[Sync] Failed to refresh after incoming sync payload: {ex.Message}"); }
    }

    private void HandleSyncAckReceived(string convoId, string fromPeerId)
    { statusMessage = $"Peer confirmed receipt of conversation \"{GetConvoTitle(convoId)}\"."; StateHasChanged(); ScheduleStatusClear("confirmed receipt"); }

    private async void HandleIncomingNoteSyncPayload(string noteId, string json, string fromDeviceId)
    {
        try { await RefreshNotesAsync(); statusMessage = $"Received sync for note \"{GetNoteTitle(noteId)}\" from {fromDeviceId}."; StateHasChanged(); }
        catch (Exception ex) { Console.WriteLine($"[Sync] Failed to refresh after incoming note sync payload: {ex.Message}"); }
    }

    private void HandleNoteSyncAckReceived(string noteId, string fromPeerId)
    { statusMessage = $"Peer confirmed receipt of note \"{GetNoteTitle(noteId)}\"."; StateHasChanged(); ScheduleStatusClear("confirmed receipt"); }

    private string GetConvoTitle(string id) => localConvos.FirstOrDefault(c => c.Id == id)?.Title ?? id;
    private string GetNoteTitle(string id) => localNotes.FirstOrDefault(n => n.Id == id)?.Title ?? id;

    private void ScheduleStatusClear(string marker)
    {
        _ = Task.Run(async () =>
        {
            await Task.Delay(4000);
            await InvokeAsync(() =>
            {
                if (statusMessage != null && statusMessage.Contains(marker)) { statusMessage = null; StateHasChanged(); }
            });
        });
    }

    public void Dispose()
    {
        if (_syncChangedHandler is not null) SyncService.OnChanged -= _syncChangedHandler;
        if (_authChangedHandler is not null) AuthService.OnChanged -= _authChangedHandler;
        if (_conversationsChangedHandler is not null) SyncService.OnConversationsChanged -= _conversationsChangedHandler;
        if (_notesChangedHandler is not null) SyncService.OnNotesChanged -= _notesChangedHandler;
        SyncService.OnSyncPayloadReceived -= HandleIncomingSyncPayload;
        SyncService.OnSyncAckReceived -= HandleSyncAckReceived;
        SyncService.OnNoteSyncPayloadReceived -= HandleIncomingNoteSyncPayload;
        SyncService.OnNoteSyncAckReceived -= HandleNoteSyncAckReceived;
    }
}

@implements IAsyncDisposable
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject ISidebarState SidebarState
@inject IBrowserPanelState BrowserPanel
@inject IChatPanelState ChatPanel
@inject INotesPanelState NotesPanel
@inject INavLayoutState NavLayout
@inject App.Core.Auth.IAuthService Auth
@using App.Core.UI
@using App.Shared.Services

<div class="top-row app-nav px-4 @(NavLayout.Mode == NavLayoutMode.Left ? "app-nav--left" : "app-nav--top")"
     @oncontextmenu="OnNavContextMenu"
     @oncontextmenu:preventDefault>
    <div class="app-nav-left">
        @if (ShowSidebarToggle)
        {
            @if (AppEnvironment.IsMaui)
            {
                <button type="button" @onclick="ToggleSidebar"
                        class="topbar-toggle-btn topbar-sidebar-toggle @(!SidebarState.IsCollapsed ? "active" : "")"
                        title="Toggle sidebar">
                    @if (SidebarState.IsCollapsed)
                    {
                        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" opacity="0.55">
                            <rect x="3" y="3" width="18" height="18" rx="2" />
                            <rect x="3" y="3" width="6" height="18" rx="2" fill="none" />
                        </svg>
                    }
                    else
                    {
                        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" opacity="0.55">
                            <rect x="3" y="3" width="18" height="18" rx="2" />
                            <rect x="3" y="3" width="6" height="18" rx="2" fill="currentColor" />
                        </svg>
                    }
                </button>
            }
            else
            {
                @* WASM: AppTopBar is static (no render mode) — Blazor @onclick does not run. JS delegation handles clicks. *@
                <button type="button"
                        data-wasm-sidebar-toggle="true"
                        class="topbar-toggle-btn topbar-sidebar-toggle active"
                        title="Toggle sidebar">
                    <span class="sidebar-toggle-icon sidebar-toggle-icon--collapsed" style="display:none">
                        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" opacity="0.55">
                            <rect x="3" y="3" width="18" height="18" rx="2" />
                            <rect x="3" y="3" width="6" height="18" rx="2" fill="none" />
                        </svg>
                    </span>
                    <span class="sidebar-toggle-icon sidebar-toggle-icon--expanded">
                        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" opacity="0.55">
                            <rect x="3" y="3" width="18" height="18" rx="2" />
                            <rect x="3" y="3" width="6" height="18" rx="2" fill="currentColor" />
                        </svg>
                    </span>
                </button>
            }
        }

        <div class="app-nav-primary">
            @if (AppEnvironment.IsMaui)
            {
                <button type="button" @onclick="ToggleChat" title="Chat"
                        class="topbar-toggle-btn @(IsChatActive ? "active" : "")">
                    <i class="bi bi-chat-dots" style="font-size: 24px;"></i>
                </button>
                @if (NavLayout.ShowBrowser)
                {
                    <button type="button" @onclick="ToggleBrowser" title="Browser"
                            class="topbar-toggle-btn @(BrowserPanel.IsOpen ? "active" : "")">
                        <i class="bi bi-browser-chrome" style="font-size: 24px;"></i>
                    </button>
                }
                @if (NavLayout.ShowNotes)
                {
                    <button type="button" @onclick="ToggleNotes" title="Notes"
                            class="topbar-toggle-btn @(IsNotesActive ? "active" : "")">
                        <i class="bi bi-journal-text" style="font-size: 24px;"></i>
                    </button>
                }
                @if (NavLayout.ShowGallery)
                {
                    <button type="button" @onclick="ToggleGallery" title="Gallery"
                            class="topbar-toggle-btn @(IsGalleryActive ? "active" : "")">
                        <i class="bi bi-images" style="font-size: 24px;"></i>
                    </button>
                }
                @if (NavLayout.ShowCalendar)
                {
                    <button type="button" @onclick="ToggleCalendar" title="Calendar"
                            class="topbar-toggle-btn @(IsCalendarActive ? "active" : "")">
                        <i class="bi bi-calendar3" style="font-size: 24px;"></i>
                    </button>
                }
            }
            else
            {
                <a href="/chat" title="Chat" class="@(IsChatActive ? "active" : null)">
                    <i class="bi bi-chat-dots" style="font-size: 24px;"></i>
                </a>
                @if (NavLayout.ShowNotes)
                {
                    <a href="/notes" title="Notes">
                        <i class="bi bi-journal-text" style="font-size: 24px;"></i>
                    </a>
                }
                @if (NavLayout.ShowGallery)
                {
                    <a href="/gallery" title="Gallery">
                        <i class="bi bi-images" style="font-size: 24px;"></i>
                    </a>
                }
                @if (NavLayout.ShowCalendar)
                {
                    <a href="/calendar" title="Calendar">
                        <i class="bi bi-calendar3" style="font-size: 24px;"></i>
                    </a>
                }
            }
        </div>
    </div>

    <div class="app-nav-right">
        @if (AppEnvironment.IsMaui)
        {
            <button type="button"
                    class="topbar-toggle-btn app-nav-secondary-toggle"
                    title="@(NavLayout.SecondaryExpanded ? "Hide settings icons" : "Show settings icons")"
                    aria-expanded="@NavLayout.SecondaryExpanded"
                    @onclick="ToggleSecondaryExpandedAsync">
                @if (NavLayout.Mode == NavLayoutMode.Left)
                {
                    <i class="bi @(NavLayout.SecondaryExpanded ? "bi-chevron-down" : "bi-chevron-up")" style="font-size: 1.1rem;"></i>
                }
                else
                {
                    <i class="bi @(NavLayout.SecondaryExpanded ? "bi-chevron-right" : "bi-chevron-left")" style="font-size: 1.1rem;"></i>
                }
            </button>
        }
        else
        {
            @* WASM: AppTopBar is static — Blazor @onclick does not run; JS uses data-wasm-secondary-toggle. *@
            <button type="button"
                    data-wasm-secondary-toggle="true"
                    class="topbar-toggle-btn app-nav-secondary-toggle"
                    title="Hide settings icons"
                    aria-expanded="true">
                <span class="secondary-toggle-icon secondary-toggle-icon--expanded">
                    <i class="bi bi-chevron-right" style="font-size: 1.1rem;"></i>
                </span>
                <span class="secondary-toggle-icon secondary-toggle-icon--collapsed" style="display:none">
                    <i class="bi bi-chevron-left" style="font-size: 1.1rem;"></i>
                </span>
            </button>
        }

        @* Always render the cluster on WASM so JS can show/hide without a Blazor re-render. *@
        @if (AppEnvironment.IsMaui)
        {
            @if (NavLayout.SecondaryExpanded)
            {
                <div class="app-nav-secondary">
                    @SecondarySettingsLinks
                </div>
            }
        }
        else
        {
            <div class="app-nav-secondary">
                @SecondarySettingsLinks
            </div>
        }

        <div class="app-nav-account">
            <a href="/account" title="Account / Login">
                <i class="bi bi-person-circle"></i>
            </a>
        </div>
    </div>
</div>

@if (AppEnvironment.IsMaui && _showNavContextMenu)
{
    <div class="app-nav-context-menu" style="@_navContextMenuStyle" @onclick:stopPropagation>
        <div class="app-nav-context-menu-section">Layout</div>
        <button type="button"
                class="app-nav-context-menu-item @(NavLayout.Mode == NavLayoutMode.Top ? "is-selected" : "")"
                @onclick="() => SetNavLayoutAsync(NavLayoutMode.Top)">
            Top navigation bar
        </button>
        <button type="button"
                class="app-nav-context-menu-item @(NavLayout.Mode == NavLayoutMode.Left ? "is-selected" : "")"
                @onclick="() => SetNavLayoutAsync(NavLayoutMode.Left)">
            Left navigation bar
        </button>

        <div class="app-nav-context-menu-divider"></div>
        <div class="app-nav-context-menu-section">Show app icons</div>
        <button type="button"
                class="app-nav-context-menu-item @(NavLayout.ShowBrowser ? "is-selected" : "")"
                @onclick="() => TogglePrimaryIconAsync(NavPrimaryIcon.Browser)">
            Show Browser icon
        </button>
        <button type="button"
                class="app-nav-context-menu-item @(NavLayout.ShowNotes ? "is-selected" : "")"
                @onclick="() => TogglePrimaryIconAsync(NavPrimaryIcon.Notes)">
            Show Notes icon
        </button>
        <button type="button"
                class="app-nav-context-menu-item @(NavLayout.ShowGallery ? "is-selected" : "")"
                @onclick="() => TogglePrimaryIconAsync(NavPrimaryIcon.Gallery)">
            Show Gallery icon
        </button>
        <button type="button"
                class="app-nav-context-menu-item @(NavLayout.ShowCalendar ? "is-selected" : "")"
                @onclick="() => TogglePrimaryIconAsync(NavPrimaryIcon.Calendar)">
            Show Calendar icon
        </button>
    </div>
    <div class="menu-overlay" @onclick="CloseNavContextMenu"></div>
}

@code {
    private Action? _browserPanelChangedHandler;
    private Action? _chatPanelChangedHandler;
    private Action? _notesPanelChangedHandler;
    private Action? _sidebarStateChangedHandler;
    private Action? _navLayoutChangedHandler;

    private bool _showNavContextMenu;
    private string _navContextMenuStyle = "";

    private RenderFragment SecondarySettingsLinks => __builder =>
    {
        <a href="/lemonade" title="Lemonade (local AI)" class="app-nav-emoji-link">
            <span aria-hidden="true" style="font-size: 1.25rem; line-height: 1.2;">🍋</span>
        </a>
        <a href="/local-ai" title="Ollama (local AI)" class="app-nav-emoji-link">
            <span aria-hidden="true" style="font-size: 1.25rem; line-height: 1.2;">🦙</span>
        </a>
        <a href="/cloud-providers" title="Cloud Providers">
            <i class="bi bi-cloud"></i>
        </a>
        @if (AppEnvironment.IsMaui)
        {
            <a href="/home-assistant" title="Home Assistant">
                <i class="bi bi-house-gear"></i>
            </a>
        }
        <a href="/settings" title="Settings">
            <i class="bi bi-gear"></i>
        </a>
        <a href="/sync" title="Devices & Sync">
            <i class="bi bi-arrow-repeat"></i>
        </a>
        <a href="/tools" title="Tools (MCP Servers)">
            <i class="bi bi-tools"></i>
        </a>
    };

    private bool IsChatActive => IsOnChatPage() && ChatPanel.IsOpen;
    private bool IsNotesActive => IsOnNotesPage() && NotesPanel.IsOpen;
    private bool IsGalleryActive => IsOnGalleryPage();
    private bool IsCalendarActive => IsOnCalendarPage();
    private bool ShowSidebarToggle =>
        IsOnNotesPage() || IsOnGalleryPage() || IsOnCalendarPage()
        || (IsOnChatPage() && (AppEnvironment.IsMaui ? ChatPanel.IsOpen : true));

    protected override void OnInitialized()
    {
        _browserPanelChangedHandler = () => InvokeAsync(StateHasChanged);
        BrowserPanel.OnChanged += _browserPanelChangedHandler;

        _chatPanelChangedHandler = () => InvokeAsync(StateHasChanged);
        ChatPanel.OnChanged += _chatPanelChangedHandler;

        _notesPanelChangedHandler = () => InvokeAsync(StateHasChanged);
        NotesPanel.OnChanged += _notesPanelChangedHandler;

        _sidebarStateChangedHandler = () => InvokeAsync(StateHasChanged);
        SidebarState.OnChanged += _sidebarStateChangedHandler;

        _navLayoutChangedHandler = () => InvokeAsync(StateHasChanged);
        NavLayout.OnChanged += _navLayoutChangedHandler;

        Nav.LocationChanged += OnLocationChanged;
        SyncPanelStateFromRoute();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        SyncPanelStateFromRoute();
        _ = InvokeAsync(StateHasChanged);
    }

    private void SyncPanelStateFromRoute()
    {
        if (IsOnNotesPage())
        {
            NotesPanel.IsOpen = true;
            ChatPanel.IsOpen = false;
            BrowserPanel.IsOpen = false;
        }
        else if (IsOnGalleryPage())
        {
            NotesPanel.IsOpen = false;
            ChatPanel.IsOpen = false;
            BrowserPanel.IsOpen = false;
        }
        else if (IsOnCalendarPage())
        {
            NotesPanel.IsOpen = false;
            ChatPanel.IsOpen = false;
            BrowserPanel.IsOpen = false;
        }
        else if (IsOnChatPage())
        {
            // Notes off when on /chat, but do not force chat open — browser-only mode
            // (top-bar browser icon) must be able to land on /chat with ChatPanel closed.
            NotesPanel.IsOpen = false;
        }
        else
        {
            NotesPanel.IsOpen = false;
        }
    }

    private async Task ToggleSidebar()
    {
        var collapsed = !SidebarState.IsCollapsed;
        await SidebarState.SetCollapsedAsync(collapsed, JS);
        StateHasChanged();
    }

    private void OnNavContextMenu(MouseEventArgs e)
    {
        if (!AppEnvironment.IsMaui)
            return;

        _navContextMenuStyle = $"position: fixed; top: {e.ClientY}px; left: {e.ClientX}px; z-index: 10001;";
        _showNavContextMenu = true;
    }

    private void CloseNavContextMenu() => _showNavContextMenu = false;

    private async Task SetNavLayoutAsync(NavLayoutMode mode)
    {
        CloseNavContextMenu();
        await UiStorageNamespace.ApplyAsync(JS, Auth);
        await NavLayout.SetModeAsync(mode, JS);
    }

    private async Task TogglePrimaryIconAsync(NavPrimaryIcon icon)
    {
        var currentlyVisible = icon switch
        {
            NavPrimaryIcon.Browser => NavLayout.ShowBrowser,
            NavPrimaryIcon.Notes => NavLayout.ShowNotes,
            NavPrimaryIcon.Gallery => NavLayout.ShowGallery,
            NavPrimaryIcon.Calendar => NavLayout.ShowCalendar,
            _ => true
        };

        await UiStorageNamespace.ApplyAsync(JS, Auth);
        await NavLayout.SetPrimaryIconVisibleAsync(icon, !currentlyVisible, JS);
        // Keep menu open so the user can toggle several icons.
    }

    private async Task ToggleSecondaryExpandedAsync()
    {
        await UiStorageNamespace.ApplyAsync(JS, Auth);
        await NavLayout.SetSecondaryExpandedAsync(!NavLayout.SecondaryExpanded, JS);
    }

    private async Task ToggleChat()
    {
        NotesPanel.IsOpen = false;

        if (!IsOnChatPage())
        {
            ChatPanel.IsOpen = true;
            Nav.NavigateTo("/chat");
            if (AppEnvironment.IsMaui)
                await SidebarState.SetCollapsedAsync(false, JS);
            return;
        }

        ChatPanel.Toggle();
        if (ChatPanel.IsOpen && AppEnvironment.IsMaui)
            await SidebarState.SetCollapsedAsync(false, JS);
        else if (!ChatPanel.IsOpen)
            await SidebarState.SetCollapsedAsync(true, JS);
    }

    private async Task ToggleNotes()
    {
        ChatPanel.IsOpen = false;
        BrowserPanel.IsOpen = false;
        NotesPanel.IsOpen = true;

        if (!IsOnNotesPage())
            Nav.NavigateTo("/notes");

        await SidebarState.SetCollapsedAsync(false, JS);
    }

    private async Task ToggleGallery()
    {
        ChatPanel.IsOpen = false;
        BrowserPanel.IsOpen = false;
        NotesPanel.IsOpen = false;

        if (!IsOnGalleryPage())
            Nav.NavigateTo("/gallery");

        await SidebarState.SetCollapsedAsync(false, JS);
    }

    private async Task ToggleCalendar()
    {
        ChatPanel.IsOpen = false;
        BrowserPanel.IsOpen = false;
        NotesPanel.IsOpen = false;

        if (!IsOnCalendarPage())
            Nav.NavigateTo("/calendar");

        await SidebarState.SetCollapsedAsync(false, JS);
    }

    private async Task ToggleBrowser()
    {
        NotesPanel.IsOpen = false;

        if (!IsOnChatPage())
        {
            // From Notes/Settings/etc.: browser only — do not open chat or chat history sidebar.
            BrowserPanel.IsOpen = true;
            ChatPanel.IsOpen = false;
            Nav.NavigateTo("/chat");
            await SidebarState.SetCollapsedAsync(true, JS);
            return;
        }

        // Already on /chat: toggle browser pane without changing chat open/closed.
        BrowserPanel.Toggle();
        if (BrowserPanel.IsOpen)
            await SidebarState.SetCollapsedAsync(true, JS);
    }

    private bool IsOnChatPage()
    {
        var path = Nav.ToAbsoluteUri(Nav.Uri).AbsolutePath.TrimEnd('/');
        return path.Equals("/chat", StringComparison.OrdinalIgnoreCase);
    }

    private bool IsOnNotesPage()
    {
        var path = Nav.ToAbsoluteUri(Nav.Uri).AbsolutePath.TrimEnd('/');
        return path.Equals("/notes", StringComparison.OrdinalIgnoreCase);
    }

    private bool IsOnGalleryPage()
    {
        var path = Nav.ToAbsoluteUri(Nav.Uri).AbsolutePath.TrimEnd('/');
        return path.Equals("/gallery", StringComparison.OrdinalIgnoreCase);
    }

    private bool IsOnCalendarPage()
    {
        var path = Nav.ToAbsoluteUri(Nav.Uri).AbsolutePath.TrimEnd('/');
        return path.Equals("/calendar", StringComparison.OrdinalIgnoreCase);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            await ThemeInterop.ApplySavedAsync(JS);
            if (!AppEnvironment.IsMaui)
            {
                // Re-apply settings-cluster visibility after static bar (re)inserts.
                await JS.InvokeVoidAsync("appNavLayout.applySecondaryFromStorage");
            }
        }
        catch
        {
            // JS interop may be unavailable during static render passes.
        }
    }

    public ValueTask DisposeAsync()
    {
        Nav.LocationChanged -= OnLocationChanged;

        if (_browserPanelChangedHandler != null)
            BrowserPanel.OnChanged -= _browserPanelChangedHandler;

        if (_chatPanelChangedHandler != null)
            ChatPanel.OnChanged -= _chatPanelChangedHandler;

        if (_notesPanelChangedHandler != null)
            NotesPanel.OnChanged -= _notesPanelChangedHandler;

        if (_sidebarStateChangedHandler != null)
            SidebarState.OnChanged -= _sidebarStateChangedHandler;

        if (_navLayoutChangedHandler != null)
            NavLayout.OnChanged -= _navLayoutChangedHandler;

        return ValueTask.CompletedTask;
    }
}

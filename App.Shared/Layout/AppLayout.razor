@inherits LayoutComponentBase
@implements IDisposable
@inject INavLayoutState NavLayout
@inject NavigationManager Nav

<ThemeBootstrap />
<NavLayoutBootstrap />
<AppNavigationBootstrap />
@if (AppEnvironment.IsMaui)
{
    <AuthGate />
}
<SyncConnectionBootstrap />
<WorkflowDueBootstrap />
<SetupWizard />
<AppUpdateBootstrap />
@if (AppEnvironment.IsMaui)
{
    <HelpPanel />
}

<div class="app-shell"
     data-nav-layout="@NavLayoutModeString"
     data-login-landing="@(UnsignedAppRoutes.IsAllowed(Nav) ? "1" : "0")">
    <AppTopBar />
    <div class="app-body">
        @Body
    </div>
</div>

@code {
    private Action? _navLayoutChangedHandler;

    private string NavLayoutModeString =>
        NavLayout.Mode == NavLayoutMode.Left ? "left" : "top";

    protected override void OnInitialized()
    {
        _navLayoutChangedHandler = () => InvokeAsync(StateHasChanged);
        NavLayout.OnChanged += _navLayoutChangedHandler;
        Nav.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) =>
        _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
        if (_navLayoutChangedHandler != null)
            NavLayout.OnChanged -= _navLayoutChangedHandler;
    }
}

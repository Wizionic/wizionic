    private async Task RefreshPageTitleFromDocumentAsync()
    {
        try
        {
            var raw = await BrowserAgent.EvaluateScriptAsync(BrowserPageMetadata.ReadTitleScript);
            var cleaned = UnquoteScriptResult(raw);
            var url = BrowserAgent.CurrentUrl;
            var title = BrowserPageMetadata.ResolveBookmarkTitle(cleaned, url);
            if (!string.IsNullOrWhiteSpace(title))
                _browserPageTitle = title;

            var iconRaw = await BrowserAgent.EvaluateScriptAsync(BrowserPageMetadata.ReadFaviconHrefScript);
            var icon = UnquoteScriptResult(iconRaw);
            if (!string.IsNullOrWhiteSpace(icon) && !string.IsNullOrWhiteSpace(url))
                BrowserFaviconUrl.Remember(url, icon);

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Browser] refresh title/icon for bookmark failed: {ex.Message}");
        }
    }

    private async Task<string?> CapturePageFaviconAsync(string pageUrl)
    {
        try
        {
            var iconRaw = await BrowserAgent.EvaluateScriptAsync(BrowserPageMetadata.ReadFaviconHrefScript);
            var icon = UnquoteScriptResult(iconRaw);
            if (BrowserFaviconUrl.IsUsableIconUrl(icon))
            {
                BrowserFaviconUrl.Remember(pageUrl, icon);
                return icon;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Browser] capture favicon failed: {ex.Message}");
        }

        return BrowserFaviconUrl.GetCached(pageUrl);
    }

    private static string UnquoteScriptResult(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return "";
        var trimmed = value.Trim();
        if (trimmed.Equals("null", StringComparison.OrdinalIgnoreCase)
            || trimmed.Equals("undefined", StringComparison.OrdinalIgnoreCase))
            return "";
        if (trimmed.Length >= 2 && trimmed.StartsWith('"') && trimmed.EndsWith('"'))
            return trimmed[1..^1].Replace("\\\"", "\"").Replace("\\n", "\n");
        return trimmed;
    }


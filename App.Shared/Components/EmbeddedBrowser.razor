    private async Task PinCurrentAsPwa()
    {
        var manifest = PwaDetector.CurrentManifest;
        if (manifest == null || string.IsNullOrWhiteSpace(BrowserAgent.CurrentUrl))
            return;

        // Prefer manifest start_url resolved against the manifest URL; never store file://
        // (Linux .NET treats root-relative "/" as an absolute file URI).
        var startUrl = PwaManifestHelper.ResolveStartUrl(manifest, BrowserAgent.CurrentUrl);
        if (!PwaManifestHelper.IsWebUrl(startUrl))
            startUrl = BrowserAgent.CurrentUrl;

        var name = manifest.ShortName ?? manifest.Name ?? _pinName;
        if (string.IsNullOrWhiteSpace(name))
            name = startUrl;

        var iconUrl = PwaManifestHelper.PickBestIcon(manifest);
        if (!PwaManifestHelper.IsWebUrl(iconUrl))
            iconUrl = BrowserFaviconUrl.Get(startUrl);

        var suggestedTarget = PwaManifestHelper.SuggestOpenTarget(manifest);
        var app = new SidebarApp(
            Guid.NewGuid().ToString("N"),
            name,
            manifest.ShortName ?? name,
            startUrl,
            iconUrl,
            manifest.BackgroundColor,
            manifest.ThemeColor,
            false,
            suggestedTarget,
            DateTime.UtcNow,
            IsPwa: true);

        await SidebarStore.PinAppAsync(app);
        SyncService.ScheduleAutoSyncSidebarAppAfterLocalSave(app.Id);
        ClosePinDialog();
        await OpenSidebarAppAsync(app, suggestedTarget);
    }

    private Task OpenApp(SidebarApp app) => OpenSidebarAppAsync(app);

    private async Task OpenSidebarAppAsync(SidebarApp app, OpenTarget? overrideTarget = null)
    {
        CloseAllContextMenus();

        // Never feed file:// (or other non-web) start URLs into the normalizer — it turns
        // them into a Brave/search query containing "file:///".
        var startUrl = app.StartUrl;
        if (!PwaManifestHelper.IsWebUrl(startUrl))
        {
            var healed = PwaManifestHelper.HealPinnedApp(app);
            startUrl = healed.StartUrl;
            if (healed != app)
                await SidebarStore.UpdateAppAsync(healed);
        }

        if (!PwaManifestHelper.IsWebUrl(startUrl))
        {
            Console.WriteLine($"[Browser/PWA] refuse open — bad StartUrl '{app.StartUrl}' for '{app.Name}'");
            return;
        }

        var target = overrideTarget ?? app.DefaultOpenTarget;
        if (target == OpenTarget.LastUsed)
            target = SidebarStore.GetLastOpenTarget(app.Id);

        if (target == OpenTarget.MainBrowser)
        {
            _showStartPage = false;
            await BrowserAgent.NavigateAsync(startUrl);
            await SidebarStore.SetLastOpenTargetAsync(app.Id, OpenTarget.MainBrowser);
            RefreshWebViewBounds();
            return;
        }

        SidePanel.IsOpen = true;
        SidePanel.Content = BrowserSidePanelContent.Web;
        SidePanel.ActiveAppId = app.Id;
        SidePanel.NotifyChanged();

        await SideAgent.NavigateAsync(startUrl);
        await SidebarStore.SetLastOpenTargetAsync(app.Id, OpenTarget.SidePanel);
        _pendingOverlaySync = true;
        await SyncOverlayAsync();
    }


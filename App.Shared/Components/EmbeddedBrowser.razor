    [JSInvokable]
    public async Task OnSidebarDrop(
        string fromKind,
        string fromId,
        string fromFolderId,
        string? targetKind,
        string? targetId,
        string? targetFolderId)
    {
        _sidebarDragOverBookmarkId = null;
        _sidebarDragOverFolderId = null;

        if (string.IsNullOrWhiteSpace(targetKind) || string.IsNullOrWhiteSpace(targetId))
        {
            await InvokeAsync(StateHasChanged);
            return;
        }

        if (fromKind == "bookmark")
        {
            if (targetKind == "bookmark" && fromId != targetId && !string.IsNullOrWhiteSpace(targetFolderId))
            {
                await BrowserStore.MoveBookmarkAsync(fromId, targetFolderId, targetId);
                SyncService.ScheduleAutoSyncBookmarkAfterLocalSave(fromId);
            }
            else if (targetKind == "folder" && fromFolderId != targetId)
            {
                await BrowserStore.MoveBookmarkAsync(fromId, targetId);
                SyncService.ScheduleAutoSyncBookmarkAfterLocalSave(fromId);
            }
        }
        else if (fromKind == "folder" && targetKind == "folder" && fromId != targetId)
        {
            var folders = BrowserStore.GetFolders().ToList();
            var fromIndex = folders.FindIndex(f => f.Id == fromId);
            var toIndex = folders.FindIndex(f => f.Id == targetId);
            if (fromIndex >= 0 && toIndex >= 0)
            {
                var moved = folders[fromIndex];
                folders.RemoveAt(fromIndex);
                folders.Insert(toIndex, moved);
                await BrowserStore.ReorderFoldersAsync(folders.Select(f => f.Id).ToList());
                foreach (var f in folders)
                    SyncService.ScheduleAutoSyncFolderAfterLocalSave(f.Id);
            }
        }

        await InvokeAsync(StateHasChanged);
    }


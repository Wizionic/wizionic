@implements IDisposable
@using Microsoft.JSInterop
@using App.Core.Browser
@using App.Core.UI
@using App.Shared.Services
@inject IJSRuntime JS
@inject IBrowserPanelState BrowserPanel
@inject IBrowserAgentService BrowserAgent
@inject IBrowserTabManager TabManager
@inject IBrowserOverlaySync BrowserOverlay
@inject IBrowserStore BrowserStore
@inject IBrowserSidebarStore SidebarStore
@inject IBrowserSidePanelState SidePanel
@inject IBrowserSideAgentService SideAgent
@inject IPwaDetector PwaDetector
@inject IBrowserDownloadService Downloads
@inject ISyncService SyncService
@using App.Core.Sync

<div class="browser-splitter"
     title="Drag to resize"
     @onmouseenter="OnSplitterMouseEnter"
     @onmouseleave="OnSplitterMouseLeave"
     @onmousedown="StartSplitterDrag"
     @onmousedown:preventDefault></div>
<div id="browser-panel" class="browser-panel">
    <div class="browser-tabstrip" @onclick:stopPropagation="true">
        <div class="browser-tabstrip-tabs">
            @foreach (var tab in TabManager.Tabs)
            {
                var tabId = tab.Id;
                var isActive = tabId == TabManager.ActiveTabId;
                <div class="browser-tab @(isActive ? "active" : "") @(_dragOverTabId == tabId ? "drag-over" : "")"
                     data-tab-id="@tabId"
                     @onmousedown="(e) => StartTabStripDragAsync(e, tabId)"
                     @onmousedown:preventDefault="true"
                     @onmouseenter="() => OnTabMouseEnterAsync(tabId, isActive)"
                     @onmouseleave="OnTabMouseLeave">
                    @if (!string.IsNullOrWhiteSpace(tab.FaviconUrl) || !string.IsNullOrWhiteSpace(tab.Url))
                    {
                        <img class="browser-tab-icon"
                             src="@BrowserFaviconUrl.Get(tab.Url, tab.FaviconUrl)"
                             alt=""
                             loading="lazy"
                             draggable="false"
                             onerror="this.style.display='none'; this.nextElementSibling && (this.nextElementSibling.style.display='inline-flex');" />
                        <i class="bi bi-globe2 browser-tab-icon-fallback" style="display:none;" aria-hidden="true"></i>
                    }
                    else
                    {
                        <i class="bi bi-globe2 browser-tab-icon-fallback" aria-hidden="true"></i>
                    }
                    <span class="browser-tab-title">@tab.DisplayTitle</span>
                    <button type="button"
                            class="browser-tab-close"
                            title="Close tab"
                            @onclick="() => CloseTabAsync(tabId)"
                            @onclick:stopPropagation="true"
                            @onmousedown:stopPropagation="true"
                            @onmouseenter:stopPropagation="true">
                        <i class="bi bi-x"></i>
                    </button>
                </div>
            }
        </div>
        <button type="button" class="browser-tab-new" title="New tab" @onclick="OpenNewTabAsync">
            <i class="bi bi-plus-lg"></i>
        </button>
    </div>
    @if (_tabHoverTooltipVisible)
    {
        <div class="browser-tab-tooltip-fixed"
             style="left:@($"{_tabHoverTooltipLeft:F0}px");top:@($"{_tabHoverTooltipTop:F0}px");"
             aria-hidden="true">
            <div class="browser-tab-tooltip-title">@_tabHoverTooltipTitle</div>
            @if (!string.IsNullOrWhiteSpace(_tabHoverTooltipUrl))
            {
                <div class="browser-tab-tooltip-url">@_tabHoverTooltipUrl</div>
            }
        </div>
    }
    <div class="browser-toolbar">
        <button type="button" class="browser-toolbar-btn" @onclick="GoHomeAsync" title="Home">
            <i class="bi bi-house"></i>
        </button>
        <button type="button" class="browser-toolbar-btn" @onclick="BrowserBack" disabled="@(!_canGoBack)" title="Back">
            <i class="bi bi-arrow-left"></i>
        </button>
        <button type="button" class="browser-toolbar-btn" @onclick="BrowserForward" disabled="@(!_canGoForward)" title="Forward">
            <i class="bi bi-arrow-right"></i>
        </button>
        <button type="button" class="browser-toolbar-btn" @onclick="BrowserRefresh" title="Refresh">
            <i class="bi bi-arrow-clockwise @(_isLoading ? "spin" : "")"></i>
        </button>
        <div class="browser-url-wrap">
            <input value="@_browserUrl"
                   @oninput="OnUrlInput"
                   @onkeydown="BrowserUrlKeyDown"
                   @onfocus="OnUrlFocus"
                   @onblur="OnUrlBlur"
                   class="browser-url-input"
                   placeholder="URL or search..."
                   autocomplete="off"
                   spellcheck="false" />
            @if (_showUrlSuggestions && _urlSuggestions.Count > 0)
            {
                <ul class="browser-url-suggestions">
                    @for (var i = 0; i < _urlSuggestions.Count; i++)
                    {
                        var idx = i;
                        var entry = _urlSuggestions[idx];
                        <li class="browser-url-suggestion @(idx == _urlSuggestionIndex ? "active" : "")"
                            @onmousedown="() => SelectSuggestion(entry)"
                            @onmousedown:preventDefault>
                            <span class="browser-url-suggestion-url">@entry.Url</span>
                            @if (!string.IsNullOrWhiteSpace(entry.Title)
                                 && !entry.Title.Equals(entry.Url, StringComparison.OrdinalIgnoreCase))
                            {
                                <span class="browser-url-suggestion-title">@entry.Title</span>
                            }
                        </li>
                    }
                </ul>
            }
        </div>
        <div class="browser-bookmarks-menu-wrap">
            <button type="button" class="browser-toolbar-btn @(_showBookmarkMenu ? "active" : "")"
                    @onclick="ToggleBookmarkMenu" title="Bookmarks">
                <i class="bi bi-folder"></i>
            </button>
            @if (_showBookmarkMenu)
            {
                <div class="browser-bookmarks-dropdown">
                    <button type="button" class="browser-bookmarks-page-link" @onclick="OpenBookmarksPage">
                        <i class="bi bi-grid"></i> All bookmarks
                    </button>
                    @foreach (var folder in BrowserStore.GetFolders())
                    {
                        var folderBookmarks = BrowserStore.GetBookmarks(folder.Id);
                        if (!folderBookmarks.Any())
                            continue;
                        <div class="browser-bookmarks-folder-label">@folder.Name</div>
                        @foreach (var bm in folderBookmarks)
                        {
                            <button type="button" class="browser-bookmarks-item"
                                    @onclick="() => OpenBookmarkFromMenu(bm.Url)">
                                @if (!string.IsNullOrWhiteSpace(bm.Title))
                                {
                                    <span class="browser-bookmarks-item-title">@BrowserPageMetadata.ResolveBookmarkTitle(bm.Title, bm.Url)</span>
                                }
                                <span class="browser-bookmarks-item-url">@bm.Url</span>
                            </button>
                        }
                    }
                    @if (!BrowserStore.GetBookmarks().Any())
                    {
                        <div class="browser-bookmarks-empty">No bookmarks yet</div>
                    }
                </div>
            }
        </div>
        <button type="button" class="browser-toolbar-btn browser-go-btn" @onclick="BrowserNavigate">Go</button>
        <button type="button" class="browser-toolbar-btn" @onclick="OpenBookmarkDialog" title="Bookmark this page" disabled="@(string.IsNullOrWhiteSpace(BrowserAgent.CurrentUrl) || _showStartPage)">
            <i class="bi bi-bookmark-plus"></i>
        </button>
        <div class="browser-downloads-menu-wrap">
            <button type="button"
                    class="browser-toolbar-btn @(_showDownloadsMenu ? "active" : "") @(Downloads.IsAnyInProgress ? "browser-download-active" : "")"
                    @onclick="ToggleDownloadsMenu"
                    title="Downloads">
                <i class="bi bi-download @(Downloads.IsAnyInProgress ? "spin" : "")"></i>
            </button>
            @if (_showDownloadsMenu)
            {
                <div class="browser-downloads-dropdown" @onclick:stopPropagation="true">
                    <div class="browser-downloads-header">
                        <span>Downloads</span>
                        @if (Downloads.Downloads.Any(d => d.State != BrowserDownloadState.InProgress))
                        {
                            <button type="button" class="browser-downloads-clear" @onclick="ClearCompletedDownloads">Clear</button>
                        }
                    </div>
                    @if (!Downloads.Downloads.Any())
                    {
                        <div class="browser-downloads-empty">No downloads yet</div>
                    }
                    else
                    {
                        @foreach (var dl in Downloads.Downloads)
                        {
                            var downloadId = dl.Id;
                            <div class="browser-downloads-item">
                                <div class="browser-downloads-item-main">
                                    <i class="bi @DownloadStateIcon(dl.State) browser-downloads-item-icon" aria-hidden="true"></i>
                                    <div class="browser-downloads-item-text">
                                        <div class="browser-downloads-item-name" title="@dl.FileName">@dl.FileName</div>
                                        <div class="browser-downloads-item-meta">@DownloadStatusText(dl)</div>
                                        @if (dl.State == BrowserDownloadState.InProgress && dl.ProgressFraction is double frac)
                                        {
                                            <div class="browser-downloads-progress">
                                                <div class="browser-downloads-progress-bar" style="width:@($"{frac * 100:F0}%")"></div>
                                            </div>
                                        }
                                    </div>
                                </div>
                                <div class="browser-downloads-item-actions">
                                    <button type="button"
                                            class="browser-downloads-action"
                                            title="Show in folder"
                                            disabled="@(string.IsNullOrWhiteSpace(dl.FilePath))"
                                            @onclick="() => ShowDownloadInFolderAsync(downloadId)">
                                        <i class="bi bi-folder2-open"></i>
                                    </button>
                                    <button type="button"
                                            class="browser-downloads-action"
                                            title="Open"
                                            disabled="@(dl.State != BrowserDownloadState.Completed || string.IsNullOrWhiteSpace(dl.FilePath))"
                                            @onclick="() => OpenDownloadAsync(downloadId)">
                                        <i class="bi bi-box-arrow-up-right"></i>
                                    </button>
                                    <button type="button"
                                            class="browser-downloads-action browser-downloads-action-danger"
                                            title="Delete"
                                            @onclick="() => DeleteDownloadAsync(downloadId)">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </div>
                        }
                    }
                </div>
            }
        </div>
        <button type="button" class="browser-toolbar-btn" @onclick="OpenInExternalBrowser" title="Open in external browser">
            <i class="bi bi-box-arrow-up-right"></i>
        </button>
        <button type="button" class="browser-toolbar-btn @(SidePanel.IsOpen && SidePanel.Content == BrowserSidePanelContent.Settings ? "active" : "")"
                @onclick="OpenSettingsInSidePanel" title="Browser settings">
            <i class="bi bi-gear"></i>
        </button>
    </div>
    @if (ShowBookmarksBar)
    {
        <div class="browser-bookmarks-bar" @onclick:stopPropagation="true" @onclick="CloseBarContextMenu">
            @foreach (var bm in BookmarksBarItems)
            {
                <button type="button"
                        class="browser-bookmarks-bar-item @(_dragOverBookmarkId == bm.Id ? "drag-over" : "")"
                        title="@bm.Url"
                        data-bookmark-id="@bm.Id"
                        @onmousedown="(e) => StartBarItemDragAsync(e, bm.Id)"
                        @onmousedown:preventDefault="true"
                        @oncontextmenu="(e) => OnBarContextMenu(e, bm)"
                        @oncontextmenu:preventDefault="true"
                        @oncontextmenu:stopPropagation="true">
                    <img class="browser-bookmarks-bar-icon" src="@BrowserFaviconUrl.Get(bm.Url, bm.IconUrl)" alt="" loading="lazy" draggable="false"
                         onerror="this.dataset.step=(+this.dataset.step||0)+1;var s=+this.dataset.step;if(s===1)this.src='@BrowserFaviconUrl.GetDuckDuckGo(bm.Url)';else if(s===2)this.src='@BrowserFaviconUrl.GetSiteRootIco(bm.Url)';else if(s===3)this.src='@BrowserFaviconUrl.GetGoogle(bm.Url)';else{this.onerror=null;this.style.opacity='0.35';}" />
                    @if (!string.IsNullOrWhiteSpace(bm.Title))
                    {
                        <span class="browser-bookmarks-bar-title">@BrowserPageMetadata.ResolveBookmarkTitle(bm.Title, bm.Url)</span>
                    }
                </button>
            }
            @if (!BookmarksBarItems.Any())
            {
                <span class="browser-bookmarks-bar-empty">Add bookmarks to the "Bookmarks bar" folder to show them here.</span>
            }
        </div>
    }
    <div class="browser-body" id="browser-body" @onclick="() => CloseAllContextMenus()">
        <div class="browser-main-column">
            @if (_barMenuInsetPx > 0)
            {
                <div class="browser-bar-menu-spacer" style="height:@($"{_barMenuInsetPx:F0}px")"></div>
            }
            <div id="browser-content-host" class="browser-content browser-content-host">
                @if (_showStartPage)
                {
                    <div class="browser-start-page">
                        <h3 class="browser-start-title">Bookmarks</h3>
                        @foreach (var folder in BrowserStore.GetFolders())
                        {
                            var folderBookmarks = BrowserStore.GetBookmarks(folder.Id);
                            if (!folderBookmarks.Any())
                                continue;
                            <div class="browser-start-folder">
                                <div class="browser-start-folder-name">@folder.Name</div>
                                <div class="browser-start-grid">
                                    @foreach (var bm in folderBookmarks)
                                    {
                                        <button type="button" class="browser-start-tile" @onclick="() => OpenBookmark(bm.Url)">
                                            @if (!string.IsNullOrWhiteSpace(bm.Title))
                                            {
                                                <span class="browser-start-tile-title">@BrowserPageMetadata.ResolveBookmarkTitle(bm.Title, bm.Url)</span>
                                            }
                                            <span class="browser-start-tile-url">@bm.Url</span>
                                        </button>
                                    }
                                </div>
                            </div>
                        }
                        @if (!BrowserStore.GetBookmarks().Any())
                        {
                            <p class="browser-start-empty">No bookmarks yet. Use the bookmark icon to save pages.</p>
                        }
                    </div>
                }
                else if (string.IsNullOrWhiteSpace(BrowserAgent.CurrentUrl))
                {
                    <div class="browser-placeholder">Loading browser...</div>
                }
            </div>
        </div>

        @if (SidePanel.IsOpen)
        {
            <div class="browser-side-splitter"
                 title="Drag to resize side panel"
                 @onmouseenter="OnSplitterMouseEnter"
                 @onmouseleave="OnSplitterMouseLeave"
                 @onmousedown="StartSidePanelSplitterDrag"
                 @onmousedown:preventDefault></div>
            <div class="browser-side-column" style="width:@($"{_sidePanelWidthPx:F0}px")">
                <div class="browser-side-header">
                    <span class="browser-side-header-title">@SidePanelTitle</span>
                    <button type="button" class="browser-side-close" @onclick="CloseSidePanel" title="Close panel">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
                <div class="browser-side-content">
                    @if (SidePanel.Content == BrowserSidePanelContent.Bookmarks)
                    {
                        <div class="browser-side-bookmarks">
                            <div class="browser-side-bookmarks-toolbar">
                                <button type="button" class="browser-side-toolbar-btn" @onclick="ToggleSideNewFolderInput" title="New folder">
                                    <i class="bi bi-folder-plus"></i> Folder
                                </button>
                                @if (_selectedBookmarkIds.Count > 0)
                                {
                                    <button type="button" class="browser-side-toolbar-btn browser-side-toolbar-btn-danger" @onclick="DeleteSelectedSideBookmarks">
                                        <i class="bi bi-trash"></i> Delete (@_selectedBookmarkIds.Count)
                                    </button>
                                }
                            </div>
                            @if (_showSideNewFolderInput)
                            {
                                <div class="browser-side-new-folder">
                                    <input class="newnote-input" @bind="_sideNewFolderName" placeholder="Folder name..."
                                           @onkeydown="OnSideNewFolderKeyDown" />
                                    <button type="button" class="browser-side-toolbar-btn" @onclick="ConfirmSideAddFolder" disabled="@string.IsNullOrWhiteSpace(_sideNewFolderName)">
                                        Add
                                    </button>
                                    <button type="button" class="browser-side-toolbar-btn" @onclick="CancelSideNewFolder">
                                        Cancel
                                    </button>
                                </div>
                            }
                            <div class="browser-side-bookmarks-list">
                                @foreach (var folder in BrowserStore.GetFolders())
                                {
                                    var folderBookmarks = BrowserStore.GetBookmarks(folder.Id);
                                    <div class="browser-side-folder @(_sidebarDragOverFolderId == folder.Id ? "drag-over" : "")"
                                         data-sidebar-folder-id="@folder.Id">
                                        <div class="browser-side-folder-header" data-sidebar-folder-drop="true"
                                             @onmousedown="(e) => StartSidebarFolderDragAsync(e, folder.Id)">
                                            <i class="bi bi-grip-vertical browser-side-drag-handle" aria-hidden="true"></i>
                                            <span class="browser-side-folder-name">@folder.Name</span>
                                            <span class="browser-side-folder-count">@folderBookmarks.Count</span>
                                        </div>
                                        @foreach (var bm in folderBookmarks)
                                        {
                                            <div class="browser-side-bookmark-row @(_sidebarDragOverBookmarkId == bm.Id ? "drag-over" : "") @(_selectedBookmarkIds.Contains(bm.Id) ? "selected" : "")"
                                                 data-sidebar-bookmark-id="@bm.Id"
                                                 data-sidebar-folder-id="@folder.Id">
                                                <label class="browser-side-bookmark-check" @onclick:stopPropagation="true">
                                                    <input type="checkbox" checked="@_selectedBookmarkIds.Contains(bm.Id)"
                                                           @onchange="(e) => ToggleSideBookmarkSelection(bm.Id, e)" />
                                                </label>
                                                <button type="button" class="browser-side-bookmark-link"
                                                        @onmousedown="(e) => StartSidebarBookmarkDragAsync(e, bm.Id, folder.Id)">
                                                    <img class="browser-side-bookmark-icon" src="@BrowserFaviconUrl.Get(bm.Url, bm.IconUrl)" alt="" draggable="false"
                                                         onerror="this.dataset.step=(+this.dataset.step||0)+1;var s=+this.dataset.step;if(s===1)this.src='@BrowserFaviconUrl.GetDuckDuckGo(bm.Url)';else if(s===2)this.src='@BrowserFaviconUrl.GetSiteRootIco(bm.Url)';else if(s===3)this.src='@BrowserFaviconUrl.GetGoogle(bm.Url)';else{this.onerror=null;this.style.opacity='0.35';}" />
                                                    <span class="browser-side-bookmark-title">@BrowserPageMetadata.ResolveBookmarkTitle(bm.Title, bm.Url)</span>
                                                </button>
                                                <button type="button" class="browser-side-bookmark-action" title="Edit"
                                                        @onclick:stopPropagation="true" @onclick="() => EditSideBookmark(bm)">
                                                    <i class="bi bi-pencil"></i>
                                                </button>
                                                <button type="button" class="browser-side-bookmark-action browser-side-bookmark-action-danger" title="Delete"
                                                        @onclick:stopPropagation="true" @onclick="() => DeleteSideBookmark(bm.Id)">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </div>
                                        }
                                    </div>
                                }
                                @if (!BrowserStore.GetFolders().Any())
                                {
                                    <div class="browser-side-bookmarks-empty">No folders yet.</div>
                                }
                            </div>
                        </div>
                    }
                    else if (SidePanel.Content == BrowserSidePanelContent.Settings)
                    {
                        <div class="browser-side-settings">
                            <label class="browser-settings-label">Default search engine</label>
                            <select class="newnote-select" @bind="_settingsDraft.SearchEngine">
                                <option value="@BrowserSearchEngineKind.Brave">Brave</option>
                                <option value="@BrowserSearchEngineKind.DuckDuckGo">DuckDuckGo</option>
                                <option value="@BrowserSearchEngineKind.Bing">Bing</option>
                                <option value="@BrowserSearchEngineKind.Google">Google</option>
                                <option value="@BrowserSearchEngineKind.Custom">Custom URL</option>
                            </select>
                            @if (_settingsDraft.SearchEngine == BrowserSearchEngineKind.Custom)
                            {
                                <input class="newnote-input" style="margin-top:6px;" @bind="_settingsDraft.CustomSearchUrl"
                                       placeholder="https://example.com/search?q= or ...{query}" />
                            }

                            <label class="browser-settings-label">Homepage</label>
                            <select class="newnote-select" @bind="_settingsDraft.Homepage">
                                <option value="@BrowserHomepageKind.SearchEngine">Search engine</option>
                                <option value="@BrowserHomepageKind.Bookmarks">Bookmarks page</option>
                                <option value="@BrowserHomepageKind.CustomUrl">Custom URL</option>
                            </select>
                            @if (_settingsDraft.Homepage == BrowserHomepageKind.CustomUrl)
                            {
                                <input class="newnote-input" style="margin-top:6px;" @bind="_settingsDraft.CustomHomepageUrl" placeholder="https://..." />
                            }

                            <label class="browser-settings-label">New window behavior</label>
                            <select class="newnote-select" @bind="_settingsDraft.NewWindowBehavior">
                                <option value="@BrowserNewWindowBehavior.NewTab">Open in new tab</option>
                                <option value="@BrowserNewWindowBehavior.ExternalBrowser">Open in external browser</option>
                            </select>

                            <label class="browser-settings-row">
                                <input type="checkbox" @bind="_settingsDraft.AskBeforeDownloading" />
                                Ask before downloading
                            </label>
                            <label class="browser-settings-row">
                                <input type="checkbox" @bind="_settingsDraft.ClearCookiesOnExit" />
                                Clear cookies on exit
                            </label>
                            <label class="browser-settings-row">
                                <input type="checkbox" @bind="_settingsDraft.ClearCacheOnExit" />
                                Clear cache on exit
                            </label>
                            <label class="browser-settings-row">
                                <input type="checkbox" @bind="_settingsDraft.ClearHistoryOnExit" />
                                Clear history on exit
                            </label>
                            <label class="browser-settings-row">
                                <input type="checkbox" @bind="_settingsDraft.ShowBookmarksBar" />
                                Show bookmarks bar
                            </label>

                            <div style="margin-top:12px;display:flex;gap:8px;justify-content:flex-end;">
                                <button type="button" class="newnote-btn newnote-btn-primary" @onclick="SaveSettings">Save settings</button>
                            </div>
                        </div>
                    }
                    else if (SidePanel.Content == BrowserSidePanelContent.Web)
                    {
                        @if (_barMenuInsetPx > 0)
                        {
                            <div class="browser-bar-menu-spacer" style="height:@($"{_barMenuInsetPx:F0}px")"></div>
                        }
                        <div id="browser-side-content-host" class="browser-content browser-side-content-host"></div>
                    }
                </div>
            </div>
        }

        <div class="browser-vtoolbar" @onclick:stopPropagation="true">
            <button type="button"
                    class="browser-vtoolbar-btn @(SidePanel.IsOpen && SidePanel.Content == BrowserSidePanelContent.Bookmarks ? "active" : "")"
                    title="Bookmarks"
                    @onclick="ToggleBookmarksInSidePanel">
                <i class="bi bi-bookmarks"></i>
            </button>
            @foreach (var app in SidebarStore.GetPinnedApps())
            {
                <div class="sidebar-app-icon browser-vtoolbar-app @(SidePanel.ActiveAppId == app.Id ? "active" : "") @(app.IsPwa ? "is-pwa" : "") @(_vtoolbarDragOverAppId == app.Id ? "drag-over" : "")"
                     data-vtoolbar-app-id="@app.Id"
                     title="@(app.IsPwa ? $"{app.ShortName} (app)" : app.ShortName)"
                     @onmousedown="(e) => StartVtoolbarAppDragAsync(e, app.Id)"
                     @oncontextmenu:preventDefault="true"
                     @oncontextmenu:stopPropagation="true"
                     @oncontextmenu="(e) => ShowAppContextMenu(e, app)">
                    @if (!string.IsNullOrWhiteSpace(app.IconUrl))
                    {
                        <img class="browser-vtoolbar-icon" src="@app.IconUrl" alt="@app.ShortName" />
                    }
                    else
                    {
                        <i class="bi bi-globe2"></i>
                    }
                    <span class="sidebar-app-icon-label">@app.ShortName</span>
                </div>
            }
            <div class="browser-vtoolbar-spacer"></div>
            <button type="button"
                    class="browser-vtoolbar-btn browser-vtoolbar-add @(PwaDetector.CurrentManifest != null && !PwaDetector.IsCurrentPagePinned ? "pwa-available" : "")"
                    title="@(PwaDetector.CurrentManifest != null && !PwaDetector.IsCurrentPagePinned ? "Install app" : "Pin to side panel")"
                    @onclick="OpenPinDialog">
                @if (PwaDetector.CurrentManifest != null && !PwaDetector.IsCurrentPagePinned)
                {
                    <i class="bi bi-app-indicator"></i>
                }
                else
                {
                    <i class="bi bi-plus-lg"></i>
                }
            </button>
        </div>
    </div>

    @if (_contextMenuApp != null)
    {
        <div class="browser-context-scrim" @onclick="() => CloseAllContextMenus()">
            <div class="sidebar-context-menu browser-context-popover browser-context-popover--vtoolbar"
                 style="top:@($"{_menuAnchorTop:F0}px");"
                 @onclick:stopPropagation="true">
                @if (_contextMenuApp.IsPwa)
                {
                    <div class="browser-context-popover-badge">App</div>
                }
                <div class="sidebar-context-menu-item" @onclick="() => OpenInSidePanel(_contextMenuApp)">
                    <i class="bi bi-layout-sidebar-reverse"></i> Open in side panel
                </div>
                <div class="sidebar-context-menu-item" @onclick="() => OpenInMainBrowser(_contextMenuApp)">
                    <i class="bi bi-window"></i> Open in main browser
                </div>
                <hr class="sidebar-context-menu-divider" />
                <div class="sidebar-context-menu-item @(_contextMenuApp.DefaultOpenTarget == OpenTarget.SidePanel ? "default-selected" : "")"

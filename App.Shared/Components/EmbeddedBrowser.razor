    private string? _dragOverBookmarkId;
    private string? _dragOverTabId;
    private bool _tabHoverTooltipVisible;
    private double _tabHoverTooltipLeft;
    private double _tabHoverTooltipTop;
    private string _tabHoverTooltipTitle = "";
    private string _tabHoverTooltipUrl = "";
    private string? _tabHoverTabId;
    private string? _sidebarDragOverBookmarkId;
    private string? _sidebarDragOverFolderId;
    private readonly HashSet<string> _selectedBookmarkIds = new(StringComparer.Ordinal);
    private bool _showSideNewFolderInput;
    private string _sideNewFolderName = "";

    private BrowserSettings _settingsDraft = new();
    private double _sidePanelWidthPx = 320;
    private double _browserBodyWidth;

    private bool _showPinDialog;
    private string _pinName = "";

    private SidebarApp? _contextMenuApp;
    private bool _contextMenuOpenedSidePanel;
    private string? _vtoolbarDragOverAppId;

    private bool ShowBookmarksBar => BrowserStore.GetSettings().ShowBookmarksBar;

    private IReadOnlyList<BrowserBookmark> BookmarksBarItems =>
        ShowBookmarksBar
            ? BrowserStore.GetBookmarks(BrowserBookmarkFolders.BookmarksBarFolderId)
            : [];

    private string SidePanelTitle
    {
        get
        {
            if (_contextMenuApp != null && SidePanel.Content == BrowserSidePanelContent.None)
                return _contextMenuApp.ShortName;

            return SidePanel.Content switch
            {
                BrowserSidePanelContent.Bookmarks => "Bookmarks",
                BrowserSidePanelContent.Settings => "Browser Settings",
                BrowserSidePanelContent.Web => SidebarStore.GetPinnedApps()
                    .FirstOrDefault(a => a.Id == SidePanel.ActiveAppId)?.Name ?? "App",
                _ => ""
            };
        }
    }

    private bool ShouldHideMainWebViewOverlay =>
        _showStartPage || _showBookmarkDialog || _showPinDialog;

    private bool ShouldHideSideWebViewOverlay =>
        !SidePanel.IsOpen || SidePanel.Content != BrowserSidePanelContent.Web || _showPinDialog
        || _contextMenuApp != null;

    private int DropdownInsetPx =>
        _showBookmarkMenu || _showDownloadsMenu ? 300
        : (_showUrlSuggestions && _urlSuggestions.Count > 0) ? 230
        : 0;

    private Action<string>? _urlChangedHandler;
    private Action<string>? _titleChangedHandler;
    private Action<bool>? _loadingChangedHandler;
    private Action? _browserPanelChangedHandler;
    private Action? _browserStoreChangedHandler;
    private Action? _sidebarStoreChangedHandler;
    private Action? _sidePanelChangedHandler;
    private Action? _pwaChangedHandler;
    private Action? _tabsChangedHandler;
    private Action? _downloadsChangedHandler;

    protected override async Task OnInitializedAsync()
    {
        _dotNetRef = DotNetObjectReference.Create<object>(this);
        await BrowserStore.LoadAsync();
        await SidebarStore.LoadAsync();
        _sidePanelWidthPx = SidebarStore.GetSidePanelWidthPx();
        RegisterHandlers();
        RestoreBrowserUiState();

        _browserStoreChangedHandler = () => InvokeAsync(StateHasChanged);
        BrowserStore.Changed += _browserStoreChangedHandler;

        _sidebarStoreChangedHandler = () => InvokeAsync(StateHasChanged);
        SidebarStore.Changed += _sidebarStoreChangedHandler;

        _sidePanelChangedHandler = () => InvokeAsync(OnSidePanelChangedAsync);
        SidePanel.OnChanged += _sidePanelChangedHandler;

        _pwaChangedHandler = () => InvokeAsync(StateHasChanged);
        PwaDetector.Changed += _pwaChangedHandler;

        _tabsChangedHandler = () => InvokeAsync(OnTabsChangedAsync);
        TabManager.Changed += _tabsChangedHandler;

        _downloadsChangedHandler = () => InvokeAsync(StateHasChanged);
        Downloads.Changed += _downloadsChangedHandler;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_pendingOverlaySync)
        {
            _pendingOverlaySync = false;
            await SyncOverlayAsync();
        }

        if (_barMenuInsetPending)
        {
            _barMenuInsetPending = false;
            await MeasureBarMenuInsetAsync();
        }
    }

    private async Task MeasureBarMenuInsetAsync()
    {
        if (string.IsNullOrWhiteSpace(_barContextMenuBookmarkId) || _showStartPage)
            return;

        try
        {
            var inset = await JS.InvokeAsync<double?>(
                "appBrowser.measureBarMenuSpace",
                ".browser-bookmarks-bar-context-menu",
                "browser-body");
            if (inset is > 0)
            {
                _barMenuInsetPx = inset.Value + 8;
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Browser] bar menu inset measure failed: {ex.Message}");
        }
    }

    private void RegisterHandlers()
    {
        _urlChangedHandler = url =>
        {
            _browserUrl = url;
            _canGoBack = BrowserAgent.CanGoBack;
            _canGoForward = BrowserAgent.CanGoForward;
            SyncStartPageFromActiveTab();
            InvokeAsync(StateHasChanged);
        };
        _titleChangedHandler = title =>
        {
            _browserPageTitle = title;
            InvokeAsync(StateHasChanged);
        };
        _loadingChangedHandler = loading =>
        {
            _isLoading = loading;
            _canGoBack = BrowserAgent.CanGoBack;
            _canGoForward = BrowserAgent.CanGoForward;
            InvokeAsync(StateHasChanged);
        };
        BrowserAgent.UrlChanged += _urlChangedHandler;
        BrowserAgent.TitleChanged += _titleChangedHandler;
        BrowserAgent.LoadingChanged += _loadingChangedHandler;

        _browserPanelChangedHandler = () => InvokeAsync(OnPanelChangedAsync);
        BrowserPanel.OnChanged += _browserPanelChangedHandler;
    }

    private Task OnTabsChangedAsync()
    {
        var wasStartPage = _showStartPage;
        SyncStartPageFromActiveTab();
        RestoreBrowserUiState();
        ApplyOverlayVisibility();
        // Leaving the bookmarks start page (or switching tabs) needs a bounds remeasure.
        if (wasStartPage != _showStartPage || !_showStartPage)
            RefreshWebViewBounds();
        StateHasChanged();
        return Task.CompletedTask;
    }

    private void SyncStartPageFromActiveTab()
    {
        _showStartPage = TabManager.ActiveTab?.IsStartPage == true;
    }

    private async Task OpenNewTabAsync()
    {
        await TabManager.OpenTabAsync(url: null, activate: true);
        SyncStartPageFromActiveTab();
        RestoreBrowserUiState();
        _pendingOverlaySync = true;
        await SyncOverlayAsync();
    }

    private async Task ActivateTabAsync(string tabId)
    {
        await TabManager.ActivateTabAsync(tabId);
        SyncStartPageFromActiveTab();
        RestoreBrowserUiState();
        if (_showStartPage)
            BrowserOverlay.SetMainOverlayVisible(false);
        else
        {
            _pendingOverlaySync = true;
            await SyncOverlayAsync();
        }
        StateHasChanged();
    }

    private async Task CloseTabAsync(string tabId)
    {
        await TabManager.CloseTabAsync(tabId);
        SyncStartPageFromActiveTab();
        RestoreBrowserUiState();
        if (_showStartPage)
            BrowserOverlay.SetMainOverlayVisible(false);
        else
        {
            _pendingOverlaySync = true;
            await SyncOverlayAsync();
        }
        StateHasChanged();
    }

    private static string TruncateTabUrl(string? url, int maxLen = 72)
    {
        if (string.IsNullOrWhiteSpace(url))
            return "";
        var u = url.Trim();
        if (u.Length <= maxLen)
            return u;
        return u[..(maxLen - 1)] + "…";
    }

    private async Task OnTabMouseEnterAsync(string tabId, bool isActive)
    {
        if (isActive)
        {
            HideTabHoverTooltip();
            return;
        }

        var tab = TabManager.Tabs.FirstOrDefault(t => t.Id == tabId);
        if (tab == null)
        {
            HideTabHoverTooltip();
            return;
        }

        _tabHoverTabId = tabId;
        _tabHoverTooltipTitle = tab.DisplayTitle;
        _tabHoverTooltipUrl = TruncateTabUrl(tab.Url);

        try
        {
            var anchor = await JS.InvokeAsync<TabTooltipAnchor>(
                "appBrowser.getTabTooltipAnchor",
                tabId);
            if (anchor != null && !string.IsNullOrEmpty(_tabHoverTabId) && _tabHoverTabId == tabId)
            {
                _tabHoverTooltipLeft = Math.Max(8, anchor.X);
                _tabHoverTooltipTop = anchor.Y + 6;
                _tabHoverTooltipVisible = true;
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Browser] tab tooltip anchor failed: {ex.Message}");
            // Fallback near top of panel.
            _tabHoverTooltipLeft = 12;
            _tabHoverTooltipTop = 40;
            _tabHoverTooltipVisible = true;
            StateHasChanged();
        }
    }

    private void OnTabMouseLeave()
    {
        HideTabHoverTooltip();
    }

    private void HideTabHoverTooltip()
    {
        if (!_tabHoverTooltipVisible && _tabHoverTabId == null)
            return;
        _tabHoverTooltipVisible = false;
        _tabHoverTabId = null;
        StateHasChanged();
    }

    private sealed class TabTooltipAnchor
    {
        public double X { get; set; }
        public double Y { get; set; }
        public double Width { get; set; }
        public double Height { get; set; }
    }

    private async Task StartTabStripDragAsync(MouseEventArgs e, string tabId)
    {
        // Middle-click (button 1) closes the tab. Prefer mousedown over @onauxclick:
        // auxclick is not a built-in Blazor event; WebKit throws InvalidCharacterError
        // when the renderer tries to apply '@onauxclick' as a DOM attribute.
        if (e.Button == 1)
        {
            await CloseTabAsync(tabId);
            return;
        }

        if (_dotNetRef == null || e.Button != 0)
            return;

        HideTabHoverTooltip();

        try
        {
            await JS.InvokeVoidAsync(
                "appBrowser.startTabStripDrag",
                _dotNetRef,
                ".browser-tabstrip-tabs",
                tabId,
                e.ClientX,
                e.ClientY);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Browser] tab strip drag failed: {ex.Message}");
        }
    }

    [JSInvokable]
    public async Task OnTabStripClick(string tabId)
    {
        await ActivateTabAsync(tabId);
    }

    [JSInvokable]
    public void OnTabStripDragOver(string? overId)
    {
        _dragOverTabId = overId;
        _ = InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task OnTabStripDrop(string fromId, string targetId)
    {
        _dragOverTabId = null;

        if (string.IsNullOrWhiteSpace(fromId)
            || string.IsNullOrWhiteSpace(targetId)
            || fromId == targetId)
        {
            await InvokeAsync(StateHasChanged);
            return;
        }

        var tabs = TabManager.Tabs.ToList();
        var fromIndex = tabs.FindIndex(t => t.Id == fromId);
        var toIndex = tabs.FindIndex(t => t.Id == targetId);
        if (fromIndex < 0 || toIndex < 0)
        {
            await InvokeAsync(StateHasChanged);
            return;
        }

        var moved = tabs[fromIndex];
        tabs.RemoveAt(fromIndex);
        tabs.Insert(toIndex, moved);

        await TabManager.ReorderTabsAsync(tabs.Select(t => t.Id).ToList());
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnPanelChangedAsync()
    {
        if (BrowserPanel.IsOpen)
        {
            RestoreBrowserUiState();
            _pendingOverlaySync = true;
            BrowserOverlay.RestoreCachedOverlay();
            StateHasChanged();
        }
        else
        {
            await CloseOverlayAsync();
        }
    }

    private async Task SyncOverlayAsync()
    {
        if (_dotNetRef == null)
            return;

        await InitializeSplitWidthAsync();

        try
        {
            await JS.InvokeVoidAsync("appBrowser.startBoundsObserver", "#browser-content-host", "#browser-side-content-host", _dotNetRef);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Browser] bounds observer failed: {ex.Message}");
            return;
        }

        RestoreBrowserUiState();

        ApplyOverlayVisibility();

        if (string.IsNullOrWhiteSpace(BrowserAgent.CurrentUrl) && TabManager.ActiveTab?.IsStartPage != true
            && string.IsNullOrWhiteSpace(TabManager.ActiveTab?.Url))
        {
            var navigated = await BrowserAgent.NavigateHomeAsync();
            SyncStartPageFromActiveTab();
            if (!navigated)
            {
                _showStartPage = true;
                BrowserOverlay.SetMainOverlayVisible(false);
            }
            RestoreBrowserUiState();
        }
        else
        {
            SyncStartPageFromActiveTab();
            if (_showStartPage)
                BrowserOverlay.SetMainOverlayVisible(false);
        }
    }

    private async Task OnSidePanelChangedAsync()
    {
        _pendingOverlaySync = true;
        StateHasChanged();
        // Let flex layout apply the new side-column width before measuring hosts.
        await Task.Yield();
        await SyncOverlayAsync();
        await Task.Delay(50);
        try
        {
            await JS.InvokeVoidAsync(
                "appBrowser.reportBoundsNow",
                "#browser-content-host",
                "#browser-side-content-host");
        }
        catch
        {
            // Ignore if JS not ready.
        }
    }

    private void ApplyOverlayVisibility()
    {
        if (ShouldHideMainWebViewOverlay)
            BrowserOverlay.SetMainOverlayVisible(false);
        if (ShouldHideSideWebViewOverlay)
            BrowserOverlay.SetSideOverlayVisible(false);
    }

    private void RestoreBrowserUiState()
    {
        SyncStartPageFromActiveTab();
        if (!string.IsNullOrWhiteSpace(BrowserAgent.CurrentUrl))
            _browserUrl = BrowserAgent.CurrentUrl;
        else if (_showStartPage)
            _browserUrl = "";
        _browserPageTitle = BrowserAgent.PageTitle;
        _canGoBack = BrowserAgent.CanGoBack;
        _canGoForward = BrowserAgent.CanGoForward;
        _isLoading = BrowserAgent.IsLoading;
    }

    private void OnUrlInput(ChangeEventArgs e)
    {
        _showBookmarkMenu = false;
        _browserUrl = e.Value?.ToString() ?? "";
        _urlSuggestions = BrowserStore.SearchHistory(_browserUrl).ToList();
        _urlSuggestionIndex = _urlSuggestions.Count > 0 ? 0 : -1;
        _showUrlSuggestions = _urlSuggestions.Count > 0 && !string.IsNullOrWhiteSpace(_browserUrl);
        RefreshWebViewBounds();
    }

    private void OnUrlFocus()
    {
        _showBookmarkMenu = false;
        if (!string.IsNullOrWhiteSpace(_browserUrl))
        {
            _urlSuggestions = BrowserStore.SearchHistory(_browserUrl).ToList();
            _urlSuggestionIndex = _urlSuggestions.Count > 0 ? 0 : -1;
            _showUrlSuggestions = _urlSuggestions.Count > 0;
        }
        RefreshWebViewBounds();
    }

    private async Task OnUrlBlur()
    {
        if (_suppressUrlBlur)
            return;
        await Task.Delay(150);
        _showUrlSuggestions = false;
        RefreshWebViewBounds();
        StateHasChanged();
    }

    private async Task BrowserUrlKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Tab" && _showUrlSuggestions && _urlSuggestions.Count > 0)
        {
            var idx = _urlSuggestionIndex >= 0 ? _urlSuggestionIndex : 0;
            ApplySuggestion(_urlSuggestions[idx]);
            _showUrlSuggestions = false;
            return;
        }

        if (_showUrlSuggestions && _urlSuggestions.Count > 0)
        {
            if (e.Key == "ArrowDown")
            {
                _urlSuggestionIndex = Math.Min(_urlSuggestionIndex + 1, _urlSuggestions.Count - 1);
                return;
            }
            if (e.Key == "ArrowUp")
            {
                _urlSuggestionIndex = Math.Max(_urlSuggestionIndex - 1, 0);
                return;
            }
            if (e.Key == "Escape")
            {
                _showUrlSuggestions = false;
                RefreshWebViewBounds();
                return;
            }
        }

        if (e.Key == "Enter")
            await BrowserNavigate();
    }

    private void ApplySuggestion(BrowserHistoryEntry entry)
    {
        _browserUrl = entry.Url;
        _browserPageTitle = entry.Title;
    }

    private async Task SelectSuggestion(BrowserHistoryEntry entry)
    {
        _suppressUrlBlur = true;
        ApplySuggestion(entry);
        _showUrlSuggestions = false;
        await BrowserNavigate();
        _suppressUrlBlur = false;
    }

    private async Task BrowserNavigate()
    {
        _showUrlSuggestions = false;
        _showStartPage = false;
        await BrowserAgent.NavigateAsync(_browserUrl);
        SyncStartPageFromActiveTab();
        _browserUrl = BrowserAgent.CurrentUrl;
        _canGoBack = BrowserAgent.CanGoBack;
        _canGoForward = BrowserAgent.CanGoForward;
        _pendingOverlaySync = true;
        await SyncOverlayAsync();
    }

    private async Task GoHomeAsync()
    {
        _showUrlSuggestions = false;
        _showBookmarkMenu = false;

        var navigated = await BrowserAgent.NavigateHomeAsync();
        SyncStartPageFromActiveTab();
        if (!navigated || _showStartPage)
        {
            _showStartPage = true;
            _browserUrl = "";
            _browserPageTitle = "";
            BrowserOverlay.SetMainOverlayVisible(false);
        }
        else
        {
            _showStartPage = false;
            RestoreBrowserUiState();
            _pendingOverlaySync = true;
            await SyncOverlayAsync();
        }
    }

    private void ToggleBookmarkMenu()
    {
        _showBookmarkMenu = !_showBookmarkMenu;
        if (_showBookmarkMenu)
        {
            _showUrlSuggestions = false;
            _showDownloadsMenu = false;
        }
        RefreshWebViewBounds();
    }

    private void ToggleDownloadsMenu()
    {
        _showDownloadsMenu = !_showDownloadsMenu;
        if (_showDownloadsMenu)
        {
            _showBookmarkMenu = false;
            _showUrlSuggestions = false;
        }
        RefreshWebViewBounds();
    }

    private async Task OpenDownloadAsync(string id)
    {
        await Downloads.OpenAsync(id);
    }

    private async Task ShowDownloadInFolderAsync(string id)
    {
        await Downloads.ShowInFolderAsync(id);
    }

    private async Task DeleteDownloadAsync(string id)
    {
        await Downloads.DeleteAsync(id);
    }

    private void ClearCompletedDownloads()
    {
        Downloads.ClearCompleted();
    }

    private static string DownloadStateIcon(BrowserDownloadState state) => state switch
    {
        BrowserDownloadState.InProgress => "bi-arrow-down-circle spin",
        BrowserDownloadState.Completed => "bi-check-circle",
        BrowserDownloadState.Failed => "bi-exclamation-circle",
        BrowserDownloadState.Cancelled => "bi-x-circle",
        _ => "bi-download"
    };

    private static string DownloadStatusText(BrowserDownloadItem dl) => dl.State switch
    {
        BrowserDownloadState.InProgress when dl.ProgressFraction is double f =>
            $"{FormatBytes(dl.BytesReceived)} / {(dl.TotalBytes is long t ? FormatBytes(t) : "?")} ({f * 100:F0}%)",
        BrowserDownloadState.InProgress =>
            dl.BytesReceived > 0 ? $"Downloading… {FormatBytes(dl.BytesReceived)}" : "Downloading…",
        BrowserDownloadState.Completed => "Completed",
        BrowserDownloadState.Failed => string.IsNullOrWhiteSpace(dl.ErrorMessage) ? "Failed" : $"Failed: {dl.ErrorMessage}",
        BrowserDownloadState.Cancelled => "Cancelled",
        _ => ""
    };

    private static string FormatBytes(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        double v = bytes;
        string[] units = ["KB", "MB", "GB", "TB"];
        var u = -1;
        do { v /= 1024; u++; } while (v >= 1024 && u < units.Length - 1);
        return $"{v:0.##} {units[u]}";
    }


@if (_showBookmarkDialog)
{
    <div class="newnote-overlay" @onclick="CloseBookmarkDialog">
        <div class="newnote-modal browser-bookmark-modal" @onclick:stopPropagation>
            <h4 style="margin:0 0 12px 0;font-size:1.1rem;color:var(--color-text);">@(_bookmarkIsEditMode ? "Edit Bookmark" : "Add Bookmark")</h4>
            <label class="browser-settings-label">Name</label>
            <input class="newnote-input" @bind="_bookmarkTitle" placeholder="Bookmark name..." />
            <label class="browser-settings-label">URL</label>
            <input class="newnote-input" @bind="_bookmarkUrl" placeholder="https://..." />
            <label class="browser-settings-label">Folder</label>
            <select class="newnote-select" @bind="_bookmarkFolderId">
                @foreach (var folder in BrowserStore.GetFolders())
                {
                    <option value="@folder.Id">@folder.Name</option>
                }
            </select>
            <div style="margin-top:8px;">
                <input class="newnote-input" @bind="_newFolderName" placeholder="Or create new folder..." />
                @if (!string.IsNullOrWhiteSpace(_newFolderName))
                {
                    <button type="button" class="newnote-btn newnote-btn-secondary" style="margin-top:6px;" @onclick="CreateFolderForBookmark">Create folder</button>
                }
            </div>
            <div style="margin-top:12px;display:flex;gap:8px;justify-content:flex-end;">
                @if (_bookmarkIsEditMode)
                {
                    <button type="button" class="newnote-btn newnote-btn-secondary" style="margin-right:auto;color:var(--color-danger,#c0392b);" @onclick="DeleteBookmark">Delete</button>
                }
                <button type="button" class="newnote-btn newnote-btn-secondary" @onclick="CloseBookmarkDialog">Cancel</button>
                <button type="button" class="newnote-btn newnote-btn-primary" @onclick="SaveBookmark">Save</button>
            </div>
        </div>
    </div>
}

@if (_showPinDialog)
{
    <div class="newnote-overlay" @onclick="ClosePinDialog">
        <div class="newnote-modal browser-bookmark-modal" @onclick:stopPropagation>
            @if (PwaDetector.CurrentManifest != null)
            {
                <h4 style="margin:0 0 12px 0;font-size:1.1rem;color:var(--color-text);">Install App</h4>
                <div class="browser-pwa-install-hint">
                    <i class="bi bi-app-indicator"></i>
                    This site has a PWA manifest — install it as an app or pin the page only.
                </div>
                @if (!string.IsNullOrWhiteSpace(PwaManifestHelper.PickBestIcon(PwaDetector.CurrentManifest)))
                {
                    <div class="browser-pwa-preview">
                        <img src="@PwaManifestHelper.PickBestIcon(PwaDetector.CurrentManifest)" alt="" />
                        <span>@(PwaDetector.CurrentManifest.ShortName ?? PwaDetector.CurrentManifest.Name ?? "App")</span>
                    </div>
                }
            }
            else
            {
                <h4 style="margin:0 0 12px 0;font-size:1.1rem;color:var(--color-text);">Pin to Side Panel</h4>
                <p class="browser-pin-hint">Pin this page to the vertical toolbar for quick access.</p>
            }
            <label class="browser-settings-label">Name</label>
            <input class="newnote-input" @bind="_pinName" placeholder="Name..." />
            <div style="margin-top:12px;display:flex;gap:8px;justify-content:flex-end;flex-wrap:wrap;">
                <button type="button" class="newnote-btn newnote-btn-secondary" @onclick="ClosePinDialog">Cancel</button>
                @if (PwaDetector.CurrentManifest != null)
                {
                    <button type="button" class="newnote-btn newnote-btn-secondary" @onclick="PinCurrentPage">Pin page only</button>
                    <button type="button" class="newnote-btn newnote-btn-primary" @onclick="PinCurrentAsPwa">Install app</button>
                }
                else
                {
                    <button type="button" class="newnote-btn newnote-btn-primary" @onclick="PinCurrentPage">Pin page</button>
                }
            </div>
        </div>
    </div>
}

@code {

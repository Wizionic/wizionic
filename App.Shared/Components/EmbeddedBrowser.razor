    private async Task SaveBookmark()
    {
        var url = (_bookmarkUrl ?? "").Trim();
        if (string.IsNullOrWhiteSpace(url))
            return;

        if (_bookmarkIsEditMode)
        {
            if (string.IsNullOrWhiteSpace(_editingBookmarkId))
                return;

            var existing = BrowserStore.GetBookmarks().FirstOrDefault(b => b.Id == _editingBookmarkId);
            if (existing == null)
                return;

            // Editing must not touch the icon — it is captured once, when the bookmark is created.
            var updated = existing with
            {
                Title = _bookmarkTitle?.Trim() ?? "",
                Url = url,
                FolderId = _bookmarkFolderId
            };
            await BrowserStore.UpdateBookmarkAsync(updated);
            SyncService.ScheduleAutoSyncBookmarkAfterLocalSave(updated.Id);
        }
        else
        {
            var iconUrl = await CapturePageFaviconAsync(url)
                          ?? BrowserFaviconUrl.GetCached(url);
            var added = await BrowserStore.AddBookmarkAsync(url, _bookmarkTitle, _bookmarkFolderId, iconUrl);
            SyncService.ScheduleAutoSyncBookmarkAfterLocalSave(added.Id);
        }

        CloseBookmarkDialog();
    }


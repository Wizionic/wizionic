    private async Task OpenInMainBrowser(SidebarApp app)
    {
        CloseAllContextMenus();
        await OpenSidebarAppAsync(app, OpenTarget.MainBrowser);
    }

    private async Task SetDefaultTarget(SidebarApp app, OpenTarget target)
    {
        var updated = app with { DefaultOpenTarget = target };
        await SidebarStore.UpdateAppAsync(updated);
        SyncService.ScheduleAutoSyncSidebarAppAfterLocalSave(updated.Id);
        _contextMenuApp = updated;
        StateHasChanged();
    }

    private async Task UnpinApp(SidebarApp app)
    {
        CloseAllContextMenus();
        if (SidePanel.ActiveAppId == app.Id)
            CloseSidePanel();

        await SidebarStore.UnpinAppAsync(app.Id);
        SyncService.ScheduleAutoSyncSidebarAppDeleteAfterLocalDelete(app.Id, DateTime.UtcNow);
    }

    private async Task StartSidePanelSplitterDrag()
    {
        if (_dotNetRef == null)
            return;

        try
        {
            await JS.InvokeVoidAsync("appBrowser.startSidePanelSplitterDrag", _dotNetRef, "#browser-body");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Browser] side panel splitter failed: {ex.Message}");
        }
    }

    [JSInvokable]
    public async Task OnSidePanelDrag(double widthPx)
    {
        _sidePanelWidthPx = Math.Clamp(widthPx, 240, 560);
        await SidebarStore.SetSidePanelWidthPxAsync(_sidePanelWidthPx);
        RefreshWebViewBounds();
        await InvokeAsync(StateHasChanged);
    }

    private void RestoreWebViewOverlayIfNeeded()
    {
        try
        {
            _ = JS.InvokeVoidAsync("appBrowser.reportBoundsNow", "#browser-content-host", "#browser-side-content-host");
        }
        catch
        {
            BrowserOverlay.RestoreCachedOverlay();
        }
    }

    private async Task OnSplitterMouseEnter()
    {
        try { await JS.InvokeVoidAsync("appBrowser.setResizeCursor", true); } catch { }
    }

    private async Task OnSplitterMouseLeave()
    {
        try { await JS.InvokeVoidAsync("appBrowser.setResizeCursor", false); } catch { }
    }

    private async Task InitializeSplitWidthAsync()
    {
        try
        {
            _splitWrapperWidth = await JS.InvokeAsync<double>("appBrowser.getWrapperWidth", "#chat-split-wrapper");
        }
        catch
        {
            _splitWrapperWidth = 0;
        }

        if (BrowserPanel.ChatPaneWidthPx <= 0 && _splitWrapperWidth > 0)
        {
            var defaultWidth = Math.Clamp(_splitWrapperWidth * 0.32, 280, _splitWrapperWidth * 0.55);
            BrowserPanel.ChatPaneWidthPx = defaultWidth;
        }
    }

    private async Task StartSplitterDrag()
    {
        if (_dotNetRef == null)
            return;

        try
        {
            _splitWrapperWidth = await JS.InvokeAsync<double>("appBrowser.getWrapperWidth", "#chat-split-wrapper");
            await JS.InvokeVoidAsync("appBrowser.startSplitterDrag", _dotNetRef, "#chat-split-wrapper");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Browser] splitter drag failed: {ex.Message}");
        }
    }

    [JSInvokable]
    public void OnSplitterDrag(double x)
    {
        var max = _splitWrapperWidth > 0 ? _splitWrapperWidth * 0.6 : 900;
        BrowserPanel.ChatPaneWidthPx = Math.Clamp(x, 280, max);
        _ = InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public void OnBrowserMainOverlayBounds(double x, double y, double width, double height)
    {
        if (ShouldHideMainWebViewOverlay)
        {
            BrowserOverlay.SetMainOverlayVisible(false);
            return;
        }

        var inset = DropdownInsetPx;
        if (inset > 0 && height > inset + 80)
        {
            y += inset;
            height -= inset;
        }

        BrowserOverlay.ReportMainBounds(x, y, width, height);
    }

    [JSInvokable]
    public void OnBrowserSideOverlayBounds(double x, double y, double width, double height)
    {
        if (ShouldHideSideWebViewOverlay || width <= 1 || height <= 1)
        {
            BrowserOverlay.SetSideOverlayVisible(false);
            return;
        }

        BrowserOverlay.ReportSideBounds(x, y, width, height);
    }

    private void RefreshWebViewBounds() => RestoreWebViewOverlayIfNeeded();

    private async Task CloseOverlayAsync()
    {
        try { await JS.InvokeVoidAsync("appBrowser.stopBoundsObserver"); } catch { }
        try { await JS.InvokeVoidAsync("appBrowser.setResizeCursor", false); } catch { }
        BrowserOverlay.SetMainOverlayVisible(false);
        BrowserOverlay.SetSideOverlayVisible(false);
    }

    public void Dispose()
    {
        if (_urlChangedHandler != null)
            BrowserAgent.UrlChanged -= _urlChangedHandler;
        if (_titleChangedHandler != null)
            BrowserAgent.TitleChanged -= _titleChangedHandler;
        if (_loadingChangedHandler != null)
            BrowserAgent.LoadingChanged -= _loadingChangedHandler;
        if (_browserPanelChangedHandler != null)
            BrowserPanel.OnChanged -= _browserPanelChangedHandler;
        if (_browserStoreChangedHandler != null)
            BrowserStore.Changed -= _browserStoreChangedHandler;
        if (_sidebarStoreChangedHandler != null)
            SidebarStore.Changed -= _sidebarStoreChangedHandler;
        if (_sidePanelChangedHandler != null)
            SidePanel.OnChanged -= _sidePanelChangedHandler;
        if (_pwaChangedHandler != null)
            PwaDetector.Changed -= _pwaChangedHandler;
        if (_tabsChangedHandler != null)
            TabManager.Changed -= _tabsChangedHandler;
        if (_downloadsChangedHandler != null)
            Downloads.Changed -= _downloadsChangedHandler;

        try { _ = JS.InvokeVoidAsync("appBrowser.stopBoundsObserver"); } catch { }
        BrowserOverlay.SetMainOverlayVisible(false);
        BrowserOverlay.SetSideOverlayVisible(false);
        _dotNetRef?.Dispose();
    }
}
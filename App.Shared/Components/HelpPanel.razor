@using App.Core.Help
@inject IHelpOverlay Overlay
@implements IDisposable

@if (Overlay.IsOpen)
{
    <div class="help-overlay" role="dialog" aria-modal="true" aria-label="Help">
        <div class="help-overlay-backdrop" @onclick="Overlay.Close"></div>
        <div class="help-overlay-panel">
            <div class="help-overlay-header">
                <h2>Help</h2>
                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="Overlay.Close">Close</button>
            </div>
            <HelpView TopicId="@Overlay.TopicId" TopicIdChanged="OnTopicChanged" />
        </div>
    </div>
}

@code {
    private Action? _handler;

    protected override void OnInitialized()
    {
        _handler = () => InvokeAsync(StateHasChanged);
        Overlay.Changed += _handler;
    }

    private void OnTopicChanged(string id) => Overlay.Open(id);

    public void Dispose()
    {
        if (_handler != null)
            Overlay.Changed -= _handler;
    }
}

        moveTargetNotebooks.Clear();
        StateHasChanged();
    }

    private async Task ConfirmMoveEntry(string targetNoteId)
    {
        openMoveNotebookDialog = false;
        StateHasChanged();

        // Block moves into a locked notebook that has not been unlocked this session.
        var target = notes.FirstOrDefault(n => n.Id == targetNoteId);
        if (target?.IsPasswordProtected == true && !unlockedNoteIds.Contains(targetNoteId))
        {
            OpenUnlockDialog(targetNoteId, thenLoad: false);
            return;
        }

        await CommitActiveEditAsync(persistToStore: true);

        var sourceEntries = await NoteStore.LoadNoteAsync(moveSourceNoteId);
        if (moveSourceEntryIndex < 0 || moveSourceEntryIndex >= sourceEntries.Count) return;

        var msg = sourceEntries[moveSourceEntryIndex] with
        {
            ItemId = Guid.NewGuid().ToString("N"),
            ModifiedAt = DateTime.UtcNow
        };

        // Remove from source
        sourceEntries.RemoveAt(moveSourceEntryIndex);
        await NoteStore.SaveNoteAsync(moveSourceNoteId, sourceEntries);

        // Add to target
        var targetEntries = await NoteStore.LoadNoteAsync(targetNoteId);
        targetEntries.Add(msg);
        await NoteStore.SaveNoteAsync(targetNoteId, targetEntries);

        // Update indexes for both
        notes = await NoteStore.LoadIndexAsync();
        SyncBridge.ScheduleAutoSyncNoteAfterLocalSave(moveSourceNoteId, notes.FirstOrDefault(n => n.Id == moveSourceNoteId)?.Title ?? "");
        SyncBridge.ScheduleAutoSyncNoteAfterLocalSave(targetNoteId, notes.FirstOrDefault(n => n.Id == targetNoteId)?.Title ?? "");

        // Reload current view
        await LoadNote(activeNoteId!);
        StateHasChanged();
    }

    private async Task DeleteNoteEntry(int index)
    {
        if (index < 0 || index >= currentNoteMessages.Count)
            return;

        if (editingMessageIndex == index)
            CancelEdit();
        else
            await CommitActiveEditAsync(persistToStore: true);

        currentNoteMessages[index] = ChatMessageHelper.SoftDelete(currentNoteMessages[index]);
        await SaveCurrent();
        StateHasChanged();
    }


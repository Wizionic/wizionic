        {
            var pos = await JS.InvokeAsync<PopupPosition>("getMenuPopupPosition", $"entry-menu-btn-{index}");
            // Use the raw position from JS — no extra offsets. The JS function already
            // handles overflow (positions left if no room on the right edge).
            entryPopupStyle = $"position: fixed; top: {pos.top:F0}px; left: {pos.left:F0}px; z-index: 15000;";
            StateHasChanged();

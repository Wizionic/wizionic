    private async Task ToggleNotesMicAsync()
    {
        if (isNotesMicRecording)
        {
            await StopNotesMicAsync(cancelOnly: false);
            return;
        }

        if (editingMessageIndex is null)
            return;

        notesMicStatus = null;
        notesMicStatusIsError = false;
        _lastSttTranscript = null;
        _notesMicCues.Clear();
        _archiveBuffer.Clear();
        _notesMicClipId = Guid.NewGuid().ToString("N");
        _notesMicStartedUtc = DateTime.UtcNow;

        var archive = NoteAudio.IsSupported;
        if (archive)
        {
            try
            {
                if (!await Quota.CanAcceptBytesAsync(20_000_000))
                {
                    notesMicStatus = "Storage is nearly full. Dictation will still run; lecture audio may not be saved.";
                    notesMicStatusIsError = false;
                }
            }
            catch { /* quota is best-effort */ }
        }

        _reorderDotNetRef ??= DotNetObjectReference.Create(this);
        try
        {
            var start = await JS.InvokeAsync<MicStartResult>("appMicRollingStart", _reorderDotNetRef, new
            {
                windowMs = 25000,
                overlapMs = 2000,
                archive
            });
            if (start is not { Ok: true })
            {
                notesMicStatusIsError = true;
                notesMicStatus = start?.Error ?? "Could not start microphone.";
                if (notesMicStatus.Contains("Permission", StringComparison.OrdinalIgnoreCase)
                    || notesMicStatus.Contains("NotAllowed", StringComparison.OrdinalIgnoreCase)
                    || notesMicStatus.Contains("denied", StringComparison.OrdinalIgnoreCase))
                {
                    notesMicStatus = "Microphone permission denied. Allow mic access for this app/site and try again.";
                }
                return;
            }

            isNotesMicRecording = true;
            var hint = Speech.NotesSttModelHint;
            notesMicStatus = "Listening…" + (hint is null ? "" : $" · {hint}")
                + (archive ? " · recording audio" : "");
        }
        catch (Exception ex)
        {
            notesMicStatusIsError = true;
            notesMicStatus = "Microphone error: " + ex.Message;
            isNotesMicRecording = false;
            try { await JS.InvokeVoidAsync("appMicRollingCancel"); } catch { }
        }
    }

    private async Task StopNotesMicAsync(bool cancelOnly)
    {
        if (!isNotesMicRecording && _archiveBuffer.Count == 0)
            return;

        isNotesMicRecording = false;
        isNotesMicTranscribing = true;
        notesMicStatus = cancelOnly ? "Stopping…" : "Finishing transcription…";
        notesMicStatusIsError = false;
        await InvokeAsync(StateHasChanged);

        try
        {
            if (cancelOnly)
            {
                try { await JS.InvokeVoidAsync("appMicRollingCancel"); } catch { }
            }
            else
            {
                try { await JS.InvokeAsync<MicStartResult>("appMicRollingStop"); }
                catch { try { await JS.InvokeVoidAsync("appMicRollingCancel"); } catch { } }
            }
        }
        finally
        {
            try
            {
                await _sttGate.WaitAsync();
                _sttGate.Release();
            }
            catch { /* disposed */ }
            isNotesMicTranscribing = false;
            if (!notesMicStatusIsError)
            {
                var elapsed = DateTime.UtcNow - _notesMicStartedUtc;
                notesMicStatus = elapsed.TotalSeconds < 1
                    ? null
                    : $"Dictation stopped ({FormatElapsed(elapsed)}).";
            }
            await InvokeAsync(StateHasChanged);
        }
    }

    [JSInvokable]
    public Task OnNotesMicChunk(string base64, int durationMs, int startMs, bool newParagraph) =>
        InvokeAsync(() => HandleNotesMicChunkAsync(base64, durationMs, startMs, newParagraph));

    private async Task HandleNotesMicChunkAsync(string base64, int durationMs, int startMs, bool newParagraph)
    {
        if (string.IsNullOrWhiteSpace(base64) || durationMs < 250)
            return;

        byte[] wav;
        try { wav = Convert.FromBase64String(base64); }
        catch { return; }

        isNotesMicTranscribing = true;
        notesMicStatus = "Transcribing…";
        notesMicStatusIsError = false;
        StateHasChanged();

        await _sttGate.WaitAsync();
        try
        {
            var result = await Speech.TranscribeAsync(wav, Speech.ResolveNotesSttModelId(), "notes-chunk.wav");
            if (!result.Success || string.IsNullOrWhiteSpace(result.Text))
            {
                notesMicStatusIsError = true;
                notesMicStatus = result.Error ?? "Transcription failed.";
                return;
            }

            var incoming = TranscriptOverlap.NormalizeForInsert(result.Text);
            var text = TranscriptOverlap.NormalizeForInsert(
                TranscriptOverlap.Dedup(_lastSttTranscript, incoming));
            _lastSttTranscript = incoming;
            if (string.IsNullOrWhiteSpace(text))
                return;

            var startSec = Math.Max(0, startMs / 1000.0);
            _notesMicCues.Add(new NoteAudioCue(startSec, text));

            if (quillEditor is not null)
            {
                try
                {
                    await quillEditor.InsertSttSeg(text, startSec, _notesMicClipId, newParagraph);
                }
                catch
                {
                    try
                    {
                        if (newParagraph)
                            await quillEditor.InsertText("\n\n");
                        await quillEditor.InsertText(text + " ");
                    }
                    catch { /* editor may be mid-dispose */ }
                }
            }

            var hint = result.Model ?? Speech.NotesSttModelHint;
            var elapsed = DateTime.UtcNow - _notesMicStartedUtc;
            notesMicStatus = isNotesMicRecording
                ? $"Listening… {FormatElapsed(elapsed)}" + (hint is null ? "" : $" · {hint}")
                : $"Transcribed with {hint ?? "STT"}.";
            notesMicStatusIsError = false;
        }
        catch (Exception ex)
        {
            notesMicStatusIsError = true;
            notesMicStatus = "Speech-to-text error: " + ex.Message;
        }
        finally
        {
            isNotesMicTranscribing = false;
            _sttGate.Release();
            StateHasChanged();
        }
    }

    [JSInvokable]
    public Task OnNotesMicArchiveChunk(string base64, int index, bool isLast, string mime, int durationMs, int totalBytes) =>
        InvokeAsync(() => HandleArchiveChunkAsync(base64, index, isLast, mime, durationMs, totalBytes));

    private async Task HandleArchiveChunkAsync(string base64, int index, bool isLast, string mime, int durationMs, int totalBytes)
    {
        if (!NoteAudio.IsSupported)
            return;

        try
        {
            if (!string.IsNullOrEmpty(base64))
            {
                var part = Convert.FromBase64String(base64);
                _archiveBuffer.AddRange(part);
            }
        }
        catch
        {
            notesMicStatusIsError = true;
            notesMicStatus = "Could not decode recorded audio.";
            return;
        }

        if (!isLast)
            return;

        if (_archiveBuffer.Count == 0 || string.IsNullOrEmpty(activeNoteId) || editingMessageIndex is not int idx)
        {
            _archiveBuffer.Clear();
            return;
        }

        if (idx < 0 || idx >= currentNoteMessages.Count)
        {
            _archiveBuffer.Clear();
            return;
        }

        try
        {
            var bytes = _archiveBuffer.ToArray();
            _archiveBuffer.Clear();
            var clipId = _notesMicClipId ?? Guid.NewGuid().ToString("N");
            var entryId = currentNoteMessages[idx].ItemId ?? "";
            var saved = await NoteAudio.SaveAsync(
                activeNoteId,
                entryId,
                clipId,
                string.IsNullOrWhiteSpace(mime) ? "audio/webm" : mime,
                bytes,
                durationMs,
                _notesMicCues.ToList());

            var msg = currentNoteMessages[idx];
            var clips = msg.AudioClips?.ToList() ?? new List<NoteAudioRef>();
            clips.Add(saved);
            currentNoteMessages[idx] = msg with { AudioClips = clips, ModifiedAt = DateTime.UtcNow };
            await ApplyDraftToEditingMessageAsync();
            await SaveCurrent();
            localAudioIds.Add(clipId);
            await EnsureAudioUrlAsync(clipId);
            notesMicStatus = $"Saved {FormatElapsed(TimeSpan.FromMilliseconds(durationMs))} of audio on this device.";
            notesMicStatusIsError = false;
        }
        catch (Exception ex)
        {
            notesMicStatusIsError = true;
            notesMicStatus = "Could not save lecture audio: " + ex.Message;
        }
        finally
        {
            _archiveBuffer.Clear();
            StateHasChanged();
        }
    }

    private async Task RefreshLocalAudioAsync()
    {
        foreach (var url in audioUrls.Values)
        {
            try { await NoteAudio.RevokeDisplayUrlAsync(url); } catch { }
        }
        audioUrls.Clear();
        localAudioIds.Clear();
        if (!NoteAudio.IsSupported)
            return;

        foreach (var msg in currentNoteMessages)
        {
            if (msg.AudioClips is not { Count: > 0 })
                continue;
            foreach (var clip in msg.AudioClips)
            {
                try
                {
                    if (await NoteAudio.ExistsAsync(clip.Id))
                    {
                        localAudioIds.Add(clip.Id);
                        await EnsureAudioUrlAsync(clip.Id);
                    }
                }
                catch { /* skip missing clips */ }
            }
        }
    }

    private string? AudioUrlFor(string clipId) =>
        audioUrls.TryGetValue(clipId, out var url) ? url : null;

    private void PromptDeleteAudio(int entryIndex, string clipId)
    {
        pendingDeleteNoteId = null;
        pendingDeleteEntryIndex = null;
        pendingDeleteAudioEntryIndex = entryIndex;
        pendingDeleteAudioClipId = clipId;
        deleteConfirmTitle = "Delete recording?";
        deleteConfirmMessage = "The transcript stays in the note. Only the audio file on this device is removed.";
        showDeleteConfirm = true;
    }

    private async Task DeleteAudioClipAsync(int entryIndex, string clipId)
    {
        if (entryIndex < 0 || entryIndex >= currentNoteMessages.Count)
            return;

        await RemoveAudioBlobAsync(clipId);
        var msg = currentNoteMessages[entryIndex];
        var remaining = msg.AudioClips?.Where(c => !string.Equals(c.Id, clipId, StringComparison.OrdinalIgnoreCase)).ToList();
        currentNoteMessages[entryIndex] = msg with
        {
            AudioClips = remaining is { Count: > 0 } ? remaining : null,
            ModifiedAt = DateTime.UtcNow
        };
        await SaveCurrent();
        try { await Quota.CompactAsync(); } catch { }
        StateHasChanged();
    }

    private async Task RemoveAudioBlobAsync(string clipId)
    {
        if (string.IsNullOrEmpty(clipId))
            return;
        if (audioUrls.TryGetValue(clipId, out var url))
        {
            try { await NoteAudio.RevokeDisplayUrlAsync(url); } catch { }
            audioUrls.Remove(clipId);
        }
        localAudioIds.Remove(clipId);
        try { await NoteAudio.DeleteAsync(clipId); } catch { }
    }

    private async Task PlayAudioFromCursorAsync(string clipId)
    {
        if (quillEditor is null)
            return;
        try
        {
            var cue = await quillEditor.GetSttCueAtCursor();
            if (cue is null)
                return;
            var id = string.IsNullOrEmpty(cue.Value.Audio) ? clipId : cue.Value.Audio;
            await JS.InvokeVoidAsync("appNotesAudioSeekClip", chatContainer, id, cue.Value.T);
        }
        catch { /* player may not be ready */ }
    }

    private async Task EnsureAudioUrlAsync(string clipId)
    {
        if (audioUrls.ContainsKey(clipId))
            return;
        var url = await NoteAudio.CreateDisplayUrlAsync(clipId);
        if (!string.IsNullOrEmpty(url))
            audioUrls[clipId] = url;
    }

    private async Task OnNotesSearchInput()
    {
        var gen = Interlocked.Increment(ref _searchGen);
        var q = notesSearchQuery;
        if (string.IsNullOrWhiteSpace(q))
        {
            notesSearchHits = new();
            notesSearchRan = false;
            notesSearchBusy = false;
            return;
        }

        notesSearchBusy = true;
        await Task.Delay(280);
        if (gen != _searchGen)
            return;

        try
        {
            var hits = await NotesSearch.SearchAsync(q, 12, unlockedNoteIds);
            if (gen != _searchGen)
                return;
            notesSearchHits = hits.ToList();
            notesSearchRan = true;
        }
        catch
        {
            if (gen != _searchGen)
                return;
            notesSearchHits = new();
            notesSearchRan = true;
        }
        finally
        {
            if (gen == _searchGen)
                notesSearchBusy = false;
        }
    }

    private async Task OpenSearchHit(NotesSearchHit hit)
    {
        if (string.IsNullOrEmpty(hit.NotebookId))
            return;
        await CommitActiveEditAsync(persistToStore: true);
        await LoadNote(hit.NotebookId);
        if (!string.IsNullOrEmpty(hit.EntryId))
        {
            var idx = currentNoteMessages.FindIndex(m =>
                string.Equals(m.ItemId, hit.EntryId, StringComparison.OrdinalIgnoreCase));
            if (idx >= 0)
                await StartEdit(idx);
        }
    }

    private async Task AskMyNotesAsync()
    {
        var q = (notesAskText ?? "").Trim();
        if (q.Length == 0)
            return;
        notesAskBusy = true;
        notesAskError = null;
        notesAskAnswer = null;
        try
        {
            var result = await NotesSearch.AskAsync(q, unlockedNoteIds);
            if (!string.IsNullOrEmpty(result.Error))
                notesAskError = result.Error;
            else
                notesAskAnswer = result.AnswerMarkdown;
            if (result.Citations.Count > 0)
            {
                notesSearchHits = result.Citations.ToList();
                notesSearchRan = true;
            }
        }
        catch (Exception ex)
        {
            notesAskError = ex.Message;
        }
        finally
        {
            notesAskBusy = false;
        }
    }

    private static string FormatElapsed(TimeSpan elapsed)
    {
        if (elapsed.TotalHours >= 1)
            return elapsed.ToString(@"h\:mm\:ss");
        return elapsed.ToString(@"m\:ss");
    }

    private sealed class MicStartResult
    {
        [System.Text.Json.Serialization.JsonPropertyName("ok")]
        public bool Ok { get; set; }
        [System.Text.Json.Serialization.JsonPropertyName("error")]
        public string? Error { get; set; }
        [System.Text.Json.Serialization.JsonPropertyName("already")]
        public bool Already { get; set; }
        [System.Text.Json.Serialization.JsonPropertyName("archive")]
        public bool Archive { get; set; }
    }
}

    private void CancelPendingDelete()
    {
        showDeleteConfirm = false;
        pendingDeleteNoteId = null;
        pendingDeleteEntryIndex = null;
        pendingDeleteAudioClipId = null;
        pendingDeleteAudioEntryIndex = null;
    }

    private async Task ConfirmPendingDelete()
    {
        if (!string.IsNullOrEmpty(pendingDeleteAudioClipId) && pendingDeleteAudioEntryIndex is int audioIdx)
            await DeleteAudioClipAsync(audioIdx, pendingDeleteAudioClipId);
        else if (!string.IsNullOrEmpty(pendingDeleteNoteId))
            await DeleteNote(pendingDeleteNoteId);
        else if (pendingDeleteEntryIndex is int index)
            await DeleteNoteEntry(index);

        CancelPendingDelete();
    }

    private async Task MoveNoteEntryUp(int index)
    {
        if (index <= 0 || index >= currentNoteMessages.Count) return;

        await CommitActiveEditAsync(persistToStore: true);

        var item = currentNoteMessages[index];
        currentNoteMessages.RemoveAt(index);
        currentNoteMessages.Insert(index - 1, item);
        
        await SaveCurrent();
        StateHasChanged();
    }

    private async Task MoveNoteEntryDown(int index)
    {
        if (index < 0 || index >= currentNoteMessages.Count - 1) return;

        await CommitActiveEditAsync(persistToStore: true);

        var item = currentNoteMessages[index];
        currentNoteMessages.RemoveAt(index);
        currentNoteMessages.Insert(index + 1, item);

        await SaveCurrent();
        StateHasChanged();
    }


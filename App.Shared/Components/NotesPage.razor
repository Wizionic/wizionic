@implements IAsyncDisposable
@using App.Core.Auth
@using App.Core.Speech
@using App.Core.Storage
@using App.Core.UI
@using App.Shared.Services
@using Microsoft.AspNetCore.Components.Routing
@using System.Text
@using System.Net

@inject IJSRuntime JS
@inject NavigationManager Nav
@inject INoteStore NoteStore
@inject IAuthService AuthService
@inject INotesSyncBridge SyncBridge
@inject ISidebarState SidebarState
@inject INotesChatHandoff NotesChatHandoff
@inject IChatPanelState ChatPanel
@inject ISpeechTranscriptionService Speech
@inject INoteAudioStore NoteAudio
@inject INotesSearchService NotesSearch
@inject IStorageQuotaService Quota
@inject IKeyStore KeyStore

<WasmSidebarSync />

<div class="page @(SidebarState.IsCollapsed ? "sidebar-collapsed" : "")">
    <div class="sidebar">
        <nav class="cf-nav cf-column">
            <div class="cf-item notes-search-wrap">
                <label class="notes-search-label help-heading" for="notes-search">Search <HelpGlyph Topic="notes" /></label>
                <input id="notes-search"
                       type="search"
                       class="form-control form-control-sm"
                       placeholder="Find in notes"
                       @bind="notesSearchQuery"
                       @bind:event="oninput"
                       @bind:after="OnNotesSearchInput"
                       @onclick:stopPropagation="true" />
                @if (notesSearchBusy)
                {
                    <div class="notes-search-status">Searching…</div>
                }
                else if (notesSearchHits.Count > 0)
                {
                    <div class="notes-search-results">
                        @foreach (var hit in notesSearchHits)
                        {
                            var h = hit;
                            <button type="button"
                                    class="notes-search-hit"
                                    @onclick="() => OpenSearchHit(h)"
                                    @onclick:stopPropagation="true">
                                <span class="notes-search-hit-title">@h.NotebookTitle</span>
                                <span class="notes-search-hit-snippet">@h.Snippet</span>
                            </button>
                        }
                    </div>
                }
                else if (!string.IsNullOrWhiteSpace(notesSearchQuery) && notesSearchRan)
                {
                    <div class="notes-search-status">No matching notes.</div>
                }
                @if (!string.IsNullOrWhiteSpace(KeyStore.LastSelectedModel))
                {
                    <textarea class="form-control form-control-sm notes-ask-input"
                              rows="2"
                              placeholder="Ask my notes…"
                              @bind="notesAskText"
                              @onclick:stopPropagation="true"></textarea>
                    <button type="button"
                            class="btn btn-outline-secondary btn-sm"
                            disabled="@notesAskBusy"
                            @onclick="AskMyNotesAsync"
                            @onclick:stopPropagation="true">
                        @(notesAskBusy ? "Asking…" : "Ask")
                    </button>
                    @if (!string.IsNullOrEmpty(notesAskError))
                    {
                        <div class="notes-search-status" style="color:var(--cf-error-fg);">@notesAskError</div>
                    }
                    else if (!string.IsNullOrEmpty(notesAskAnswer))
                    {
                        <div class="notes-ask-answer">@notesAskAnswer</div>
                    }
                }
            </div>
            <div class="cf-item">
                <span class="cf-link small">
                   <h4 class="help-heading">Notebooks <HelpGlyph Topic="notes" /></h4>
                    <div class="menu" @onclick:stopPropagation>
                        <button id="notebooks-menu-btn" class="menu-button" @onclick:stopPropagation @onclick="() => ToggleExportAllMenu()" title="Notebook options">⋮</button>
                    </div>
                    <button class="menu-button" @onclick="OpenCreateNoteDialog" title="New notebook">
                        <i class="cf-icon bi bi-plus-circle" style="font-size: 30px;"></i>
                    </button>
                </span>
            </div>

            @foreach (var n in notes.OrderBy(x => x.SortOrder).ThenByDescending(x => x.LastUpdated))
            {
                var isActive = activeNoteId == n.Id;
                <div class="conversation-item @(isActive ? "active" : "") @(_dragNoteId == n.Id ? "note-dragging" : "") @(_dragOverNoteId == n.Id ? "note-drag-over" : "")"
                     data-reorder-id="@n.Id"
                     @onpointerdown="e => OnNotePointerDown(e, n.Id)"
                     @onpointerdown:preventDefault="false">
                    <div class="row-top">
                        <div class="title">
                            @if (n.IsPasswordProtected)
                            {
                                <i class="cf-icon bi bi-lock-fill" style="font-size:0.85em; margin-right:4px; opacity:0.85;" title="Password protected"></i>
                            }
                            @n.Title
                        </div>
                        <div class="menu" @onclick:stopPropagation @onpointerdown:stopPropagation>
                            <button id="menu-btn-@n.Id" class="menu-button" @onclick:stopPropagation @onclick="() => ToggleMenu(n.Id)">⋮</button>
                        </div>
                    </div>
                    <div class="date">@n.LastUpdated.ToLocalTime().ToString("MMM d")</div>
                </div>
            }
            @if (!notes.Any())
            {
                <div class="cf-item" style="font-size:0.75em; color:var(--cf-text-muted); padding-left:12px;">No notes yet.</div>
            }
        </nav>
    </div>

    <main @onclick="OnNotesChromeClick">
        <div class="chat-wrapper" style="flex: 1; display: flex; flex-direction: column;">
            @if (IsActiveNoteLocked)
            {
                <div style="flex:1; display:flex; align-items:center; justify-content:center; padding:2rem; text-align:center;">
                    <div style="max-width:360px;">
                        <i class="cf-icon bi bi-lock-fill" style="font-size:2.5rem; color:var(--cf-text-muted); opacity:0.8;"></i>
                        <h3 style="margin:0.75rem 0 0.35rem 0; font-size:1.15rem; color:var(--color-text);">Notebook locked</h3>
                        <p style="margin:0; font-size:0.9rem; color:var(--cf-text-muted);">
                            Enter your account password to view this notebook.
                        </p>
                        <button type="button" class="newnote-btn newnote-btn-primary" style="margin-top:1rem;" @onclick="() => OpenUnlockDialog(activeNoteId!)">
                            Unlock
                        </button>
                    </div>
                </div>
            }
            else
            {
                <div class="chat-container" @ref="chatContainer">
                    @for (var i = 0; i < currentNoteMessages.Count; i++)
                    {
                        var msg = currentNoteMessages[i];
                        var capturedIndex = i;
                        var isEditing = editingMessageIndex == capturedIndex;

                        @if (msg.DeletedAt is null)
                        {
                            <div class="message-row" style="margin-bottom: 32px; display: flex; justify-content:  flex-start;">
                                    <div class="note-entry-wrap @(isEditing ? "note-editing" : "")" @onclick:stopPropagation="true">
                                    <div class="note-response-actions" @onclick:stopPropagation="true">
                                        @if (isEditing)
                                        {
                                            <button type="button" class="menu-button note-action-btn" @onclick="() => SaveEdit(capturedIndex)" title="Save">
                                                <i class="cf-icon bi bi-check-lg"></i>
                                            </button>
                                            <button type="button" class="menu-button note-action-btn" @onclick="CancelEditAsync" title="Cancel">
                                                <i class="cf-icon bi bi-x-lg"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button" class="menu-button note-action-btn" @onclick="async () => await StartEdit(capturedIndex)" title="Edit">
                                                <i class="cf-icon bi bi-pencil"></i>
                                            </button>
                                             @if (capturedIndex > 0)
                                             {
                                                 <button type="button" class="menu-button note-action-btn" @onclick="() => MoveNoteEntryUp(capturedIndex)" title="Move up">
                                                     <i class="cf-icon bi bi-arrow-up"></i>
                                                 </button>
                                             }
                                             @if (capturedIndex < currentNoteMessages.Count - 1)
                                             {
                                                 <button type="button" class="menu-button note-action-btn" @onclick="() => MoveNoteEntryDown(capturedIndex)" title="Move down">
                                                     <i class="cf-icon bi bi-arrow-down"></i>
                                                 </button>
                                             }
                                            <div class="menu" @onclick:stopPropagation style="position:relative;">
                                                @if (openEntryMenuIndex == capturedIndex)
                                                {
                                                    <div class="menu-popup" style="@entryPopupStyle" @onclick:stopPropagation>
                                                        <div @onclick="() => { CloseEntryMenu(); PromptDeleteNoteEntry(capturedIndex); }">
                                                            <button type="button" class="menu-button"><i class="cf-icon bi bi-trash3-fill"></i></button>
                                                            Delete note entry
                                                        </div>
                                                        <div @onclick="() => OpenMoveNotebookDialog(capturedIndex)">
                                                            <button type="button" class="menu-button"><i class="cf-icon bi bi-arrow-right-square"></i></button>
                                                            Move note entry
                                                        </div>
                                                    </div>
                                                    <div class="menu-overlay" @onclick="CloseEntryMenu"></div>
                                                }
                                                @if (openMoveNotebookDialog)
                                                {
                                                    <div class="newnote-overlay" @onclick:stopPropagation>
                                                        <div class="newnote-modal move-notebook-modal" @onclick:stopPropagation>
                                                            <h4 style="margin:0 0 12px 0;font-size:1.1rem;color:var(--color-text);">Move Note to Notebook</h4>
                                                            @if (moveTargetNotebooks.Count == 0)
                                                            {
                                                                <p style="font-size:0.85rem;color:var(--cf-text-muted);margin:12px 0 0 0;">No other notebooks available.</p>
                                                            }
                                                            else
                                                            {
                                                                @foreach (var target in moveTargetNotebooks)
                                                                {
                                                                    var t = target;
                                                                    <div class="move-notebook-item" @onclick="() => ConfirmMoveEntry(t.Id)" @onclick:stopPropagation>
                                                                        <i class="cf-icon bi bi-journal" style="font-size:1.1em;color:var(--cf-text-muted);margin-right:8px;"></i>
                                                                        <span>@t.Title</span>
                                                                    </div>
                                                                }
                                                            }
                                                            <div style="margin-top:16px;display:flex;gap:8px;justify-content:flex-end;">
                                                                <button type="button" class="newnote-btn newnote-btn-secondary" @onclick="CloseMoveNotebookDialog">Cancel</button>
                                                            </div>
                                                        </div>
                                                    </div>
                                                }
                                                <button type="button" id="@($"entry-menu-btn-{capturedIndex}")" class="menu-button note-action-btn" style="background:none;border:none;padding:4px;cursor:pointer;" @onclick="() => ToggleEntryMenu(capturedIndex)" title="More options">
                                                    <i class="cf-icon bi bi-three-dots-vertical"></i>
                                                </button>
                                            </div>
                                        }
                                    </div>
                                    <div class="message-bot @(isEditing ? "note-editing" : "")"
                                         @onclick="() => OnNoteBodyClick(capturedIndex)"
                                         @onclick:stopPropagation="true">
                                        @if (isEditing)
                                        {
                                            <QuillEditor @ref="quillEditor"
                                                         @key="@($"note-edit-{activeNoteId}-{capturedIndex}-{editSessionKey}")"
                                                         InitialHtml="@editingInitialHtml"
                                                         HtmlChanged="OnEditHtmlChanged">
                                                <ToolbarContent>
                                                    <select class="ql-header">
                                                        <option selected=""></option>
                                                        <option value="1"></option>
                                                        <option value="2"></option>
                                                        <option value="3"></option>
                                                    </select>
                                                    <span class="ql-formats">
                                                        <button type="button" class="ql-bold"></button>
                                                        <button type="button" class="ql-italic"></button>
                                                        <button type="button" class="ql-underline"></button>
                                                        <button type="button" class="ql-strike"></button>
                                                    </span>
                                                    <span class="ql-formats">
                                                        <select class="ql-color"></select>
                                                        <select class="ql-background"></select>
                                                    </span>
                                                    <span class="ql-formats">
                                                        <button type="button" class="ql-list" value="ordered"></button>
                                                        <button type="button" class="ql-list" value="bullet"></button>
                                                    </span>
                                                    <span class="ql-formats">
                                                        <button type="button" class="ql-link"></button>
                                                        <button type="button" class="ql-image"></button>
                                                    </span>
                                                    <span class="ql-formats">
                                                        <button type="button" class="note-ai-toolbar-btn" title="Edit with AI"
                                                                @onclick="OpenCurrentNoteInChat"
                                                                @onclick:stopPropagation="true">
                                                            <i class="bi bi-stars"></i>
                                                        </button>
                                                        @if (Speech.IsNotesSttAvailable)
                                                        {
                                                            <button type="button"
                                                                    class="note-ai-toolbar-btn @(isNotesMicRecording ? "mic-recording" : "")"
                                                                    title="@(isNotesMicRecording ? "Stop dictation" : "Dictate / record lecture")"
                                                                    disabled="@isNotesMicTranscribing"
                                                                    @onclick="ToggleNotesMicAsync"
                                                                    @onclick:stopPropagation="true"
                                                                    style="@(isNotesMicRecording ? "color:#e11d48;" : null)">
                                                                @if (isNotesMicTranscribing && !isNotesMicRecording)
                                                                {
                                                                    <i class="bi bi-hourglass-split"></i>
                                                                }
                                                                else if (isNotesMicRecording)
                                                                {
                                                                    <i class="bi bi-stop-circle-fill"></i>
                                                                }
                                                                else
                                                                {
                                                                    <i class="bi bi-mic"></i>
                                                                }
                                                            </button>
                                                        }
                                                    </span>
                                                </ToolbarContent>
                                            </QuillEditor>
                                            @if (!string.IsNullOrEmpty(notesMicStatus))
                                            {
                                                <div class="notes-mic-status @(notesMicStatusIsError ? "is-error" : "")">@notesMicStatus</div>
                                            }
                                        }
                                        else if (NoteContentFormatter.IsHtml(msg.ContentFormat))
                                        {
                                            <div class="ql-snow note-quill-display">
                                                <div class="ql-editor">
                                                    @((MarkupString)msg.Content)
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="chat-markdown note-entry-body">
                                                @((MarkupString)NoteContentFormatter.ToDisplayHtml(msg.Content, msg.ContentFormat))
                                            </div>
                                        }

                                        @if (!IsUserNoteEntry(msg) && !string.IsNullOrWhiteSpace(msg.ModelUsed))
                                        {
                                            <div class="model-label" style="font-size:0.6em;color:var(--cf-text-muted);text-align:right;margin-top:2px;opacity:0.7">
                                                via @msg.ModelUsed
                                            </div>
                                        }
                                        @if (msg.AudioClips is { Count: > 0 })
                                        {
                                            <div class="note-audio-list" @onclick:stopPropagation="true">
                                                @foreach (var clip in msg.AudioClips)
                                                {
                                                    var c = clip;
                                                    @if (localAudioIds.Contains(c.Id))
                                                    {
                                                        <NoteAudioPlayer Clip="c"
                                                                         Url="@AudioUrlFor(c.Id)"
                                                                         Cues="c.Cues"
                                                                         CanDelete="true"
                                                                         CanPlayFromCursor="isEditing"
                                                                         OnDelete="() => PromptDeleteAudio(capturedIndex, c.Id)"
                                                                         OnPlayFromCursor="() => PlayAudioFromCursorAsync(c.Id)" />
                                                    }
                                                }
                                            </div>
                                        }
                                        @if (msg.Timestamp.HasValue)
                                        {
                                            <div style="font-size:0.6em;color:var(--cf-text-muted);text-align:right;margin-top:2px;opacity:0.7">
                                                @(msg.Timestamp.Value.ToLocalTime().ToString("MMM d, HH:mm"))
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                        

                    }
                </div>
            }
        </div>
    </main>

    @if (!string.IsNullOrEmpty(activeNoteId) && nameDialogMode == NoteNameDialogMode.None && !IsActiveNoteLocked)
    {
        <button type="button"
                class="menu-button notes-fab"
                title="Add note entry"
                @onclick="AddEntryToCurrentNote">
            <i class="cf-icon bi bi-plus-circle"></i>
        </button>
    }
    @if (openMenuId != null)
    {
        <div class="menu-popup" style="@activePopupStyle" @onclick:stopPropagation>
            <div @onclick="async () => { await AddNoteEntry(openMenuId); }">
                <button type="button" class="menu-button"><i class="cf-icon bi bi-plus-lg"></i></button>
                Add
            </div>
            <div @onclick="() => OpenRenameDialog(openMenuId)">
                <button type="button" class="menu-button"><i class="cf-icon bi bi-pencil-square"></i></button>
                Rename
            </div>
            <div @onclick="() => ExportNotebook(openMenuId)">
                <button type="button" class="menu-button"><i class="cf-icon bi bi-file-earmark-arrow-down"></i></button>
                Export
            </div>
            @if (AuthService.IsAuthenticated && AuthService.HasPassword)
            {
                var menuNote = notes.FirstOrDefault(n => n.Id == openMenuId);
                @if (menuNote?.IsPasswordProtected == true)
                {
                    <div @onclick="() => RemoveNotebookProtection(openMenuId)">
                        <button type="button" class="menu-button"><i class="cf-icon bi bi-unlock"></i></button>
                        Remove password protection
                    </div>
                }
                else
                {
                    <div @onclick="() => ProtectNotebook(openMenuId)">
                        <button type="button" class="menu-button"><i class="cf-icon bi bi-lock-fill"></i></button>
                        Protect with password
                    </div>
                }
            }
            <div @onclick="() => PromptDeleteNote(openMenuId)">
                <button type="button" class="menu-button"><i class="cf-icon bi bi-trash3-fill"></i></button>
                Delete Notebook
            </div>
        </div>
        <div class="menu-overlay" @onclick="CloseMenu"></div>
    }

    @if (openExportAllMenuId != null)
    {
        <div class="menu-popup" style="@exportAllPopupStyle" @onclick:stopPropagation>
            <div @onclick="() => ExportAllNotebooks()">
                <button type="button" class="menu-button"><i class="cf-icon bi bi-file-earmark-arrow-down"></i></button>
                Export all
            </div>
        </div>
        <div class="menu-overlay" @onclick="CloseExportAllMenu"></div>
    }

    <ConfirmDialog IsVisible="showDeleteConfirm"
                   Title="@deleteConfirmTitle"
                   Message="@deleteConfirmMessage"
                   OnConfirm="ConfirmPendingDelete"
                   OnCancel="CancelPendingDelete" />

    @if (nameDialogMode != NoteNameDialogMode.None)
    {
        <div class="newnote-overlay" @onclick="CancelNameDialog">
            <div class="newnote-modal" @onclick:stopPropagation>
                <h4 style="margin:0 0 12px 0;font-size:1.1rem;color:var(--color-text);">
                    @(nameDialogMode == NoteNameDialogMode.Create ? "New Notebook" : "Rename Note")
                </h4>
                @if (nameDialogMode == NoteNameDialogMode.Create)
                {
                    <p style="font-size:0.85rem;color:var(--cf-text-muted);margin:0 0 12px 0;">Enter a name for your notebook. A first note entry will be added automatically.</p>
                }
                <input type="text"
                       @bind="nameDialogTitle"
                       @bind:event="oninput"
                       placeholder="Notebook name..."
                       class="newnote-input"
                       @onkeydown="NameDialogKeyHandler" />
                <div style="margin-top:12px;display:flex;gap:8px;justify-content:flex-end;">
                    <button type="button" class="newnote-btn newnote-btn-secondary" @onclick="CancelNameDialog">Cancel</button>
                    <button type="button" class="newnote-btn newnote-btn-primary" @onclick="ConfirmNameDialog" disabled="@(string.IsNullOrWhiteSpace(nameDialogTitle))">
                        @(nameDialogMode == NoteNameDialogMode.Create ? "Create" : "Save")
                    </button>
                </div>
            </div>
        </div>
    }

    @if (showUnlockDialog)
    {
        <div class="newnote-overlay" @onclick="CancelUnlockDialog">
            <div class="newnote-modal" @onclick:stopPropagation>
                <h4 style="margin:0 0 12px 0;font-size:1.1rem;color:var(--color-text);">
                    <i class="cf-icon bi bi-lock-fill" style="margin-right:6px;"></i>
                    @(pendingRemoveProtectionNoteId != null ? "Remove password protection" : "Unlock notebook")
                </h4>
                <p style="font-size:0.85rem;color:var(--cf-text-muted);margin:0 0 12px 0;">
                    @(pendingRemoveProtectionNoteId != null
                        ? "Enter your account password to remove protection from this notebook."
                        : "Enter your account password to open this notebook.")
                </p>
                @if (!string.IsNullOrEmpty(unlockError))
                {
                    <div style="color: var(--cf-error-fg); margin: 0 0 0.5rem; font-size:0.9em;">@unlockError</div>
                }
                <input type="password"
                       @bind="unlockPassword"
                       @bind:event="oninput"
                       placeholder="Password"
                       class="newnote-input"
                       autocomplete="current-password"
                       @onkeydown="UnlockDialogKeyHandler" />
                <div style="margin-top:12px;display:flex;gap:8px;justify-content:flex-end;">
                    <button type="button" class="newnote-btn newnote-btn-secondary" @onclick="CancelUnlockDialog" disabled="@unlockBusy">Cancel</button>
                    <button type="button" class="newnote-btn newnote-btn-primary" @onclick="ConfirmUnlockDialog" disabled="@(unlockBusy || string.IsNullOrWhiteSpace(unlockPassword))">
                        @(pendingRemoveProtectionNoteId != null ? "Remove protection" : "Unlock")
                    </button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<LocalNote> notes = new();
    private string? activeNoteId;
    private List<ChatMessage> currentNoteMessages = new();
    private string? openMenuId;
    private string? openExportAllMenuId;
    private string activePopupStyle = "";
    private string exportAllPopupStyle = "";
    private ElementReference chatContainer;

    private int? editingMessageIndex;
    private string editingInitialHtml = "";
    private string _editBaselineHtml = "";
    private string? _activeEditDraftHtml;
    private bool _editBaselineCaptured;
    private bool _editDirty;
    private int editSessionKey;
    private QuillEditor? quillEditor;

    private bool isNotesMicRecording;
    private bool isNotesMicTranscribing;
    private string? notesMicStatus;
    private bool notesMicStatusIsError;
    private DateTime _notesMicStartedUtc;
    private string? _notesMicClipId;
    private string? _lastSttTranscript;
    private readonly List<NoteAudioCue> _notesMicCues = new();
    private readonly List<byte> _archiveBuffer = new();
    private readonly SemaphoreSlim _sttGate = new(1, 1);
    private readonly HashSet<string> localAudioIds = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, string> audioUrls = new(StringComparer.OrdinalIgnoreCase);

    private string notesSearchQuery = "";
    private bool notesSearchBusy;
    private bool notesSearchRan;
    private List<NotesSearchHit> notesSearchHits = new();
    private int _searchGen;
    private string notesAskText = "";
    private bool notesAskBusy;
    private string? notesAskAnswer;
    private string? notesAskError;

    private enum NoteNameDialogMode { None, Create, Rename }

    private NoteNameDialogMode nameDialogMode = NoteNameDialogMode.None;
    private string? nameDialogNoteId;
    private string nameDialogTitle = "";

    private bool showDeleteConfirm;
    private string deleteConfirmTitle = "";
    private string deleteConfirmMessage = "";
    private string? pendingDeleteNoteId;
    private int? pendingDeleteEntryIndex;
    private string? pendingDeleteAudioClipId;
    private int? pendingDeleteAudioEntryIndex;

    private int? openEntryMenuIndex;
    private string entryPopupStyle = "";
    private bool openMoveNotebookDialog;
    private string moveSourceNoteId = "";
    private int moveSourceEntryIndex = -1;
    private List<LocalNote> moveTargetNotebooks = new();

    /// <summary>
    /// Notebook IDs unlocked for this page session only. Leaving a notebook and returning
    /// re-prompts for the account password when the notebook is protected.
    /// </summary>
    private readonly HashSet<string> unlockedNoteIds = new(StringComparer.OrdinalIgnoreCase);

    private string? _dragNoteId;
    private string? _dragOverNoteId;
    private bool _noteDragMoved;
    private DotNetObjectReference<NotesPage>? _reorderDotNetRef;

    private bool showUnlockDialog;
    private string? unlockTargetNoteId;
    private string unlockPassword = "";
    private string? unlockError;
    private bool unlockBusy;
    private bool unlockThenLoad;
    /// <summary>When set, successful password verify removes protection instead of only unlocking.</summary>
    private string? pendingRemoveProtectionNoteId;

    private bool IsActiveNoteLocked =>
        !string.IsNullOrEmpty(activeNoteId)
        && notes.FirstOrDefault(n => n.Id == activeNoteId)?.IsPasswordProtected == true
        && !unlockedNoteIds.Contains(activeNoteId);

    private class PopupPosition
    {
        public double top { get; set; }
        public double left { get; set; }
    }
    private Action? _sidebarStateChangedHandler;
    private Action? _notesSyncChangedHandler;

    protected override async Task OnInitializedAsync()
    {
        await AuthService.LoadAsync();

        notes = await NoteStore.LoadIndexAsync();

        if (notes.Any())
        {
            try
            {
                await UiStorageNamespace.ApplyAsync(JS, AuthService);
                var lastId = await JS.InvokeAsync<string>("appNotesUi.getLastNotebookId");
                if (!string.IsNullOrEmpty(lastId) && notes.Any(n => n.Id == lastId))
                    activeNoteId = lastId;
            }
            catch
            {
                // JS interop may be unavailable during a rare prerender.
            }

            activeNoteId ??= notes.OrderByDescending(n => n.LastUpdated).First().Id;
            await LoadNote(activeNoteId);
        }

        _sidebarStateChangedHandler = () => InvokeAsync(StateHasChanged);
        SidebarState.OnChanged += _sidebarStateChangedHandler;

        _notesSyncChangedHandler = () => _ = RefreshNotesFromSyncAsync();
        SyncBridge.OnNotesChanged += _notesSyncChangedHandler;

        // Autosave when navigating away. Use LocationChanged only — do not catch
        // MissingMethodException (that type can be stripped under WASM trim and crash OnInitialized).
        Nav.LocationChanged += OnLocationChanged;
    }

    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        try
        {
            await CommitActiveEditAsync(persistToStore: true);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Notes] Failed to autosave after navigation: {ex.Message}");
        }
    }

    private async Task RefreshNotesFromSyncAsync()
    {
        notes = await NoteStore.LoadIndexAsync();

        if (string.IsNullOrEmpty(activeNoteId) || !notes.Any(n => n.Id == activeNoteId) || IsActiveNoteLocked)
        {
            await InvokeAsync(StateHasChanged);
            return;
        }

        var fromStore = await NoteStore.LoadNoteAsync(activeNoteId);

        // Open editor can be ahead of the store. Fold a *dirty* draft into memory, then
        // per-entry merge so remote sync never silently drops unsaved typing. Click-to-edit
        // without a real HTML change must not stamp ModifiedAt or it wins LWW over real edits.
        var hasOpenEdit = editingMessageIndex is int openIdx
            && openIdx >= 0
            && openIdx < currentNoteMessages.Count;

        if (hasOpenEdit)
        {
            var idx = editingMessageIndex!.Value;
            var editingItemId = currentNoteMessages[idx].ItemId;

            string? html = _activeEditDraftHtml;
            if (html is null && quillEditor is not null)
            {
                try { html = await quillEditor.GetHTML(); }
                catch { /* editor may be mid-dispose */ }
            }

            var draftDirty = _editDirty && html is not null && !NoteHtmlEquals(html, currentNoteMessages[idx].Content);

            if (draftDirty)
            {
                var persistHtml = IsBlankQuillHtml(html) ? "" : html!;
                currentNoteMessages[idx] = ChatMessageHelper.TouchModified(
                    currentNoteMessages[idx],
                    content: persistHtml,
                    contentFormat: NoteContentFormatter.FormatHtml);
                _activeEditDraftHtml = persistHtml;
            }

            if (!draftDirty)
            {
                currentNoteMessages = fromStore;
            }
            else
            {
                var merge = NoteSyncMerger.Merge(currentNoteMessages, fromStore);
                currentNoteMessages = merge.Entries;

                // Persist only when the dirty draft still has content the store lacks.
                if (merge.DiffersFromRemote)
                {
                    try
                    {
                        var note = notes.FirstOrDefault(n => n.Id == activeNoteId);
                        var title = note?.Title ?? "Untitled";
                        await NoteStore.SaveNoteAsync(activeNoteId, currentNoteMessages);
                        await NoteStore.UpdateIndexAfterSaveAsync(activeNoteId, title, currentNoteMessages);
                        notes = await NoteStore.LoadIndexAsync();
                        SyncBridge.ScheduleAutoSyncNoteAfterLocalSave(activeNoteId, title);
                    }
                    catch (Exception ex)
                    {
                        Console.WriteLine($"[Notes] Failed to persist merged note after sync: {ex.Message}");
                    }
                }
            }

            if (!string.IsNullOrEmpty(editingItemId))
            {
                var newIdx = currentNoteMessages.FindIndex(m =>
                    string.Equals(m.ItemId, editingItemId, StringComparison.OrdinalIgnoreCase)
                    && m.DeletedAt is null);

                if (newIdx >= 0)
                {
                    editingMessageIndex = newIdx;
                    var msg = currentNoteMessages[newIdx];
                    editingInitialHtml = NoteContentFormatter.ToEditorHtml(msg.Content, msg.ContentFormat);
                    _editBaselineHtml = editingInitialHtml;
                    _activeEditDraftHtml = editingInitialHtml;
                    _editBaselineCaptured = false;
                    _editDirty = draftDirty;
                    editSessionKey++; // remount Quill on merged HTML
                }
                else
                {
                    CancelEdit();
                }
            }
        }
        else
        {
            currentNoteMessages = fromStore;
        }

        await InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try { await JS.InvokeVoidAsync("appNotesAudioBindSeek", chatContainer); }
        catch { /* notes audio seek helper may be missing */ }

        if (!firstRender)
            return;

        _reorderDotNetRef ??= DotNetObjectReference.Create(this);
        try
        {
            await JS.InvokeVoidAsync("appNotesUi.bindSaveHotkey", _reorderDotNetRef);
        }
        catch { /* notes UI module may be missing during static render */ }

        if (!AppEnvironment.IsMaui)
            return;

        try
        {
            if (SidebarState.IsCollapsed)
            {
                await SidebarState.SetCollapsedAsync(false, JS);
                StateHasChanged();
            }
        }
        catch { /* sidebar init may be unavailable during static render */ }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await StopNotesMicAsync(cancelOnly: false);
        }
        catch { /* ignore */ }

        try
        {
            await CommitActiveEditAsync(persistToStore: true);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Notes] Failed to autosave on dispose: {ex.Message}");
        }

        Nav.LocationChanged -= OnLocationChanged;

        try
        {
            await JS.InvokeVoidAsync("appNotesUi.unbindSaveHotkey");
        }
        catch { /* page may already be torn down */ }

        if (_sidebarStateChangedHandler != null)
            SidebarState.OnChanged -= _sidebarStateChangedHandler;

        if (_notesSyncChangedHandler != null)
            SyncBridge.OnNotesChanged -= _notesSyncChangedHandler;

        foreach (var url in audioUrls.Values)
        {
            try { await NoteAudio.RevokeDisplayUrlAsync(url); } catch { }
        }
        audioUrls.Clear();

        _reorderDotNetRef?.Dispose();
        _reorderDotNetRef = null;
        _sttGate.Dispose();
    }

    private void CancelEdit()
    {
        editingMessageIndex = null;
        editingInitialHtml = "";
        _editBaselineHtml = "";
        _activeEditDraftHtml = null;
        _editBaselineCaptured = false;
        _editDirty = false;
        quillEditor = null;
        editSessionKey++;
    }

    private async Task CancelEditAsync()
    {
        await StopNotesMicAsync(cancelOnly: true);
        CancelEdit();
    }

    private void OnEditHtmlChanged(string html)
    {
        // First callback is Quill's canonical form after mount — not a user edit.
        // Do not write editingInitialHtml here: it is rendered as MarkupString inside
        // the editor host, and changing it makes Blazor patch DOM that Quill owns
        // (removeChild on null in MAUI WebView).
        if (!_editBaselineCaptured)
        {
            _editBaselineHtml = html ?? "";
            _activeEditDraftHtml = _editBaselineHtml;
            _editBaselineCaptured = true;
            _editDirty = false;
            return;
        }

        _activeEditDraftHtml = html;
        _editDirty = !NoteHtmlEquals(html, _editBaselineHtml);
    }

    /// <summary>
    /// True = dirty draft applied with a new ModifiedAt.
    /// False = no content change (do not save).
    /// Null = could not read the editor; leave the session open.
    /// </summary>
    private async Task<bool?> TryApplyDirtyDraftAsync()
    {
        if (editingMessageIndex is not int index || index < 0 || index >= currentNoteMessages.Count)
            return false;

        string? html = _activeEditDraftHtml;
        if (html is null && quillEditor is not null)
            html = await quillEditor.GetHTML();

        if (html is null)
            return null;

        if (!_editDirty || NoteHtmlEquals(html, currentNoteMessages[index].Content))
            return false;

        if (IsBlankQuillHtml(html))
            html = "";

        currentNoteMessages[index] = ChatMessageHelper.TouchModified(
            currentNoteMessages[index],
            content: html,
            contentFormat: NoteContentFormatter.FormatHtml);
        _activeEditDraftHtml = html;
        return true;
    }

    private async Task ApplyDraftToEditingMessageAsync()
    {
        await TryApplyDirtyDraftAsync();
    }

    private async Task CommitActiveEditAsync(bool persistToStore = false)
    {
        if (isNotesMicRecording)
            await StopNotesMicAsync(cancelOnly: false);

        if (editingMessageIndex is null)
            return;

        var changed = await TryApplyDirtyDraftAsync();
        if (changed is null)
            return;

        CancelEdit();

        if (persistToStore && changed == true)
            await SaveCurrent();
    }

    [JSInvokable]
    public async Task OnNotesSaveHotkey()
    {
        if (editingMessageIndex is int index)
            await SaveEdit(index);
        await InvokeAsync(StateHasChanged);
    }

    private async Task OpenCurrentNoteInChat()
    {
        if (string.IsNullOrEmpty(activeNoteId) || editingMessageIndex is not int index)
            return;
        if (index < 0 || index >= currentNoteMessages.Count)
            return;

        if (await TryApplyDirtyDraftAsync() == true)
            await SaveCurrent();

        var msg = currentNoteMessages[index];
        var note = notes.FirstOrDefault(n => n.Id == activeNoteId);
        NotesChatHandoff.SetEditWithAiRequest(new NotesChatHandoffPayload(
            NotebookId: activeNoteId,
            NotebookTitle: note?.Title ?? "Untitled",
            EntryId: msg.ItemId,
            Html: msg.Content ?? ""));

        CancelEdit();
        ChatPanel.IsOpen = true;
        if (AppEnvironment.IsMaui)
        {
            try { await SidebarState.SetCollapsedAsync(false, JS); }
            catch { /* sidebar init may be unavailable */ }
        }

        Nav.NavigateTo("/chat?noteEdit=1");
    }

    private Task OnNoteBodyClick(int index) => StartEdit(index);

    private async Task StartEdit(int index)
    {
        if (index < 0 || index >= currentNoteMessages.Count)
            return;

        if (editingMessageIndex == index)
            return;

        CloseEntryMenu();
        await CommitActiveEditAsync(persistToStore: true);

        var msg = currentNoteMessages[index];
        editingMessageIndex = index;
        editingInitialHtml = NoteContentFormatter.ToEditorHtml(msg.Content, msg.ContentFormat);
        _editBaselineHtml = editingInitialHtml;
        _activeEditDraftHtml = editingInitialHtml;
        _editBaselineCaptured = false;
        _editDirty = false;
        editSessionKey++;
    }

    private async Task SaveEdit(int index)
    {
        if (editingMessageIndex != index)
            return;

        await CommitActiveEditAsync(persistToStore: true);
    }


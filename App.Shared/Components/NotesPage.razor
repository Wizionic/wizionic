    private async Task OnNotePointerDown(PointerEventArgs e, string noteId)
    {
        // Left button only (pointerType mouse); allow touch/pen without button check.
        if (string.Equals(e.PointerType, "mouse", StringComparison.OrdinalIgnoreCase) && e.Button != 0)
            return;

        _reorderDotNetRef ??= DotNetObjectReference.Create(this);
        _noteDragMoved = false;

        try
        {
            // Pointer-based reorder works in browser and MAUI WebView2 (HTML5 DnD does not).
            await JS.InvokeVoidAsync(
                "appNotesReorder.start",
                _reorderDotNetRef,
                noteId,
                e.ClientX,
                e.ClientY);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Notes] Reorder gesture start failed: {ex.Message}");
            // Fallback: treat as a normal open click if interop is unavailable.
            await SwitchNote(noteId);
        }
    }

    [JSInvokable]
    public void OnReorderDragStarted(string noteId)
    {
        _dragNoteId = noteId;
        _noteDragMoved = true;
        _ = InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public void OnReorderDragOver(string? overNoteId)
    {
        if (_dragOverNoteId == overNoteId)
            return;
        _dragOverNoteId = overNoteId;
        _ = InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task OnReorderClick(string noteId)
    {
        _dragNoteId = null;
        _dragOverNoteId = null;
        _noteDragMoved = false;
        await SwitchNote(noteId);
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task OnReorderDrop(string sourceId, string targetId)
    {
        _dragNoteId = null;
        _dragOverNoteId = null;

        if (string.IsNullOrEmpty(sourceId) || string.IsNullOrEmpty(targetId) || sourceId == targetId)
        {
            _noteDragMoved = false;
            await InvokeAsync(StateHasChanged);
            return;
        }

        var ordered = notes
            .OrderBy(n => n.SortOrder)
            .ThenByDescending(n => n.LastUpdated)
            .ToList();

        var from = ordered.FindIndex(n => n.Id == sourceId);
        var to = ordered.FindIndex(n => n.Id == targetId);
        if (from < 0 || to < 0)
        {
            _noteDragMoved = false;
            await InvokeAsync(StateHasChanged);
            return;
        }

        var item = ordered[from];
        ordered.RemoveAt(from);
        ordered.Insert(to, item);

        await NoteStore.ReorderNotesAsync(ordered.Select(n => n.Id).ToList());
        notes = await NoteStore.LoadIndexAsync();
        _noteDragMoved = true;
        await InvokeAsync(StateHasChanged);
    }

    private async Task SwitchNote(string id)
    {
        if (activeNoteId != id)
        {
            // Re-lock previous notebook so returning requires the password again.
            if (!string.IsNullOrEmpty(activeNoteId))
                unlockedNoteIds.Remove(activeNoteId);

            await CommitActiveEditAsync(persistToStore: true);
            await LoadNote(id);
        }
        await SidebarState.CollapseIfMobileAsync(JS);
    }

    private async Task LoadNote(string id)
    {
        activeNoteId = id;
        var note = notes.FirstOrDefault(n => n.Id == id);
        if (note?.IsPasswordProtected == true && !unlockedNoteIds.Contains(id))
        {
            currentNoteMessages = new();
            OpenUnlockDialog(id, thenLoad: true);
            StateHasChanged();
            return;
        }

        currentNoteMessages = await NoteStore.LoadNoteAsync(id);
        StateHasChanged();
    }

    private void OpenUnlockDialog(string noteId, bool thenLoad = true)
    {
        unlockTargetNoteId = noteId;
        unlockPassword = "";
        unlockError = null;
        unlockBusy = false;
        unlockThenLoad = thenLoad;
        pendingRemoveProtectionNoteId = null;
        showUnlockDialog = true;
    }

    private void CancelUnlockDialog()
    {
        showUnlockDialog = false;
        unlockTargetNoteId = null;
        unlockPassword = "";
        unlockError = null;
        unlockBusy = false;
        unlockThenLoad = false;
        pendingRemoveProtectionNoteId = null;
    }

    private async Task UnlockDialogKeyHandler(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !unlockBusy && !string.IsNullOrWhiteSpace(unlockPassword))
            await ConfirmUnlockDialog();
        else if (e.Key == "Escape")
            CancelUnlockDialog();
    }

    private async Task ConfirmUnlockDialog()
    {
        if (string.IsNullOrEmpty(unlockTargetNoteId) || string.IsNullOrWhiteSpace(unlockPassword))
            return;

        unlockBusy = true;
        unlockError = null;
        try
        {
            var (success, err) = await AuthService.VerifyPasswordAsync(unlockPassword);
            if (!success)
            {
                unlockError = err ?? "Incorrect password.";
                return;
            }

            var noteId = unlockTargetNoteId;
            var shouldLoad = unlockThenLoad;
            var removeProtection = pendingRemoveProtectionNoteId != null
                && string.Equals(pendingRemoveProtectionNoteId, noteId, StringComparison.OrdinalIgnoreCase);

            CancelUnlockDialog();

            if (removeProtection)
            {
                await NoteStore.SetPasswordProtectedAsync(noteId, false);
                notes = await NoteStore.LoadIndexAsync();
                unlockedNoteIds.Remove(noteId);
                SyncBridge.ScheduleAutoSyncNoteAfterLocalSave(
                    noteId,
                    notes.FirstOrDefault(n => n.Id == noteId)?.Title ?? "");
            }
            else
            {
                unlockedNoteIds.Add(noteId);
                if (shouldLoad)
                {
                    activeNoteId = noteId;
                    currentNoteMessages = await NoteStore.LoadNoteAsync(noteId);
                }
            }

            StateHasChanged();
        }
        finally
        {
            unlockBusy = false;
        }
    }

    private async Task ProtectNotebook(string? noteId)
    {
        CloseMenu();
        if (string.IsNullOrEmpty(noteId))
            return;

        if (!AuthService.IsAuthenticated || !AuthService.HasPassword)
            return;

        await NoteStore.SetPasswordProtectedAsync(noteId, true);
        notes = await NoteStore.LoadIndexAsync();
        SyncBridge.ScheduleAutoSyncNoteAfterLocalSave(
            noteId,
            notes.FirstOrDefault(n => n.Id == noteId)?.Title ?? "");

        // Keep the notebook open if the user just locked the one they are viewing.
        if (activeNoteId == noteId)
            unlockedNoteIds.Add(noteId);

        StateHasChanged();
    }

    private void RemoveNotebookProtection(string? noteId)
    {
        CloseMenu();
        if (string.IsNullOrEmpty(noteId))
            return;

        unlockTargetNoteId = noteId;
        unlockPassword = "";
        unlockError = null;
        unlockBusy = false;
        unlockThenLoad = false;
        pendingRemoveProtectionNoteId = noteId;
        showUnlockDialog = true;
    }

    private async Task SaveCurrent()
    {
        if (string.IsNullOrEmpty(activeNoteId)) return;
        var note = notes.FirstOrDefault(n => n.Id == activeNoteId);
        var title = note?.Title ?? "Untitled";
        await NoteStore.SaveNoteAsync(activeNoteId, currentNoteMessages);
        await NoteStore.UpdateIndexAfterSaveAsync(activeNoteId, title, currentNoteMessages);
        notes = await NoteStore.LoadIndexAsync();
        SyncBridge.ScheduleAutoSyncNoteAfterLocalSave(activeNoteId, title);
    }

    private async Task DeleteNote(string id)
    {
        var deletedAt = await NoteStore.DeleteNoteAsync(id);
        notes = await NoteStore.LoadIndexAsync();
        SyncBridge.ScheduleAutoSyncNoteDeleteAfterLocalDelete(id, deletedAt);

        if (activeNoteId == id)
        {
            activeNoteId = null;
            currentNoteMessages = new();
            if (notes.Any())
            {
                activeNoteId = notes.OrderByDescending(n => n.LastUpdated).First().Id;
                await LoadNote(activeNoteId);
            }
        }
        StateHasChanged();
    }

    private async Task AddEntryToCurrentNote()
    {
        if (string.IsNullOrEmpty(activeNoteId))
            return;

        await AddNoteEntry(activeNoteId);
    }

    private async Task AddNoteEntry(string noteId)
    {
        CloseMenu();
        await CommitActiveEditAsync(persistToStore: true);

        if (activeNoteId != noteId)
            await LoadNote(noteId);

        // Wait for unlock if the notebook is protected and not yet unlocked.
        if (notes.FirstOrDefault(n => n.Id == noteId)?.IsPasswordProtected == true
            && !unlockedNoteIds.Contains(noteId))
            return;

        var now = DateTime.UtcNow;
        var newEntry = new ChatMessage(
            Role: "user",
            Content: "<p><br></p>",
            Timestamp: now,
            ModifiedAt: now,
            ItemId: Guid.NewGuid().ToString("N"),
            ContentFormat: NoteContentFormatter.FormatHtml);

        currentNoteMessages.Add(newEntry);
        await SaveCurrent();
        await StartEdit(currentNoteMessages.Count - 1);
        StateHasChanged();
    }


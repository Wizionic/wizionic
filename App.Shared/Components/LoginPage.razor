@using App.Core.Auth
@using App.Core.Configuration
@inject IAuthService Auth
@inject IGuestDataMigrationService? GuestMigration
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="settings-content" style="max-width: 520px; margin: 2rem auto; padding: 0 1rem;">
    <div class="login-brand">
        <img class="login-brand-logo" src="/images/app50.png" width="48" height="48" alt="Wizionic" title="Wizionic" />
        <h2>Wizionic</h2>
    </div>
    @if (!AppEnvironment.IsMaui)
    {
    <div class="login-lead">
        Download the Wizionic app to use private local AI.
    </div>
    <div class="login-download-stack">
        <div class="login-download-card @(_detectedOs == "windows" ? "login-download-card--active" : _detectedOs == "linux" ? "login-download-card--muted" : null)">
            @if (_detectedOs == "windows")
            {
                <div class="login-download-badge">Recommended for this device</div>
            }
            <div class="login-download-title">
                <a href="@AppServerOptions.LatestWindowsSetupUrl">
                    Download Wizionic App for Windows
                </a>
            </div>
            <p class="login-download-desc">Windows installer (.exe) — Windows 10 and 11.</p>
            <a class="btn btn-primary btn-sm login-download-btn" href="@AppServerOptions.LatestWindowsSetupUrl">
                Download for Windows
            </a>
        </div>

        <div class="login-download-card @(_detectedOs == "linux" ? "login-download-card--active" : _detectedOs == "windows" ? "login-download-card--muted" : null)">
            @if (_detectedOs == "linux")
            {
                <div class="login-download-badge">Recommended for this device</div>
            }
            <div class="login-download-title">Download Wizionic App for Linux</div>
            <p class="login-download-desc">Debian/Ubuntu .deb, with AppImage fallback:</p>
            <div class="login-install-cmd-row">
                <pre class="login-install-cmd" id="linux-install-cmd"><code>@LinuxInstallCommand</code></pre>
                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="CopyLinuxInstallCommand">
                    @(_linuxInstallCopied ? "Copied" : "Copy")
                </button>
            </div>
            <div class="login-download-links">
                <a href="@AppServerOptions.LatestLinuxAppImageUrl">AppImage only</a>
                <span class="login-download-sep">·</span>
                <a href="@AppServerOptions.LatestLinuxInstallScriptUrl">install.sh</a>
            </div>
        </div>
    </div>
    }
    @if (!(Auth.IsAuthenticated && !string.IsNullOrEmpty(Auth.Email)) && string.IsNullOrEmpty(twoFactorChallengeId))
    {
    <p style="color: var(--color-text-muted);">Login to sync your encrypted data and settings across devices:
    </p>
    }

    @if (Auth.IsAuthenticated && !string.IsNullOrEmpty(Auth.Email))
    {
        <div class="cf-success-box" style="margin: 1rem 0; padding: 0.75rem 1rem;">
            Logged in as <strong>@Auth.Email</strong>.<br />
            <span style="font-size:0.9em;">You can now sync your encrypted chat history across browsers or devices with the Wizionic app.</span>
        </div>

        <div style="display:flex; gap:0.5rem; flex-wrap:wrap;">
            <button class="btn btn-primary" @onclick='() => Nav.NavigateTo("/chat")'>Continue to Chat</button>
            <button class="btn btn-outline-secondary" @onclick='() => Nav.NavigateTo("/settings")'>Settings</button>
            <button class="btn btn-outline-secondary" @onclick="DoLogout">Sign out</button>
        </div>

        <div style="margin-top: 1.75rem; padding-top: 1rem; border-top: 1px solid var(--color-border);">
            @if (!string.IsNullOrEmpty(passwordMessage) && !_showPasswordForm)
            {
                <div style="color: var(--color-success-fg, var(--cf-success-fg, #22c55e)); margin: 0 0 0.5rem; font-size:0.9em;">@passwordMessage</div>
            }
            @if (!string.IsNullOrEmpty(twoFactorMessage) && !_showTwoFactorForm)
            {
                <div style="color: var(--color-success-fg, var(--cf-success-fg, #22c55e)); margin: 0 0 0.5rem; font-size:0.9em;">@twoFactorMessage</div>
            }

            @if (!_showPasswordForm)
            {
                <button type="button"
                        class="btn btn-link p-0"
                        style="font-size:0.95rem;"
                        @onclick="() => _showPasswordForm = true">
                    @(Auth.HasPassword ? "Change password" : "Add a password")
                </button>
            }
            else
            {
            <h3 style="font-size:1.05rem; margin:0 0 0.35rem 0;">
                @(Auth.HasPassword ? "Change password" : "Add a password")
            </h3>
            <p style="margin:0 0 0.75rem 0; font-size:0.9em; color: var(--color-text-muted);">
                Optional. Use a password to sign in without waiting for an email code, and to unlock protected notebooks.
                @App.Core.Auth.PasswordRules.RequirementsText
            </p>

            @if (!string.IsNullOrEmpty(passwordMessage))
            {
                <div style="color: var(--color-success-fg, var(--cf-success-fg, #22c55e)); margin: 0 0 0.5rem; font-size:0.9em;">@passwordMessage</div>
            }
            @if (!string.IsNullOrEmpty(passwordError))
            {
                <div style="color: var(--cf-error-fg); margin: 0 0 0.5rem; font-size:0.9em;">@passwordError</div>
            }

            @if (Auth.HasPassword)
            {
                <div style="margin-bottom:0.5rem;">
                    <input type="password"
                           @bind-value="currentPassword"
                           @bind-value:event="oninput"
                           placeholder="Current password"
                           class="form-control"
                           autocomplete="current-password" />
                </div>
            }
            <div style="margin-bottom:0.5rem;">
                <input type="password"
                       @bind-value="newPassword"
                       @bind-value:event="oninput"
                       placeholder="New password"
                       class="form-control"
                       autocomplete="new-password" />
            </div>
            <div style="margin-bottom:0.75rem;">
                <input type="password"
                       @bind-value="confirmPassword"
                       @bind-value:event="oninput"
                       placeholder="Confirm new password"
                       class="form-control"
                       autocomplete="new-password" />
            </div>
            <div style="display:flex; gap:0.5rem; flex-wrap:wrap;">
                <button class="btn btn-primary"
                        @onclick="SavePassword"
                        disabled="@(busy || string.IsNullOrWhiteSpace(newPassword) || string.IsNullOrWhiteSpace(confirmPassword) || (Auth.HasPassword && string.IsNullOrWhiteSpace(currentPassword)))">
                    @(Auth.HasPassword ? "Update password" : "Save password")
                </button>
                <button type="button" class="btn btn-outline-secondary" @onclick="CancelPasswordForm" disabled="@busy">
                    Cancel
                </button>
            </div>
            @if (!Auth.HasPassword)
            {
                <label style="display:flex; align-items:flex-start; gap:0.5rem; margin-top:0.85rem; font-size:0.9em;">
                    <input type="checkbox" @bind="enableTwoFactorOnSave" disabled="@busy" />
                    <span>Require a second factor when signing in (email code, or SMS if you add a phone).</span>
                </label>
            }
            }

            @if (Auth.HasPassword && !_showTwoFactorForm)
            {
                <div style="margin-top:0.35rem;">
                    <button type="button"
                            class="btn btn-link p-0"
                            style="font-size:0.95rem;"
                            @onclick="() => _showTwoFactorForm = true">
                        Two-factor sign-in
                    </button>
                </div>
            }
            else if (Auth.HasPassword)
            {
            <div style="margin-top: 1.25rem; padding-top: 1rem; border-top: 1px solid var(--color-border);">
                <h3 style="font-size:1.05rem; margin:0 0 0.35rem 0;">Two-factor sign-in</h3>
                <p style="margin:0 0 0.75rem 0; font-size:0.9em; color: var(--color-text-muted);">
                    Only asked when you first sign in. Unlocking notebooks, chats, and albums still uses your password alone.
                </p>

                @if (!string.IsNullOrEmpty(twoFactorMessage))
                {
                    <div style="color: var(--color-success-fg, var(--cf-success-fg, #22c55e)); margin: 0 0 0.5rem; font-size:0.9em;">@twoFactorMessage</div>
                }
                @if (!string.IsNullOrEmpty(twoFactorError))
                {
                    <div style="color: var(--cf-error-fg); margin: 0 0 0.5rem; font-size:0.9em;">@twoFactorError</div>
                }

                <label style="display:flex; align-items:flex-start; gap:0.5rem; font-size:0.95em;">
                    <input type="checkbox"
                           checked="@Auth.TwoFactorEnabled"
                           disabled="@busy"
                           @onchange="OnTwoFactorCheckboxChanged" />
                    <span>Require a second factor when signing in</span>
                </label>

                @if (_confirmDisableTwoFactor)
                {
                    <div style="margin-top:0.6rem; display:flex; flex-direction:column; gap:0.5rem; max-width:420px;">
                        <input type="password"
                               @bind-value="twoFactorCurrentPassword"
                               @bind-value:event="oninput"
                               placeholder="Current password"
                               class="form-control"
                               autocomplete="current-password" />
                        <div style="display:flex; gap:0.5rem; flex-wrap:wrap;">
                            <button class="btn btn-primary btn-sm" @onclick="ConfirmDisableTwoFactor" disabled="@(busy || string.IsNullOrWhiteSpace(twoFactorCurrentPassword))">
                                Turn off two-factor
                            </button>
                            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="CancelDisableTwoFactor" disabled="@busy">Cancel</button>
                        </div>
                    </div>
                }

                @if (Auth.TwoFactorEnabled)
                {
                    <p style="margin:0.65rem 0 0; font-size:0.9em; color: var(--color-text-muted);">
                        After your password we will ask for an email code@(Auth.HasTwoFactorPhone ? $", or SMS to {Auth.TwoFactorPhoneMasked}." : ".")
                    </p>

                    @if (Auth.SmsTwoFactorAvailable)
                    {
                        @if (Auth.HasTwoFactorPhone && !_changePhone)
                        {
                            <div style="margin-top:0.6rem; display:flex; gap:0.5rem; flex-wrap:wrap;">
                                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => _changePhone = true" disabled="@busy">Change number</button>
                                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => _confirmRemovePhone = true" disabled="@busy">Remove phone</button>
                            </div>
                            @if (_confirmRemovePhone)
                            {
                                <div style="margin-top:0.5rem; display:flex; flex-direction:column; gap:0.5rem; max-width:420px;">
                                    <input type="password"
                                           @bind-value="twoFactorCurrentPassword"
                                           @bind-value:event="oninput"
                                           placeholder="Current password"
                                           class="form-control"
                                           autocomplete="current-password" />
                                    <div style="display:flex; gap:0.5rem;">
                                        <button class="btn btn-primary btn-sm" @onclick="RemovePhone" disabled="@(busy || string.IsNullOrWhiteSpace(twoFactorCurrentPassword))">Remove phone</button>
                                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => _confirmRemovePhone = false" disabled="@busy">Cancel</button>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div style="margin-top:0.65rem; display:flex; flex-direction:column; gap:0.5rem; max-width:420px;">
                                <input type="tel"
                                       @bind-value="phoneNumber"
                                       @bind-value:event="oninput"
                                       placeholder="+15551234567"
                                       class="form-control"
                                       autocomplete="tel" />
                                @if (smsEnrollSent)
                                {
                                    <input type="text"
                                           @bind-value="smsEnrollCode"
                                           @bind-value:event="oninput"
                                           placeholder="SMS code"
                                           class="form-control"
                                           inputmode="numeric"
                                           autocomplete="one-time-code" />
                                }
                                <div style="display:flex; gap:0.5rem; flex-wrap:wrap;">
                                    <button class="btn btn-outline-secondary btn-sm" @onclick="SendEnrollSms" disabled="@(busy || string.IsNullOrWhiteSpace(phoneNumber))">
                                        @(smsEnrollSent ? "Resend SMS" : "Send SMS code")
                                    </button>
                                    @if (smsEnrollSent)
                                    {
                                        <button class="btn btn-primary btn-sm" @onclick="ConfirmEnrollSms" disabled="@(busy || string.IsNullOrWhiteSpace(smsEnrollCode))">
                                            Confirm phone
                                        </button>
                                    }
                                    @if (_changePhone)
                                    {
                                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="CancelChangePhone" disabled="@busy">Cancel</button>
                                    }
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <p style="margin:0.5rem 0 0; font-size:0.85em; color: var(--color-text-muted);">
                            SMS is not configured on this server. Email codes still work as the second factor.
                        </p>
                    }
                }

                <div style="margin-top:0.85rem;">
                    <button type="button" class="btn btn-outline-secondary" @onclick="CancelTwoFactorForm" disabled="@busy">
                        Cancel
                    </button>
                </div>
            </div>
            }
        </div>
    }
    else if (!string.IsNullOrEmpty(twoFactorChallengeId))
    {
        @if (!string.IsNullOrEmpty(error))
        {
            <div style="color: var(--cf-error-fg); margin: 0.25rem 0 0.5rem; font-size:0.9em;">@error</div>
        }

        <p style="color: var(--color-text-muted);">
            Enter the @(twoFactorMethod == "sms" ? "SMS" : "email") code to finish signing in.
            @if (twoFactorMethod == "sms" && !string.IsNullOrEmpty(twoFactorMaskedPhone))
            {
                <text> Sent to @twoFactorMaskedPhone.</text>
            }
        </p>

        <div style="display:flex; flex-direction:column; gap:0.5rem; max-width:420px;">
            <input type="text"
                   @bind-value="twoFactorCode"
                   @bind-value:event="oninput"
                   placeholder="Verification code"
                   class="form-control"
                   autocomplete="one-time-code"
                   @onkeydown="TwoFactorKeyHandler" />
            <div>
                <button class="btn btn-primary" @onclick="VerifyTwoFactor" disabled="@(busy || string.IsNullOrWhiteSpace(twoFactorCode))">
                    Verify and sign in
                </button>
            </div>
            <div style="display:flex; gap:0.5rem; flex-wrap:wrap;">
                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="ResendTwoFactor" disabled="@busy">Resend code</button>
                @if (twoFactorMethods.Contains("sms") && twoFactorMethod != "sms")
                {
                    <button type="button" class="btn btn-outline-secondary btn-sm" @onclick='() => SwitchTwoFactorMethod("sms")' disabled="@busy">Use SMS</button>
                }
                @if (twoFactorMethods.Contains("email") && twoFactorMethod != "email")
                {
                    <button type="button" class="btn btn-outline-secondary btn-sm" @onclick='() => SwitchTwoFactorMethod("email")' disabled="@busy">Use email</button>
                }
                <button type="button" class="btn btn-link btn-sm p-0" @onclick="CancelTwoFactor" disabled="@busy">Back</button>
            </div>
        </div>
    }
    else
    {
        @if (!string.IsNullOrEmpty(error))
        {
            <div style="color: var(--cf-error-fg); margin: 0.25rem 0 0.5rem; font-size:0.9em;">@error</div>
        }

        <div style="display:flex; gap:0.5rem; margin: 0.75rem 0 1rem; flex-wrap:wrap;">
            <button type="button"
                    class="btn @(loginMode == LoginMode.Code ? "btn-primary" : "btn-outline-secondary") btn-sm"
                    @onclick="() => SwitchLoginMode(LoginMode.Code)"
                    disabled="@busy">
                Login code (email)
            </button>
            <button type="button"
                    class="btn @(loginMode == LoginMode.Password ? "btn-primary" : "btn-outline-secondary") btn-sm"
                    @onclick="() => SwitchLoginMode(LoginMode.Password)"
                    disabled="@busy">
                Password
            </button>
        </div>

        @if (loginMode == LoginMode.Password)
        {
            <div style="display:flex; flex-direction:column; gap:0.5rem; max-width:420px;">
                <input type="email"
                       @bind-value="email"
                       @bind-value:event="oninput"
                       placeholder="email address"
                       class="form-control"
                       autocomplete="username" />
                <input type="password"
                       @bind-value="passwordLogin"
                       @bind-value:event="oninput"
                       placeholder="password"
                       class="form-control"
                       autocomplete="current-password"
                       @onkeydown="PasswordLoginKeyHandler" />
                <div>
                    <button class="btn btn-primary"
                            @onclick="LoginWithPassword"
                            disabled="@(busy || !IsValidEmail(email) || string.IsNullOrWhiteSpace(passwordLogin))">
                        Sign in with password
                    </button>
                </div>
                <p style="margin:0; font-size:0.85em; color: var(--color-text-muted);">
                    If you turned on two-factor, sign in with your password first.
                </p>
            </div>
        }
        else if (loginSent)
        {
            <div style="margin: 0.75rem 0; padding: 0.75rem 1rem; background: var(--color-info-bg); border: 1px solid var(--color-info-border); border-radius: 6px;">
                <p style="margin:0 0 0.25rem 0;"><strong>Login code sent!</strong></p>
                <p style="margin:0; font-size:0.95em;">
                    We've emailed a login code to <strong>@email</strong>. Open your inbox (and check spam).
                    Enter the code below, or click the web login link in the email.
                </p>
            </div>

            <div style="display:flex; gap:0.5rem; align-items:flex-end; flex-wrap:wrap; margin-top:0.75rem;">
                <div style="flex:1; min-width:160px;">
                    <input type="text"
                           @bind-value="loginCode"
                           @bind-value:event="oninput"
                           placeholder="Login code"
                           class="form-control"
                           style="letter-spacing:0.15em; text-transform:uppercase;" />
                </div>
                <button class="btn btn-primary"
                        @onclick="VerifyCode"
                        disabled="@(busy || string.IsNullOrWhiteSpace(loginCode))">
                    Verify code
                </button>
            </div>

            <button class="btn btn-outline-secondary" style="margin-top:0.75rem;" @onclick="Reset" disabled="@busy">Use a different email</button>
        }
        else
        {
            <div style="display:flex; gap:0.5rem; align-items:flex-end; flex-wrap:wrap;">
                <div style="flex:1; min-width:220px;">
                    <input type="email"
                           @bind-value="email"
                           @bind-value:event="oninput"
                           placeholder="email address"
                           class="form-control" />
                </div>
                <button class="btn btn-primary"
                        @onclick="SendLoginCode"
                        disabled="@(busy || !IsValidEmail(email))">
                    Send login code
                </button>
            </div>
        }


    }

    <footer class="site-legal-footer">
        <a href="/privacy">Privacy</a>
        <span class="login-download-sep">·</span>
        <a href="/terms">Terms</a>
        <span class="login-download-sep">·</span>
        <a href="https://github.com/Wizionic/wizionic/blob/main/SECURITY.md">Security</a>
        <span class="login-download-sep">·</span>
        <a href="https://github.com/Wizionic/wizionic">Source</a>
    </footer>
</div>

@code {
    [Parameter] public bool RedirectAuthenticatedToChat { get; set; } = true;
    [Parameter] public string RedirectAfterLogin { get; set; } = "/chat";
    [Parameter] public string AccountPath { get; set; } = "/account";
    /// <summary>
    /// WASM: /account redirects unauthenticated users to / (same login landing).
    /// MAUI: set false so /account shows the login form (Home is not the login page).
    /// </summary>
    [Parameter] public bool RedirectUnauthenticatedAccountToRoot { get; set; } = true;

    private const string LinuxInstallCommand = "curl -fsSL https://github.com/Wizionic/wizionic/releases/latest/download/install.sh | bash";

    private bool _linuxInstallCopied;
    private bool _showPasswordForm;
    private bool _showTwoFactorForm;
    /// <summary>"windows", "linux", "mac", or null until detected.</summary>
    private string? _detectedOs;

    private enum LoginMode { Code, Password }

    string email = "";
    string loginCode = "";
    string passwordLogin = "";
    string newPassword = "";
    string confirmPassword = "";
    string currentPassword = "";
    bool loginSent;
    bool busy;
    string? error;
    string? passwordError;
    string? passwordMessage;
    LoginMode loginMode = LoginMode.Code;

    bool enableTwoFactorOnSave;
    bool _confirmDisableTwoFactor;
    bool _confirmRemovePhone;
    bool _changePhone;
    bool smsEnrollSent;
    string twoFactorCurrentPassword = "";
    string phoneNumber = "";
    string smsEnrollCode = "";
    string? twoFactorError;
    string? twoFactorMessage;

    string? twoFactorChallengeId;
    string twoFactorMethod = "email";
    List<string> twoFactorMethods = new() { "email" };
    string? twoFactorMaskedPhone;
    string twoFactorCode = "";

    private const string TfChallengeKey = "wizionic.tf.challenge";
    private const string TfMethodKey = "wizionic.tf.method";
    private const string TfMethodsKey = "wizionic.tf.methods";
    private const string TfMaskedKey = "wizionic.tf.masked";
    private const string TfEmailKey = "wizionic.tf.email";

    private async Task CopyLinuxInstallCommand()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", LinuxInstallCommand);
            _linuxInstallCopied = true;
            StateHasChanged();
            await Task.Delay(2000);
            _linuxInstallCopied = false;
            StateHasChanged();
        }
        catch
        {
            // Clipboard may be blocked; user can still select the code block.
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && string.IsNullOrEmpty(twoFactorChallengeId) && !Auth.IsAuthenticated)
            await RestoreTwoFactorChallengeAsync();

        if (!firstRender || AppEnvironment.IsMaui || _detectedOs is not null)
            return;

        try
        {
            // Prefer modern platform hint, fall back to userAgent.
            var platform = await JS.InvokeAsync<string>("appPlatform");
            _detectedOs = DetectOsFromUserAgent(platform);
            await InvokeAsync(StateHasChanged);
        }
        catch
        {
            _detectedOs = "unknown";
        }
    }

    private static string DetectOsFromUserAgent(string? ua)
    {
        if (string.IsNullOrWhiteSpace(ua))
            return "unknown";

        var s = ua.ToLowerInvariant();
        if (s.Contains("win"))
            return "windows";
        // Android UAs often include "Linux" — treat as non-desktop.
        if (s.Contains("android") || s.Contains("iphone") || s.Contains("ipad"))
            return "unknown";
        if (s.Contains("linux") || s.Contains("x11") || s.Contains("cros"))
            return "linux";
        if (s.Contains("mac"))
            return "mac";
        return "unknown";
    }

    protected override async Task OnInitializedAsync()
    {
        await Auth.LoadAsync();
        if (Auth.IsAuthenticated && GuestMigration is not null)
            await GuestMigration.MigrateIfNeededAsync();

        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        string path = uri.AbsolutePath.TrimEnd('/');
        bool isExplicitAccountView = path.Equals(AccountPath.TrimEnd('/'), StringComparison.OrdinalIgnoreCase);

        if (!Auth.IsAuthenticated && isExplicitAccountView && RedirectUnauthenticatedAccountToRoot)
        {
            Nav.NavigateTo("/", replace: true);
            return;
        }

        if (Auth.IsAuthenticated && RedirectAuthenticatedToChat && !isExplicitAccountView)
        {
            Nav.NavigateTo(RedirectAfterLogin, replace: true);
            return;
        }

        if (uri.Query.Contains("passwordRequired=1", StringComparison.OrdinalIgnoreCase))
        {
            loginMode = LoginMode.Password;
            error = "This account requires your password, then a second factor.";
        }

        await RestoreTwoFactorChallengeAsync();
    }

    async Task SendLoginCode()
    {
        error = null;
        busy = true;
        try
        {
            if (!IsValidEmail(email)) return;

            var (success, err) = await Auth.RequestLoginCodeAsync(email);
            if (success)
                loginSent = true;
            else
                error = err;
        }
        finally
        {
            busy = false;
        }
    }

    async Task VerifyCode()
    {
        error = null;
        busy = true;
        try
        {
            if (!IsValidEmail(email) || string.IsNullOrWhiteSpace(loginCode))
                return;

            var (success, err) = await Auth.VerifyLoginCodeAsync(email, loginCode);
            if (!success)
            {
                error = err;
                return;
            }

            if (GuestMigration is not null)
                await GuestMigration.MigrateIfNeededAsync();

            Nav.NavigateTo(RedirectAfterLogin, replace: true);
        }
        finally
        {
            busy = false;
        }
    }

    async Task DoLogout()
    {
        await Auth.SignOutAsync();
        passwordLogin = "";
        newPassword = "";
        confirmPassword = "";
        currentPassword = "";
        passwordError = null;
        passwordMessage = null;
        twoFactorError = null;
        twoFactorMessage = null;
        _showPasswordForm = false;
        _showTwoFactorForm = false;
        loginMode = LoginMode.Code;
        await ClearTwoFactorChallengeAsync();
        ResetTwoFactorManage();
    }

    void Reset()
    {
        loginSent = false;
        loginCode = "";
        error = null;
    }

    void SwitchLoginMode(LoginMode mode)
    {
        loginMode = mode;
        error = null;
        if (mode == LoginMode.Code)
            passwordLogin = "";
        else
        {
            loginSent = false;
            loginCode = "";
        }
    }

    async Task LoginWithPassword()
    {
        error = null;
        busy = true;
        try
        {
            if (!IsValidEmail(email) || string.IsNullOrWhiteSpace(passwordLogin))
                return;

            var result = await Auth.LoginWithPasswordAsync(email, passwordLogin);
            if (!result.Success)
            {
                error = result.Error ?? "Invalid email or password.";
                return;
            }

            passwordLogin = "";
            if (result.RequiresTwoFactor && !string.IsNullOrWhiteSpace(result.ChallengeId))
            {
                await BeginTwoFactorAsync(result);
                return;
            }

            if (GuestMigration is not null)
                await GuestMigration.MigrateIfNeededAsync();

            Nav.NavigateTo(RedirectAfterLogin, replace: true);
        }
        finally
        {
            busy = false;
        }
    }

    async Task PasswordLoginKeyHandler(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !busy && IsValidEmail(email) && !string.IsNullOrWhiteSpace(passwordLogin))
            await LoginWithPassword();
    }

    void CancelPasswordForm()
    {
        _showPasswordForm = false;
        passwordError = null;
        newPassword = "";
        confirmPassword = "";
        currentPassword = "";
    }

    void CancelTwoFactorForm()
    {
        _showTwoFactorForm = false;
        twoFactorError = null;
        ResetTwoFactorManage();
    }

    async Task SavePassword()
    {
        passwordError = null;
        passwordMessage = null;
        busy = true;
        try
        {
            if (!App.Core.Auth.PasswordRules.TryValidate(newPassword, out var reason))
            {
                passwordError = reason;
                return;
            }

            if (!string.Equals(newPassword, confirmPassword, StringComparison.Ordinal))
            {
                passwordError = "Passwords do not match.";
                return;
            }

            var changingExisting = Auth.HasPassword;
            var (success, err) = await Auth.SetPasswordAsync(
                newPassword,
                confirmPassword,
                changingExisting ? currentPassword : null);

            if (!success)
            {
                passwordError = err ?? "Could not save password.";
                return;
            }

            passwordMessage = changingExisting
                ? "Password updated."
                : "Password saved. You can now sign in with it next time.";
            _showPasswordForm = false;
            newPassword = "";
            confirmPassword = "";
            currentPassword = "";

            if (!changingExisting && enableTwoFactorOnSave)
            {
                var (tfOk, tfErr) = await Auth.SetTwoFactorEnabledAsync(true);
                if (tfOk)
                    passwordMessage += " Two-factor sign-in is on.";
                else
                    passwordError = tfErr ?? "Password saved, but two-factor could not be enabled.";
                enableTwoFactorOnSave = false;
            }
        }
        finally
        {
            busy = false;
        }
    }

    private static bool IsValidEmail(string? e)
    {
        if (string.IsNullOrWhiteSpace(e))
            return false;

        var value = e.Trim();
        int atIndex = value.IndexOf('@');
        if (atIndex <= 0 || atIndex == value.Length - 1)
            return false;

        int dotIndex = value.LastIndexOf('.');
        if (dotIndex <= atIndex + 1 || dotIndex == value.Length - 1)
            return false;

        if (value.Contains(' ') || value.Length < 5 || value.Length > 254)
            return false;

        return true;
    }

    async Task OnTwoFactorCheckboxChanged(ChangeEventArgs e)
    {
        twoFactorError = null;
        twoFactorMessage = null;
        var want = e.Value is bool b && b || string.Equals(e.Value?.ToString(), "true", StringComparison.OrdinalIgnoreCase);
        if (want == Auth.TwoFactorEnabled)
            return;

        if (!want)
        {
            _confirmDisableTwoFactor = true;
            return;
        }

        busy = true;
        try
        {
            var (ok, err) = await Auth.SetTwoFactorEnabledAsync(true);
            if (!ok)
                twoFactorError = err ?? "Could not enable two-factor sign-in.";
            else
                twoFactorMessage = "Two-factor sign-in is on. We will ask for an email code after your password.";
        }
        finally
        {
            busy = false;
        }
    }

    async Task ConfirmDisableTwoFactor()
    {
        twoFactorError = null;
        twoFactorMessage = null;
        busy = true;
        try
        {
            var (ok, err) = await Auth.SetTwoFactorEnabledAsync(false, twoFactorCurrentPassword);
            if (!ok)
            {
                twoFactorError = err ?? "Could not turn off two-factor sign-in.";
                return;
            }

            twoFactorMessage = "Two-factor sign-in is off.";
            ResetTwoFactorManage();
        }
        finally
        {
            busy = false;
        }
    }

    void CancelDisableTwoFactor()
    {
        _confirmDisableTwoFactor = false;
        twoFactorCurrentPassword = "";
    }

    async Task SendEnrollSms()
    {
        twoFactorError = null;
        twoFactorMessage = null;
        busy = true;
        try
        {
            var (ok, err) = await Auth.EnrollTwoFactorPhoneAsync(phoneNumber);
            if (!ok)
            {
                twoFactorError = err ?? "Could not send an SMS code.";
                return;
            }

            smsEnrollSent = true;
            twoFactorMessage = "SMS code sent.";
        }
        finally
        {
            busy = false;
        }
    }

    async Task ConfirmEnrollSms()
    {
        twoFactorError = null;
        twoFactorMessage = null;
        busy = true;
        try
        {
            var (ok, err) = await Auth.ConfirmTwoFactorPhoneAsync(phoneNumber, smsEnrollCode);
            if (!ok)
            {
                twoFactorError = err ?? "Incorrect or expired code.";
                return;
            }

            twoFactorMessage = "SMS two-factor is ready.";
            phoneNumber = "";
            smsEnrollCode = "";
            smsEnrollSent = false;
            _changePhone = false;
        }
        finally
        {
            busy = false;
        }
    }

    async Task RemovePhone()
    {
        twoFactorError = null;
        twoFactorMessage = null;
        busy = true;
        try
        {
            var (ok, err) = await Auth.RemoveTwoFactorPhoneAsync(twoFactorCurrentPassword);
            if (!ok)
            {
                twoFactorError = err ?? "Could not remove the phone number.";
                return;
            }

            twoFactorMessage = "Phone number removed. Email codes are still used as the second factor.";
            _confirmRemovePhone = false;
            twoFactorCurrentPassword = "";
        }
        finally
        {
            busy = false;
        }
    }

    void CancelChangePhone()
    {
        _changePhone = false;
        smsEnrollSent = false;
        smsEnrollCode = "";
        phoneNumber = "";
    }

    void ResetTwoFactorManage()
    {
        _confirmDisableTwoFactor = false;
        _confirmRemovePhone = false;
        _changePhone = false;
        smsEnrollSent = false;
        twoFactorCurrentPassword = "";
        phoneNumber = "";
        smsEnrollCode = "";
        enableTwoFactorOnSave = false;
    }

    async Task BeginTwoFactorAsync(AuthLoginResult result)
    {
        twoFactorChallengeId = result.ChallengeId;
        twoFactorMethods = result.Methods.Count > 0 ? result.Methods.ToList() : new List<string> { "email" };
        twoFactorMethod = twoFactorMethods.Contains("sms") ? "sms" : "email";
        twoFactorMaskedPhone = result.MaskedPhone;
        twoFactorCode = "";
        loginMode = LoginMode.Password;
        await PersistTwoFactorChallengeAsync();
    }

    async Task VerifyTwoFactor()
    {
        error = null;
        if (string.IsNullOrWhiteSpace(twoFactorChallengeId) || string.IsNullOrWhiteSpace(twoFactorCode))
            return;

        busy = true;
        try
        {
            var result = await Auth.VerifyTwoFactorAsync(twoFactorChallengeId, twoFactorCode, twoFactorMethod);
            if (!result.Success)
            {
                error = result.Error ?? "Incorrect or expired code.";
                return;
            }

            await ClearTwoFactorChallengeAsync();
            if (GuestMigration is not null)
                await GuestMigration.MigrateIfNeededAsync();

            Nav.NavigateTo(RedirectAfterLogin, replace: true);
        }
        finally
        {
            busy = false;
        }
    }

    async Task TwoFactorKeyHandler(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !busy && !string.IsNullOrWhiteSpace(twoFactorCode))
            await VerifyTwoFactor();
    }

    async Task ResendTwoFactor()
    {
        error = null;
        if (string.IsNullOrWhiteSpace(twoFactorChallengeId))
            return;

        busy = true;
        try
        {
            var (ok, err) = await Auth.SendTwoFactorAsync(twoFactorChallengeId, twoFactorMethod);
            error = ok ? null : (err ?? "Could not send a code.");
        }
        finally
        {
            busy = false;
        }
    }

    async Task SwitchTwoFactorMethod(string method)
    {
        twoFactorMethod = method;
        twoFactorCode = "";
        error = null;
        await PersistTwoFactorChallengeAsync();
        await ResendTwoFactor();
    }

    async Task CancelTwoFactor()
    {
        await ClearTwoFactorChallengeAsync();
        error = null;
    }

    async Task PersistTwoFactorChallengeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("sessionStorage.setItem", TfChallengeKey, twoFactorChallengeId ?? "");
            await JS.InvokeVoidAsync("sessionStorage.setItem", TfMethodKey, twoFactorMethod);
            await JS.InvokeVoidAsync("sessionStorage.setItem", TfMethodsKey, string.Join(",", twoFactorMethods));
            await JS.InvokeVoidAsync("sessionStorage.setItem", TfMaskedKey, twoFactorMaskedPhone ?? "");
            await JS.InvokeVoidAsync("sessionStorage.setItem", TfEmailKey, email);
        }
        catch
        {
            // sessionStorage may be unavailable (MAUI / private mode).
        }
    }

    async Task RestoreTwoFactorChallengeAsync()
    {
        if (Auth.IsAuthenticated)
        {
            await ClearTwoFactorChallengeAsync();
            return;
        }

        try
        {
            var challenge = await JS.InvokeAsync<string>("sessionStorage.getItem", TfChallengeKey);
            if (string.IsNullOrWhiteSpace(challenge))
                return;

            twoFactorChallengeId = challenge;
            twoFactorMethod = await JS.InvokeAsync<string>("sessionStorage.getItem", TfMethodKey) ?? "email";
            var methods = await JS.InvokeAsync<string>("sessionStorage.getItem", TfMethodsKey);
            twoFactorMethods = string.IsNullOrWhiteSpace(methods)
                ? new List<string> { twoFactorMethod }
                : methods.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();
            twoFactorMaskedPhone = await JS.InvokeAsync<string>("sessionStorage.getItem", TfMaskedKey);
            var storedEmail = await JS.InvokeAsync<string>("sessionStorage.getItem", TfEmailKey);
            if (!string.IsNullOrWhiteSpace(storedEmail))
                email = storedEmail;
            loginMode = LoginMode.Password;
        }
        catch
        {
            // Ignore missing JS / storage.
        }
    }

    async Task ClearTwoFactorChallengeAsync()
    {
        twoFactorChallengeId = null;
        twoFactorCode = "";
        twoFactorMaskedPhone = null;
        twoFactorMethod = "email";
        twoFactorMethods = new List<string> { "email" };
        try
        {
            await JS.InvokeVoidAsync("sessionStorage.removeItem", TfChallengeKey);
            await JS.InvokeVoidAsync("sessionStorage.removeItem", TfMethodKey);
            await JS.InvokeVoidAsync("sessionStorage.removeItem", TfMethodsKey);
            await JS.InvokeVoidAsync("sessionStorage.removeItem", TfMaskedKey);
            await JS.InvokeVoidAsync("sessionStorage.removeItem", TfEmailKey);
        }
        catch
        {
            // Ignore.
        }
    }
}
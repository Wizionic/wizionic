@using App.Core.Auth
@using App.Core.Configuration
@using App.Core.Homeserver
@using App.Core.UI
@inject IAppServerEndpoint ServerEndpoint
@inject IAppRestartService AppRestart
@inject IHomeserverInstallService Homeserver
@inject IAuthService Auth

<label>Server URL</label>
<input type="text" class="form-control" @bind="loginServerDraft" placeholder="https://wizionic.com or http://pc-name.local:5150" />
<div style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.5rem;">
    <button type="button" class="btn btn-primary btn-sm" @onclick="SaveLoginServer" disabled="@loginServerBusy">
        @(loginServerBusy ? "Saving…" : "Save login server")
    </button>
    <button type="button" class="btn btn-outline-secondary btn-sm" @onclick='() => ApplyLoginServerPreset("https://wizionic.com")' disabled="@loginServerBusy">
        Public (wizionic.com)
    </button>
    @if (Homeserver.GetState().IsInstalled)
    {
        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick='() => ApplyLoginServerPreset(HomeserverPaths.DefaultBaseUrl)' disabled="@loginServerBusy">
            This PC (localhost:5150)
        </button>
    }
</div>
@if (!string.IsNullOrEmpty(loginServerMessage))
{
    <div style="margin-top: 0.5rem; font-size: 0.9em; color: @(loginServerIsError ? "var(--cf-error-fg, #c00)" : "var(--cf-success-fg, #22c55e)");">
        @loginServerMessage
        @if (loginServerRestartPending && AppRestart.CanRestart)
        {
            <button type="button" class="btn btn-primary btn-sm" style="margin-left: 0.5rem;" @onclick="RestartForLoginServer">
                Restart now
            </button>
        }
    </div>
}

<ConfirmDialog IsVisible="@showRestartConfirm"
               Title="Restart required"
               Message="@restartConfirmMessage"
               ConfirmText="Restart now"
               CancelText="Later"
               Danger="false"
               OnConfirm="RestartForLoginServer"
               OnCancel="() => showRestartConfirm = false" />

@code {
    private string loginServerDraft = "";
    private string? loginServerMessage;
    private bool loginServerIsError;
    private bool loginServerBusy;
    private bool loginServerRestartPending;
    private bool showRestartConfirm;
    private string restartConfirmMessage = "";

    protected override void OnInitialized()
    {
        loginServerDraft = ServerEndpoint.BaseUrl;
        if (string.IsNullOrWhiteSpace(loginServerDraft))
            loginServerDraft = "https://wizionic.com";
    }

    private Task ApplyLoginServerPreset(string url)
    {
        loginServerDraft = url;
        return SaveLoginServer();
    }

    private async Task SaveLoginServer()
    {
        loginServerBusy = true;
        loginServerMessage = null;
        loginServerRestartPending = false;
        showRestartConfirm = false;
        StateHasChanged();
        try
        {
            var restartRequired = await ServerEndpoint.SetBaseUrlAsync(loginServerDraft);
            loginServerDraft = ServerEndpoint.BaseUrl;
            loginServerIsError = false;
            if (restartRequired)
            {
                try { await Auth.SignOutAsync(); }
                catch { Auth.SignOutLocal(); }
                loginServerRestartPending = true;
                loginServerMessage = $"Login server saved as {ServerEndpoint.BaseUrl}. Restart Wizionic to sign in there.";
                restartConfirmMessage =
                    $"Wizionic will sign you out and restart to use {ServerEndpoint.BaseUrl}. " +
                    "The new address is already saved.";
                if (AppRestart.CanRestart)
                    showRestartConfirm = true;
            }
            else
            {
                loginServerMessage = $"Login server is {ServerEndpoint.BaseUrl}.";
            }
        }
        catch (Exception ex)
        {
            loginServerMessage = ex.Message;
            loginServerIsError = true;
        }
        finally
        {
            loginServerBusy = false;
            StateHasChanged();
        }
    }

    private void RestartForLoginServer()
    {
        showRestartConfirm = false;
        if (!AppRestart.CanRestart)
            return;
        AppRestart.Restart();
    }
}

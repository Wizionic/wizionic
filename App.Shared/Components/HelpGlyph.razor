@using App.Core.Help
@inject IHelpOverlay Overlay

<button type="button"
        class="help-glyph"
        title="Help"
        aria-label="Open help"
        @onclick="Open"
        @onclick:stopPropagation="true">
    <i class="bi bi-question-circle" aria-hidden="true"></i>
</button>

@code {
    [Parameter] public string Topic { get; set; } = "start";

    private void Open() => Overlay.Open(Topic);
}

    private void SetFormTimesFromLocal(DateTime startLocal, DateTime endLocal, bool allDay)
    {
        if (allDay)
        {
            _formStartStr = startLocal.ToString("yyyy-MM-dd");
            _formEndStr = endLocal.ToString("yyyy-MM-dd");
        }
        else
        {
            // datetime-local requires no seconds / timezone for reliable browser display
            _formStartStr = startLocal.ToString("yyyy-MM-ddTHH:mm");
            _formEndStr = endLocal.ToString("yyyy-MM-ddTHH:mm");
        }
    }

    private void OnAllDayChanged(ChangeEventArgs e)
    {
        var next = e.Value is bool b && b;
        // Preserve calendar day when switching modes
        if (!TryParseFormDateTime(_formStartStr, _formAllDay, out var start))
            start = DateTime.Now;
        if (!TryParseFormDateTime(_formEndStr, _formAllDay, out var end))
            end = start.AddHours(1);

        _formAllDay = next;
        if (next)
            SetFormTimesFromLocal(start.Date, end.Date == start.Date && end.TimeOfDay > TimeSpan.Zero ? end.Date : end.Date, allDay: true);
        else
            SetFormTimesFromLocal(
                start.Date.AddHours(Math.Max(9, start.Hour)),
                end.Date.AddHours(end.Hour == 0 && end.Date > start.Date ? 10 : Math.Max(end.Hour, start.Hour + 1)),
                allDay: false);
    }

    private static bool TryParseFormDateTime(string? s, bool allDay, out DateTime local)
    {
        local = default;
        if (string.IsNullOrWhiteSpace(s)) return false;
        if (allDay)
        {
            if (DateTime.TryParseExact(s, "yyyy-MM-dd", null, System.Globalization.DateTimeStyles.None, out var d))
            {
                local = DateTime.SpecifyKind(d.Date, DateTimeKind.Local);
                return true;
            }
        }
        else
        {
            // Accept with or without seconds
            string[] formats = ["yyyy-MM-ddTHH:mm", "yyyy-MM-ddTHH:mm:ss", "yyyy-MM-dd HH:mm"];
            if (DateTime.TryParseExact(s, formats, null, System.Globalization.DateTimeStyles.None, out var dt)
                || DateTime.TryParse(s, out dt))
            {
                local = DateTime.SpecifyKind(dt, DateTimeKind.Local);
                return true;
            }
        }
        return false;
    }

    private async Task SaveEvent()
    {
        if (string.IsNullOrWhiteSpace(_formSummary) || string.IsNullOrEmpty(_formCalendarId))
            return;

        if (!TryParseFormDateTime(_formStartStr, _formAllDay, out var startLocal))
            return;
        if (!TryParseFormDateTime(_formEndStr, _formAllDay, out var endLocal))
            endLocal = _formAllDay ? startLocal : startLocal.AddHours(1);

        DateTime startUtc, endUtc;
        if (_formAllDay)
        {
            // RFC 5545: all-day DTEND is exclusive (day after last day)
            startUtc = DateTime.SpecifyKind(startLocal.Date, DateTimeKind.Local).ToUniversalTime();
            var endDate = endLocal.Date;
            if (endDate < startLocal.Date) endDate = startLocal.Date;
            endUtc = DateTime.SpecifyKind(endDate.AddDays(1), DateTimeKind.Local).ToUniversalTime();
        }
        else
        {
            startUtc = startLocal.ToUniversalTime();
            endUtc = endLocal.ToUniversalTime();
            if (endUtc <= startUtc) endUtc = startUtc.AddHours(1);
        }

        var now = DateTime.UtcNow;
        var id = _editingEventId ?? Guid.NewGuid().ToString("N");
        var existing = _editingEventId is not null ? await CalendarStore.LoadEventAsync(_editingEventId) : null;

        string? rrule = null;
        if (_formRepeatPreset == "custom")
            rrule = _formCustomRRule;
        else
            rrule = CalendarIcs.BuildRRule(_formRepeatPreset, startLocal);

        var evt = new CalendarEvent(
            id,
            _formCalendarId,
            _formSummary.Trim(),
            startUtc,
            endUtc,
            _formAllDay,
            string.IsNullOrWhiteSpace(_formDescription) ? null : _formDescription.Trim(),
            string.IsNullOrWhiteSpace(_formLocation) ? null : _formLocation.Trim(),
            TimeZoneId: TimeZoneInfo.Local.Id,
            RRule: rrule,
            Sequence: (existing?.Sequence ?? 0) + (_editingEventId is null ? 0 : 1),
            CreatedUtc: existing?.CreatedUtc ?? now,
            ModifiedUtc: now,
            WorkflowId: existing?.WorkflowId);

        await CalendarStore.UpsertEventAsync(evt);
        SyncBridge.ScheduleAutoSyncEventAfterLocalSave(evt.CalendarId, evt.Id);
        _showEventDialog = false;
        await ReloadAsync();
    }


        // All-day end is exclusive (next day) in storage — show inclusive end date in the form
        var startLocal = evt.StartUtc.ToLocalTime();
        var endLocal = evt.EndUtc.ToLocalTime();
        if (evt.IsAllDay && endLocal.TimeOfDay == TimeSpan.Zero && endLocal > startLocal)
            endLocal = endLocal.AddDays(-1);
        SetFormTimesFromLocal(startLocal, endLocal, evt.IsAllDay);
        _formCalendarId = evt.CalendarId;
        SetRepeatPresetFromRRule(evt.RRule, startLocal);
        _showEventDialog = true;
        StateHasChanged();
    }

    private void SetRepeatPresetFromRRule(string? rrule, DateTime startLocal)
    {
        _formCustomRRule = null;
        if (string.IsNullOrWhiteSpace(rrule))
        {
            _formRepeatPreset = "none";
            return;
        }

        // Match UI presets first (order: weekdays before weekly; monthly token depends on start date)
        foreach (var preset in new[] { "daily", "weekdays", "weekly", "monthly", "yearly" })
        {
            var built = CalendarIcs.BuildRRule(preset, startLocal);
            if (string.Equals(built, rrule, StringComparison.OrdinalIgnoreCase)
                || string.Equals(NormalizeRRule(built), NormalizeRRule(rrule), StringComparison.OrdinalIgnoreCase))
            {
                _formRepeatPreset = preset;
                return;
            }
        }

        // Heuristic match for common RRULEs
        var u = NormalizeRRule(rrule);
        if (u.StartsWith("FREQ=DAILY") && !u.Contains("BYDAY="))
        {
            _formRepeatPreset = "daily";
            return;
        }
        if (u.Contains("FREQ=WEEKLY") && u.Contains("BYDAY=MO,TU,WE,TH,FR") && !u.Contains("INTERVAL="))
        {
            _formRepeatPreset = "weekdays";
            return;
        }
        if (u.StartsWith("FREQ=WEEKLY"))
        {
            _formRepeatPreset = "weekly";
            return;
        }
        // Monthly by weekday (2SA) or by month day
        if (u.StartsWith("FREQ=MONTHLY"))
        {
            _formRepeatPreset = "monthly";
            return;
        }
        if (u.StartsWith("FREQ=YEARLY"))
        {
            _formRepeatPreset = "yearly";
            return;
        }

        _formRepeatPreset = "custom";
        _formCustomRRule = rrule;
    }

    /// <summary>Google-style monthly label from the form start date, e.g. "Monthly on the 2nd Saturday".</summary>
    private string MonthlyRepeatOptionText
    {
        get
        {
            if (!TryParseFormDateTime(_formStartStr, _formAllDay, out var start))
                start = DateTime.Now;
            return CalendarIcs.MonthlyRepeatOptionLabel(start);
        }
    }

    private static string NormalizeRRule(string? r)
    {
        if (string.IsNullOrWhiteSpace(r)) return "";
        return r.ToUpperInvariant().Replace(" ", "").TrimEnd(';');
    }

    private void CloseEventDialog() => _showEventDialog = false;


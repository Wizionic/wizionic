    private async Task ExportCalendarAsync(LocalCalendar cal)
    {
        CloseCalMenu();
        try
        {
            var events = await CalendarStore.LoadEventsForCalendarAsync(cal.Id);
            var ics = CalendarIcs.ExportCalendar(cal, events);
            var bytes = Encoding.UTF8.GetBytes(ics);
            var b64 = Convert.ToBase64String(bytes);
            var fileName = CalendarIcs.SafeFileName(cal.Name) + ".ics";
            await JS.InvokeAsync<bool>("downloadBase64File", b64, fileName, "text/calendar");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[CalendarPage] export failed: {ex.Message}");
        }
    }

    private void BeginImport(string calendarId)
    {
        CloseCalMenu();
        _importTargetCalendarId = calendarId;
        _importStatus = null;
    }

    private void CancelImport()
    {
        _importTargetCalendarId = null;
        _importStatus = null;
    }

    private async Task OnIcsFileSelected(InputFileChangeEventArgs e)
    {
        if (string.IsNullOrEmpty(_importTargetCalendarId)) return;
        var file = e.File;
        if (file is null) return;

        try
        {
            _importStatus = "Importing…";
            await InvokeAsync(StateHasChanged);

            await using var stream = file.OpenReadStream(maxAllowedSize: 8 * 1024 * 1024);
            using var reader = new StreamReader(stream, Encoding.UTF8);
            var text = await reader.ReadToEndAsync();
            var result = CalendarIcs.Import(text, _importTargetCalendarId);

            var imported = 0;
            foreach (var evt in result.Events)
            {
                await CalendarStore.UpsertEventAsync(evt);
                SyncBridge.ScheduleAutoSyncEventAfterLocalSave(evt.CalendarId, evt.Id);
                imported++;
            }

            _importStatus = imported == 0
                ? $"No events found{(result.Skipped > 0 ? $" ({result.Skipped} skipped)" : "")}."
                : $"Imported {imported} event(s)" +
                  (result.CalendarName is not null ? $" from “{result.CalendarName}”" : "") +
                  (result.Skipped > 0 ? $", {result.Skipped} skipped" : "") + ".";

            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _importStatus = $"Import failed: {ex.Message}";
            Console.WriteLine($"[CalendarPage] import failed: {ex}");
        }
    }

    public ValueTask DisposeAsync()
    {
        if (_sidebarHandler is not null)
            SidebarState.OnChanged -= _sidebarHandler;
        if (_syncHandler is not null)
            SyncBridge.OnCalendarsChanged -= _syncHandler;
        return ValueTask.CompletedTask;
    }

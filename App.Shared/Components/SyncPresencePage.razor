@implements IDisposable
@using App.Core.Auth
@using App.Core.Browser
@using App.Core.Storage
@using App.Core.Sync
@using App.Shared.Services

@inject ISyncService SyncService
@inject IAuthService AuthService
@inject IConversationStore ConversationStore
@inject INoteStore NoteStore
@inject IGalleryStore GalleryStore
@inject IBrowserStore BrowserStore
@inject IBrowserSidebarStore SidebarStore
@inject IStorageQuotaService StorageQuota
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="settings-content sync-page-content">
    @if (!string.IsNullOrEmpty(PendingDataSyncMessage))
    {
        <div class="cf-sync-info-box">@PendingDataSyncMessage</div>
    }

    @if (!AuthService.IsAuthenticated)
    {
        <div class="cf-sync-warning sync-login-box">
            <strong>Login required.</strong>
            <div class="mt-2">
                Sign in with your email to see your other devices and sync chats between browsers and native apps.
            </div>
            <div class="mt-2">
                <button @onclick="@(() => Nav.NavigateTo("/account"))" class="btn btn-outline-secondary btn-sm">Go to login</button>
                @if (ShowBackToChat)
                {
                    <button @onclick="@(() => Nav.NavigateTo("/chat"))" class="btn btn-outline-secondary btn-sm ms-2">Back to Chat</button>
                }
            </div>
        </div>
    }
    else
    {
        @* ── Panel 1: Devices ─────────────────────────────────────────── *@
        <section class="sync-panel">
            <div class="sync-panel-header">
                <h3 class="sync-panel-title help-heading">Devices <HelpGlyph Topic="sync" /></h3>
                <button @onclick="RefreshDevices" class="btn btn-outline-primary btn-sm" disabled="@isRefreshing">
                    @(isRefreshing ? "Refreshing..." : "Refresh")
                </button>
                <span class="sync-connection-status ms-auto @(SyncService.IsConnected ? "cf-status-online" : "cf-status-offline")">
                    @(SyncService.IsConnected ? "Connected for live updates" : "Connecting…")
                </span>
            </div>

            @if (devices.Any())
            {
                <div class="cf-sync-table-wrapper">
                    <table class="cf-sync-table">
                        <thead>
                            <tr>
                                <th class="cf-sync-cell">Device Name</th>
                                <th class="cf-sync-cell">Last Active</th>
                                @if (ShowAiServerOptions)
                                {
                                    <th class="cf-sync-cell">AI Server</th>
                                }
                                else
                                {
                                    <th class="cf-sync-cell">Status</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var d in devices.OrderByDescending(x => x.IsOnline).ThenByDescending(x => x.LastActiveUtc))
                            {
                                var isSelf = SyncService.IsSelf(d.DeviceId);
                                <tr class="@(isSelf ? "sync-self-row" : "")">
                                    <td class="cf-sync-cell sync-device-name-cell">
                                        <span class="@(d.IsOnline ? "cf-status-online" : "cf-status-offline")" title="@(d.IsOnline ? "Online" : "Offline")">&#9679;</span>
                                        <strong>@d.Name</strong>
                                        @if (isSelf)
                                        {
                                            <span class="sync-self-label">(this device)</span>
                                        }
                                        @if (d.IsOnline)
                                        {
                                            <span class="online-text">online</span>
                                        }
                                        @if (d.IsNativeApp)
                                        {
                                            <span class="sync-cap-badge" title="Native desktop/mobile app">app</span>
                                        }
                                        else
                                        {
                                            <span class="sync-cap-badge" title="Web browser client">browser</span>
                                        }
                                    </td>
                                    <td class="cf-sync-cell sync-last-active-cell">
                                        @FormatLastActive(d.LastActiveUtc, d.IsOnline)
                                    </td>
                                    <td class="cf-sync-cell">
                                        @if (ShowAiServerOptions && !isSelf)
                                        {
                                            var isAiServerLabel = string.Equals(SyncService.AiServerDeviceId, d.DeviceId, StringComparison.OrdinalIgnoreCase);
                                            var showCheckbox = d.IsOnline || isAiServerLabel;
                                            var aiHint = isAiServerLabel && !d.IsOnline
                                                ? "Uncheck to stop routing chats through this offline device and use local AI again"
                                                : d.CanRelayAi && d.AiModelCount > 0
                                                    ? $"{d.AiModelCount} model(s) advertised"
                                                    : "Models discovered after connecting";
                                            if (showCheckbox)
                                            {
                                                <label class="ai-server-label" title="@($"Route chat completions through this device ({aiHint})")">
                                                    <input type="checkbox" checked="@isAiServerLabel" @onchange="(e) => ToggleAiServer(d.DeviceId, e)" />
                                                    <span>Use this device for my chats</span>
                                                </label>
                                            }
                                            if (d.IsOnline && !isAiServerLabel && d.CanRelayAi && d.AiModelCount > 0)
                                            {
                                                @:<div class="ai-hint-text">@d.AiModelCount model(s) available</div>
                                            }
                                            if (isAiServerLabel)
                                            {
                                                if (SyncService.IsAiProxyConnected)
                                                {
                                                    <span>Connected</span>
                                                }
                                                else if (!d.IsOnline)
                                                {
                                                    <span class="sync-warning-text">Offline — uncheck to use local AI</span>
                                                }
                                                else
                                                {
                                                    <span>Connecting</span>
                                                }
                                                @if (!string.IsNullOrEmpty(SyncService.AiProxyError))
                                                {
                                                    @:<span class="sync-warning-text"> &#8212; @SyncService.AiProxyError</span>
                                                }
                                            }
                                        }
                                        else if (!ShowAiServerOptions)
                                        {
                                            if (d.IsOnline)
                                            {
                                                @:<span class="cf-status-online">Online</span>
                                            }
                                            else
                                            {
                                                @:<span class="cf-status-offline">Offline</span>
                                            }
                                            if (d.CanRelayAi && d.AiModelCount > 0)
                                            {
                                                @:<span class="ai-hint-text">&#183; @d.AiModelCount AI model(s)</span>
                                            }
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (ShowAiServerOptions && !string.IsNullOrEmpty(SyncService.AiServerDeviceId))
                {
                    var aiServer = devices.FirstOrDefault(d => string.Equals(d.DeviceId, SyncService.AiServerDeviceId, StringComparison.OrdinalIgnoreCase));
                    var aiLabel = aiServer?.Name ?? "selected device";
                    var aiOffline = aiServer is null || !aiServer.IsOnline;
                    <div class="@(aiOffline ? "cf-sync-warning" : "cf-sync-success") sync-ai-route-banner">
                        Chat AI is routed through <strong>@aiLabel</strong>
                        @if (aiOffline)
                        {
                            <span> (offline — uncheck below or clear routing to use local AI)</span>
                        }
                        else if (SyncService.RemoteModels.Any())
                        {
                            <span> @SyncService.RemoteModels.Count model(s) available on Chat.</span>
                        }
                    </div>
                }

                <div class="sync-device-name-row">
                    <label class="form-label mb-0 sync-form-label">Rename this device:</label>
                    <input type="text"
                           @bind="newDeviceName"
                           placeholder="@SyncService.MyDeviceName"
                           class="form-control form-control-sm sync-input-field" />
                    <button type="button" @onclick="SaveDeviceName" class="btn btn-outline-secondary btn-sm sync-rename-save">Save</button>
                </div>
            }
            else
            {
                <div class="sync-muted-text py-2">Loading device list…</div>
            }
        </section>

        @* ── Panel 2: Sync targets ────────────────────────────────────── *@
        @if (devices.Any())
        {
            <section class="sync-panel">
                <div class="sync-panel-header">
                    <h3 class="sync-panel-title">Sync targets</h3>
                </div>

                <label class="sync-to-all-label">
                    <input type="checkbox" checked="@SyncService.SyncToAllDevices" @onchange="ToggleSyncToAll" />
                    <strong>Sync to all devices</strong>
                </label>
                <p class="sync-desc-text sync-panel-lead">
                    @if (SyncService.SyncToAllDevices)
                    {
                        <span>New devices are included automatically. Individual selection is locked while this is on.</span>
                    }
                    else
                    {
                        <span>Choose which devices receive sync. Turn on “Sync to all devices” to include every peer automatically.</span>
                    }
                </p>

                <div class="sync-subsection-title">Sync to these devices</div>
                @{
                    var others = SyncService.GetOtherDevices().ToList();
                }
                @if (others.Any())
                {
                    <div class="sync-target-list">
                        @foreach (var d in others)
                        {
                            var selected = SyncService.SyncToAllDevices || selectedTargetDeviceIds.Contains(d.DeviceId);
                            <label class="sync-target-label @(d.IsOnline ? "" : "sync-target-muted") @(SyncService.SyncToAllDevices ? "sync-target-locked" : "")">
                                <input type="checkbox"
                                       checked="@selected"
                                       disabled="@SyncService.SyncToAllDevices"
                                       @onchange="async (e) => await ToggleTarget(d.DeviceId, e)" />
                                <span class="@(d.IsOnline ? "cf-status-online" : "cf-status-offline")">&#9679;</span>
                                <span>@d.Name</span>
                                @if (d.IsOnline) { <span class="online-now">(online now)</span> }
                                else { <span class="sync-last-seen">(last seen @FormatLastActive(d.LastActiveUtc, false))</span> }
                            </label>
                        }
                    </div>
                }
                else
                {
                    <div class="sync-muted-text">No other devices are known for this account yet. Open Wizionic on another browser or device and log in with the same email.</div>
                }
            </section>
        }

        @* ── Panel: Storage limit ─────────────────────────────────────── *@
        <section class="sync-panel">
            <div class="sync-panel-header">
                <h3 class="sync-panel-title">Storage limit</h3>
                <button type="button" class="btn btn-outline-primary btn-sm" @onclick="RefreshStorageQuota" disabled="@_quotaBusy">
                    @(_quotaBusy ? "…" : "Refresh")
                </button>
            </div>
            <p class="sync-desc-text sync-panel-lead">
                Cap how much local space Wizionic may use for <strong>all</strong> synced data (chat, notes, gallery, etc.).
                Default is <strong>50% of available capacity</strong>
                @if (_quotaSnapshot?.CapacitySource == "browser-quota")
                {
                    <span> (browser storage quota for this site).</span>
                }
                else if (_quotaSnapshot?.CapacitySource == "disk-free")
                {
                    <span> (free disk space on this device).</span>
                }
                else
                {
                    <span>.</span>
                }
            </p>
            @if (_quotaSnapshot != null)
            {
                <div class="sync-muted-text" style="margin-bottom:8px;">
                    Used: <strong>@FormatBytes(_quotaSnapshot.AppUsageBytes)</strong>
                    · Capacity: <strong>@FormatBytes(_quotaSnapshot.AvailableCapacityBytes)</strong>
                    · Your limit: <strong>@FormatBytes(_quotaSnapshot.EffectiveLimitBytes)</strong>
                    (@_quotaPercent.ToString("0")%)
                </div>
                <div style="height:8px;background:var(--color-bg-muted,#eee);border-radius:4px;overflow:hidden;margin-bottom:12px;">
                    <div style="height:100%;width:@QuotaBarPercent()%;background:var(--primary-blue,#4a90d9);"></div>
                </div>
            }
            <label class="sync-auto-sync-label" style="display:flex;align-items:center;gap:12px;flex-wrap:wrap;">
                <span>Use up to</span>
                <input type="range" min="10" max="90" step="5" value="@_quotaPercent"
                       @oninput="OnQuotaPercentInput" style="flex:1;min-width:120px;" />
                <strong style="min-width:3rem;">@_quotaPercent.ToString("0")%</strong>
                <button type="button" class="btn btn-outline-primary btn-sm" @onclick="SaveQuotaSettings" disabled="@_quotaBusy">Save</button>
            </label>
            <div style="margin-top:8px;display:flex;gap:8px;flex-wrap:wrap;align-items:center;">
                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="CompactStorage" disabled="@_quotaBusy">
                    Reclaim free space
                </button>
                <span class="sync-muted-text" style="font-size:0.8rem;">
                    MAUI data folder: local chat/notes/gallery live in the app data DB (not homeserver.db).
                </span>
            </div>
            @if (!string.IsNullOrEmpty(_quotaMessage))
            {
                <div class="sync-muted-text" style="margin-top:8px;">@_quotaMessage</div>
            }
        </section>

        @* ── Panel 3: What to sync ────────────────────────────────────── *@
        <section class="sync-panel">
            <div class="sync-panel-header">
                <h3 class="sync-panel-title">What to sync</h3>
            </div>
            <p class="sync-desc-text sync-panel-lead">
                When <strong>Auto sync</strong> is on, changes push over encrypted WebRTC to the devices above (never through the server).
                Uncheck Auto sync on a row to show manual Sync controls.
            </p>

            <div class="sync-categories">
                @* Chat history *@
                <div class="sync-category-row">
                    <div class="sync-section-header">
                        <h4 class="sync-category-title">Chat history</h4>
                        @if (!SyncService.AutoSyncChatHistory)
                        {
                            <button @onclick="SyncAllConversations"
                                    class="btn btn-outline-primary btn-sm"
                                    disabled="@(!HasSyncTargets || !localConvos.Any() || isBulkSyncing)">
                                @(isBulkSyncing ? "Syncing…" : "Sync All")
                            </button>
                        }
                        <label class="sync-auto-sync-label ms-auto">
                            <span class="sync-muted-text" style="margin-right:10px;font-size:0.85rem;" title="Local encrypted chat history size">
                                @FormatBytes(_quotaSnapshot?.ChatHistoryBytes ?? 0)
                            </span>
                            <input type="checkbox" checked="@SyncService.AutoSyncChatHistory" @onchange="ToggleAutoSyncChat" />
                            Auto sync
                        </label>
                    </div>
                    @if (!SyncService.AutoSyncChatHistory)
                    {
                        @if (localConvos.Any())
                        {
                            <div class="sync-items-list">
                                @foreach (var c in localConvos.OrderByDescending(x => x.LastUpdated))
                                {
                                    <div class="cf-sync-card sync-item-row">
                                        <div class="sync-item-info">
                                            <div class="sync-item-title">@c.Title</div>
                                            <div class="sync-item-date">@c.LastUpdated.ToLocalTime().ToString("MMM d, HH:mm")</div>
                                        </div>
                                        <button @onclick="() => SyncConversation(c)"
                                                class="btn btn-outline-primary btn-sm"
                                                disabled="@(!HasSyncTargets)">Sync</button>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="sync-muted-text">No conversations yet on this device.</div>
                        }
                    }
                </div>

                @* Notes *@
                <div class="sync-category-row">
                    <div class="sync-section-header">
                        <h4 class="sync-category-title">Notes</h4>
                        @if (!SyncService.AutoSyncNotes)
                        {
                            <button @onclick="SyncAllNotes"
                                    class="btn btn-outline-primary btn-sm"
                                    disabled="@(!HasSyncTargets || !localNotes.Any() || isBulkSyncing)">
                                @(isBulkSyncing ? "Syncing…" : "Sync All")
                            </button>
                        }
                        <label class="sync-auto-sync-label ms-auto">
                            <span class="sync-muted-text" style="margin-right:10px;font-size:0.85rem;" title="Local encrypted notes size">
                                @FormatBytes(_quotaSnapshot?.NotesBytes ?? 0)
                            </span>
                            <input type="checkbox" checked="@SyncService.AutoSyncNotes" @onchange="ToggleAutoSyncNotes" />
                            Auto sync
                        </label>
                    </div>
                    @if (!SyncService.AutoSyncNotes)
                    {
                        @if (localNotes.Any())
                        {
                            <div class="sync-items-list">
                                @foreach (var n in localNotes.OrderByDescending(x => x.LastUpdated))
                                {
                                    <div class="cf-sync-card sync-item-row">
                                        <div class="sync-item-info">
                                            <div class="sync-item-title">@n.Title</div>
                                            <div class="sync-item-date">@n.LastUpdated.ToLocalTime().ToString("MMM d, HH:mm")</div>
                                        </div>
                                        <button @onclick="() => SyncNote(n)"
                                                class="btn btn-outline-primary btn-sm"
                                                disabled="@(!HasSyncTargets)">Sync</button>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="sync-muted-text">No notes yet on this device.</div>
                        }
                    }
                </div>

                @* Gallery *@
                <div class="sync-category-row">
                    <div class="sync-section-header">
                        <h4 class="sync-category-title">Gallery</h4>
                        @if (!SyncService.AutoSyncGallery)
                        {
                            <button @onclick="SyncAllAlbums"
                                    class="btn btn-outline-primary btn-sm"
                                    disabled="@(!HasSyncTargets || !localAlbums.Any() || isBulkSyncing)">
                                @(isBulkSyncing ? "Syncing…" : "Sync All")
                            </button>
                        }
                        <label class="sync-auto-sync-label ms-auto">
                            <span class="sync-muted-text" style="margin-right:10px;font-size:0.85rem;" title="Local encrypted gallery images size">
                                @FormatBytes(_quotaSnapshot?.GalleryBytes ?? 0)
                            </span>
                            <input type="checkbox" checked="@SyncService.AutoSyncGallery" @onchange="ToggleAutoSyncGallery" />
                            Auto sync
                        </label>
                    </div>
                    @if (!SyncService.AutoSyncGallery)
                    {
                        @if (localAlbums.Any())
                        {
                            <div class="sync-items-list">
                                @foreach (var a in localAlbums.OrderByDescending(x => x.LastUpdated))
                                {
                                    <div class="cf-sync-card sync-item-row">
                                        <div class="sync-item-info">
                                            <div class="sync-item-title">@a.Title</div>
                                            <div class="sync-item-date">@a.LastUpdated.ToLocalTime().ToString("MMM d, HH:mm")</div>
                                        </div>
                                        <button @onclick="() => SyncAlbum(a)"
                                                class="btn btn-outline-primary btn-sm"
                                                disabled="@(!HasSyncTargets)">Sync</button>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="sync-muted-text">No albums yet on this device.</div>
                        }
                    }
                </div>

                @* Calendar *@
                <div class="sync-category-row">
                    <div class="sync-section-header">
                        <h4 class="sync-category-title">Calendar</h4>
                        @if (!SyncService.AutoSyncCalendar)
                        {
                            <button @onclick="SyncAllCalendars"
                                    class="btn btn-outline-primary btn-sm"
                                    disabled="@(!HasSyncTargets || isBulkSyncing)">
                                @(isBulkSyncing ? "Syncing…" : "Sync All")
                            </button>
                        }
                        <label class="sync-auto-sync-label ms-auto">
                            <input type="checkbox" checked="@SyncService.AutoSyncCalendar" @onchange="ToggleAutoSyncCalendar" />
                            Auto sync
                        </label>
                    </div>
                    @if (!SyncService.AutoSyncCalendar)
                    {
                        <div class="sync-muted-text">Auto sync is off — use Sync All to push calendars and events over WebRTC.</div>
                    }
                </div>

                @if (AppEnvironment.IsMaui)
                {
                    <div class="sync-category-row">
                        <div class="sync-section-header">
                            <h4 class="sync-category-title">Bookmarks</h4>
                            @if (!SyncService.AutoSyncBookmarks)
                            {
                                <button @onclick="SyncAllBookmarks"
                                        class="btn btn-outline-primary btn-sm"
                                        disabled="@(!HasSyncTargets || !localBookmarks.Any() || isBulkSyncing)">
                                    @(isBulkSyncing ? "Syncing…" : "Sync All")
                                </button>
                            }
                            <label class="sync-auto-sync-label ms-auto">
                                <input type="checkbox" checked="@SyncService.AutoSyncBookmarks" @onchange="ToggleAutoSyncBookmarks" />
                                Auto sync
                            </label>
                        </div>
                        @if (!SyncService.AutoSyncBookmarks)
                        {
                            @if (localBookmarks.Any())
                            {
                                <div class="sync-items-list">
                                    @foreach (var bm in localBookmarks.OrderBy(x => x.Title, StringComparer.OrdinalIgnoreCase))
                                    {
                                        <div class="cf-sync-card sync-item-row">
                                            <div class="sync-item-info">
                                                <div class="sync-item-title">@(string.IsNullOrWhiteSpace(bm.Title) ? bm.Url : bm.Title)</div>
                                                <div class="sync-item-date">@bm.Url</div>
                                            </div>
                                            <button @onclick="() => SyncBookmark(bm)"
                                                    class="btn btn-outline-primary btn-sm"
                                                    disabled="@(!HasSyncTargets)">Sync</button>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="sync-muted-text">No bookmarks yet on this device.</div>
                            }
                        }
                    </div>

                    <div class="sync-category-row">
                        <div class="sync-section-header">
                            <h4 class="sync-category-title">Installed apps</h4>
                            @if (!SyncService.AutoSyncInstalledApps)
                            {
                                <button @onclick="SyncAllInstalledApps"
                                        class="btn btn-outline-primary btn-sm"
                                        disabled="@(!HasSyncTargets || !localApps.Any() || isBulkSyncing)">
                                    @(isBulkSyncing ? "Syncing…" : "Sync All")
                                </button>
                            }
                            <label class="sync-auto-sync-label ms-auto">
                                <input type="checkbox" checked="@SyncService.AutoSyncInstalledApps" @onchange="ToggleAutoSyncApps" />
                                Auto sync
                            </label>
                        </div>
                        @if (!SyncService.AutoSyncInstalledApps)
                        {
                            @if (localApps.Any())
                            {
                                <div class="sync-items-list">
                                    @foreach (var app in localApps.OrderBy(x => x.SortOrder).ThenBy(x => x.Name, StringComparer.OrdinalIgnoreCase))
                                    {
                                        <div class="cf-sync-card sync-item-row">
                                            <div class="sync-item-info">
                                                <div class="sync-item-title">@app.Name @(app.IsPwa ? "(PWA)" : "")</div>
                                                <div class="sync-item-date">@app.StartUrl</div>
                                            </div>
                                            <button @onclick="() => SyncInstalledApp(app)"
                                                    class="btn btn-outline-primary btn-sm"
                                                    disabled="@(!HasSyncTargets)">Sync</button>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="sync-muted-text">No pinned apps yet on this device.</div>
                            }
                        }
                    </div>
                }

                @SettingsSection("Local AI", SettingsSyncCategory.LocalAi, SyncService.AutoSyncLocalAi, ToggleAutoSyncLocalAi)
                @SettingsSection("Lemonade", SettingsSyncCategory.Lemonade, SyncService.AutoSyncLemonade, ToggleAutoSyncLemonade)
                @SettingsSection("Cloud Providers", SettingsSyncCategory.CloudProviders, SyncService.AutoSyncCloudProviders, ToggleAutoSyncCloudProviders)
                @if (AppEnvironment.IsMaui)
                {
                    @SettingsSection("Home Assistant", SettingsSyncCategory.HomeAssistant, SyncService.AutoSyncHomeAssistant, ToggleAutoSyncHomeAssistant)
                }
                @SettingsSection("Tools (MCP + Connectors)", SettingsSyncCategory.Tools, SyncService.AutoSyncTools, ToggleAutoSyncTools)
                @SettingsSection("Skills (SKILL.md)", SettingsSyncCategory.Skills, SyncService.AutoSyncSkills, ToggleAutoSyncSkills)
                @SettingsSection("System prompt", SettingsSyncCategory.SystemPrompt, SyncService.AutoSyncSystemPrompt, ToggleAutoSyncSystemPrompt)
                @SettingsSection("About you", SettingsSyncCategory.Profile, SyncService.AutoSyncProfile, ToggleAutoSyncProfile)
                @SettingsSection("Memories", SettingsSyncCategory.Memories, SyncService.AutoSyncMemories, ToggleAutoSyncMemories)
                @SettingsSection("Appearance", SettingsSyncCategory.Appearance, SyncService.AutoSyncAppearance, ToggleAutoSyncAppearance)
            </div>

            @if (!string.IsNullOrEmpty(statusMessage))
            {
                <div class="cf-sync-info-card mt-3">@statusMessage</div>
            }
        </section>

        @* ── Panel 4: Debug log ───────────────────────────────────────── *@
        <section class="sync-panel sync-panel--debug">
            <div class="sync-panel-header">
                <h3 class="sync-panel-title">Sync debug log</h3>
                <label class="sync-auto-sync-label">
                    <input type="checkbox" checked="@_syncDebugEnabled" @onchange="ToggleSyncDebug" />
                    Write log file
                </label>
                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="RefreshSyncDebug">Refresh</button>
                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="ClearSyncDebug">Clear</button>
                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="CopySyncDebug">
                    @(_syncDebugCopied ? "Copied" : "Copy")
                </button>
            </div>
            <p class="sync-desc-text sync-panel-lead">
                Live ring buffer of hub / WebRTC / browser sync events.
                @if (!string.IsNullOrEmpty(_syncLogFilePath))
                {
                    <span> File (when enabled): <code>@_syncLogFilePath</code></span>
                }

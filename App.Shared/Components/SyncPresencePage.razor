            var queued = await SyncService.SyncSettingsCategoryToDevicesAsync(category, targets);
            statusMessage = $"Queued {SettingsSyncCategory.DisplayName(category)} settings sync to {queued} device(s).";
        }
        finally { isBulkSyncing = false; StateHasChanged(); }
    }


    /// <summary>
    /// Prefer peers that advertised browser sync; if none have the flag yet (hub race),
    /// use all selected targets so first Sync All is not a no-op.
    /// </summary>
    private List<string> ResolveBrowserSyncTargets()
    {
        var selected = CurrentTargets().ToList();
        var capable = selected
            .Where(id => devices.Any(d =>
                string.Equals(d.DeviceId, id, StringComparison.OrdinalIgnoreCase) && d.SupportsBrowserSync))
            .ToList();
        return capable.Count > 0 ? capable : selected;
    }

    private async Task SyncAllBookmarks()
    {
        if (!HasSyncTargets) { statusMessage = "Select at least one target device above first."; StateHasChanged(); return; }
        isBulkSyncing = true; StateHasChanged();
        try
        {
            await SyncService.EnsureConnectedAndRegisteredAsync();
            if (!SyncService.IsConnected) { statusMessage = "Not connected to sync server. Try Refresh on the Devices section, then sync again."; return; }
            await BrowserStore.LoadAsync();
            var targets = ResolveBrowserSyncTargets();
            var advertised = targets.Count(id => devices.Any(d =>
                string.Equals(d.DeviceId, id, StringComparison.OrdinalIgnoreCase) && d.SupportsBrowserSync));
            var queued = await SyncService.SyncAllBookmarksToDevicesAsync(targets);
            var targetNames = devices.Where(d => targets.Contains(d.DeviceId)).Select(d => d.Name).ToList();
            var note = advertised == 0
                ? " (peers had not advertised browser sync yet — still attempting)"
                : "";
            statusMessage = $"Checking {queued} device(s) for bookmarks that need sync ({string.Join(", ", targetNames)}){note}. Only changed items are transferred.";
        }
        finally { isBulkSyncing = false; StateHasChanged(); }
    }


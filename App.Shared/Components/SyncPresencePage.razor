    private async Task SyncBookmark(BrowserBookmark bm)
    {
        if (!HasSyncTargets) { statusMessage = "Select at least one target device above first."; StateHasChanged(); return; }
        await SyncService.EnsureConnectedAndRegisteredAsync();
        var folder = BrowserStore.GetFolders().FirstOrDefault(f => f.Id == bm.FolderId);
        var targets = ResolveBrowserSyncTargets();
        foreach (var targetId in targets)
        {
            if (folder != null)
                await SyncService.StartWebRtcFolderSyncAsync(targetId, folder);
            await SyncService.StartWebRtcBookmarkSyncAsync(targetId, bm);
        }
        statusMessage = $"Syncing bookmark \"{(string.IsNullOrWhiteSpace(bm.Title) ? bm.Url : bm.Title)}\"…";
        StateHasChanged();
    }


    private async Task RefreshStorageQuota()
    {
        _quotaBusy = true;
        try
        {
            var settings = await StorageQuota.GetSettingsAsync();
            _quotaPercent = settings.PercentOfAvailable;
            _quotaSnapshot = await StorageQuota.GetSnapshotAsync();
        }
        catch (Exception ex)
        {
            _quotaMessage = "Could not read storage: " + ex.Message;
        }
        finally
        {
            _quotaBusy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void OnQuotaPercentInput(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), out var v))
            _quotaPercent = Math.Clamp(v, 10, 90);
    }

    private async Task SaveQuotaSettings()
    {
        _quotaBusy = true;
        try
        {
            await StorageQuota.SetSettingsAsync(new StorageQuotaSettings(_quotaPercent, null));
            _quotaSnapshot = await StorageQuota.GetSnapshotAsync();
            _quotaMessage = $"Saved. Limit is {FormatBytes(_quotaSnapshot.EffectiveLimitBytes)}.";
        }
        catch (Exception ex)
        {
            _quotaMessage = "Save failed: " + ex.Message;
        }
        finally
        {
            _quotaBusy = false;
        }
    }

    private async Task CompactStorage()
    {
        _quotaBusy = true;
        _quotaMessage = "Reclaiming free space…";
        try
        {
            await StorageQuota.CompactAsync();
            _quotaSnapshot = await StorageQuota.GetSnapshotAsync();
            _quotaMessage =
                $"Reclaimed. Used now {FormatBytes(_quotaSnapshot.AppUsageBytes)} " +
                $"(chat {FormatBytes(_quotaSnapshot.ChatHistoryBytes)}, notes {FormatBytes(_quotaSnapshot.NotesBytes)}, " +
                $"gallery {FormatBytes(_quotaSnapshot.GalleryBytes)}).";
        }
        catch (Exception ex)
        {
            _quotaMessage = "Compact failed: " + ex.Message;
        }
        finally
        {
            _quotaBusy = false;
        }
    }

    private double QuotaBarPercent()
    {
        if (_quotaSnapshot == null || _quotaSnapshot.EffectiveLimitBytes <= 0)
            return 0;
        return Math.Min(100, 100.0 * _quotaSnapshot.AppUsageBytes / _quotaSnapshot.EffectiveLimitBytes);
    }

    private static string FormatBytes(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        double v = bytes;
        string[] units = { "KB", "MB", "GB", "TB" };
        var i = -1;
        do { v /= 1024; i++; } while (v >= 1024 && i < units.Length - 1);
        return $"{v:0.##} {units[i]}";
    }

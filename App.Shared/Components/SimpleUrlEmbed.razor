@*
  Embed a URL with no address bar.
  - MAUI Windows/Linux: native WebView overlay (required for Home Assistant — X-Frame-Options).
  - WASM / host: iframe (requires the target to allow framing).
*@
@using App.Core.UI
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IUrlEmbedOverlay EmbedOverlay
@inject IJSRuntime JS
@inject NavigationManager Nav

@if (UseNativeOverlay)
{
    <div @ref="_hostRef"
         class="simple-url-embed-host"
         data-url-embed="native">
        @if (string.IsNullOrWhiteSpace(NormalizedUrl) || NormalizedUrl == "about:blank")
        {
            <div class="simple-url-embed-placeholder">No URL</div>
        }
    </div>
}
else if (!AllowIframe || !CanUseIframe)
{
    @* HA and mixed-content targets must not go in an iframe — blank pane / NotFound. *@
    <div class="simple-url-embed-placeholder" style="padding:1.5rem;color:var(--cf-text-muted);">
        @if (!AllowIframe)
        {
            <text>This site cannot be framed. Use the desktop app’s native embed, or open it in a browser.</text>
        }
        else
        {
            <text>Cannot embed this URL here (mixed content or invalid address). Open it in a new tab instead.</text>
        }
    </div>
}
else
{
    @* No sandbox: HA and other SPAs break under restrictive sandbox. *@
    <iframe class="simple-url-embed"
            src="@NormalizedUrl"
            title="@Title"
            referrerpolicy="no-referrer-when-downgrade"
            allow="clipboard-read; clipboard-write; microphone; autoplay; fullscreen">
    </iframe>
}

@code {
    [Parameter] public string? Url { get; set; }
    [Parameter] public string Title { get; set; } = "Embedded page";
    /// <summary>
    /// When false, never fall back to an iframe (Home Assistant sends X-Frame-Options: SAMEORIGIN).
    /// </summary>
    [Parameter] public bool AllowIframe { get; set; } = true;

    private ElementReference _hostRef;
    private DotNetObjectReference<SimpleUrlEmbed>? _dotNetRef;
    private bool _jsAttached;
    private bool _useIframeFallback;
    private bool _nativeAttachFailed;
    private string _lastShownUrl = "";

    /// <summary>MAUI native overlay, unless JS interop failed.</summary>
    private bool UseNativeOverlay => EmbedOverlay.IsNative && !_useIframeFallback && !_nativeAttachFailed;

    private string NormalizedUrl
    {
        get
        {
            var u = (Url ?? "").Trim();
            if (string.IsNullOrWhiteSpace(u))
                return "about:blank";
            // Scheme-less values are relative to the site origin in HTML — force absolute.
            if (!u.StartsWith("http://", StringComparison.OrdinalIgnoreCase)
                && !u.StartsWith("https://", StringComparison.OrdinalIgnoreCase)
                && !string.Equals(u, "about:blank", StringComparison.OrdinalIgnoreCase))
            {
                u = "http://" + u.TrimStart('/');
            }
            return u.TrimEnd('/');
        }
    }

    /// <summary>
    /// Iframe only for absolute http(s) URLs that are not mixed content on an HTTPS page.
    /// </summary>
    private bool CanUseIframe
    {
        get
        {
            var u = NormalizedUrl;
            if (string.IsNullOrWhiteSpace(u) || string.Equals(u, "about:blank", StringComparison.OrdinalIgnoreCase))
                return false;
            if (!Uri.TryCreate(u, UriKind.Absolute, out var target)
                || (target.Scheme != Uri.UriSchemeHttp && target.Scheme != Uri.UriSchemeHttps))
            {
                return false;
            }

            var pageHttps = Nav.BaseUri.StartsWith("https:", StringComparison.OrdinalIgnoreCase);
            // Desktop WebView (MAUI) allows local http embeds even when the Blazor
            // host origin is https://0.0.0.0/ — same path Linux and Chatfish use.
            if (pageHttps && target.Scheme == Uri.UriSchemeHttp)
                return AppEnvironment.IsMaui;

            return true;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!UseNativeOverlay)
            return;

        var url = NormalizedUrl;
        if (url == "about:blank")
        {
            EmbedOverlay.Hide(this);
            _lastShownUrl = "";
            return;
        }

        if (!string.Equals(_lastShownUrl, url, StringComparison.OrdinalIgnoreCase))
        {
            EmbedOverlay.Show(url, this);
            _lastShownUrl = url;
        }

        await MeasureAndReportAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!UseNativeOverlay)
            return;

        if (firstRender || !_jsAttached)
        {
            try
            {
                _dotNetRef ??= DotNetObjectReference.Create(this);
                await JS.InvokeVoidAsync("appUrlEmbed.attach", _hostRef, _dotNetRef);
                _jsAttached = true;
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[UrlEmbed] attach failed{(AllowIframe ? ", falling back to iframe" : "")}: {ex.Message}");
                if (AllowIframe)
                    _useIframeFallback = true;
                else
                    _nativeAttachFailed = true;
                EmbedOverlay.Hide(this);
                StateHasChanged();
                return;
            }
        }

        await MeasureAndReportAsync();
    }

    private async Task MeasureAndReportAsync()
    {
        if (!UseNativeOverlay || !_jsAttached)
            return;
        try
        {
            await JS.InvokeVoidAsync("appUrlEmbed.measure", _hostRef);
        }
        catch
        {
            // host may not be in DOM yet
        }
    }

    [JSInvokable]
    public void OnBounds(double x, double y, double width, double height)
    {
        EmbedOverlay.UpdateBounds(x, y, width, height, this);
    }

    public async ValueTask DisposeAsync()
    {
        if (UseNativeOverlay || _jsAttached)
        {
            try
            {
                if (_jsAttached)
                    await JS.InvokeVoidAsync("appUrlEmbed.detach", _hostRef);
            }
            catch
            {
                // ignore
            }

            EmbedOverlay.Hide(this);
        }

        _dotNetRef?.Dispose();
        _dotNetRef = null;
    }
}

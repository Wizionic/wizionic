@inject App.Core.Storage.IKeyStore KeyStore
@inject App.Core.Storage.ISettingsSyncStore SettingsSync
@inject App.Core.Sync.ISyncService SyncService
@inject NavigationManager Nav
@inject HttpClient Http
@inject App.Core.Auth.IAuthService Auth
@inject App.Core.Connectors.IUriLauncher UriLauncher
@inject App.Core.Connectors.OAuthReturnBridge? OAuthReturn
@inject App.Core.Storage.IMcpToolRefresher? McpToolRefresher
@inject App.Core.Connectors.IOpenApiConnectorRefresher? OpenApiRefresher
@using App.Core.Connectors
@using App.Core.Sync
@using App.Shared.Services
@using App.Shared.Services.Connectors
@implements IDisposable

<div class="settings-content cf-connectors-page">
    <div class="cf-conn-top">
        <div class="cf-conn-tabs">
            <button type="button" class="cf-conn-tab @(activeTab == "skills" ? "cf-conn-tab-active" : "")"
                    @onclick="ShowSkillsTab">Skills</button>
            <button type="button" class="cf-conn-tab @(activeTab == "tools" ? "cf-conn-tab-active" : "")"
                    @onclick="ShowToolsTab">Tools</button>
        </div>
        @if (activeTab == "tools")
        {
            <div class="cf-conn-search">
                <span class="cf-conn-search-icon" aria-hidden="true">🔍</span>
                <input type="search"
                       value="@searchQuery"
                       @oninput="OnSearchInput"
                       placeholder="Search tools…"
                       class="cf-conn-search-input" />
                @if (isSearching)
                {
                    <span class="cf-conn-search-busy" title="Searching registry…">…</span>
                }
            </div>
        }
    </div>

    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="cf-conn-banner @(statusIsError ? "cf-conn-banner-error" : "cf-conn-banner-ok")">
            @statusMessage
            <button type="button" class="cf-conn-banner-close" @onclick="() => statusMessage = null">✕</button>
        </div>
    }

    @if (activeTab == "skills")
    {
        <section class="cf-conn-section">
            <h2 class="cf-conn-section-title">Skills</h2>
            <p class="text-muted" style="font-size:0.88rem;margin:-0.35rem 0 0.85rem;">
                Reusable SKILL.md procedures (Agent Skills open standard). Run from here or type <code>/skill-name</code> in chat.
            </p>
            <SkillsPanel />
        </section>
    }
    else
    {

    <!-- ========== Installed ========== -->
    <section class="cf-conn-section">
        <div class="cf-conn-section-head">
            <h2 class="cf-conn-section-title">Installed</h2>
            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="OpenAddCustomDialog">
                + Custom MCP
            </button>
        </div>
        @if (!FilteredInstalled.Any())
        {
            <p class="cf-conn-empty">No tools installed yet. Browse Discover below or search the registry.</p>
        }
        else
        {
            <div class="cf-tool-grid">
                @foreach (var item in FilteredInstalled)
                {
                    <div class="cf-tool-card">
                        <div class="cf-tool-card-main cf-tool-card-main-static">
                            @RenderToolIcon(item.IconText, item.IconBackground, item.IconImageUrl)
                            <div class="cf-tool-card-body">
                                <div class="cf-tool-card-title-row">
                                    <span class="cf-tool-card-title">@item.DisplayName</span>
                                    @if (item.Kind == ConnectorKind.OpenApiOAuth)
                                    {
                                        <span class="cf-tool-kind">OAuth</span>
                                    }
                                    else if (item.IsCustomMcp)
                                    {
                                        <span class="cf-tool-kind">Custom</span>
                                    }
                                    else
                                    {
                                        <span class="cf-tool-kind">MCP</span>
                                    }
                                    @if (!item.Enabled)
                                    {
                                        <span class="cf-conn-card-badge">Disabled</span>
                                    }
                                </div>
                                @if (!string.IsNullOrWhiteSpace(item.Description))
                                {
                                    <div class="cf-tool-card-desc">@item.Description</div>
                                }
                                <div class="cf-tool-card-meta">
                                    @if (!string.IsNullOrWhiteSpace(item.Publisher))
                                    {
                                        <span class="cf-tool-by">By @item.Publisher</span>
                                    }
                                    else if (!string.IsNullOrWhiteSpace(item.Subtitle))
                                    {
                                        <span class="cf-tool-by">@item.Subtitle</span>
                                    }
                                    <span class="cf-conn-status">@(item.Enabled ? "Connected" : "Off")</span>
                                </div>
                            </div>
                        </div>
                        <div class="cf-tool-card-actions">
                            <div class="cf-conn-menu-wrap">
                                <button type="button"
                                        class="cf-conn-menu-btn"
                                        @onclick="() => ToggleMenu(item.Id)"
                                        title="Options">⋮</button>
                                @if (openMenuId == item.Id)
                                {
                                    <div class="cf-conn-menu">
                                        @if (item.Kind == ConnectorKind.Mcp)
                                        {
                                            <button type="button" @onclick="() => OpenMcpTokenEditor(item)">Token…</button>
                                        }
                                        <button type="button" @onclick="() => ToggleInstalledEnabled(item)">
                                            @(item.Enabled ? "Disable" : "Enable")
                                        </button>
                                        <button type="button" class="cf-conn-menu-danger" @onclick="() => Disconnect(item)">
                                            Disconnect
                                        </button>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </section>

    <!-- ========== Discover ========== -->
    <section class="cf-conn-section">
        <div class="cf-conn-section-head">
            <h2 class="cf-conn-section-title">
                @(string.IsNullOrWhiteSpace(searchQuery) ? "Discover" : "Search results")
            </h2>
            <button type="button" class="btn btn-outline-primary btn-sm" @onclick="() => RefreshDiscoverAsync()" disabled="@(isLoading || isSearching)">
                @(isLoading || isSearching ? "Loading…" : "Refresh")
            </button>
        </div>

        @if (!string.IsNullOrEmpty(loadError))
        {
            <div class="cf-dialog-error">
                @loadError
                <button @onclick="() => RefreshDiscoverAsync()" class="btn btn-link" style="padding:0 0.25rem; font-size:0.9em;">Retry</button>
            </div>
        }

        @if ((isLoading || isSearching) && !discoverOAuth.Any() && !registryTools.Any())
        {
            <div class="text-muted" style="padding:0.5rem 0;">Loading tools…</div>
        }
        else if (!FilteredDiscoverOAuth.Any() && !FilteredDiscoverMcp.Any())
        {
            <p class="cf-conn-empty">
                @if (!string.IsNullOrWhiteSpace(searchQuery))
                {
                    <text>No remote-capable tools match “@searchQuery”. Try another query.</text>
                }
                else if (!string.IsNullOrEmpty(catalogLoadError))
                {
                    <text>Could not load catalog (@catalogLoadError).</text>
                }
                else
                {
                    <text>No tools to discover right now. Add OAuth connectors in the server database, or search the MCP registry.</text>
                }
            </p>
        }
        else
        {
            <div class="cf-tool-grid">
                @foreach (var entry in FilteredDiscoverOAuth)
                {
                    var installed = IsOAuthInstalled(entry.ConnectorId);
                    <div class="cf-tool-card">
                        <button type="button"
                                class="cf-tool-card-main"
                                @onclick="() => OpenOAuthDetails(entry)"
                                title="Details — @entry.DisplayName">
                            @RenderToolIcon(entry.IconText, entry.IconBackground, entry.IconImageUrl)
                            <div class="cf-tool-card-body">
                                <div class="cf-tool-card-title-row">
                                    <span class="cf-tool-card-title">@entry.DisplayName</span>
                                    <span class="cf-tool-kind">OAuth</span>
                                    @if (installed)
                                    {
                                        <span class="cf-conn-card-badge">Installed</span>
                                    }
                                </div>
                                @if (!string.IsNullOrWhiteSpace(entry.Description))
                                {
                                    <div class="cf-tool-card-desc">@entry.Description</div>
                                }
                                <div class="cf-tool-card-meta">
                                    <span class="cf-tool-by">By Wizionic</span>
                                </div>
                            </div>
                        </button>
                        <div class="cf-tool-card-actions">
                            @if (installed)
                            {
                                <button type="button" class="btn btn-outline-secondary btn-sm"
                                        @onclick="() => ToggleMenu(OAuthMenuId(entry.ConnectorId))">
                                    Manage
                                </button>
                            }
                            else
                            {
                                <button type="button" class="btn btn-primary btn-sm"
                                        @onclick="() => OnFeaturedOAuthClick(entry)">
                                    Connect
                                </button>
                            }
                        </div>
                    </div>
                }

                @foreach (var mcp in FilteredDiscoverMcp)
                {
                    <div class="cf-tool-card">
                        <button type="button"
                                class="cf-tool-card-main"
                                @onclick="() => OpenMcpDetails(mcp)"
                                title="Details — @mcp.DisplayTitle">
                            @RenderToolIcon("🔌", "var(--color-bg-muted, #f3f4f6)", mcp.IconUrl)
                            <div class="cf-tool-card-body">
                                <div class="cf-tool-card-title-row">
                                    <span class="cf-tool-card-title">@mcp.DisplayTitle</span>
                                    <span class="cf-tool-kind">MCP</span>
                                    @if (mcp.RequiresAuth)
                                    {
                                        <span class="cf-badge-auth">token</span>
                                    }
                                </div>
                                @if (!string.IsNullOrWhiteSpace(mcp.Description))
                                {
                                    <div class="cf-tool-card-desc">@mcp.Description</div>
                                }
                                <div class="cf-tool-card-meta">
                                    @if (!string.IsNullOrWhiteSpace(mcp.Publisher))
                                    {
                                        <span class="cf-tool-by">By @mcp.Publisher</span>
                                    }
                                </div>
                            </div>
                        </button>
                        <div class="cf-tool-card-actions">
                            <button type="button" class="btn btn-primary btn-sm"
                                    @onclick="() => InstallMcpAsync(mcp)">
                                Install
                            </button>
                        </div>
                    </div>
                }
            </div>
        }
    </section>

    <div style="margin-top: 1.5rem; display:flex; gap:0.5rem; align-items:center; flex-wrap:wrap;">
        <button @onclick="@(() => Nav.NavigateTo("/chat"))" class="btn btn-outline-secondary">Back to Chat</button>
        <small class="text-muted">MCP list from the official registry · install config stays on this device · tools sync with Devices &amp; Sync.</small>
    </div>

    } @* end tools tab *@
</div>

<ConfirmDialog IsVisible="@(!string.IsNullOrEmpty(removeCustomName))"
               Title="Remove custom connector?"
               Message="@($"Remove custom connector \"{removeCustomName}\"?")"
               ConfirmText="Remove"
               OnConfirm="ConfirmRemoveCustom"
               OnCancel="() => removeCustomName = null" />

@if (showAddCustomDialog)
{
    <div @onclick="CloseCustomDialog" class="cf-conn-modal-backdrop">
        <div @onclick:stopPropagation class="cf-conn-modal">
            <div class="cf-conn-modal-title">Custom MCP connector</div>
            <div class="text-muted" style="font-size:0.85rem; margin-bottom:1rem;">
                Enter a name and an MCP server URL (HTTP/SSE)
            </div>
            <div style="margin-bottom:0.75rem;">
                <label class="cf-conn-label">Name</label>
                <input type="text" @bind="newCustomName" placeholder="My Connector" class="cf-dialog-input" />
            </div>
            <div style="margin-bottom:1rem;">
                <label class="cf-conn-label">Server URL</label>
                <input type="text" @bind="newCustomUrl" placeholder="https://mcp.example.com/sse" class="cf-dialog-input" />
            </div>
            @if (!string.IsNullOrEmpty(customDialogError))
            {
                <div class="cf-dialog-error">@customDialogError</div>
            }
            <div style="display:flex; justify-content:space-between;">
                <button @onclick="CloseCustomDialog" class="btn btn-outline-secondary">Cancel</button>
                <button @onclick="AddCustomConnector" class="btn btn-primary">Add Connector</button>
            </div>
        </div>
    </div>
}

@if (tokenEditor is not null)
{
    <div @onclick="() => tokenEditor = null" class="cf-conn-modal-backdrop">
        <div @onclick:stopPropagation class="cf-conn-modal">
            <div class="cf-conn-modal-title">MCP token — @tokenEditor.DisplayName</div>
            <input type="password"
                   @bind="tokenEditorValue"
                   class="cf-dialog-input"
                   placeholder="Paste bearer token / API key" />
            <div style="display:flex; justify-content:flex-end; gap:0.5rem; margin-top:1rem;">
                <button class="btn btn-outline-secondary" @onclick="() => tokenEditor = null">Cancel</button>
                <button class="btn btn-primary" @onclick="SaveTokenEditor">Save</button>
            </div>
        </div>
    </div>
}

@if (detailsMcp is not null)
{
    <div @onclick="() => detailsMcp = null" class="cf-conn-modal-backdrop">
        <div @onclick:stopPropagation class="cf-conn-modal cf-tool-details-modal">
            <div class="cf-tool-details-head">
                @RenderToolIcon("🔌", "var(--color-bg-muted, #f3f4f6)", detailsMcp.IconUrl)
                <div>
                    <div class="cf-conn-modal-title" style="margin-bottom:0.15rem;">@detailsMcp.DisplayTitle</div>
                    @if (!string.IsNullOrWhiteSpace(detailsMcp.Publisher))
                    {
                        <div class="cf-tool-by">By @detailsMcp.Publisher</div>
                    }
                </div>
            </div>
            @if (!string.IsNullOrWhiteSpace(detailsMcp.Description))
            {
                <p class="cf-tool-details-desc">@detailsMcp.Description</p>
            }
            <dl class="cf-tool-details-dl">
                <div><dt>Registry id</dt><dd><code>@detailsMcp.Name</code></dd></div>
                <div><dt>Transport</dt><dd>@detailsMcp.Transport</dd></div>
                @if (!string.IsNullOrWhiteSpace(detailsMcp.Version))
                {
                    <div><dt>Version</dt><dd>@detailsMcp.Version</dd></div>
                }
                @if (!string.IsNullOrWhiteSpace(detailsMcp.RemoteUrl))
                {
                    <div><dt>Endpoint</dt><dd class="cf-tool-details-url">@detailsMcp.RemoteUrl</dd></div>
                }
                @if (detailsMcp.RequiresAuth)
                {
                    <div><dt>Auth</dt><dd>Bearer token required after install</dd></div>
                }
            </dl>
            <div style="display:flex; justify-content:space-between; gap:0.5rem; margin-top:1.1rem; flex-wrap:wrap;">
                <div style="display:flex; gap:0.5rem;">
                    @if (!string.IsNullOrWhiteSpace(detailsMcp.InfoUrl))
                    {
                        <a class="btn btn-outline-secondary btn-sm" href="@detailsMcp.InfoUrl" target="_blank" rel="noopener">Docs / site</a>
                    }
                </div>
                <div style="display:flex; gap:0.5rem;">
                    <button type="button" class="btn btn-outline-secondary" @onclick="() => detailsMcp = null">Close</button>
                    @if (!detailsMcp.IsEnabled)
                    {
                        <button type="button" class="btn btn-primary" @onclick="() => InstallMcpFromDetailsAsync()">Install</button>
                    }
                </div>
            </div>
        </div>
    </div>
}

@if (detailsOAuth is not null)
{
    <div @onclick="() => detailsOAuth = null" class="cf-conn-modal-backdrop">
        <div @onclick:stopPropagation class="cf-conn-modal cf-tool-details-modal">
            <div class="cf-tool-details-head">
                @RenderToolIcon(detailsOAuth.IconText, detailsOAuth.IconBackground, detailsOAuth.IconImageUrl)
                <div>
                    <div class="cf-conn-modal-title" style="margin-bottom:0.15rem;">@detailsOAuth.DisplayName</div>
                    <div class="cf-tool-by">By Wizionic · OAuth</div>
                </div>
            </div>
            @if (!string.IsNullOrWhiteSpace(detailsOAuth.Description))
            {
                <p class="cf-tool-details-desc">@detailsOAuth.Description</p>
            }
            <div style="display:flex; justify-content:flex-end; gap:0.5rem; margin-top:1.1rem;">
                <button type="button" class="btn btn-outline-secondary" @onclick="() => detailsOAuth = null">Close</button>
                @if (!IsOAuthInstalled(detailsOAuth.ConnectorId))
                {
                    <button type="button" class="btn btn-primary" @onclick="() => ConnectOAuthFromDetailsAsync()">Connect</button>
                }
            </div>
        </div>
    </div>
}

@code {
    private string activeTab = "skills";
    private void ShowSkillsTab() => activeTab = "skills";
    private void ShowToolsTab() => activeTab = "tools";
    private List<ManagedMcpTool> registryTools = new();
    private List<ManagedMcpTool> customTools = new();
    private bool isLoading;
    private bool isSearching;
    private string? loadError;
    private string searchQuery = "";
    private string? openMenuId;
    private string? statusMessage;
    private bool statusIsError;
    private string? removeCustomName;

    private bool showAddCustomDialog;
    private string newCustomName = "";
    private string newCustomUrl = "";
    private string customDialogError = "";

    private InstalledItem? tokenEditor;
    private string tokenEditorValue = "";
    private ManagedMcpTool? detailsMcp;
    private CatalogItem? detailsOAuth;

    private Dictionary<string, bool> oauthProviderReady = new(StringComparer.OrdinalIgnoreCase);
    private List<CatalogItem> allCatalog = new();
    private string? catalogLoadError;

    private CancellationTokenSource? _searchCts;
    private int _searchGeneration;

    private IEnumerable<CatalogItem> discoverOAuth =>
        allCatalog
            .OrderByDescending(c => c.Featured)
            .ThenBy(c => c.SortOrder)
            .ThenBy(c => c.DisplayName, StringComparer.OrdinalIgnoreCase);

    private IEnumerable<CatalogItem> FilteredDiscoverOAuth
    {
        get
        {
            var q = searchQuery?.Trim() ?? "";
            var items = discoverOAuth.AsEnumerable();
            if (!string.IsNullOrEmpty(q))
            {
                items = items.Where(e =>
                    e.DisplayName.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                    (e.Description?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    e.ConnectorId.Contains(q, StringComparison.OrdinalIgnoreCase));
            }
            // Hide already-installed OAuth from Discover (they live under Installed).
            return items.Where(e => !IsOAuthInstalled(e.ConnectorId));
        }
    }

    private IEnumerable<ManagedMcpTool> FilteredDiscoverMcp =>
        registryTools.Where(t => !t.IsEnabled);

    private IEnumerable<InstalledItem> FilteredInstalled
    {
        get
        {
            var items = BuildInstalled();
            var q = searchQuery?.Trim() ?? "";
            if (string.IsNullOrEmpty(q))
                return items;
            return items.Where(i =>
                i.DisplayName.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                (i.Description?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (i.Publisher?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (i.Subtitle?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false));
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (OAuthReturn is not null)
            OAuthReturn.Changed += OnOAuthReturnBridgeChanged;

        // Default to Skills; allow ?tab=tools or ?tab=skills
        try
        {
            var uri = Nav.ToAbsoluteUri(Nav.Uri);
            var q = uri.Query.TrimStart('?');
            foreach (var part in q.Split('&', StringSplitOptions.RemoveEmptyEntries))
            {
                var eq = part.IndexOf('=');
                if (eq <= 0) continue;
                var key = Uri.UnescapeDataString(part[..eq]);
                var val = Uri.UnescapeDataString(part[(eq + 1)..]);
                if (key.Equals("tab", StringComparison.OrdinalIgnoreCase) &&
                    val.Equals("tools", StringComparison.OrdinalIgnoreCase))
                {
                    activeTab = "tools";
                    break;
                }
            }
        }
        catch { /* keep default skills */ }

        await KeyStore.LoadAsync();
        await LoadCatalogAsync();
        await LoadOAuthStatusAsync();
        LoadCustomsFromStore();
        await RefreshDiscoverAsync();
        ApplyPendingOAuthStatus();
        await HandleOAuthReturnAsync();
        await RefreshOpenApiToolsAsync();
    }

    public void Dispose()
    {
        if (OAuthReturn is not null)
            OAuthReturn.Changed -= OnOAuthReturnBridgeChanged;
        _searchCts?.Cancel();
        _searchCts?.Dispose();
    }

    private async Task LoadCatalogAsync()
    {
        catalogLoadError = null;
        try
        {
            // Source of truth: SQLite Connectors table via host API. Empty DB ⇒ no OAuth entries.
            var list = await Http.GetFromJsonAsync<List<CatalogItem>>("/api/connectors/catalog");
            allCatalog = list ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Tools] Catalog load failed: {ex.Message}");
            catalogLoadError = "could not load catalog from server";
            allCatalog = new();
        }
    }

    private void ApplyPendingOAuthStatus()
    {
        var status = OAuthReturn?.TakeStatus();
        if (status is null) return;
        statusMessage = status.Value.Message;
        statusIsError = status.Value.IsError;
    }

    private void OnOAuthReturnBridgeChanged() =>
        _ = InvokeAsync(async () =>
        {
            ApplyPendingOAuthStatus();
            await HandleOAuthReturnAsync();
            StateHasChanged();
        });

    private async Task LoadOAuthStatusAsync()
    {
        try
        {
            var status = await Http.GetFromJsonAsync<Dictionary<string, bool>>("/api/oauth/status");
            if (status is not null)
                oauthProviderReady = new Dictionary<string, bool>(status, StringComparer.OrdinalIgnoreCase);
        }
        catch
        {
            // Host may not expose status during partial deploys
        }
    }

    private async Task HandleOAuthReturnAsync()
    {
        var queryString = OAuthReturn?.TakePendingQuery();
        if (string.IsNullOrWhiteSpace(queryString))
            queryString = Nav.ToAbsoluteUri(Nav.Uri).Query;

        var query = ParseQuery(queryString ?? "");

        if (query.TryGetValue("oauth_error", out var err) && !string.IsNullOrWhiteSpace(err))
        {
            statusMessage = Uri.UnescapeDataString(err);
            statusIsError = true;
            ClearOAuthQuery();
            return;
        }

        if (!query.TryGetValue("oauth_session", out var sessionId) || string.IsNullOrWhiteSpace(sessionId))
            return;

        try
        {
            var sessionUrl = $"/api/oauth/session/{Uri.EscapeDataString(sessionId)}";
            var session = await Http.GetFromJsonAsync<OAuthSessionDto>(sessionUrl);
            if (session is null || string.IsNullOrWhiteSpace(session.AccessToken))
            {
                statusMessage = "OAuth session expired. Please try connecting again.";
                statusIsError = true;
            }
            else
            {
                var connectorId = !string.IsNullOrWhiteSpace(session.ConnectorId)
                    ? session.ConnectorId
                    : (query.GetValueOrDefault("oauth_connector") ?? "");

                var tokens = new OAuthTokenSet(
                    session.AccessToken,
                    session.RefreshToken,
                    session.ExpiresAtUtc,
                    session.TokenType,
                    session.Scope,
                    session.AccountLabel);

                await KeyStore.UpsertOAuthConnectorAsync(new OAuthConnectorInstall(
                    connectorId,
                    Enabled: true,
                    Tokens: tokens,
                    ConnectedAtUtc: DateTimeOffset.UtcNow,
                    AccountLabel: session.AccountLabel));

                await SettingsSyncHooks.AfterLocalSaveAsync(SettingsSync, SyncService, SettingsSyncCategory.Tools);
                await RefreshOpenApiToolsAsync();

                statusMessage = $"Connected {ConnectorCatalog.DisplayNameFor(connectorId)}"
                    + (string.IsNullOrWhiteSpace(session.AccountLabel) ? "" : $" ({session.AccountLabel})");
                statusIsError = false;
            }
        }
        catch (Exception ex)
        {
            statusMessage = $"Could not complete OAuth: {ex.Message}";
            statusIsError = true;
        }

        ClearOAuthQuery();
    }

    private void ClearOAuthQuery()
    {
        try
        {
            var abs = Nav.ToAbsoluteUri(Nav.Uri);
            if (abs.Scheme is "http" or "https"
                && abs.AbsolutePath.Contains("tools", StringComparison.OrdinalIgnoreCase)
                && abs.Query.Contains("oauth_", StringComparison.OrdinalIgnoreCase))
            {
                Nav.NavigateTo("/tools", forceLoad: false, replace: true);
            }
        }
        catch
        {
            // ignore
        }
    }

    private static Dictionary<string, string> ParseQuery(string query)
    {
        var dict = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        if (string.IsNullOrWhiteSpace(query)) return dict;
        var q = query.StartsWith('?') ? query[1..] : query;
        foreach (var part in q.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var eq = part.IndexOf('=');
            if (eq <= 0) continue;
            var key = Uri.UnescapeDataString(part[..eq]);
            var val = Uri.UnescapeDataString(part[(eq + 1)..]);
            dict[key] = val;
        }
        return dict;
    }

    private List<InstalledItem> BuildInstalled()
    {
        var list = new List<InstalledItem>();

        foreach (var o in KeyStore.GetOAuthConnectors().Where(c => c.Tokens is not null))
        {
            var cat = allCatalog.FirstOrDefault(c =>
                c.ConnectorId.Equals(o.ConnectorId, StringComparison.OrdinalIgnoreCase));
            list.Add(new InstalledItem
            {
                Id = "oauth:" + o.ConnectorId,
                ConnectorId = o.ConnectorId,
                DisplayName = cat?.DisplayName ?? ConnectorCatalog.DisplayNameFor(o.ConnectorId),
                Description = cat?.Description,
                Subtitle = o.AccountLabel ?? o.Tokens?.AccountLabel,
                Publisher = null,
                IconText = cat?.IconText ?? "⬡",
                IconBackground = cat?.IconBackground ?? "#6b7280",
                IconImageUrl = cat?.IconImageUrl,
                Kind = ConnectorKind.OpenApiOAuth,
                Enabled = o.Enabled,
                McpName = null
            });
        }

        // Enabled MCP from registry list + custom installs (with stored URL).
        var seen = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        foreach (var t in registryTools.Where(x => x.IsEnabled).Concat(customTools.Where(x => x.IsEnabled)))
        {
            if (!seen.Add(t.Name)) continue;
            list.Add(new InstalledItem
            {
                Id = "mcp:" + t.Name,
                ConnectorId = t.Name,
                DisplayName = t.DisplayTitle,
                Description = t.Description,
                Subtitle = t.IsCustom ? "Custom MCP" : "MCP",
                Publisher = t.Publisher,
                IconText = "🔌",
                IconBackground = "var(--color-bg-muted, #f3f4f6)",
                IconImageUrl = t.IconUrl,
                Kind = ConnectorKind.Mcp,
                Enabled = true,
                McpName = t.Name,
                IsCustomMcp = t.IsCustom
            });
        }

        // Enabled names that are not in either list (e.g. after search changed) — still show them.
        foreach (var name in KeyStore.EnabledMcpServerNames)
        {
            if (!seen.Add(name)) continue;
            var token = KeyStore.GetMcpToken(name);
            var custom = KeyStore.GetCustomConnectors()
                .FirstOrDefault(c => c.Name.Equals(name, StringComparison.OrdinalIgnoreCase));
            list.Add(new InstalledItem
            {
                Id = "mcp:" + name,
                ConnectorId = name,
                DisplayName = ShortMcpName(name),
                Description = null,
                Subtitle = custom is not null ? "MCP" : "MCP",
                IconText = "🔌",
                IconBackground = "var(--color-bg-muted, #f3f4f6)",
                Kind = ConnectorKind.Mcp,
                Enabled = true,
                McpName = name,
                IsCustomMcp = custom is not null && registryTools.All(r => !r.Name.Equals(name, StringComparison.OrdinalIgnoreCase))
            });
        }

        return list.OrderBy(i => i.DisplayName, StringComparer.OrdinalIgnoreCase).ToList();
    }

    private bool IsOAuthInstalled(string id) =>
        KeyStore.GetOAuthConnector(id)?.Tokens is not null;

    private async Task OnFeaturedOAuthClick(CatalogItem entry)
    {
        openMenuId = null;
        if (IsOAuthInstalled(entry.ConnectorId))
        {
            openMenuId = "oauth:" + entry.ConnectorId;
            return;
        }

        var provider = entry.OAuthProviderId ?? entry.ConnectorId;
        if (oauthProviderReady.TryGetValue(provider, out var ready) && !ready)
        {
            statusMessage =
                $"OAuth for {entry.DisplayName} is not configured. " +
                $"Insert a row into OAuthProviders (ProviderId='{provider}') or set OAuth__{provider}__* env vars.";
            statusIsError = true;
            return;
        }

        var server = (Auth.ServerBaseUrl ?? "").TrimEnd('/');
        if (string.IsNullOrWhiteSpace(server))
        {
            try { server = new Uri(Nav.BaseUri).GetLeftPart(UriPartial.Authority); }
            catch { server = ""; }
        }
        if (string.IsNullOrWhiteSpace(server))
        {
            statusMessage = "No App Server URL configured. Set AppServer:BaseUrl (MAUI) or open the web app on the host.";
            statusIsError = true;
            return;
        }

        var returnUrl = AppEnvironment.IsMaui
            ? $"{server}/api/oauth/done"
            : server;

        var startUrl =
            $"{server}/api/oauth/{Uri.EscapeDataString(provider)}/start" +
            $"?connector={Uri.EscapeDataString(entry.ConnectorId)}" +
            $"&returnUrl={Uri.EscapeDataString(returnUrl)}";

        statusMessage = AppEnvironment.IsMaui
            ? $"Opening {entry.DisplayName} sign-in in the browser panel… (you’ll return here when done)."
            : $"Redirecting to {entry.DisplayName}…";
        statusIsError = false;
        StateHasChanged();

        await UriLauncher.OpenAsync(startUrl);
    }

    private RenderFragment RenderToolIcon(string? iconText, string? iconBackground, string? iconImageUrl) => builder =>
    {
        var fallback = string.IsNullOrWhiteSpace(iconText) ? "◇" : iconText;
        var bg = string.IsNullOrWhiteSpace(iconBackground)
            ? "var(--color-bg-muted, #f3f4f6)"
            : iconBackground;

        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", "cf-conn-icon cf-tool-icon");
        builder.AddAttribute(2, "style",
            "background:" + bg + ";color:var(--color-text-muted,#6b7280);position:relative;overflow:hidden;");

        // Always render a glyph fallback so a broken remote icon never shows the browser "missing image" box.
        builder.OpenElement(3, "span");
        builder.AddAttribute(4, "class", "cf-tool-icon-fallback");
        builder.AddAttribute(5, "aria-hidden", "true");
        builder.AddContent(6, fallback);
        builder.CloseElement();

        if (!string.IsNullOrWhiteSpace(iconImageUrl))
        {
            builder.OpenElement(7, "img");
            builder.AddAttribute(8, "class", "cf-tool-icon-img");
            builder.AddAttribute(9, "src", iconImageUrl);
            builder.AddAttribute(10, "alt", "");
            builder.AddAttribute(11, "loading", "lazy");
            // Hide broken image; leave the soft glyph underneath.
            builder.AddAttribute(12, "onerror",
                "this.classList.add('is-broken');this.removeAttribute('src');");
            builder.CloseElement();
        }

        builder.CloseElement();
    };


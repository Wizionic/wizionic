    private async Task AddCustomConnector()
    {
        customDialogError = "";
        var name = (newCustomName ?? "").Trim();
        var url = (newCustomUrl ?? "").Trim();

        if (string.IsNullOrWhiteSpace(name))
        {
            customDialogError = "Please enter a name.";
            return;
        }
        if (string.IsNullOrWhiteSpace(url) ||
            !(url.StartsWith("http://", StringComparison.OrdinalIgnoreCase) ||
              url.StartsWith("https://", StringComparison.OrdinalIgnoreCase)))
        {
            customDialogError = "Please enter a valid HTTP or HTTPS URL.";
            return;
        }

        var allKnown = new HashSet<string>(registryTools.Select(r => r.Name), StringComparer.OrdinalIgnoreCase);
        foreach (var c in KeyStore.GetCustomConnectors())
            allKnown.Add(c.Name);
        if (allKnown.Contains(name))
        {
            customDialogError = "A connector with this name already exists.";
            return;
        }

        await KeyStore.AddCustomConnectorAsync(name, url);
        await KeyStore.SetMcpServerEnabledAsync(name, true);
        LoadCustomsFromStore();
        await RefreshMcpToolsAsync();
        await SettingsSyncHooks.AfterLocalSaveAsync(SettingsSync, SyncService, SettingsSyncCategory.Tools);
        showAddCustomDialog = false;
        statusMessage = $"Added {name}";
        statusIsError = false;
    }

    private async Task ConfirmRemoveCustom()
    {
        if (string.IsNullOrEmpty(removeCustomName)) return;
        await KeyStore.RemoveCustomConnectorAsync(removeCustomName);
        await KeyStore.SetMcpServerEnabledAsync(removeCustomName, false);
        removeCustomName = null;
        LoadCustomsFromStore();
        await RefreshMcpToolsAsync();
        await SettingsSyncHooks.AfterLocalSaveAsync(SettingsSync, SyncService, SettingsSyncCategory.Tools);
    }


    /// <summary>Only called from the explicit Install button (or details modal Install).</summary>
    private async Task InstallMcpAsync(ManagedMcpTool mcp)
    {
        openMenuId = null;
        if (mcp.IsEnabled)
        {
            statusMessage = $"{mcp.DisplayTitle} is already installed.";
            statusIsError = false;
            return;
        }

        mcp.IsEnabled = true;
        // Snapshot URL at install so chat tools work even when this server leaves the browse list.
        if (!string.IsNullOrWhiteSpace(mcp.RemoteUrl))
        {
            var existing = KeyStore.GetCustomConnectors()
                .Any(c => c.Name.Equals(mcp.Name, StringComparison.OrdinalIgnoreCase));
            if (!existing)
                await KeyStore.AddCustomConnectorAsync(mcp.Name, mcp.RemoteUrl);
        }
        await KeyStore.SetMcpServerEnabledAsync(mcp.Name, true);
        await SettingsSyncHooks.AfterLocalSaveAsync(SettingsSync, SyncService, SettingsSyncCategory.Tools);
        await RefreshMcpToolsAsync();
        LoadCustomsFromStore();
        statusMessage = $"Installed {mcp.DisplayTitle}";
        statusIsError = false;
        if (mcp.RequiresAuth)
        {
            OpenMcpTokenEditor(new InstalledItem
            {
                Id = "mcp:" + mcp.Name,
                DisplayName = mcp.DisplayTitle,
                McpName = mcp.Name,
                Kind = ConnectorKind.Mcp
            });
        }
        StateHasChanged();
    }

    private void ToggleMenu(string id) =>
        openMenuId = openMenuId == id ? null : id;

    private static string OAuthMenuId(string connectorId) => "oauth:" + connectorId;

    private async Task ToggleInstalledEnabled(InstalledItem item)
    {
        openMenuId = null;
        if (item.Kind == ConnectorKind.OpenApiOAuth)
        {
            await KeyStore.SetOAuthConnectorEnabledAsync(item.ConnectorId, !item.Enabled);
            await SettingsSyncHooks.AfterLocalSaveAsync(SettingsSync, SyncService, SettingsSyncCategory.Tools);
            await RefreshOpenApiToolsAsync();
        }
        else if (!string.IsNullOrEmpty(item.McpName))
        {
            await KeyStore.SetMcpServerEnabledAsync(item.McpName, !item.Enabled);
            var tool = registryTools.Concat(customTools).FirstOrDefault(t => t.Name == item.McpName);
            if (tool is not null) tool.IsEnabled = !item.Enabled;
            await SettingsSyncHooks.AfterLocalSaveAsync(SettingsSync, SyncService, SettingsSyncCategory.Tools);
            await RefreshMcpToolsAsync();
        }
        StateHasChanged();
    }

    private async Task Disconnect(InstalledItem item)
    {
        openMenuId = null;
        if (item.Kind == ConnectorKind.OpenApiOAuth)
        {
            await KeyStore.RemoveOAuthConnectorAsync(item.ConnectorId);
            await SettingsSyncHooks.AfterLocalSaveAsync(SettingsSync, SyncService, SettingsSyncCategory.Tools);
            await RefreshOpenApiToolsAsync();
            statusMessage = $"Disconnected {item.DisplayName}";
            statusIsError = false;
        }
        else if (!string.IsNullOrEmpty(item.McpName))
        {
            await KeyStore.SetMcpServerEnabledAsync(item.McpName, false);
            await KeyStore.SetMcpTokenAsync(item.McpName, "");
            var tool = registryTools.Concat(customTools).FirstOrDefault(t => t.Name == item.McpName);
            if (tool is not null)
            {
                tool.IsEnabled = false;
                tool.Token = "";
            }
            // Remove stored URL snapshot (registry install or user custom).
            await KeyStore.RemoveCustomConnectorAsync(item.McpName);
            LoadCustomsFromStore();
            await SettingsSyncHooks.AfterLocalSaveAsync(SettingsSync, SyncService, SettingsSyncCategory.Tools);
            await RefreshMcpToolsAsync();
            statusMessage = $"Disconnected {item.DisplayName}";
            statusIsError = false;
        }
        StateHasChanged();
    }

    private void OpenMcpTokenEditor(InstalledItem item)
    {
        openMenuId = null;
        tokenEditor = item;
        var tool = registryTools.Concat(customTools).FirstOrDefault(t => t.Name == item.McpName);
        tokenEditorValue = tool?.Token ?? KeyStore.GetMcpToken(item.McpName ?? "");
    }

    private async Task SaveTokenEditor()
    {
        if (tokenEditor?.McpName is null) return;
        await KeyStore.SetMcpTokenAsync(tokenEditor.McpName, tokenEditorValue ?? "");
        var tool = registryTools.Concat(customTools).FirstOrDefault(t => t.Name == tokenEditor.McpName);
        if (tool is not null) tool.Token = tokenEditorValue ?? "";
        await SettingsSyncHooks.AfterLocalSaveAsync(SettingsSync, SyncService, SettingsSyncCategory.Tools);
        await RefreshMcpToolsAsync();
        tokenEditor = null;
        statusMessage = "Token saved";
        statusIsError = false;
    }

    private static string ShortMcpName(string fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName)) return "MCP";
        var last = fullName.Split('/', StringSplitOptions.RemoveEmptyEntries).LastOrDefault() ?? fullName;
        return last.Length > 32 ? last[..29] + "…" : last;
    }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        searchQuery = e.Value?.ToString() ?? "";
        _searchCts?.Cancel();
        _searchCts?.Dispose();
        _searchCts = new CancellationTokenSource();
        var cts = _searchCts;
        var gen = ++_searchGeneration;

        try
        {
            await Task.Delay(320, cts.Token);
            if (gen != _searchGeneration) return;
            await RefreshDiscoverAsync(cts.Token);
        }
        catch (TaskCanceledException)
        {
            // superseded by a newer keystroke
        }
    }

    private async Task RefreshDiscoverAsync(CancellationToken ct = default)
    {
        var q = searchQuery?.Trim() ?? "";
        if (string.IsNullOrEmpty(q))
            isLoading = true;
        else
            isSearching = true;
        loadError = null;
        StateHasChanged();

        try
        {
            var url = string.IsNullOrEmpty(q)
                ? "/api/tools/mcp-registry?limit=20"
                : $"/api/tools/mcp-registry?q={Uri.EscapeDataString(q)}&limit=30";

            var list = await Http.GetFromJsonAsync<List<RemoteMcpServer>>(url, ct);
            ct.ThrowIfCancellationRequested();

            var enabled = KeyStore.EnabledMcpServerNames;

            registryTools = (list ?? new List<RemoteMcpServer>())
                .Select(s => new ManagedMcpTool
                {
                    Name = s.Name,
                    Title = s.Title,
                    Description = s.Description,
                    Publisher = s.Publisher,
                    IconUrl = s.IconUrl,
                    RemoteUrl = s.RemoteUrl,
                    Transport = s.Transport,
                    RequiresAuth = s.RequiresAuth,
                    InfoUrl = s.InfoUrl,
                    Version = s.Version,
                    IsEnabled = enabled.Contains(s.Name),
                    Token = KeyStore.GetMcpToken(s.Name),
                    IsCustom = false
                })
                .ToList();

            // Keep enabled state in sync for any still-listed tools
            foreach (var t in registryTools)
                t.IsEnabled = enabled.Contains(t.Name);

            _ = RefreshMcpToolsAsync();
        }
        catch (OperationCanceledException)
        {
            throw;
        }
        catch (Exception ex)
        {
            loadError = $"Could not load registry: {ex.Message}";
            if (!registryTools.Any())
                registryTools = new();
        }
        finally
        {
            isLoading = false;
            isSearching = false;
            StateHasChanged();
        }
    }

    private void LoadCustomsFromStore()
    {
        var enabled = KeyStore.EnabledMcpServerNames;
        var registryNames = new HashSet<string>(
            registryTools.Select(r => r.Name), StringComparer.OrdinalIgnoreCase);

        customTools = KeyStore.GetCustomConnectors()
            .Select(c => new ManagedMcpTool
            {
                Name = c.Name,
                Title = ShortMcpName(c.Name),
                Description = registryNames.Contains(c.Name) ? "" : "Custom MCP connector",
                RemoteUrl = c.ServerUrl,
                Transport = "custom",
                RequiresAuth = false,
                IsEnabled = enabled.Contains(c.Name),
                Token = KeyStore.GetMcpToken(c.Name),
                // True only when not also a known registry server (user-typed URL).
                IsCustom = !registryNames.Contains(c.Name)
            })
            .OrderBy(t => t.Name, StringComparer.OrdinalIgnoreCase)
            .ToList();
    }


@using App.Core.Ollama
@using App.Core.Storage
@using App.Core.Sync
@using App.Shared.Services
@inject IKeyStore KeyStore
@inject ISettingsSyncStore SettingsSync
@inject ISyncService SyncService
@inject NavigationManager Nav
@inject HttpClient Http
@inject IAuthService AuthService

<div class="settings-content" style="padding: 1rem 2rem; max-width: 800px; margin: 0 auto;">

    <h4>Ollama</h4>
    <p style="color: var(--color-text-muted); font-size: 0.9em;">
        Run open models privately with
        <a href="https://www.ollama.com/" target="_blank" rel="noopener">Ollama</a>.
        Settings stay on this device only.
        For Lemonade (AMD-friendly local server), use the <a href="/lemonade">Lemonade</a> page.
    </p>

    <div style="max-width: 640px;">
        <div class="ollama-instructions">
            <p>
                Download and install Ollama from
                <a href="https://www.ollama.com/" target="_blank" rel="noopener">ollama.com</a>,
            </p>

            <div class="cf-info-box" style="margin: 1rem 0; border-color: var(--color-accent);">
                <strong>On https://wizionic.com:</strong> Browser security blocks direct http:// calls to local Ollama (mixed content).
                Set <code>OLLAMA_ORIGINS</code> to allow this site:
                <div class="model-command" style="margin-top: 0.5rem;">
                    <span class="model-desc">Windows PowerShell</span>
                    <pre><code>[System.Environment]::SetEnvironmentVariable("OLLAMA_ORIGINS","https://wizionic.com","User")</code></pre>
                </div>
            </div>
        </div>

        <label>Base URL</label>
        <input type="text" @bind="ollamaBaseUrl" placeholder="http://localhost:11434" class="form-control" />
        <div style="font-size:0.75em; color:var(--cf-text-muted); margin:2px 0 4px;">
            Default: http://localhost:11434. Remote/LAN Ollama needs CORS + non-mixed-content access.
        </div>

        <button type="button" @onclick="RefreshOllamaModels" class="btn btn-outline-primary" style="margin-top: 0.25rem;" disabled="@busy">
            @(busy && busyAction == "refresh" ? "Refreshing…" : "Refresh Models from Ollama")
        </button>

        <!-- Pull from library -->
        <div style="margin-top: 1.25rem; padding: 0.85rem 1rem; border: 1px solid var(--color-border, #ddd); border-radius: 8px; background: var(--color-bg-muted, #f8f9fb);">
            <label style="font-weight: 600;">Pull a model</label>
            <div style="display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center;">
                <select class="form-control" style="flex: 1; min-width: 200px;" @bind="pullModelId" disabled="@busy">
                    <option value="">— select a model —</option>
                    @foreach (var m in pullChoices)
                    {
                        <option value="@m.Name">@m.Name (@OllamaCapabilitiesResolver.FormatSize(m.SizeBytes))</option>
                    }
                </select>
                <button type="button" class="btn btn-primary" @onclick="PullSelectedModel" disabled="@(busy || string.IsNullOrEmpty(pullModelId))">
                    @(busy && busyAction == "pull" ? "Pulling…" : "Pull")
                </button>
                <button type="button" class="btn btn-outline-secondary" @onclick="LoadLibraryCatalog" disabled="@busy">
                    @(busy && busyAction == "catalog" ? "Loading…" : "Reload catalog")
                </button>
            </div>
            @if (libraryLoadError != null)
            {
                <div style="font-size: 0.8em; color: var(--cf-error-fg, #c00); margin-top: 0.4rem;">@libraryLoadError</div>
            }
            else if (!pullChoices.Any() && libraryLoaded)
            {
                <div style="font-size: 0.8em; color: var(--cf-text-muted); margin-top: 0.4rem;">
                    No catalog models left to pull (or catalog empty). Try Reload catalog, or type a name below.
                </div>
            }

        <div style="margin-top: 0.75rem;">
            <label>Pull / add by name</label>
            <div style="display: flex; gap: 4px;">
                <input type="text" @bind="newOllamaModel" placeholder="e.g. gemma3:1b" class="form-control" style="flex:1;" disabled="@busy" />
                <button type="button" @onclick="PullByName" class="btn btn-outline-primary" disabled="@(busy || string.IsNullOrWhiteSpace(newOllamaModel))">
                    @(busy && busyAction == "pull-name" ? "Pulling…" : "Pull")
                </button>
            </div>
        </div>

        </div>



        <div class="model-list" style="margin-top: 1rem;">
            <label>Installed Ollama Models</label>
            @if (ollamaModelSettings.Any())
            {
                <div class="ollama-model-list">
                    @foreach (var model in ollamaModelSettings)
                    {
                        <div class="ollama-model-row @(editingOllamaName == model.Name ? "is-active" : "")">
                            <div class="ollama-model-row-main">
                                <div class="ollama-model-row-title">@DisplayOllamaLabel(model)</div>
                                @if (ShowModelSubtitle(model))
                                {
                                    <div class="ollama-model-row-subtitle">@model.Name</div>
                                }
                            </div>
                            <div class="ollama-model-row-meta">
                                <span class="ollama-vision-proxy-badge" title="On-disk size">@OllamaCapabilitiesResolver.FormatSize(model.SizeBytes)</span>
                                <span class="ollama-vision-proxy-badge">Chat</span>
                                @if (model.SupportsVision)
                                {
                                    <span class="ollama-vision-proxy-badge">Vision</span>
                                }
                                @if (model.IsVisionProxy)
                                {
                                    <span class="ollama-vision-proxy-badge">Vision proxy</span>
                                }
                            </div>
                            <div class="ollama-model-row-actions">
                                <button type="button"
                                        class="ollama-model-edit-btn"
                                        title="Edit model settings"
                                        disabled="@busy"
                                        @onclick="() => OpenOllamaEditor(model.Name)">
                                    ✏️
                                </button>
                                <button type="button"
                                        class="ollama-model-edit-btn"
                                        title="Remove from Ollama (disk)"
                                        disabled="@busy"
                                        @onclick="() => DeleteOllamaModel(model.Name)">
                                    🗑
                                </button>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div style="font-size: 0.8em; color: var(--cf-text-muted);">No models loaded. Refresh, pull from the catalog, or add a name below.</div>
            }
        </div>

        @if (editingOllamaName != null && ollamaEditDraft != null)
        {
            <div class="ollama-model-editor">
                <h4>Edit Ollama model</h4>

                <label>Label</label>
                <input type="text" @bind="ollamaEditDraft.Label" class="form-control" />

                <label>Model request name</label>
                <input type="text" value="@ollamaEditDraft.Name" class="form-control" readonly />

                <label>Size</label>
                <input type="text" value="@OllamaCapabilitiesResolver.FormatSize(ollamaEditDraft.SizeBytes)" class="form-control" readonly />

                <label>Server endpoint</label>
                <input type="text" value="@KeyStore.OllamaChatEndpoint" class="form-control" readonly />

                <label>Context size</label>
                <input type="number" min="0" step="1" @bind="ollamaEditDraft.ContextSize" class="form-control" />

                <div class="ollama-toggle-row">
                    <div>
                        <label class="ollama-toggle-label">Vision Support</label>
                        <div class="ollama-field-hint">Allow image attachments in chat for this model.</div>
                    </div>
                    <label class="ollama-toggle">
                        <input type="checkbox" @bind="ollamaEditDraft.SupportsVision" />
                        <span class="ollama-toggle-slider"></span>
                    </label>
                </div>

                <div class="ollama-toggle-row">
                    <div>
                        <label class="ollama-toggle-label">Tool Support</label>
                        <div class="ollama-field-hint">Enable agentic tools (web search, MCP, etc.).</div>
                    </div>
                    <label class="ollama-toggle">
                        <input type="checkbox" @bind="ollamaEditDraft.SupportsTools" />
                        <span class="ollama-toggle-slider"></span>
                    </label>
                </div>

                <div class="ollama-toggle-row @(ollamaEditDraft.SupportsVision ? "" : "is-disabled")">
                    <div>
                        <label class="ollama-toggle-label">Vision proxy</label>
                        <div class="ollama-field-hint">Describe images for text-only models (one proxy globally).</div>
                    </div>
                    <label class="ollama-toggle">
                        <input type="checkbox"
                               @bind="ollamaEditDraft.IsVisionProxy"
                               disabled="@(!ollamaEditDraft.SupportsVision)" />
                        <span class="ollama-toggle-slider"></span>
                    </label>
                </div>

                @if (!string.IsNullOrEmpty(saveFeedback))
                {
                    <div class="ollama-save-feedback @(saveFeedbackIsError ? "is-error" : "is-success")" role="status">
                        @saveFeedback
                    </div>
                }

                <div class="ollama-editor-actions">
                    <button type="button" @onclick="SaveOllamaEditor" class="btn btn-primary" disabled="@busy">Save model</button>
                    <button type="button" @onclick="CloseOllamaEditor" class="btn btn-link-style">Close</button>
                    <button type="button" @onclick="DeleteEditingFromDisk" class="btn btn-outline-secondary ollama-remove-btn" disabled="@busy">
                        Remove from disk
                    </button>
                </div>
            </div>
        }


    </div>

    @if (!string.IsNullOrEmpty(pageFeedback))
    {
        <div class="ollama-save-feedback @(pageFeedbackIsError ? "is-error" : "is-success")" role="status" style="margin-top: 1rem; white-space: pre-wrap;">
            @pageFeedback
        </div>
    }

    <div style="margin-top: 1.5rem;">
        <button type="button" @onclick="@(() => Nav.NavigateTo("/chat"))" class="btn btn-outline-secondary">Back to Chat</button>
    </div>
</div>

@code {
    string ollamaBaseUrl = "http://localhost:11434";
    List<OllamaModelSettings> ollamaModelSettings = new();
    string newOllamaModel = "";
    string? editingOllamaName;
    OllamaModelSettings? ollamaEditDraft;

    string pullModelId = "";
    List<OllamaCapabilitiesResolver.OllamaLibraryModel> libraryModels = new();
    List<OllamaCapabilitiesResolver.OllamaLibraryModel> pullChoices = new();
    bool libraryLoaded;
    string? libraryLoadError;

    bool busy;
    string busyAction = "";

    string? saveFeedback;
    bool saveFeedbackIsError;
    string? pageFeedback;
    bool pageFeedbackIsError;
    CancellationTokenSource? _saveFeedbackCts;
    CancellationTokenSource? _pageFeedbackCts;

    protected override async Task OnInitializedAsync()
    {
        await KeyStore.LoadAsync();
        await AuthService.LoadAsync();
        ollamaBaseUrl = KeyStore.OllamaBaseUrl;
        ReloadAll();
        await LoadLibraryCatalog();
    }

    void ReloadAll()
    {
        ollamaModelSettings = KeyStore.OllamaModelSettingsList.ToList();
        RebuildPullChoices();
    }

    void RebuildPullChoices()
    {
        var installed = new HashSet<string>(
            ollamaModelSettings.Select(m => m.Name),
            StringComparer.OrdinalIgnoreCase);
        var installedBare = new HashSet<string>(
            ollamaModelSettings.Select(m => m.Name.Split(':')[0]),
            StringComparer.OrdinalIgnoreCase);

        pullChoices = libraryModels
            .Where(m =>
            {
                if (installed.Contains(m.Name))
                    return false;
                // Hide library entry if any installed tag shares the same model family
                // (e.g. installed llama3.2:1b hides library "llama3.2").
                var bare = m.Name.Split(':')[0];
                if (installedBare.Contains(bare) && !m.Name.Contains(':', StringComparison.Ordinal))
                    return false;
                return true;
            })
            .ToList();
    }

    static string DisplayOllamaLabel(OllamaModelSettings model) =>
        string.IsNullOrWhiteSpace(model.Label) ? model.Name : model.Label;

    static bool ShowModelSubtitle(OllamaModelSettings model) =>
        !string.IsNullOrWhiteSpace(model.Label)
        && !string.Equals(model.Label.Trim(), model.Name.Trim(), StringComparison.OrdinalIgnoreCase);

    async Task LoadLibraryCatalog()
    {
        busy = true;
        busyAction = "catalog";
        libraryLoadError = null;
        StateHasChanged();
        try
        {
            libraryModels = (await OllamaCapabilitiesResolver.ListLibraryModelsAsync(Http)).ToList();
            libraryLoaded = true;
            RebuildPullChoices();
            if (libraryModels.Count == 0)
                libraryLoadError = "Could not load Ollama library catalog (network?). You can still pull by name.";
        }
        catch (Exception ex)
        {
            libraryLoadError = ex.Message;
            libraryLoaded = true;
        }
        finally
        {
            busy = false;
            busyAction = "";
            StateHasChanged();
        }
    }

    async Task RefreshOllamaModels()
    {
        busy = true;
        busyAction = "refresh";
        StateHasChanged();
        try
        {
            await KeyStore.RefreshOllamaModelsFromServerAsync(Http, ollamaBaseUrl);
            ollamaBaseUrl = KeyStore.OllamaBaseUrl;
            ReloadAll();
            if (editingOllamaName != null
                && ollamaModelSettings.All(m => !string.Equals(m.Name, editingOllamaName, StringComparison.OrdinalIgnoreCase)))
                CloseOllamaEditor();
            else if (editingOllamaName != null)
                OpenOllamaEditor(editingOllamaName);

            await ShowPageFeedbackAsync(
                $"Ollama models refreshed ({ollamaModelSettings.Count}).",
                isError: false);
        }
        catch (Exception ex)
        {
            var msg = ex.Message;
            if (IsNetworkError(msg))
            {
                msg += "\n\nTip: On https://wizionic.com this is expected for http Ollama. Set OLLAMA_ORIGINS or use the desktop app.";
            }
            await ShowPageFeedbackAsync(msg, isError: true);
        }
        finally
        {
            busy = false;
            busyAction = "";
            StateHasChanged();
        }
    }

    async Task PullSelectedModel()
    {
        if (string.IsNullOrWhiteSpace(pullModelId))
            return;
        await PullModelInternal(pullModelId, "pull");
        pullModelId = "";
    }

    async Task PullByName()
    {
        var name = (newOllamaModel ?? "").Trim();
        if (string.IsNullOrWhiteSpace(name))
            return;
        await PullModelInternal(name, "pull-name");
        newOllamaModel = "";
    }

    async Task PullModelInternal(string modelName, string action)
    {
        busy = true;
        busyAction = action;
        StateHasChanged();
        try
        {
            await KeyStore.SetOllamaBaseUrlAsync(ollamaBaseUrl);
            using var longHttp = CreateLongTimeoutClient();
            await ShowPageFeedbackAsync($"Pulling {modelName}… (this can take a while)", isError: false);
            await OllamaCapabilitiesResolver.PullModelAsync(longHttp, ollamaBaseUrl, modelName);
            await KeyStore.RefreshOllamaModelsFromServerAsync(Http, ollamaBaseUrl);
            ReloadAll();
            await ShowPageFeedbackAsync($"Pulled {modelName}.", isError: false);
        }
        catch (Exception ex)
        {
            await ShowPageFeedbackAsync($"Pull failed: {ex.Message}", isError: true);
        }
        finally
        {
            busy = false;
            busyAction = "";
            StateHasChanged();
        }
    }

    async Task DeleteOllamaModel(string modelName)
    {
        busy = true;
        busyAction = "delete";
        StateHasChanged();
        try
        {
            await KeyStore.SetOllamaBaseUrlAsync(ollamaBaseUrl);
            using var client = CreateLongTimeoutClient();
            await OllamaCapabilitiesResolver.DeleteModelAsync(client, ollamaBaseUrl, modelName);
            await KeyStore.RemoveOllamaModelAsync(modelName);
            if (string.Equals(editingOllamaName, modelName, StringComparison.OrdinalIgnoreCase))
                CloseOllamaEditor();
            ReloadAll();
            await ShowPageFeedbackAsync($"Removed {modelName} from Ollama.", isError: false);
        }
        catch (Exception ex)
        {
            // Still drop from Wizionic list if user wants? Prefer fail loudly.
            await ShowPageFeedbackAsync($"Remove failed: {ex.Message}", isError: true);
        }
        finally
        {
            busy = false;
            busyAction = "";
            StateHasChanged();
        }
    }

    async Task DeleteEditingFromDisk()
    {
        if (editingOllamaName == null) return;
        await DeleteOllamaModel(editingOllamaName);
    }

    static HttpClient CreateLongTimeoutClient() =>
        new() { Timeout = TimeSpan.FromMinutes(45) };

    void OpenOllamaEditor(string modelName)
    {
        var settings = KeyStore.GetOllamaModelSettings(modelName);
        if (settings == null) return;
        editingOllamaName = modelName;
        ollamaEditDraft = settings.Clone();
    }

    void CloseOllamaEditor()
    {
        editingOllamaName = null;
        ollamaEditDraft = null;
    }

    async Task SaveOllamaEditor()
    {
        if (ollamaEditDraft == null) return;
        try
        {
            if (!ollamaEditDraft.SupportsVision)
                ollamaEditDraft.IsVisionProxy = false;

            await KeyStore.SetOllamaBaseUrlAsync(ollamaBaseUrl);
            await KeyStore.SaveOllamaModelSettingsAsync(ollamaEditDraft);
            await SettingsSyncHooks.AfterLocalSaveAsync(SettingsSync, SyncService, SettingsSyncCategory.LocalAi);
            ReloadAll();
            editingOllamaName = ollamaEditDraft.Name;
            ollamaEditDraft = KeyStore.GetOllamaModelSettings(ollamaEditDraft.Name)?.Clone();
            await ShowSaveFeedbackAsync("Ollama model settings saved.", isError: false);
        }
        catch (Exception ex)
        {
            await ShowSaveFeedbackAsync($"Could not save: {ex.Message}", isError: true);
        }
    }

    static bool IsNetworkError(string msg) =>
        msg.Contains("CORS", StringComparison.OrdinalIgnoreCase) ||
        msg.Contains("fetch", StringComparison.OrdinalIgnoreCase) ||
        msg.Contains("blocked", StringComparison.OrdinalIgnoreCase) ||
        msg.Contains("Mixed Content", StringComparison.OrdinalIgnoreCase) ||
        msg.Contains("Failed to refresh", StringComparison.OrdinalIgnoreCase) ||
        msg.Contains("Connection refused", StringComparison.OrdinalIgnoreCase) ||
        msg.Contains("No connection", StringComparison.OrdinalIgnoreCase) ||
        msg.Contains("actively refused", StringComparison.OrdinalIgnoreCase);

    async Task ShowSaveFeedbackAsync(string message, bool isError)
    {
        _saveFeedbackCts?.Cancel();
        _saveFeedbackCts?.Dispose();
        _saveFeedbackCts = new CancellationTokenSource();
        var token = _saveFeedbackCts.Token;
        saveFeedback = message;
        saveFeedbackIsError = isError;
        StateHasChanged();
        try
        {
            await Task.Delay(4000, token);
            saveFeedback = null;
            StateHasChanged();
        }
        catch (TaskCanceledException) { }
    }

    async Task ShowPageFeedbackAsync(string message, bool isError)
    {
        _pageFeedbackCts?.Cancel();
        _pageFeedbackCts?.Dispose();
        _pageFeedbackCts = new CancellationTokenSource();
        var token = _pageFeedbackCts.Token;
        pageFeedback = message;
        pageFeedbackIsError = isError;
        StateHasChanged();
        try
        {
            await Task.Delay(isError ? 8000 : 4000, token);
            pageFeedback = null;
            StateHasChanged();
        }
        catch (TaskCanceledException) { }
    }
}

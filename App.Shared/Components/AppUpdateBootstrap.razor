@using App.Core.Connectors
@using App.Core.Setup
@using App.Core.UI
@using App.Core.Update
@inject IUpdateService UpdateService
@inject ISetupWizardHost SetupWizard
@inject IDesktopShellService DesktopShell
@inject IServiceProvider Services
@implements IDisposable

@if (_showPrompt)
{
    <ConfirmDialog IsVisible="true"
                   Title="Update available"
                   Message="@_promptMessage"
                   ConfirmText="@ConfirmLabel"
                   CancelText="Later"
                   Danger="false"
                   OnConfirm="AcceptUpdateAsync"
                   OnCancel="Dismiss" />
}

@code {
    private static readonly TimeSpan AutoCheckCooldown = TimeSpan.FromHours(1);

    private UpdateCheckResult? _result;
    private bool _showPrompt;
    private bool _busy;
    private bool _started;
    private bool _checking;
    private DateTimeOffset _lastCheckUtc = DateTimeOffset.MinValue;
    private string? _dismissedVersion;
    private string _promptMessage = "";
    private Action? _wizardChanged;

    private string ConfirmLabel =>
        _busy
            ? "Working…"
            : _result?.RequiresManualInstall == true
                ? "Download installer"
                : "Install and restart";

    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender || _started || !AppEnvironment.IsMaui)
            return;
        if (UpdateService.UpdatesManagedByStore)
        {
            _started = true;
            return;
        }

        _started = true;
        DesktopShell.OnForegrounded += OnForegrounded;
        _ = CheckWhenReadyAsync();
    }

    private void OnForegrounded()
        => _ = CheckAndPromptAsync();

    private async Task CheckWhenReadyAsync()
    {
        // Let the shell paint; don't sit on top of first-run setup.
        await Task.Delay(2500);
        await WaitForSetupWizardAsync();
        await CheckAndPromptAsync();
    }

    private async Task CheckAndPromptAsync()
    {
        if (_showPrompt || _busy || _checking)
            return;
        if (DateTimeOffset.UtcNow - _lastCheckUtc < AutoCheckCooldown)
            return;
        if (SetupWizard.IsVisible)
            return;

        _checking = true;
        try
        {
            var result = await UpdateService.CheckForUpdateAsync();
            _lastCheckUtc = DateTimeOffset.UtcNow;
            if (result.Status != UpdateCheckStatus.UpdateAvailable || result.Update is null)
                return;

            var next = result.Update.Version;
            if (!string.IsNullOrEmpty(_dismissedVersion)
                && string.Equals(_dismissedVersion, next, StringComparison.OrdinalIgnoreCase))
                return;

            _result = result;
            var current = result.CurrentVersion;
            if (result.RequiresManualInstall)
            {
                _promptMessage = string.IsNullOrWhiteSpace(result.Message)
                    ? $"Version {next} is available. Open the installer download now?"
                    : result.Message.TrimEnd() + "\n\nOpen the installer download now?";
            }
            else if (string.IsNullOrWhiteSpace(current))
            {
                _promptMessage = $"Version {next} is available. Install it now? The app will restart.";
            }
            else
            {
                _promptMessage = $"Version {next} is available (you have {current}). Install it now? The app will restart.";
            }

            if (DesktopShell.IsSupported && DesktopShell.IsHidden)
                DesktopShell.Show();

            _showPrompt = true;
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Update] Check failed: {ex.Message}");
        }
        finally
        {
            _checking = false;
        }
    }

    private async Task WaitForSetupWizardAsync()
    {
        if (!SetupWizard.IsVisible)
            return;

        var tcs = new TaskCompletionSource(TaskCreationOptions.RunContinuationsAsynchronously);
        void Handler()
        {
            if (!SetupWizard.IsVisible)
                tcs.TrySetResult();
        }

        _wizardChanged = Handler;
        SetupWizard.OnChanged += Handler;
        try
        {
            if (!SetupWizard.IsVisible)
                return;
            await tcs.Task;
            await Task.Delay(600);
        }
        finally
        {
            SetupWizard.OnChanged -= Handler;
            _wizardChanged = null;
        }
    }

    private async Task AcceptUpdateAsync()
    {
        if (_busy || _result?.Update is null)
            return;

        _busy = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            if (_result.RequiresManualInstall)
            {
                var url = UpdateService.InstallerDownloadUrl;
                if (!string.IsNullOrWhiteSpace(url)
                    && Services.GetService(typeof(IUriLauncher)) is IUriLauncher launcher)
                {
                    await launcher.OpenAsync(url);
                }

                Dismiss();
                return;
            }

            await UpdateService.DownloadAndInstallAsync(_result.Update);
        }
        catch (Exception ex)
        {
            _busy = false;
            _promptMessage = "Could not install the update: " + ex.Message;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void Dismiss()
    {
        _dismissedVersion = _result?.Update?.Version ?? _dismissedVersion;
        _showPrompt = false;
        _busy = false;
    }

    public void Dispose()
    {
        DesktopShell.OnForegrounded -= OnForegrounded;
        if (_wizardChanged != null)
            SetupWizard.OnChanged -= _wizardChanged;
    }
}

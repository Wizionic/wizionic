@if (showSaveToGalleryDialog)
{
    <div class="newnote-overlay" style="z-index:60;" @onclick="CloseSaveToGallery">
        <div class="newnote-modal move-notebook-modal" @onclick:stopPropagation>
            <h4 style="margin:0 0 12px 0;font-size:1.1rem;color:var(--color-text);">Save to Gallery</h4>
            @if (saveToGalleryBusy)
            {
                <p style="font-size:0.85rem;color:var(--cf-text-muted);">Saving…</p>
            }
            else if (saveToGalleryAlbums.Count == 0)
            {
                <p style="font-size:0.85rem;color:var(--cf-text-muted);margin:0 0 12px 0;">No albums yet. Create one below.</p>
            }
            else
            {
                <p style="font-size:0.85rem;color:var(--cf-text-muted);margin:0 0 8px 0;">Choose an album:</p>
                @foreach (var a in saveToGalleryAlbums)
                {
                    var capt = a;
                    <div class="move-notebook-item" @onclick="() => ConfirmSaveToGallery(capt.Id)" @onclick:stopPropagation>
                        <i class="cf-icon bi bi-images" style="font-size:1.1em;color:var(--cf-text-muted);margin-right:8px;"></i>
                        <span>@capt.Title</span>
                    </div>
                }
            }
            <div style="margin-top:12px; display:flex; gap:8px; align-items:center;">
                <input class="newnote-input" style="flex:1;" placeholder="New album name"
                       @bind="saveToGalleryNewTitle" @bind:event="oninput"
                       @onkeydown="SaveToGalleryNewKey" />
                <button type="button" class="newnote-btn newnote-btn-primary"
                        disabled="@(saveToGalleryBusy || string.IsNullOrWhiteSpace(saveToGalleryNewTitle))"
                        @onclick="ConfirmSaveToNewAlbum">Create &amp; save</button>
            </div>
            @if (!string.IsNullOrEmpty(saveToGalleryError))
            {
                <p style="color:var(--cf-danger, #c00); font-size:0.85rem; margin:8px 0 0 0;">@saveToGalleryError</p>
            }
            <div style="margin-top:16px;display:flex;gap:8px;justify-content:flex-end;">
                <button type="button" class="newnote-btn newnote-btn-secondary" @onclick="CloseSaveToGallery" disabled="@saveToGalleryBusy">Cancel</button>
            </div>

    private bool _lastSyncedAiProxyConnected;

    protected override async Task OnInitializedAsync()
    {
        dotNetRef ??= DotNetObjectReference.Create<object>(this);
        RegisterEventHandlers();

        if (BrowserPanel.IsOpen && AppEnvironment.IsMaui)
        {
            _ = InitializeChatDataAsync();
            return;
        }

        await InitializeChatDataAsync();
    }

    private void RegisterEventHandlers()
    {
        _sidebarStateChangedHandler = () => InvokeAsync(StateHasChanged);
        SidebarState.OnChanged += _sidebarStateChangedHandler;

        _browserPanelChangedHandler = () => InvokeAsync(OnBrowserPanelChangedAsync);
        BrowserPanel.OnChanged += _browserPanelChangedHandler;

        _chatPanelChangedHandler = () => InvokeAsync(OnChatPanelChangedAsync);
        ChatPanel.OnChanged += _chatPanelChangedHandler;

        SyncService.OnConversationsChanged += OnConversationsChangedFromSync;

        _syncChangedHandler = () => InvokeAsync(async () =>
        {
            var aiStateChanged =
                _lastSyncedAiServerId != SyncService.AiServerDeviceId
                || _lastSyncedRemoteModelCount != SyncService.RemoteModels.Count
                || _lastSyncedAiProxyConnected != SyncService.IsAiProxyConnected;

            _lastSyncedAiServerId = SyncService.AiServerDeviceId;
            _lastSyncedRemoteModelCount = SyncService.RemoteModels.Count;
            _lastSyncedAiProxyConnected = SyncService.IsAiProxyConnected;

            if (aiStateChanged)
            {
                await RefreshModelListAsync();
                EnsureValidModelSelection();
            }

            StateHasChanged();
        });
        SyncService.OnChanged += _syncChangedHandler;
    }

    private async Task InitializeChatDataAsync()
    {
        _chatIndexLoading = true;

        // Phase 1 — local only (fast): paint titles + model list before network/sync.
        await KeyStore.LoadAsync();
        try { await SkillStore.LoadAsync(); } catch { /* optional */ }
        await AuthService.LoadAsync();
        if (AuthService.IsAuthenticated && !string.IsNullOrEmpty(AuthService.Email))
            currentUser = AuthService.Email;

        // Local catalog from KeyStore — no HTTP wait for proxy providers.
        ReloadModelListFromCatalog(preferRemote: false);
        EnsureValidModelSelection();

        localConvos = await ConversationStore.LoadIndexAsync();
        _chatIndexLoading = false;
        var lastId = await ConversationStore.GetLastConvoIdAsync();
        await InvokeAsync(StateHasChanged);

        // Notes / Gallery "Edit with AI" → new chat (skip last-convo restore).
        var fromNoteEdit = NotesChatHandoff.TryTakeEditWithAiRequest(out var notePayload);
        var fromGalleryEdit = GalleryChatHandoff.TryTakeEditWithAiRequest(out var editImage);
        if (fromNoteEdit && notePayload != null)
        {
            ChatPanel.IsOpen = true;
            await NewConversation();
            messages.Add(NotesChatContext.CreateMessage(notePayload));
            try
            {
                await ConversationStore.SetConversationTitleAsync(
                    activeConvoId!,
                    "Note: " + (string.IsNullOrWhiteSpace(notePayload.NotebookTitle) ? "Untitled" : notePayload.NotebookTitle));
            }
            catch { /* title is optional */ }
            await SaveCurrentConvo();
            await InvokeAsync(StateHasChanged);
            try
            {
                var uri = Nav.ToAbsoluteUri(Nav.Uri);
                if (uri.Query.Contains("noteEdit", StringComparison.OrdinalIgnoreCase))
                    Nav.NavigateTo(uri.GetLeftPart(UriPartial.Path), replace: true);
            }
            catch { /* ignore */ }
        }
        else if (fromGalleryEdit && editImage != null)
        {
            ChatPanel.IsOpen = true;
            await NewConversation();
            pendingFiles.Add(editImage);
            SelectPreferredImageEditModel();
            await InvokeAsync(StateHasChanged);
            // Drop query string so refresh does not re-trigger without handoff.
            try
            {
                var uri = Nav.ToAbsoluteUri(Nav.Uri);
                if (uri.Query.Contains("galleryEdit", StringComparison.OrdinalIgnoreCase))
                    Nav.NavigateTo(uri.GetLeftPart(UriPartial.Path), replace: true);
            }
            catch { /* ignore */ }
        }
        else if (!string.IsNullOrEmpty(lastId) && localConvos.Any(c => c.Id == lastId))
        {
            activeConvoId = lastId;
            await LoadConversation(lastId);
        }
        else if (localConvos.Any())
        {
            activeConvoId = localConvos.OrderBy(c => c.SortOrder).ThenByDescending(c => c.LastUpdated).First().Id;
            await LoadConversation(activeConvoId);
        }
        else
        {
            await NewConversation();
        }

        await InvokeAsync(StateHasChanged);

        // Phase 3 — background: proxied models, sync hub.
        _ = CompleteChatInitInBackgroundAsync();
    }

    /// <summary>Prefer Lemonade Image+Edit models for gallery edit handoff.</summary>
    private void SelectPreferredImageEditModel()
    {
        var edit = modelList.FirstOrDefault(m => m.SupportsImageEdit && m.IsImageGeneration)
                   ?? modelList.FirstOrDefault(m => m.SupportsImageEdit)
                   ?? modelList.FirstOrDefault(m => m.IsImageGeneration);
        if (edit != null)
        {
            selectedModel = edit.Id;
            _ = KeyStore.SetLastSelectedModelAsync(selectedModel);
            ApplyImageParamsFromModel(selectedModel);
        }
    }

    private async Task CompleteChatInitInBackgroundAsync()
    {
        try
        {
            await ModelCatalog.RefreshAsync();
            ReloadModelListFromCatalog(preferRemote: true);
            // Keep gallery-edit model if we still have a pending image attachment.
            if (pendingFiles.Any(IsImageAttachment) && CurrentModelInfo?.SupportsImageEdit != true)
                SelectPreferredImageEditModel();
            else
                EnsureValidModelSelection();
            await InvokeAsync(StateHasChanged);

            if (AuthService.IsAuthenticated && !string.IsNullOrEmpty(AuthService.Email))
            {
                await SyncService.EnsureConnectedAndRegisteredAsync();
                if (!string.IsNullOrEmpty(SyncService.AiServerDeviceId))
                    await SyncService.EnsureAiProxyConnectionAsync();

                if (!string.IsNullOrEmpty(SyncService.AiServerDeviceId) && SyncService.RemoteModels.Any())
                {
                    ReloadModelListFromCatalog(preferRemote: true);
                    EnsureValidModelSelection();
                }

                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Chat] Background init: {ex.Message}");
        }
    }

    private async Task RefreshModelListAsync()
    {
        await ModelCatalog.RefreshAsync();
        ReloadModelListFromCatalog(preferRemote: true);
    }

    private void ReloadModelListFromCatalog(bool preferRemote)
    {
        if (preferRemote && !string.IsNullOrEmpty(SyncService.AiServerDeviceId) && SyncService.RemoteModels.Any())
            modelList = ChatModelMapper.ToChatModelInfoList(SyncService.RemoteModels);
        else
            modelList = ModelCatalog.GetAvailableModels();

        var profiles = KeyStore.ModelProfiles;
        if (profiles.Count == 0)
            return;

        var head = profiles
            .Where(p => !string.IsNullOrWhiteSpace(p.Id) && !string.IsNullOrWhiteSpace(p.Name))
            .Select(p => new ChatModelInfo(
                ModelProfileId.ForPicker(p.Id),
                p.Name,
                "📋",
                p.Id,
                "Profiles"))
            .ToList();
        if (head.Count > 0)
            modelList = head.Concat(modelList).ToList();
    }

    private void EnsureValidModelSelection()
    {
        if (!modelList.Any())
        {
            selectedModel = "";
            return;
        }

        if (IsModelInList(selectedModel))
            return;

        var activeProfilePicker = !string.IsNullOrWhiteSpace(KeyStore.ActiveModelProfileId)
            ? ModelProfileId.ForPicker(KeyStore.ActiveModelProfileId)
            : null;
        if (IsModelInList(activeProfilePicker))
        {
            selectedModel = activeProfilePicker!;
            return;
        }

        var savedModel = KeyStore.LastSelectedModel;
        if (IsModelInList(savedModel))
        {
            selectedModel = savedModel;
            return;
        }

        var configuredDefault = ModelCatalog.GetConfiguredDefaultModelId(modelList);
        if (!string.IsNullOrEmpty(configuredDefault))
        {
            selectedModel = configuredDefault;
            return;
        }

        selectedModel = modelList.First().Id;
    }

    private bool IsModelInList(string? modelId) =>
        !string.IsNullOrEmpty(modelId) && modelList.Any(m => m.Id == modelId);

    private async Task OnSelectedModelChanged()
    {
        if (string.IsNullOrEmpty(selectedModel))
            return;

        if (ModelProfileId.TryParsePicker(selectedModel, out var profileId))
            await KeyStore.SetActiveModelProfileIdAsync(profileId);
        await KeyStore.SetLastSelectedModelAsync(selectedModel);
        if (IsImageGenerationModel)
            ApplyImageParamsFromModel(EffectiveChatModelId);
        RefreshContextEstimate(preferServerUsage: false);
    }

    private void RefreshContextEstimate(bool preferServerUsage)
    {
        var limit = CurrentModelInfo is { ContextSize: > 0 } mi
            ? mi.ContextSize
            : (_contextLimit ?? 0);
        if (limit > 0)
            _contextLimit = limit;

        if (!preferServerUsage || _contextUsed is null or <= 0)
            _contextUsed = EstimateVisibleMessagesTokens();
    }

    private int EstimateVisibleMessagesTokens()
    {
        int n = 0;
        foreach (var m in messages)
        {
            if (m.DeletedAt != null) continue;
            n += 4;
            if (!string.IsNullOrEmpty(m.Content))
                n += Math.Max(1, (int)Math.Ceiling(m.Content.Length / 4.0));
            if (m.Attachments != null)
                n += m.Attachments.Count * 256;
        }
        return n;
    }

    private static string FormatTokenCount(int n)
    {
        if (n >= 1_000_000)
            return $"{n / 1_000_000.0:0.#}M";
        if (n >= 10_000)
            return $"{n / 1000.0:0.#}k";
        if (n >= 1000)
            return $"{n / 1000.0:0.#}k";
        return n.ToString();
    }

    private void ApplyStatsToContext(ChatCompletionStats? stats)
    {
        if (stats == null)
        {
            RefreshContextEstimate(preferServerUsage: false);
            return;
        }

        if (stats.ContextLimit is int lim and > 0)
            _contextLimit = lim;
        else if (CurrentModelInfo is { ContextSize: > 0 } mi)
            _contextLimit = mi.ContextSize;

        if (stats.ContextUsed is int used and > 0)
            _contextUsed = used;
        else if (stats.PromptTokens is int pin)
            _contextUsed = pin + (stats.CompletionTokens ?? 0);
        else
            RefreshContextEstimate(preferServerUsage: false);
    }

    /// <summary>
    /// Summarize older turns into one memory message and keep the most recent messages.
    /// Frees context for longer chats (manual compact; button warns at 80%/90%).
    /// </summary>
    async Task CompactConversationAsync()
    {
        if (!CanCompactConversation || string.IsNullOrEmpty(selectedModel) || IsImageGenerationModel)
            return;

        isCompacting = true;
        contextStatusIsError = false;
        contextStatusMessage = "Compacting conversation…";
        StateHasChanged();

        try
        {
            var visible = messages
                .Where(m => m.DeletedAt is null &&
                            (!string.IsNullOrWhiteSpace(m.Content) || m.Attachments is { Count: > 0 }))
                .ToList();

            if (visible.Count <= CompactKeepRecentMessages)
            {
                contextStatusMessage = "Not enough messages to compact.";
                return;
            }

            var visibleIndexed = messages
                .Select((m, i) => (m, i))
                .Where(x => x.m.DeletedAt is null &&
                            (!string.IsNullOrWhiteSpace(x.m.Content) || x.m.Attachments is { Count: > 0 }))
                .ToList();

            var dropCount = visibleIndexed.Count - CompactKeepRecentMessages;
            var indicesToDrop = visibleIndexed.Take(dropCount).Select(x => x.i).ToHashSet();
            var toSummarize = visibleIndexed.Take(dropCount).Select(x => x.m).ToList();

            var transcript = new System.Text.StringBuilder();
            foreach (var m in toSummarize)
            {
                var role = (m.Role ?? "assistant").ToLowerInvariant();
                if (role is not ("user" or "assistant" or "system"))
                    role = string.Equals(m.User, currentUser, StringComparison.OrdinalIgnoreCase) ? "user" : "assistant";
                var text = m.Content ?? "";
                if (text.Length > 4000)
                    text = text[..4000] + "…";
                transcript.AppendLine($"{role}: {text}");
                transcript.AppendLine();
                if (transcript.Length > 48_000)
                {
                    transcript.AppendLine("…[transcript truncated]");
                    break;
                }
            }

            var prompt =
                "Summarize the following earlier conversation turns for future context. " +
                "Capture key facts, decisions, names, preferences, and open questions. " +
                "Use concise bullet points. Do not greet or add preamble.\n\n" +
                transcript.ToString();

            // Isolated request so we don't re-send the full chat while summarizing.
            var compactMsgs = new List<ChatMessage>
            {
                new(Role: "user", Content: prompt, Timestamp: DateTime.UtcNow)
            };

            var result = await ChatCompletionService.CompleteAsync(
                EffectiveChatModelId,
                compactMsgs,
                currentUser,
                conversationId: activeConvoId + ":compact",
                ct: default);

            if (!string.IsNullOrEmpty(result.Error) || string.IsNullOrWhiteSpace(result.Text))
            {
                contextStatusIsError = true;
                contextStatusMessage = result.Error ?? "Compact failed: empty summary.";
                return;
            }

            var summary = result.Text.Trim();
            if (summary.Length > 6000)
                summary = summary[..6000] + "…";

            var summaryMsg = new ChatMessage(
                Role: "assistant",
                Content:
                    "📦 **Conversation compacted** — earlier turns summarized to free context:\n\n" + summary,
                ModelUsed: selectedModel,
                Timestamp: DateTime.UtcNow,
                ToolTrace: $"📦 Compacted {dropCount} older message(s); kept last {CompactKeepRecentMessages}.",
                StatsLine: result.Stats?.FormatLine());

            var rebuilt = new List<ChatMessage> { summaryMsg };
            for (var i = 0; i < messages.Count; i++)
            {
                if (indicesToDrop.Contains(i))
                    continue;
                rebuilt.Add(messages[i]);
            }
            messages = rebuilt;

            await SaveCurrentConvo();
            RefreshContextEstimate(preferServerUsage: false);
            contextStatusIsError = false;
            contextStatusMessage =
                $"Compacted {dropCount} messages → summary. Context now ~{ContextButtonLabel} ({ContextUsagePercent}%).";
            RequestScrollToBottom();
        }
        catch (Exception ex)
        {
            contextStatusIsError = true;
            contextStatusMessage = "Compact error: " + ex.Message;
        }
        finally
        {
            isCompacting = false;
            StateHasChanged();
            _ = ClearContextStatusSoonAsync();
        }
    }

    async Task ClearContextStatusSoonAsync()
    {
        try
        {
            await Task.Delay(8000);
            if (!contextStatusIsError)
            {
                contextStatusMessage = null;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch { /* ignore */ }
    }

    async Task ToggleMicRecording()
    {
        if (isMicTranscribing || isSending || voiceModeOn)
            return;

        if (isMicRecording)
        {
            await StopMicAndTranscribeAsync();
            return;
        }

        micStatusMessage = null;
        micStatusIsError = false;
        try
        {
            var start = await JS.InvokeAsync<MicStartResult>("appMicStart");
            if (start is not { Ok: true })
            {
                micStatusIsError = true;
                micStatusMessage = start?.Error ?? "Could not start microphone.";
                if (micStatusMessage.Contains("Permission", StringComparison.OrdinalIgnoreCase) ||
                    micStatusMessage.Contains("NotAllowed", StringComparison.OrdinalIgnoreCase) ||
                    micStatusMessage.Contains("denied", StringComparison.OrdinalIgnoreCase))
                {
                    micStatusMessage = "Microphone permission denied. Allow mic access for this app/site and try again.";
                }
                return;
            }

            isMicRecording = true;
            micStatusMessage = null;
        }
        catch (Exception ex)
        {
            micStatusIsError = true;
            micStatusMessage = "Microphone error: " + ex.Message;
            isMicRecording = false;
            try { await JS.InvokeVoidAsync("appMicCancel"); } catch { }
        }
    }

    async Task StopMicAndTranscribeAsync()
    {
        isMicRecording = false;
        isMicTranscribing = true;
        micStatusMessage = "Transcribing…";
        micStatusIsError = false;
        StateHasChanged();

        _micCts?.Cancel();
        _micCts = new CancellationTokenSource();
        var ct = _micCts.Token;

        try
        {
            var stop = await JS.InvokeAsync<MicStopResult>("appMicStop");
            if (stop is not { Ok: true } || string.IsNullOrWhiteSpace(stop.Base64))
            {
                micStatusIsError = true;
                micStatusMessage = stop?.Error ?? "No audio recorded.";
                return;
            }

            if (stop.DurationMs is < 250)
            {
                micStatusIsError = true;
                micStatusMessage = "Recording too short. Hold a bit longer before stopping.";
                return;
            }

            byte[] wavBytes;
            try { wavBytes = Convert.FromBase64String(stop.Base64); }
            catch
            {
                micStatusIsError = true;
                micStatusMessage = "Could not decode recorded audio.";
                return;
            }

            string? transcript;
            string? transcriptModel;
            if (UseCloudSpeech && SpeechCloudProviderId != null)
            {
                var sttSlot = ModelProfileId.ResolveSttModelId(KeyStore);
                ModelProfileId.TryCloudProvider(sttSlot, out _, out var sttModel);
                var result = await CloudSpeech.TranscribeAsync(new CloudTranscriptionRequest(
                    ProviderId: SpeechCloudProviderId,
                    WavBytes: wavBytes,
                    Model: sttModel ?? CloudSpeech.DefaultSttModel(SpeechCloudProviderId),
                    Language: null,
                    FileName: "chat-recording.wav"), ct);
                if (!result.Success || string.IsNullOrWhiteSpace(result.Text))
                {
                    micStatusIsError = true;
                    micStatusMessage = result.Error ?? "Transcription failed.";
                    return;
                }
                transcript = result.Text;
                transcriptModel = result.Model;
            }
            else
            {
                var result = await LemonadeSpeech.TranscribeAsync(new LemonadeTranscriptionRequest(
                    WavBytes: wavBytes,
                    Model: LemonadeSpeech.DefaultSttModel,
                    Language: null,
                    FileName: "chat-recording.wav"), ct);
                if (!result.Success || string.IsNullOrWhiteSpace(result.Text))
                {
                    micStatusIsError = true;
                    micStatusMessage = result.Error ?? "Transcription failed.";
                    return;
                }
                transcript = result.Text;
                transcriptModel = result.Model;
            }

            try
            {
                await JS.InvokeVoidAsync("appendChatTextareaText", messageTextarea, transcript);
            }
            catch
            {
                micStatusMessage = "Transcript: " + transcript;
                micStatusIsError = false;
                return;
            }

            micStatusMessage = $"Transcribed with {transcriptModel ?? "STT"}.";
            micStatusIsError = false;
            _ = ClearMicStatusAfterDelayAsync();
        }
        catch (Exception ex)
        {
            micStatusIsError = true;
            micStatusMessage = "Speech-to-text error: " + ex.Message;
            try { await JS.InvokeVoidAsync("appMicCancel"); } catch { }
        }
        finally
        {
            isMicTranscribing = false;
            isMicRecording = false;
            StateHasChanged();
        }
    }

    async Task ClearMicStatusAfterDelayAsync()
    {
        try
        {
            await Task.Delay(4000);
            if (!micStatusIsError)
            {
                micStatusMessage = null;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch { }
    }


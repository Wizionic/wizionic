    static bool IsImageOnlyAssistantMessage(ChatMessage msg)
    {
        if (string.IsNullOrWhiteSpace(msg.Content))
            return msg.Attachments?.Any() == true;
        var c = msg.Content.Trim();
        return c.StartsWith("Generated image for:", StringComparison.OrdinalIgnoreCase)
               || c.StartsWith("Edited image for:", StringComparison.OrdinalIgnoreCase);
    }

    static string StripMarkdownForSpeech(string raw)
    {
        if (string.IsNullOrWhiteSpace(raw)) return "";
        // Light cleanup so TTS doesn't read markdown noise.
        var s = System.Text.RegularExpressions.Regex.Replace(raw, @"!\[.*?\]\(.*?\)", " ");
        s = System.Text.RegularExpressions.Regex.Replace(s, @"\[([^\]]+)\]\([^)]+\)", "$1");
        s = System.Text.RegularExpressions.Regex.Replace(s, "[`*_#>]+", " ");
        s = System.Text.RegularExpressions.Regex.Replace(s, @"\s+", " ").Trim();
        return s;
    }

    async Task SpeakLastAssistantMessageAsync()
    {
        for (int i = messages.Count - 1; i >= 0; i--)
        {
            var m = messages[i];
            if (m.DeletedAt != null) continue;
            if (m.Role == "user" || m.User == currentUser) continue;
            if (string.IsNullOrWhiteSpace(m.Content)) continue;
            if (IsImageOnlyAssistantMessage(m)) continue;
            await SpeakMessageAsync(i);
            return;
        }
        ttsStatusMessage = "No assistant message to read.";
        StateHasChanged();
    }


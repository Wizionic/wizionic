        <label style="font-size:0.8em;">Model</label>
        <select class="form-control" style="width:100%; margin-bottom:0.5rem;" @bind="imageModel" @bind:after="OnImagePanelModelChanged">
            @foreach (var m in ImagePanelModelNames)

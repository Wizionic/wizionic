    async Task SaveAttachmentToAlbumAsync(string albumId, Attachment att)
    {
        var now = DateTime.UtcNow;
        var gi = new GalleryImage(
            Id: Guid.NewGuid().ToString("N"),
            Name: string.IsNullOrWhiteSpace(att.Name) ? "chat-image.png" : att.Name,
            ContentType: string.IsNullOrWhiteSpace(att.ContentType) ? "image/png" : att.ContentType,
            DataBase64: att.DataBase64,
            Size: att.Size > 0 ? att.Size : (long)(att.DataBase64.Length * 0.75),
            Timestamp: now,
            ModifiedAt: now);

        // Prefer raw-bytes ingest when available (WASM generates thumb).
        try
        {
            var bytes = Convert.FromBase64String(att.DataBase64);
            await GalleryStore.UpsertImageFromRawBytesAsync(
                albumId, gi.Id, gi.Name, gi.ContentType, bytes);
        }
        catch
        {
            await GalleryStore.UpsertImageAsync(albumId, gi);
        }
    }

    bool MessageHasImageAttachment(int index)
    {
        if (index < 0 || index >= messages.Count) return false;
        var atts = messages[index].Attachments;
        return atts != null && atts.Any(IsImageAttachment);
    }

    static bool IsImageAttachment(Attachment att) =>
        ChatAttachmentClassifier.Classify(att) == ChatAttachmentKind.Image &&
        !string.IsNullOrWhiteSpace(att.DataBase64);

    Attachment? FindLatestImageAttachment()
    {
        for (int i = messages.Count - 1; i >= 0; i--)
        {
            var atts = messages[i].Attachments;
            if (atts == null) continue;
            var img = atts.LastOrDefault(IsImageAttachment);
            if (img != null) return img;
        }

        return pendingFiles.LastOrDefault(IsImageAttachment);
    }

    void OpenImageGenPanel()
    {
        imagePanelMode = "generate";
        imagePanelError = null;
        imageEditSourceBytes = null;
        imageEditPreviewUrl = null;
        imagePrompt = "";
        imagePanelUsesCloud = ModelProfileId.TryCloudProvider(ProfileImageModelId, out var imgPid, out var imgName);
        imagePanelCloudProviderId = imagePanelUsesCloud ? imgPid : null;
        if (imagePanelUsesCloud && imagePanelCloudProviderId != null)
        {
            imageModel = imgName
                         ?? CloudImages.DefaultImageModel(imagePanelCloudProviderId)
                         ?? CloudImages.ImageModelNames(imagePanelCloudProviderId).FirstOrDefault()
                         ?? "";
        }
        else
        {
            imageModel = LemonadeImages.DefaultImageModel ?? LemonadeImages.ImageModelNames.FirstOrDefault() ?? "";
            ApplyImageParamsFromModel(imageModel);
        }
        showImagePanel = true;
    }

    void OpenImageEditPanel(int? messageIndex)
    {
        imagePanelUsesCloud = ModelProfileId.TryCloudProvider(ProfileEditModelId ?? ProfileImageModelId, out var editPid, out _);
        imagePanelCloudProviderId = imagePanelUsesCloud ? editPid : null;
        var editAvailable = imagePanelUsesCloud
            ? CloudImages.IsEditAvailable(imagePanelCloudProviderId!)
            : LemonadeImages.IsEditAvailable;
        if (!editAvailable)
        {
            imagePanelError =
                "No edit-capable image models found. Refresh models on Cloud providers or Local AI.";
            imagePanelMode = "edit";
            showImagePanel = true;
            imageEditSourceBytes = null;
            imageEditPreviewUrl = null;
            return;
        }

        Attachment? source = null;
        if (messageIndex is int idx && idx >= 0 && idx < messages.Count)
            source = messages[idx].Attachments?.LastOrDefault(IsImageAttachment);
        source ??= FindLatestImageAttachment();

        if (source == null)
        {
            imagePanelError = "No image found to edit. Generate or attach an image first.";
            imagePanelMode = "edit";
            showImagePanel = true;
            imageEditSourceBytes = null;
            imageEditPreviewUrl = null;
            return;
        }

        try
        {
            imageEditSourceBytes = Convert.FromBase64String(source.DataBase64);
        }
        catch
        {
            imagePanelError = "Could not decode the source image.";
            showImagePanel = true;
            return;
        }

        imagePanelMode = "edit";
        imagePanelError = null;
        imageEditPreviewUrl = AttachmentDataUrl(source);
        imagePrompt = "";
        if (imagePanelUsesCloud && imagePanelCloudProviderId != null)
        {
            imageModel = CloudImages.DefaultEditModel(imagePanelCloudProviderId)
                         ?? CloudImages.EditModelNames(imagePanelCloudProviderId).FirstOrDefault()
                         ?? "";
        }
        else
        {
            imageModel = LemonadeImages.DefaultEditModel ?? LemonadeImages.EditModelNames.FirstOrDefault() ?? "";
            ApplyImageParamsFromModel(imageModel);
        }
        showImagePanel = true;
    }

    void CloseImagePanel()
    {
        if (imageBusy) return;
        showImagePanel = false;
        imagePanelError = null;
        imageEditSourceBytes = null;
        imageEditPreviewUrl = null;
        _imageCts?.Cancel();
    }

    async Task SubmitImagePanel()
    {
        if (imageBusy) return;
        imagePanelError = null;

        if (string.IsNullOrWhiteSpace(imagePrompt))
        {
            imagePanelError = "Enter a prompt.";
            return;
        }

        if (string.IsNullOrWhiteSpace(imageModel))
        {
            imagePanelError = "Select an image model. Refresh models if the list is empty.";
            return;
        }

        var panelEditOk = imagePanelUsesCloud && imagePanelCloudProviderId != null
            ? CloudImages.ModelSupportsEdit(imagePanelCloudProviderId, imageModel)
            : LemonadeImages.ModelSupportsEdit(imageModel);
        if (imagePanelMode == "edit" && !panelEditOk)
        {
            imagePanelError = $"{imageModel} does not support editing. Choose an edit-capable model.";
            return;
        }

        imageBusy = true;
        isSending = true;
        isTyping = true;
        typingLabel = imagePanelMode == "edit" ? "Editing image…" : "Generating image…";
        StateHasChanged();

        _imageCts?.Cancel();
        _imageCts = new CancellationTokenSource();
        var ct = _imageCts.Token;

        string? panelB64;
        string? panelModel;
        string? panelError;
        try
        {
            if (imagePanelUsesCloud && imagePanelCloudProviderId != null)
            {
                CloudImageResult cloudResult;
                if (imagePanelMode == "edit")
                {
                    if (imageEditSourceBytes is not { Length: > 0 })
                    {
                        imagePanelError = "No source image for edit.";
                        return;
                    }

                    cloudResult = await CloudImages.EditAsync(new CloudImageEditRequest(
                        ProviderId: imagePanelCloudProviderId,
                        Prompt: imagePrompt.Trim(),
                        ImageBytes: imageEditSourceBytes,
                        Model: imageModel), ct);
                }
                else
                {
                    cloudResult = await CloudImages.GenerateAsync(new CloudImageGenerateRequest(
                        ProviderId: imagePanelCloudProviderId,
                        Prompt: imagePrompt.Trim(),
                        Model: imageModel), ct);
                }

                panelB64 = cloudResult.Base64Png;
                panelModel = cloudResult.Model;
                panelError = cloudResult.Success ? null : cloudResult.Error;
            }
            else
            {
                LemonadeImageResult result;
                if (imagePanelMode == "edit")
                {
                    if (imageEditSourceBytes is not { Length: > 0 })
                    {
                        imagePanelError = "No source image for edit.";
                        return;
                    }

                    result = await LemonadeImages.EditAsync(new LemonadeImageEditRequest(
                        Prompt: imagePrompt.Trim(),
                        ImagePngBytes: imageEditSourceBytes,
                        Model: imageModel,
                        Size: ImageSizeString,
                        Steps: imageSteps > 0 ? imageSteps : null,
                        CfgScale: imageCfg,
                        Seed: ParsedImageSeed), ct);
                }
                else
                {
                    result = await LemonadeImages.GenerateAsync(new LemonadeImageGenerateRequest(
                        Prompt: imagePrompt.Trim(),
                        Model: imageModel,
                        Size: ImageSizeString,
                        Steps: imageSteps > 0 ? imageSteps : null,
                        CfgScale: imageCfg,
                        Seed: ParsedImageSeed), ct);
                }

                if (result.Success && !string.IsNullOrWhiteSpace(result.Base64Png) &&
                    !string.Equals(imageUpscale, "off", StringComparison.OrdinalIgnoreCase))
                {
                    typingLabel = "Upscaling…";
                    StateHasChanged();
                    result = await MaybeUpscaleAsync(result);
                }

                panelB64 = result.Base64Png;
                panelModel = result.Model;
                panelError = result.Success ? null : result.Error;
            }
        }
        catch (Exception ex)
        {
            panelB64 = null;
            panelModel = imageModel;
            panelError = ex.Message;
        }
        finally
        {
            imageBusy = false;
            isSending = false;
            isTyping = false;
            typingLabel = "Wizionic is thinking…";
        }

        if (string.IsNullOrWhiteSpace(panelB64))
        {
            imagePanelError = panelError ?? "Image request failed.";
            StateHasChanged();
            return;
        }

        string? panelAutoSave = null;
        if (ContextualRequestRouter.MessageSuggestsGalleryTools(imagePrompt))
            panelAutoSave = await TryAutoSaveGeneratedImageAsync(imagePrompt, panelB64);

        await AppendGeneratedImageMessageAsync(
            imagePrompt.Trim(),
            panelB64,
            ResolveImagePanelCatalogId(panelModel ?? imageModel),
            isEdit: imagePanelMode == "edit",
            autoSaveNote: panelAutoSave);

        showImagePanel = false;
        imageEditSourceBytes = null;
        imageEditPreviewUrl = null;
        imagePrompt = "";
        StateHasChanged();
    }

    string ResolveImagePanelCatalogId(string modelOrId)
    {
        if (string.IsNullOrWhiteSpace(modelOrId))
            return selectedModel ?? "";
        if (CloudModelId.IsCloud(modelOrId)
            || modelOrId.StartsWith("lemonade/", StringComparison.OrdinalIgnoreCase)
            || modelOrId.StartsWith("ollama/", StringComparison.OrdinalIgnoreCase))
            return modelOrId;
        if (imagePanelUsesCloud && !string.IsNullOrWhiteSpace(imagePanelCloudProviderId))
            return CloudModelId.Format(imagePanelCloudProviderId, modelOrId);
        return "lemonade/" + modelOrId.Trim();
    }

    (string Source, string Model) DescribeImageCatalogModel(string catalogModelId)
    {
        if (CloudModelId.TryParse(catalogModelId, out var providerId, out var cloudName))
        {
            var provider = KeyStore.GetCloudProvider(providerId);
            var source = !string.IsNullOrWhiteSpace(provider?.DisplayName) ? provider!.DisplayName : providerId;
            return (source, cloudName);
        }

        if (catalogModelId.StartsWith("lemonade/", StringComparison.OrdinalIgnoreCase))
            return ("Lemonade", catalogModelId.Split('/', 2)[1]);
        if (catalogModelId.StartsWith("ollama/", StringComparison.OrdinalIgnoreCase))
            return ("Ollama", catalogModelId.Split('/', 2)[1]);
        return ("Direct", catalogModelId);
    }

    string FormatDirectImageTrace(bool isEdit, string catalogModelId)
    {
        var action = isEdit ? "Image edit" : "Image generate";
        var (source, model) = DescribeImageCatalogModel(catalogModelId);
        return $"[{DateTime.UtcNow:HH:mm:ss.fff}] 🎨 {action} · {source} · {model}";
    }

    async Task AppendGeneratedImageMessageAsync(
        string prompt, string base64Png, string catalogModelId, bool isEdit, string? autoSaveNote = null)
    {
        if (string.IsNullOrEmpty(activeConvoId))
        {
            activeConvoId = Guid.NewGuid().ToString();
            await ConversationStore.SetLastConvoIdAsync(activeConvoId);
        }

        var now = DateTime.UtcNow;
        var userLine = isEdit
            ? $"(Edit image) {prompt}"
            : $"(Generate image) {prompt}";

        messages.Add(new ChatMessage(
            Role: "user",
            Content: userLine,
            Timestamp: now,
            User: currentUser,
            ItemId: Guid.NewGuid().ToString("N"),
            ModifiedAt: now));

        var fileName = isEdit
            ? $"edited-{now:yyyyMMdd-HHmmss}.png"
            : $"generated-{now:yyyyMMdd-HHmmss}.png";
        var att = new Attachment(fileName, "image/png", base64Png, EstimateBase64Bytes(base64Png));
        var caption = isEdit
            ? $"Edited image for: {prompt}"
            : $"Generated image for: {prompt}";
        if (!string.IsNullOrWhiteSpace(autoSaveNote))
            caption = caption + "\n\n" + autoSaveNote;

        var used = string.IsNullOrWhiteSpace(catalogModelId) ? selectedModel : catalogModelId;
        messages.Add(new ChatMessage(
            Role: "assistant",
            Content: caption,
            ModelUsed: used,
            Timestamp: now,
            Attachments: new List<Attachment> { att },
            ToolTrace: FormatDirectImageTrace(isEdit, used ?? ""),
            ItemId: Guid.NewGuid().ToString("N"),
            ModifiedAt: now));

        RequestScrollToBottom();
        await SaveCurrentConvo();
    }

    static long EstimateBase64Bytes(string b64)
    {
        // Approx decoded size; enough for UI/storage metadata.
        return (long)(b64.Length * 3L / 4L);
    }

    async Task SaveCurrentConvo()
    {
        if (string.IsNullOrEmpty(activeConvoId)) return;
        // Never overwrite a locked chat — body is not loaded until unlock this session.
        if (IsActiveChatLocked)
            return;
        await ConversationStore.SaveConversationAsync(activeConvoId, messages);
        await ConversationStore.UpdateIndexAfterSaveAsync(activeConvoId, messages, localConvos);
        localConvos = await ConversationStore.LoadIndexAsync();
        SyncService.ScheduleAutoSyncConvoAfterLocalSave(activeConvoId);
    }


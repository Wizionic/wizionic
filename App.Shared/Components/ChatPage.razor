    private async Task OnChatComposerInput(ChangeEventArgs e)
    {
        string text;
        try { text = await JS.InvokeAsync<string>("getChatTextareaValue", messageTextarea); }
        catch { text = e.Value?.ToString() ?? ""; }
        UpdateSlashSuggestions(text ?? "");
    }

    private async Task OnChatComposerKeyDown(KeyboardEventArgs e)
    {
        if (_slashSuggestions.Count == 0) return;

        if (e.Key == "ArrowDown")
        {
            _slashHighlight = (_slashHighlight + 1) % _slashSuggestions.Count;
            StateHasChanged();
        }
        else if (e.Key == "ArrowUp")
        {
            _slashHighlight = (_slashHighlight - 1 + _slashSuggestions.Count) % _slashSuggestions.Count;
            StateHasChanged();
        }
        else if (e.Key is "Enter" or "Tab")
        {
            if (_slashHighlight >= 0 && _slashHighlight < _slashSuggestions.Count)
            {
                await ApplySlashSkill(_slashSuggestions[_slashHighlight].Name);
            }
        }
        else if (e.Key == "Escape")
        {
            _slashSuggestions = new();
            StateHasChanged();
        }
    }

    private void UpdateSlashSuggestions(string text)
    {
        text ??= "";
        // Only when composing a slash command at start of input
        if (!text.StartsWith('/') || text.Contains('\n'))
        {
            if (_slashSuggestions.Count > 0)
            {
                _slashSuggestions = new();
                StateHasChanged();
            }
            return;
        }

        var rest = text[1..];
        // /skill foo  → filter foo; /skill-foo → filter skill-foo / foo; /foo → filter foo
        string filter;
        if (rest.StartsWith("skill ", StringComparison.OrdinalIgnoreCase))
            filter = rest["skill ".Length..].Trim();
        else
            filter = rest.Trim();

        filter = filter.TrimStart('/');
        var filterNorm = SkillMarkdown.NormalizeName(filter);

        IEnumerable<SkillRecord> skills;
        try { skills = SkillStore.List().Where(s => s.Enabled); }
        catch { skills = Array.Empty<SkillRecord>(); }

        var items = new List<SlashSkillItem>();
        foreach (var s in skills)
        {
            var name = s.Name ?? "";
            if (!string.IsNullOrEmpty(filterNorm) &&
                !name.Contains(filterNorm, StringComparison.OrdinalIgnoreCase) &&
                !("skill-" + name).Contains(filterNorm, StringComparison.OrdinalIgnoreCase))
                continue;

            string desc = "";
            try
            {
                var doc = SkillMarkdown.Parse(s.Markdown);
                desc = doc.Description ?? "";
                if (desc.Length > 90) desc = desc[..87] + "…";
            }
            catch { /* ignore */ }

            items.Add(new SlashSkillItem { Name = name, Description = desc });
            if (items.Count >= 8) break;
        }

        _slashSuggestions = items.OrderBy(i => i.Name, StringComparer.OrdinalIgnoreCase).ToList();
        _slashHighlight = 0;
        StateHasChanged();
    }

    private async Task ApplySlashSkill(string skillName)
    {
        var cmd = "/" + skillName;
        try { await JS.InvokeVoidAsync("setChatTextareaValue", messageTextarea, cmd); }
        catch
        {
            try { await JS.InvokeVoidAsync("eval", $"document.getElementById('chat-message-input').value = {System.Text.Json.JsonSerializer.Serialize(cmd)}"); }
            catch { /* ignore */ }
        }
        _slashSuggestions = new();
        StateHasChanged();
    }

    async Task Send(string? overrideText = null)
    {
        string currentMessage = overrideText ?? "";
        if (string.IsNullOrWhiteSpace(currentMessage))
        {
            try { currentMessage = await JS.InvokeAsync<string>("getChatTextareaValue", messageTextarea); }
            catch { /* ignore */ }
        }

        _slashSuggestions = new();

        if (isSending || (string.IsNullOrWhiteSpace(currentMessage) && !pendingFiles.Any()))
            return;

        // Image models in the picker: prompt + Send → generate (or edit if an image is attached).
        if (IsImageGenerationModel)
        {
            await SendAsImageRequestAsync(currentMessage.Trim());
            return;
        }

        isSending = true;
        _sendCts?.Cancel();
        _sendCts?.Dispose();
        _sendCts = new CancellationTokenSource();
        var sendCt = _sendCts.Token;

        if (string.IsNullOrEmpty(activeConvoId))
        {
            activeConvoId = Guid.NewGuid().ToString();
            await ConversationStore.SetLastConvoIdAsync(activeConvoId);
        }

        // Store *raw* text (markdown/plain) for persistence, LLM history, and tool use.
        // Rendering always applies FormatMessage for display.
        var rawUser = currentMessage;
        var attachmentsForThisTurn = pendingFiles.Any() ? pendingFiles.ToList() : null;
        var now = DateTime.UtcNow;
        messages.Add(new ChatMessage(
            Role: "user", Content: rawUser, ModelUsed: null, Timestamp: now, User: currentUser,
            Attachments: attachmentsForThisTurn, ItemId: Guid.NewGuid().ToString("N"), ModifiedAt: now));

        var botIndex = messages.Count;
        messages.Add(new ChatMessage(
            Role: "assistant", Content: "", ModelUsed: selectedModel, Timestamp: now,
            ItemId: Guid.NewGuid().ToString("N"), ModifiedAt: now));

        isTyping = true;
        pendingFiles.Clear();
        attachStatusMessage = null;
        try { await JS.InvokeVoidAsync("resetChatTextarea", messageTextarea); } catch { }
        RequestScrollToBottom();
        StateHasChanged();

        await KeyStore.SetLastSelectedModelAsync(selectedModel);

        var accumulated = "";
        var lastUiUpdate = DateTime.MinValue;
        var streamBotIndex = botIndex;

        try
        {
            accumulated = await CallProvider(async partial =>
            {
                // Throttle Blazor re-renders while tokens arrive (local Ollama/Lemonade stream).
                var nowUtc = DateTime.UtcNow;
                var prevLen = messages[streamBotIndex].Content?.Length ?? 0;
                if ((nowUtc - lastUiUpdate).TotalMilliseconds < 40 &&
                    partial.Length - prevLen < 24)
                    return;

                lastUiUpdate = nowUtc;
                if (isTyping)
                    isTyping = false; // first token: drop "thinking…"

                var current = messages[streamBotIndex];
                messages[streamBotIndex] = current with { Content = partial, ModifiedAt = DateTime.UtcNow };
                RequestScrollToBottom();
                await InvokeAsync(StateHasChanged);
            }, sendCt);

            var currentModel = messages[botIndex].ModelUsed;
            var resultAtts = _pendingResultAttachments;
            _pendingResultAttachments = null;
            var statsLine = _pendingStatsLine;
            _pendingStatsLine = null;
            if (string.IsNullOrWhiteSpace(accumulated) &&
                !string.IsNullOrWhiteSpace(messages[botIndex].Content))
            {
                accumulated = messages[botIndex].Content!;
            }

            var touched = ChatMessageHelper.TouchModified(messages[botIndex], content: accumulated);
            messages[botIndex] = touched with
            {
                ModelUsed = currentModel,
                ToolTrace = _pendingToolTrace,
                Attachments = resultAtts is { Count: > 0 } ? resultAtts : touched.Attachments,
                StatsLine = statsLine
            };
            _pendingToolTrace = ""; // consumed
            RequestScrollToBottom();
            StateHasChanged();

            // Save to local
            await SaveCurrentConvo();

            // Omni may already return speech as an audio attachment — prefer that over auto-TTS.
            var hasOmniAudio = resultAtts?.Any(a =>
                a.ContentType != null &&
                a.ContentType.StartsWith("audio/", StringComparison.OrdinalIgnoreCase)) == true;

            var wasStopped = statsLine?.Contains("stopped", StringComparison.OrdinalIgnoreCase) == true
                             || accumulated.Contains("Generation stopped", StringComparison.OrdinalIgnoreCase);

            if (!wasStopped && (voiceModeOn || autoSpeakReplies) && IsTtsAvailable && !hasOmniAudio &&
                !string.IsNullOrWhiteSpace(accumulated) &&
                !accumulated.StartsWith("Error calling provider", StringComparison.OrdinalIgnoreCase))
            {
                if (voiceModeOn)
                {
                    voiceStatusMessage = "Speaking…";
                    StateHasChanged();
                    try { await JS.InvokeVoidAsync("appVoiceSetMuted", true); } catch { }
                    await SpeakMessageAsync(botIndex, waitForEnd: true);
                    if (voiceModeOn)
                    {
                        var followUps = KeyStore.GetUserProfile().VoiceFollowUpWithoutWake;
                        if (followUps)
                        {
                            voiceSessionUntilUtc = DateTime.UtcNow.AddSeconds(30);
                            voiceAwaitingWake = false;
                        }
                        else
                        {
                            voiceSessionUntilUtc = DateTime.MinValue;
                            voiceAwaitingWake = true;
                        }
                        voiceStatusMessage = $"Listening for “{KeyStore.AssistantName}”…";
                        try { await JS.InvokeVoidAsync("appVoiceSetMuted", false); } catch { }
                    }
                }
                else
                {
                    _ = SpeakMessageAsync(botIndex);
                }
            }
            else if (!wasStopped && hasOmniAudio && resultAtts != null)
            {
                var audio = resultAtts.First(a =>
                    a.ContentType != null &&
                    a.ContentType.StartsWith("audio/", StringComparison.OrdinalIgnoreCase));
                _ = PlayAttachmentAudio(audio);
            }
        }
        finally
        {
            isTyping = false;
            isSending = false;
            RequestScrollToBottom();
            StateHasChanged();
        }
    }

    /// <summary>
    /// When a Lemonade image model is selected in the chat picker, treat the message as an image prompt.
    /// If a pending image attachment exists, run edit (only when the model supports edit); otherwise generate.
    /// </summary>
    async Task SendAsImageRequestAsync(string prompt)
    {
        if (string.IsNullOrWhiteSpace(prompt))
            return;

        var isCloudImage = CloudModelId.TryParse(selectedModel, out var sendCloudProviderId, out var sendCloudModel);
        var modelName = isCloudImage
            ? sendCloudModel
            : selectedModel.StartsWith("lemonade/", StringComparison.OrdinalIgnoreCase)
                ? selectedModel.Split('/', 2)[1]
                : selectedModel;

        var sourceImage = pendingFiles.LastOrDefault(IsImageAttachment);
        var wantsEdit = sourceImage != null;
        byte[]? sourceBytes = null;
        if (wantsEdit)
        {
            try { sourceBytes = Convert.FromBase64String(sourceImage!.DataBase64); }
            catch
            {
                wantsEdit = false;
            }
        }

        var editSupported = isCloudImage
            ? CloudImages.ModelSupportsEdit(sendCloudProviderId, modelName)
            : LemonadeImages.ModelSupportsEdit(modelName);
        if (wantsEdit && !editSupported)
        {
            await AppendImageErrorMessageAsync(
                $"(Edit image) {prompt}",
                $"{modelName} does not support image editing (generate-only). " +
                "Pick an Image+Edit model, or remove the attachment to generate a new image.");
            pendingFiles.Clear();
            try { await JS.InvokeVoidAsync("resetChatTextarea", messageTextarea); } catch { }
            return;
        }

        isSending = true;
        isTyping = true;
        typingLabel = wantsEdit ? "Editing image…" : "Generating image…";
        try { await JS.InvokeVoidAsync("resetChatTextarea", messageTextarea); } catch { }
        pendingFiles.Clear();
        RequestScrollToBottom();
        StateHasChanged();

        await KeyStore.SetLastSelectedModelAsync(selectedModel);

        string? resultB64;
        string? resultModel;
        string? resultError;
        try
        {
            if (isCloudImage)
            {
                CloudImageResult cloudResult;
                if (wantsEdit && sourceBytes is { Length: > 0 })
                {
                    cloudResult = await CloudImages.EditAsync(new CloudImageEditRequest(
                        ProviderId: sendCloudProviderId,
                        Prompt: prompt,
                        ImageBytes: sourceBytes,
                        Model: modelName));
                }
                else
                {
                    cloudResult = await CloudImages.GenerateAsync(new CloudImageGenerateRequest(
                        ProviderId: sendCloudProviderId,
                        Prompt: prompt,
                        Model: modelName));
                }
                resultB64 = cloudResult.Base64Png;
                resultModel = cloudResult.Model;
                resultError = cloudResult.Success ? null : cloudResult.Error;
            }
            else
            {
                LemonadeImageResult result;
                if (wantsEdit && sourceBytes is { Length: > 0 })
                {
                    result = await LemonadeImages.EditAsync(new LemonadeImageEditRequest(
                        Prompt: prompt,
                        ImagePngBytes: sourceBytes,
                        Model: modelName,
                        Size: ImageSizeString,
                        Steps: imageSteps > 0 ? imageSteps : null,
                        CfgScale: imageCfg,
                        Seed: ParsedImageSeed));
                }
                else
                {
                    result = await LemonadeImages.GenerateAsync(new LemonadeImageGenerateRequest(
                        Prompt: prompt,
                        Model: modelName,
                        Size: ImageSizeString,
                        Steps: imageSteps > 0 ? imageSteps : null,
                        CfgScale: imageCfg,
                        Seed: ParsedImageSeed));
                }

                if (result.Success && !string.IsNullOrWhiteSpace(result.Base64Png) &&
                    !string.Equals(imageUpscale, "off", StringComparison.OrdinalIgnoreCase))
                {
                    typingLabel = "Upscaling…";
                    StateHasChanged();
                    result = await MaybeUpscaleAsync(result);
                }

                resultB64 = result.Base64Png;
                resultModel = result.Model;
                resultError = result.Success ? null : result.Error;
            }
        }
        catch (Exception ex)
        {
            resultB64 = null;
            resultModel = modelName;
            resultError = ex.Message;
        }
        finally
        {
            isTyping = false;
            isSending = false;
            typingLabel = "Wizionic is thinking…";
        }

        if (string.IsNullOrWhiteSpace(resultB64))
        {
            await AppendImageErrorMessageAsync(
                wantsEdit ? $"(Edit image) {prompt}" : $"(Generate image) {prompt}",
                resultError ?? "Image request failed.");
            return;
        }

        try
        {
            var convoId = activeConvoId ?? "_default";
            MediaBuffer.AddImage(
                convoId,
                resultB64,
                "image/png",
                wantsEdit ? "edited-image.png" : "generated-image.png",
                wantsEdit ? "image_edit" : "image_generate");
        }
        catch { /* non-fatal */ }

        // Direct image-model path has no LLM tools — auto-save when the prompt names an album.
        string? autoSaveNote = null;
        if (ContextualRequestRouter.MessageSuggestsGalleryTools(prompt))
        {
            autoSaveNote = await TryAutoSaveGeneratedImageAsync(prompt, resultB64);
        }

        await AppendGeneratedImageMessageAsync(
            prompt, resultB64, selectedModel, wantsEdit, autoSaveNote);
        StateHasChanged();
    }

    /// <summary>
    /// When the chat picker is an image model (no tool loop), honor "save to Fruit album" in the prompt.
    /// </summary>
    async Task<string?> TryAutoSaveGeneratedImageAsync(string prompt, string base64Png)
    {
        var albumName = ContextualRequestRouter.TryExtractAlbumName(prompt);
        if (string.IsNullOrWhiteSpace(albumName))
        {
            if (prompt.Contains("gallery", StringComparison.OrdinalIgnoreCase)
                || prompt.Contains("album", StringComparison.OrdinalIgnoreCase))
                albumName = "Gallery";
            else
                return null;
        }

        try
        {
            var raw = Convert.FromBase64String(base64Png);
            var (ok, msg) = await GallerySaveHelper.SaveImageAsync(
                GalleryStore,
                SyncService,
                StorageQuota,
                albumName,
                raw,
                "image/png",
                "generated-image.png");
            return ok ? msg : "Could not auto-save to gallery: " + msg;
        }
        catch (Exception ex)
        {
            return "Could not auto-save to gallery: " + ex.Message;
        }
    }


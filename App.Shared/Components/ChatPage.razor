    [JSInvokable]
    public Task OnVoiceUtterance(string base64, int durationMs) =>
        InvokeAsync(() => HandleVoiceUtteranceAsync(base64, durationMs));

    async Task HandleVoiceUtteranceAsync(string base64, int durationMs)
    {
        if (!voiceModeOn || voiceBusy || isSending || isMicTranscribing)
            return;
        if (string.IsNullOrWhiteSpace(base64) || durationMs < 250)
            return;

        var followUps = KeyStore.GetUserProfile().VoiceFollowUpWithoutWake;
        var name = KeyStore.AssistantName;
        var sessionLive = followUps && DateTime.UtcNow <= voiceSessionUntilUtc;

        // Ambient music / long noise: don't STT unless we're in a follow-up window.
        if (durationMs > 8000 && !sessionLive)
            return;

        voiceBusy = true;
        try { await JS.InvokeVoidAsync("appVoiceSetMuted", true); } catch { }
        voiceStatusMessage = "Transcribing…";
        StateHasChanged();

        try
        {
            byte[] wavBytes;
            try { wavBytes = Convert.FromBase64String(base64); }
            catch
            {
                voiceStatusMessage = "Could not decode speech.";
                return;
            }

            var transcript = await TranscribeWavBytesAsync(wavBytes);
            if (string.IsNullOrWhiteSpace(transcript))
            {
                voiceStatusMessage = $"Listening for “{name}”…";
                return;
            }

            var heardWake = ContextualRequestRouter.ContainsWakeWord(transcript, name);
            var remainder = HomeAssistantFallback.StripWakeWord(transcript, name).Trim().Trim(',', '.', '!', '?');
            var toSend = transcript.Trim();

            if (!heardWake && !sessionLive)
            {
                voiceStatusMessage = $"Listening for “{name}”…";
                return;
            }

            if (heardWake && string.IsNullOrWhiteSpace(remainder))
            {
                if (followUps)
                {
                    voiceAwaitingWake = false;
                    voiceSessionUntilUtc = DateTime.UtcNow.AddSeconds(30);
                    voiceStatusMessage = "Go ahead.";
                    return;
                }

                voiceStatusMessage = $"Listening for “{name}”…";
                return;
            }

            if (!heardWake && sessionLive && !string.IsNullOrWhiteSpace(name))
                toSend = name + ", " + toSend;

            if (followUps)
            {
                voiceAwaitingWake = false;
                voiceSessionUntilUtc = DateTime.UtcNow.AddSeconds(30);
            }
            else
            {
                voiceAwaitingWake = true;
                voiceSessionUntilUtc = DateTime.MinValue;
            }

            voiceStatusMessage = "Sending…";
            StateHasChanged();
            await Send(toSend);
        }
        catch (Exception ex)
        {
            voiceStatusMessage = "Voice error: " + ex.Message;
        }
        finally
        {
            voiceBusy = false;
            if (voiceModeOn && !isSending)
            {
                try { await JS.InvokeVoidAsync("appVoiceSetMuted", false); } catch { }
                if (string.IsNullOrWhiteSpace(voiceStatusMessage) || voiceStatusMessage == "Sending…" || voiceStatusMessage == "Transcribing…")
                    voiceStatusMessage = $"Listening for “{KeyStore.AssistantName}”…";
            }
            StateHasChanged();
        }
    }

    async Task<string?> TranscribeWavBytesAsync(byte[] wavBytes)
    {
        using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(45));
        if (UseCloudSpeech && SpeechCloudProviderId != null)
        {
            var sttSlot = ModelProfileId.ResolveSttModelId(KeyStore);
            ModelProfileId.TryCloudProvider(sttSlot, out _, out var sttModel);
            var result = await CloudSpeech.TranscribeAsync(new CloudTranscriptionRequest(
                ProviderId: SpeechCloudProviderId,
                WavBytes: wavBytes,
                Model: sttModel ?? CloudSpeech.DefaultSttModel(SpeechCloudProviderId),
                Language: null,
                FileName: "voice-mode.wav"), cts.Token);
            return result.Success ? result.Text : null;
        }

        var local = await LemonadeSpeech.TranscribeAsync(new LemonadeTranscriptionRequest(
            WavBytes: wavBytes,
            Model: LemonadeSpeech.DefaultSttModel,
            Language: null,
            FileName: "voice-mode.wav"), cts.Token);
        return local.Success ? local.Text : null;
    }

    async Task SpeakMessageAsync(int index, bool waitForEnd = false)
    {
        if (!IsTtsAvailable)
            return;
        if (index < 0 || index >= messages.Count)
            return;
        if (ttsBusyIndex != null)
            return;

        var msg = messages[index];
        var text = StripMarkdownForSpeech(msg.Content ?? "");
        if (string.IsNullOrWhiteSpace(text))
        {
            ttsStatusMessage = "Nothing to speak in that message.";
            return;
        }

        ttsBusyIndex = index;
        ttsStatusMessage = null;
        StateHasChanged();

        _ttsCts?.Cancel();
        _ttsCts = new CancellationTokenSource();
        var ct = _ttsCts.Token;

        try
        {
            try { await JS.InvokeVoidAsync("appStopAudio"); } catch { }

            string? audioB64;
            string contentType;
            if (UseCloudSpeech && SpeechCloudProviderId != null)
            {
                var ttsSlot = ModelProfileId.ResolveTtsModelId(KeyStore);
                ModelProfileId.TryCloudProvider(ttsSlot, out _, out var ttsModel);
                var result = await CloudSpeech.SpeakAsync(new CloudSpeechRequest(
                    ProviderId: SpeechCloudProviderId,
                    Input: text,
                    Model: ttsModel ?? CloudSpeech.DefaultTtsModel(SpeechCloudProviderId),
                    Voice: ModelProfileId.ResolveVoice(KeyStore) ?? CloudSpeech.DefaultVoice(SpeechCloudProviderId),
                    Speed: 1.0,
                    ResponseFormat: "mp3"), ct);
                if (!result.Success || result.AudioBytes is not { Length: > 0 })
                {
                    ttsStatusMessage = result.Error ?? "Text-to-speech failed.";
                    return;
                }
                audioB64 = result.ToBase64();
                contentType = result.ContentType ?? "audio/mpeg";
            }
            else
            {
                var result = await LemonadeSpeech.SpeakAsync(new LemonadeSpeechRequest(
                    Input: text,
                    Model: LemonadeSpeech.DefaultTtsModel,
                    Voice: LemonadeSpeech.DefaultVoice,
                    Speed: 1.0,
                    ResponseFormat: "mp3"), ct);
                if (!result.Success || result.AudioBytes is not { Length: > 0 })
                {
                    ttsStatusMessage = result.Error ?? "Text-to-speech failed.";
                    return;
                }
                audioB64 = result.ToBase64();
                contentType = result.ContentType ?? "audio/mpeg";
            }

            var playFn = waitForEnd ? "appPlayAudioBase64Wait" : "appPlayAudioBase64";
            var play = await JS.InvokeAsync<string>(playFn, audioB64, contentType);
            if (play != "ok")
                ttsStatusMessage = "Playback failed: " + play;
        }
        catch (Exception ex)
        {
            ttsStatusMessage = "Text-to-speech error: " + ex.Message;
        }
        finally
        {
            ttsBusyIndex = null;
            StateHasChanged();
            if (!string.IsNullOrEmpty(ttsStatusMessage))
            {
                try
                {
                    await Task.Delay(5000);
                    ttsStatusMessage = null;
                    await InvokeAsync(StateHasChanged);
                }
                catch { }
            }
        }
    }


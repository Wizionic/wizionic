        @if (!imagePanelUsesCloud)
        {
        <div style="display:flex; flex-wrap:wrap; gap:0.5rem; margin-bottom:0.5rem;">
            <div style="width:72px;">
                <label style="font-size:0.8em;">Steps</label>
                <input type="number" min="1" max="50" class="form-control" style="width:100%;" @bind="imageSteps" />
            </div>
            <div style="width:72px;">
                <label style="font-size:0.8em;">CFG</label>
                <input type="number" min="0" max="20" step="0.1" class="form-control" style="width:100%;" @bind="imageCfg" />
            </div>
            <div style="width:88px;">
                <label style="font-size:0.8em;">Width</label>
                <select class="form-control" style="width:100%;" @bind="imageWidth">
                    <option value="256">256</option>
                    <option value="512">512</option>
                    <option value="768">768</option>
                    <option value="1024">1024</option>
                </select>
            </div>
            <div style="width:88px;">
                <label style="font-size:0.8em;">Height</label>
                <select class="form-control" style="width:100%;" @bind="imageHeight">
                    <option value="256">256</option>
                    <option value="512">512</option>
                    <option value="768">768</option>
                    <option value="1024">1024</option>
                </select>
            </div>
            <div style="width:88px;">
                <label style="font-size:0.8em;">Seed</label>
                <input type="text" class="form-control" style="width:100%;" @bind="imageSeedText" placeholder="random" />
            </div>
            <div style="flex:1; min-width:120px;">
                <label style="font-size:0.8em;">Upscale</label>
                <select class="form-control" style="width:100%;" @bind="imageUpscale">
                    <option value="off">Off</option>
                    <option value="RealESRGAN-x4plus">x4 plus</option>
                    <option value="RealESRGAN-x4plus-anime">x4 anime</option>
                </select>
            </div>
        </div>
        }

        @if (!string.IsNullOrEmpty(imagePanelError))
        {
            <div style="font-size:0.8em; color:#b91c1c; margin-bottom:0.5rem; white-space:pre-wrap;">@imagePanelError</div>
        }

        <div style="display:flex; gap:8px; justify-content:flex-end; margin-top:0.5rem;">
            <button type="button" class="btn btn-outline-secondary" @onclick="CloseImagePanel" disabled="@imageBusy">Cancel</button>
            <button type="button" class="btn btn-primary" @onclick="SubmitImagePanel" disabled="@imageBusy">
                @(imageBusy ? "Working…" : (imagePanelMode == "edit" ? "Edit" : "Generate"))
            </button>
        </div>
    </div>
}

@if (textPreviewAttachment != null)
{

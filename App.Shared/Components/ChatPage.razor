@implements IDisposable

@using Markdig
@using Microsoft.JSInterop
@using Microsoft.Extensions.AI
@using App.Core.Auth
@using App.Core.Chat
@using App.Core.Lemonade
@using App.Core.Cloud
@using App.Core.Storage
@using App.Core.Sync
@using App.Core.Tools
@using App.Core.Skills
@using App.Core.UI
@using App.Core.Browser
@using App.Shared.Services
@using App.Shared.Services.Lemonade
@using App.Shared.Services.Tools
@using Microsoft.AspNetCore.Components.Forms
@using ChatMessage = App.Core.Storage.ChatMessage
@using Attachment = App.Core.Storage.Attachment
@using LocalConvo = App.Core.Storage.LocalConvo
@using LocalNote = App.Core.Storage.LocalNote

@inject IJSRuntime JS
@inject NavigationManager Nav
@inject IKeyStore KeyStore
@inject IConversationStore ConversationStore
@inject IChatModelCatalog ModelCatalog
@inject IAuthService AuthService
@inject ISyncService SyncService
@inject IChatCompletionService ChatCompletionService
@inject ILemonadeImageService LemonadeImages
@inject ILemonadeSpeechService LemonadeSpeech
@inject ICloudImageService CloudImages
@inject ICloudSpeechService CloudSpeech
@inject INoteStore NoteStore
@inject IGalleryStore GalleryStore
@inject IGalleryChatHandoff GalleryChatHandoff
@inject INotesChatHandoff NotesChatHandoff
@inject IConversationMediaBuffer MediaBuffer
@inject IStorageQuotaService StorageQuota
@inject ISidebarState SidebarState
@inject IBrowserPanelState BrowserPanel
@inject ISkillStore SkillStore
@inject IChatPanelState ChatPanel

<WasmSidebarSync />

<div class="page @((SidebarState.IsCollapsed || (AppEnvironment.IsMaui && !ChatPanel.IsOpen)) ? "sidebar-collapsed" : "") @(AppEnvironment.IsMaui && !ChatPanel.IsOpen ? "chat-panel-closed" : "")">
    <!-- Sidebar -->
    <div class="sidebar">
        <nav class="cf-nav cf-column">
            <!-- AI Chats header -->
            <div class="cf-item">
                <span class="cf-link small">
                   <h4>AI Chats</h4>
                    <button class="menu-button" @onclick="NewConversation" title="New chat">
                        <i class="cf-icon bi bi-plus-circle" style="font-size: 30px;"></i>
                    </button>
                </span>
            </div>

            <!-- Local convos list (stable SortOrder; pointer drag-reorder like Notes) -->
            @if (_chatIndexLoading && !localConvos.Any())
            {
                <div class="cf-item" style="font-size:0.75em; color:var(--cf-text-muted); padding-left:12px;">Loading chats…</div>
            }
            @foreach (var c in localConvos.OrderBy(x => x.SortOrder).ThenByDescending(x => x.LastUpdated))
            {
                var isActive = activeConvoId == c.Id;
                <div class="conversation-item @(isActive ? "active" : "") @(_dragConvoId == c.Id ? "note-dragging" : "") @(_dragOverConvoId == c.Id ? "note-drag-over" : "")"
                     data-reorder-id="@c.Id"
                     @onpointerdown="e => OnConvoPointerDown(e, c.Id)"
                     @onpointerdown:preventDefault="false">
                    <div class="row-top">
                        <div class="title">
                            @if (c.IsPasswordProtected)
                            {
                                <i class="cf-icon bi bi-lock-fill" style="font-size:0.85em; margin-right:4px; opacity:0.85;" title="Password protected"></i>
                            }
                            @c.Title
                        </div>
                        <div class="menu" @onclick:stopPropagation @onpointerdown:stopPropagation>
                            <button id="menu-btn-@c.Id" class="menu-button" @onclick:stopPropagation @onclick="() => ToggleMenu(c.Id)">⋮</button>
                        </div>
                    </div>
                    <div class="date">@c.LastUpdated.ToLocalTime().ToString("MMM d")</div>
                </div>
            }
            @if (!_chatIndexLoading && !localConvos.Any())
            {
                <div class="cf-item" style="font-size:0.75em; color:var(--cf-text-muted); padding-left:12px;">No local conversations yet.</div>
            }
        </nav>
    </div>

    <!-- Main content -->
    <main>
        <div id="chat-split-wrapper" class="chat-wrapper @(BrowserPanel.IsOpen ? "browser-panel-open" : "") @(AppEnvironment.IsMaui && !ChatPanel.IsOpen ? "chat-panel-closed" : "")" @ref="_splitWrapper">
            <div class="chat-column" style="@ChatColumnStyle">
            @if (!string.IsNullOrEmpty(SyncService.AiServerDeviceId))
            {
                <div style="padding: 0.35rem 1rem; background: #f0fdf4; border-bottom: 1px solid #bbf7d0; font-size: 0.85em; color: #166534;">
                    AI via <strong>@(SyncService.GetAiServerDeviceName() ?? "remote device")</strong>
                    @if (SyncService.IsAiProxyConnected)
                    {
                        <span> — connected</span>
                    }
                    else
                    {
                        <span> — connecting…</span>
                    }
                    @if (!string.IsNullOrEmpty(SyncService.AiProxyError))
                    {
                        <span style="color:#b45309;"> (@SyncService.AiProxyError)</span>
                    }
                </div>
            }
            <div class="chat-container" @ref="chatContainer" id="chat-container">
                @if (IsActiveChatLocked)
                {
                    <div style="padding:2rem 1rem; text-align:center; color:var(--cf-text-muted);">
                        <i class="bi bi-lock-fill" style="font-size:1.5rem; display:block; margin-bottom:0.5rem;"></i>
                        <div style="margin-bottom:0.75rem;">This chat is password protected.</div>
                        <button type="button" class="btn btn-outline-primary btn-sm" @onclick="() => PromptUnlockChat(activeConvoId)">Unlock</button>
                    </div>
                }
                else
                {
                @for (var msgIndex = 0; msgIndex < messages.Count; msgIndex++)
                {
                    var capturedIndex = msgIndex;
                    var msg = messages[capturedIndex];
                    @if (msg.DeletedAt is null)
                    {
                    <div class="message-row">
                        @if (NotesChatContext.TryParse(msg, out var noteCtx))
                        {
                            <div class="note-chat-context-card">
                                <div class="note-chat-context-title">
                                    <i class="bi bi-journal-text"></i>
                                    Working with note — @noteCtx.NotebookTitle
                                </div>
                                <div class="note-chat-context-preview">@NotesChatContext.PreviewPlain(noteCtx)</div>
                            </div>
                        }
                        else if ((msg.User == currentUser) || msg.Role == "user")
                        {
                            <div class="message-me">
                                <div class="message-bot-menu" @onclick:stopPropagation>
                                    <button id="user-menu-btn-@capturedIndex" class="menu-button" @onclick:stopPropagation @onclick="() => ToggleUserMenu(capturedIndex)" title="Message options">⋮</button>
                                </div>
                                @((MarkupString)FormatMessage(msg.Content ?? ""))
                                @if (msg.Attachments != null && msg.Attachments.Any())
                                {
                                    <div class="message-attachments" style="display:flex; gap:6px; flex-wrap:wrap; margin-top:4px;">
                                        @foreach (var att in msg.Attachments)
                                        {
                                            @if (IsImageAttachment(att))
                                            {
                                                var thumbSrc = AttachmentDataUrl(att);
                                                <div style="width:52px; height:52px; border:1px solid var(--cf-border); border-radius:4px; overflow:hidden; background:var(--cf-bg-subtle); position:relative; flex-shrink:0;">
                                                    @if (thumbSrc != null)
                                                    {
                                                        <img src="@thumbSrc" alt="@att.Name"
                                                             style="width:100%; height:100%; object-fit:cover; cursor:pointer;"
                                                             title="@att.Name — click for options"
                                                             @onclick="() => OpenImagePreview(thumbSrc, att.Name, att.DataBase64, att.ContentType)" />
                                                    }
                                                </div>
                                            }
                                            else
                                            {
                                                <button type="button" class="chat-doc-chip" title="@att.Name"
                                                        @onclick="() => OpenTextPreview(att)">
                                                    <i class="bi bi-file-earmark-text"></i>
                                                    <span class="chat-doc-chip-meta">
                                                        <span class="chat-doc-chip-name">@att.Name</span>
                                                        <span class="chat-doc-chip-size">@ChatAttachmentClassifier.FormatSize(att.Size)</span>
                                                    </span>
                                                </button>
                                            }
                                        }
                                    </div>
                                }
                                @if (msg.Timestamp.HasValue)
                                {
                                    <div style="font-size: 0.6em; color: var(--color-text-muted); text-align: right; margin-top: 2px; opacity: 0.7;">
                                        @msg.Timestamp.Value.ToLocalTime().ToString("MMM d, HH:mm")
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="message-bot">
                                <div class="message-bot-menu" @onclick:stopPropagation>
                                    <button id="bot-menu-btn-@capturedIndex" class="menu-button" @onclick:stopPropagation @onclick="() => ToggleBotMenu(capturedIndex)" title="Message options">⋮</button>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(msg.ToolTrace) || !string.IsNullOrWhiteSpace(msg.StatsLine))
                                {
                                    <details style="margin-bottom: 2px; font-size: 0.7em;">
                                        <summary style="cursor:pointer; color:var(--cf-text-muted);">Model reasoning / tool calls / stats</summary>
                                        @if (!string.IsNullOrWhiteSpace(msg.StatsLine))
                                        {
                                            <div style="font-size:0.85em; background:var(--cf-bg-subtle); padding:4px 6px; border-radius:3px; margin:2px 0; color:var(--cf-text-muted);"
                                                 title="TTFT = time to first token after the model request starts. Prep (if shown) is client setup before the request.">
                                                ⏱️ @msg.StatsLine
                                            </div>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(msg.ToolTrace))
                                        {
                                            <pre style="white-space:pre-wrap; font-size:0.85em; background:var(--cf-bg-subtle); padding:4px; border-radius:3px; margin:2px 0;">@msg.ToolTrace</pre>
                                        }
                                    </details>
                                }
                                <div class="chat-markdown">
                                    @((MarkupString)FormatMessage(msg.Content ?? ""))
                                </div>
                                @if (msg.Attachments != null && msg.Attachments.Any())
                                {
                                    <div class="message-attachments" style="display:flex; gap:8px; flex-wrap:wrap; margin-top:8px;">
                                        @foreach (var att in msg.Attachments)
                                        {
                                            var botThumb = AttachmentDataUrl(att);
                                            <div style="max-width:min(320px,100%); border:1px solid var(--cf-border); border-radius:8px; overflow:hidden; background:var(--cf-bg-subtle);">
                                                @if (botThumb != null)
                                                {
                                                    <img src="@botThumb" alt="@att.Name"
                                                         style="display:block; max-width:100%; height:auto; cursor:pointer;"
                                                         title="@att.Name"
                                                         @onclick="() => OpenImagePreview(botThumb, att.Name, att.DataBase64, att.ContentType)" />
                                                    <div style="display:flex; gap:4px; padding:4px 6px; border-top:1px solid var(--cf-border); background:var(--cf-bg, #fff); flex-wrap:wrap;">
                                                        <button type="button" class="btn btn-link-style" style="font-size:0.75em; padding:2px 6px;"
                                                                title="Download" @onclick="() => DownloadAttachment(att)" @onclick:stopPropagation>
                                                            <i class="bi bi-download"></i> Download
                                                        </button>
                                                        <button type="button" class="btn btn-link-style" style="font-size:0.75em; padding:2px 6px;"
                                                                title="Copy image" @onclick="() => CopyAttachment(att)" @onclick:stopPropagation>
                                                            <i class="bi bi-clipboard"></i> Copy
                                                        </button>
                                                        <button type="button" class="btn btn-link-style" style="font-size:0.75em; padding:2px 6px;"
                                                                title="Save to Gallery" @onclick="() => OpenSaveToGallery(att)" @onclick:stopPropagation>
                                                            <i class="bi bi-images"></i> Save to Gallery
                                                        </button>
                                                    </div>
                                                }
                                                else if (att.ContentType != null && att.ContentType.StartsWith("audio/", StringComparison.OrdinalIgnoreCase))
                                                {
                                                    <div style="padding:6px 8px; font-size:0.8em;">
                                                        <button type="button" class="btn btn-link-style" style="padding:2px 4px;"
                                                                @onclick="() => PlayAttachmentAudio(att)" @onclick:stopPropagation>
                                                            <i class="bi bi-play-circle"></i> Play audio
                                                        </button>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <button type="button" class="chat-doc-chip" title="@att.Name"
                                                            @onclick="() => OpenTextPreview(att)">
                                                        <i class="bi bi-file-earmark-text"></i>
                                                        <span class="chat-doc-chip-meta">
                                                            <span class="chat-doc-chip-name">@att.Name</span>
                                                            <span class="chat-doc-chip-size">@ChatAttachmentClassifier.FormatSize(att.Size)</span>
                                                        </span>
                                                    </button>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                                <div style="display:flex; flex-wrap:wrap; align-items:center; justify-content:flex-end; gap:6px; margin-top:4px;">
                                    @if (IsTtsAvailable && !string.IsNullOrWhiteSpace(msg.Content) && !IsImageOnlyAssistantMessage(msg))
                                    {
                                        <button type="button"
                                                class="btn btn-link-style"
                                                style="font-size:0.75em; padding:2px 6px; opacity:0.85;"
                                                title="Read aloud"
                                                disabled="@(ttsBusyIndex == capturedIndex)"
                                                @onclick="() => SpeakMessageAsync(capturedIndex)"
                                                @onclick:stopPropagation>
                                            @if (ttsBusyIndex == capturedIndex)
                                            {
                                                <i class="bi bi-hourglass-split"></i>
                                            }
                                            else
                                            {
                                                <i class="bi bi-volume-up"></i>
                                            }
                                            <span style="margin-left:2px;">@(ttsBusyIndex == capturedIndex ? "Speaking…" : "Speak")</span>
                                        </button>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(msg.ModelUsed))
                                    {
                                        <div class="model-label" style="font-size: 0.6em; color: var(--color-text-muted); opacity: 0.7;">
                                            via @msg.ModelUsed
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                    }
                }
                }

                @if (isTyping && !IsActiveChatLocked)
                {
                    <div class="message-row">
                        <div class="message-bot typing">@typingLabel</div>
                    </div>
                }
            </div>

            <!-- === COMPACT SEAMLESS INPUT BAR === -->
            @if (!IsActiveChatLocked)
            {
            <div class="input-area">
                <div class="input-container">
                    <div class="message-wrapper flex-grow-1">
                        @if (pendingFiles.Any())
                        {
                            <div class="pending-attachments" style="display:flex; gap:6px; flex-wrap:wrap; margin-bottom:4px; padding-bottom:2px; border-bottom:1px solid #f0f0f0;">
                                @foreach (var f in pendingFiles)
                                {
                                    @if (IsImageAttachment(f))
                                    {
                                        var thumbSrc = AttachmentDataUrl(f);
                                        <div style="position:relative; width:42px; height:42px; border:1px solid #ddd; border-radius:4px; overflow:hidden; background:#fafafa; flex-shrink:0;">
                                            @if (thumbSrc != null)
                                            {
                                                <img src="@thumbSrc" alt="@f.Name" style="width:100%; height:100%; object-fit:cover;" />
                                            }
                                            <button type="button" class="chat-doc-chip-remove" title="Remove"
                                                    @onclick:stopPropagation @onclick="() => RemovePendingFile(f)">×</button>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="chat-doc-chip" title="@f.Name" @onclick="() => OpenTextPreview(f)">
                                            <i class="bi bi-file-earmark-text"></i>
                                            <span class="chat-doc-chip-meta">
                                                <span class="chat-doc-chip-name">@f.Name</span>
                                                <span class="chat-doc-chip-size">@ChatAttachmentClassifier.FormatSize(f.Size)</span>
                                            </span>
                                            <button type="button" class="chat-doc-chip-remove" title="Remove"
                                                    @onclick:stopPropagation @onclick="() => RemovePendingFile(f)">×</button>
                                        </div>
                                    }
                                }
                            </div>
                        }

                        @if (_slashSuggestions.Count > 0)
                        {
                            <div class="chat-slash-menu" role="listbox">
                                <div class="chat-slash-menu-title">Skills</div>
                                @for (var i = 0; i < _slashSuggestions.Count; i++)
                                {
                                    var s = _slashSuggestions[i];
                                    var idx = i;
                                    <button type="button"
                                            class="chat-slash-item @(_slashHighlight == idx ? "is-active" : "")"
                                            @onclick="() => ApplySlashSkill(s.Name)"
                                            @onmouseenter="() => _slashHighlight = idx">
                                        <span class="chat-slash-cmd">/@s.Name</span>
                                        <span class="chat-slash-desc">@s.Description</span>
                                    </button>
                                }
                            </div>
                        }

                        <textarea @ref="messageTextarea"
                                  id="chat-message-input"
                                  placeholder="@ChatPlaceholder"
                                  class="message-input"
                                  rows="3"
                                  @oninput="OnChatComposerInput"
                                  @onkeydown="OnChatComposerKeyDown"></textarea>

                        @if (IsImageGenerationModel)
                        {
                            <div class="image-param-strip" style="display:flex; flex-wrap:wrap; gap:6px; align-items:flex-end; margin-top:6px; padding-top:6px; border-top:1px solid var(--cf-border,#eee); font-size:0.72em;">
                                <div>
                                    <div style="color:var(--cf-text-muted); margin-bottom:2px;">Steps</div>
                                    <input type="number" min="1" max="50" @bind="imageSteps" class="form-control" style="width:64px; font-size:0.9em; padding:2px 4px;" />
                                </div>
                                <div>
                                    <div style="color:var(--cf-text-muted); margin-bottom:2px;">CFG</div>
                                    <input type="number" min="0" max="20" step="0.1" @bind="imageCfg" class="form-control" style="width:64px; font-size:0.9em; padding:2px 4px;" />
                                </div>
                                <div>
                                    <div style="color:var(--cf-text-muted); margin-bottom:2px;">Width</div>
                                    <select @bind="imageWidth" class="form-control" style="width:78px; font-size:0.9em; padding:2px 4px;">
                                        <option value="256">256</option>
                                        <option value="512">512</option>
                                        <option value="768">768</option>
                                        <option value="1024">1024</option>
                                    </select>
                                </div>
                                <div>
                                    <div style="color:var(--cf-text-muted); margin-bottom:2px;">Height</div>
                                    <select @bind="imageHeight" class="form-control" style="width:78px; font-size:0.9em; padding:2px 4px;">
                                        <option value="256">256</option>
                                        <option value="512">512</option>
                                        <option value="768">768</option>
                                        <option value="1024">1024</option>
                                    </select>
                                </div>
                                <div>
                                    <div style="color:var(--cf-text-muted); margin-bottom:2px;">Seed</div>
                                    <input type="text" @bind="imageSeedText" placeholder="random" class="form-control" style="width:72px; font-size:0.9em; padding:2px 4px;" title="Leave empty for random" />
                                </div>
                                <div>
                                    <div style="color:var(--cf-text-muted); margin-bottom:2px;">Upscale</div>
                                    <select @bind="imageUpscale" class="form-control" style="width:120px; font-size:0.9em; padding:2px 4px;">
                                        <option value="off">Off</option>
                                        <option value="RealESRGAN-x4plus">x4 plus</option>
                                        <option value="RealESRGAN-x4plus-anime">x4 anime</option>
                                    </select>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="input-toolbar">
                        <!-- Plus menu replaced New Chat (new chat is in sidebar). Opens attach actions. -->
                        <div class="attach-btn-wrap">
                            <button class="action-btn" @onclick:stopPropagation @onclick="ToggleAttachMenu" title="Attach an image, PDF, or text/code file">
                                <i class="bi bi-plus-circle"></i>
                            </button>

                            @if (showAttachMenu)
                            {
                                <div class="menu-popup" style="position: absolute; bottom: 100%; left: 0; margin-bottom: 4px; min-width: 180px;" @onclick:stopPropagation>
                                    <div @onclick="async () => { showAttachMenu = false; await TriggerFileUpload(); }">
                                        <i class="bi bi-upload" style="margin-right:4px;"></i> Upload a file
                                    </div>
                                    @if (ShowImageActions)
                                    {
                                        <div @onclick="() => { showAttachMenu = false; OpenImageGenPanel(); }">
                                            <i class="bi bi-palette" style="margin-right:4px;"></i> Generate image
                                        </div>
                                    }
                                    @if (ShowImageEditActions && FindLatestImageAttachment() != null)
                                    {
                                        <div @onclick="() => { showAttachMenu = false; OpenImageEditPanel(null); }">
                                            <i class="bi bi-pencil-square" style="margin-right:4px;"></i> Edit last image
                                        </div>
                                    }
                                </div>
                                <div class="menu-overlay" @onclick="() => showAttachMenu = false"></div>
                            }
                        </div>

                        <select @bind="selectedModel" @bind:after="OnSelectedModelChanged" class="model-selector">
                            @if (modelList.Any(m => m.ProviderName == "Profiles"))
                            {
                                <optgroup label="Profiles">
                                    @foreach (var m in modelList.Where(x => x.ProviderName == "Profiles"))
                                    {
                                        <option value="@m.Id">@m.Icon @m.Label</option>
                                    }
                                </optgroup>
                            }
                            @foreach (var group in modelList.Where(m => m.ProviderName != "Profiles").GroupBy(m => m.ProviderName))
                            {
                                <optgroup label="@group.Key">
                                    @foreach (var m in group)
                                    {
                                        <option value="@m.Id">@m.Icon @m.Label</option>
                                    }
                                </optgroup>
                            }
                        </select>

                        @* Context usage — always visible when a chat model has a known window; click to compact *@
                        @if (ShowContextButton)
                        {
                            <button type="button"
                                    class="ctx-btn @ContextButtonCssClass"
                                    title="@ContextButtonTitle"
                                    disabled="@(isSending || isCompacting || !CanCompactConversation)"
                                    @onclick="CompactConversationAsync">
                                @if (isCompacting)
                                {
                                    <i class="bi bi-hourglass-split"></i>
                                    <span>…</span>
                                }
                                else
                                {
                                    <i class="bi bi-bricks"></i>
                                    <span>@ContextButtonLabel</span>
                                }
                            </button>
                        }

                        @if (IsImageGenerationModel)
                        {
                            <i class="bi bi-palette capability-icon" title="Image generation model. Type a prompt and press send to generate."></i>
                        }
                        else if (CurrentModelInfo?.IsOmniCollection == true)
                        {
                            <i class="bi bi-stars capability-icon" title="Lemonade Omni collection: can plan, generate/edit images, and speak in one reply (server-side tools)."></i>
                        }
                        else if (CurrentModelSupportsTools)
                        {
                            <i class="bi bi-tools capability-icon" title="This model supports tool calling (e.g. web search, page summarization). The model can use available tools when it needs fresh or external information."></i>
                        }
                        @if (!IsImageGenerationModel && CurrentModelSupportsVision)
                        {
                            var visionTitle = CurrentModelInfo is { SupportsVision: true }
                                ? "This model supports vision (images and PDFs). Upload files using the + menu to have the model analyze them."
                                : $"This model uses the vision proxy ({CurrentVisionProxyModelName}) to describe images before answering.";
                            <i class="bi bi-image capability-icon" title="@visionTitle"></i>
                        }
                        @* Image / speech toolbar actions only when the selected model (or Lemonade modality) can use them *@
                        @if (ShowImageActions)
                        {
                            <button type="button" class="action-btn" title="Generate image (advanced options)"
                                    disabled="@isSending"
                                    @onclick="OpenImageGenPanel">
                                <i class="bi bi-palette"></i>
                            </button>
                        }

                        @if (ShowSpeechActions && IsSttAvailable)
                        {
                            <button type="button"
                                    class="action-btn @(isMicRecording ? "mic-recording" : "")"
                                    title="@(isMicRecording ? "Stop recording and transcribe" : "Speak — record and transcribe")"
                                    disabled="@(isSending || isMicTranscribing)"
                                    @onclick="ToggleMicRecording"
                                    style="@(isMicRecording ? "color:#e11d48;" : null)">
                                @if (isMicTranscribing)
                                {
                                    <i class="bi bi-hourglass-split"></i>
                                }
                                else if (isMicRecording)
                                {
                                    <i class="bi bi-stop-circle-fill"></i>
                                }
                                else
                                {
                                    <i class="bi bi-mic"></i>
                                }
                            </button>
                        }

                        @if (ShowSpeechActions && IsSttAvailable && IsTtsAvailable)
                        {
                            <button type="button"
                                    class="action-btn @(voiceModeOn ? "mic-recording" : "")"
                                    title="@(voiceModeOn ? "Voice mode on — click to stop" : $"Voice mode — listen for “{KeyStore.AssistantName}”")"
                                    disabled="@(isSending && !voiceModeOn)"
                                    @onclick="ToggleVoiceModeAsync"
                                    style="@(voiceModeOn ? "color:#e11d48;" : null)">
                                <i class="bi @(voiceModeOn ? "bi-soundwave" : "bi-soundwave")"></i>
                            </button>
                        }

                        @if (ShowSpeechActions && IsTtsAvailable)
                        {
                            <button type="button"
                                    class="action-btn"
                                    title="@(autoSpeakReplies ? "Auto-speak replies: on (click to turn off)" : "Auto-speak replies: off (click to turn on)")"
                                    @onclick="() => autoSpeakReplies = !autoSpeakReplies"
                                    style="@(autoSpeakReplies ? "color:var(--color-accent, #2563eb);" : null)">
                                <i class="bi @(autoSpeakReplies ? "bi-volume-up-fill" : "bi-volume-mute")"></i>
                            </button>
                        }

                        @if (isSending)
                        {
                            <button type="button"
                                    id="chat-stop-btn"
                                    class="send-btn"
                                    title="Stop generation"
                                    @onclick="StopGeneration"
                                    style="background:#e11d48; border-color:#e11d48;">
                                <i class="bi bi-stop-fill"></i>
                            </button>
                        }
                        else
                        {
                            <button id="chat-send-btn"
                                    class="send-btn"
                                    @onclick="() => Send()">
                                <i class="bi bi-arrow-up-circle-fill"></i>
                            </button>
                        }
                    </div>
                    @if (voiceModeOn)
                    {
                        <div style="font-size:0.75em; color:#e11d48; padding:2px 8px 6px;">
                            @(voiceStatusMessage ?? $"Listening for “{KeyStore.AssistantName}”… pause when you finish speaking.")
                        </div>
                    }
                    else if (isMicRecording)
                    {
                        <div style="font-size:0.75em; color:#e11d48; padding:2px 8px 6px;">
                            Recording… click the mic again to stop and transcribe@(SttModelHint is { } sttHint ? $" with {sttHint}" : "").
                        </div>
                    }
                    else if (!string.IsNullOrEmpty(micStatusMessage))
                    {
                        <div style="font-size:0.75em; color:@(micStatusIsError ? "#b91c1c" : "var(--cf-text-muted)"); padding:2px 8px 6px; white-space:pre-wrap;">
                            @micStatusMessage
                        </div>
                    }
                    else if (!string.IsNullOrEmpty(ttsStatusMessage))
                    {
                        <div style="font-size:0.75em; color:#b91c1c; padding:2px 8px 6px; white-space:pre-wrap;">
                            @ttsStatusMessage
                        </div>
                    }
                    else if (!string.IsNullOrEmpty(contextStatusMessage))
                    {
                        <div style="font-size:0.75em; color:@(contextStatusIsError ? "#b91c1c" : "var(--cf-text-muted)"); padding:2px 8px 6px; white-space:pre-wrap;">
                            @contextStatusMessage
                        </div>
                    }
                    else if (!string.IsNullOrEmpty(attachStatusMessage))
                    {
                        <div style="font-size:0.75em; color:@(attachStatusIsError ? "#b91c1c" : "var(--cf-text-muted)"); padding:2px 8px 6px; white-space:pre-wrap;">
                            @attachStatusMessage
                        </div>
                    }
                </div>

                <!-- Hidden file picker for attachments (triggered by the + menu) -->
                <InputFile id="file-attach-input" style="display:none;" OnChange="OnFileSelected" />
            </div>
            }

            </div>

            @if (BrowserPanel.IsOpen && AppEnvironment.IsMaui)
            {
                <EmbeddedBrowser />
            }
        </div>
    </main>

    @if (openMenuId != null)
    {
        <div class="menu-popup" style="@activePopupStyle" @onclick:stopPropagation>
            @if (IsBotMenuOpen)
            {
                <div @onclick="async () => { await OpenAddToNotesFromMenu(openMenuId); CloseMenu(); }">
                    <button type="button" class="menu-button"><i class="bi bi-journal-plus"></i></button>
                    Add to notes
                </div>
                @if (IsTtsAvailable && _botMenuMessageIndex is int speakIdx
                    && speakIdx >= 0 && speakIdx < messages.Count
                    && !string.IsNullOrWhiteSpace(messages[speakIdx].Content)
                    && !IsImageOnlyAssistantMessage(messages[speakIdx]))
                {
                    <div @onclick="async () => { var i = speakIdx; CloseMenu(); await SpeakMessageAsync(i); }">
                        <button type="button" class="menu-button"><i class="bi bi-volume-up"></i></button>
                        Read aloud
                    </div>
                }
                @if (ShowImageEditActions && _botMenuMessageIndex is int botMsgIdx && MessageHasImageAttachment(botMsgIdx))
                {
                    <div @onclick="() => { var idx = botMsgIdx; CloseMenu(); OpenImageEditPanel(idx); }">
                        <button type="button" class="menu-button"><i class="bi bi-pencil-square"></i></button>
                        Edit image
                    </div>
                }
                <div @onclick="() => PromptDeleteMessage(openMenuId)">
                    <button type="button" class="menu-button"><i class="cf-icon bi bi-trash3-fill"></i></button>
                    Delete message
                </div>
            }
            else if (IsUserMenuOpen)
            {
                <div @onclick="async () => { await OpenAddToNotesFromMenu(openMenuId); CloseMenu(); }">
                    <button type="button" class="menu-button"><i class="bi bi-journal-plus"></i></button>
                    Add to notes
                </div>
                @if (IsTtsAvailable && _userMenuMessageIndex is int userSpeakIdx
                    && userSpeakIdx >= 0 && userSpeakIdx < messages.Count
                    && !string.IsNullOrWhiteSpace(messages[userSpeakIdx].Content))
                {
                    <div @onclick="async () => { var i = userSpeakIdx; CloseMenu(); await SpeakMessageAsync(i); }">
                        <button type="button" class="menu-button"><i class="bi bi-volume-up"></i></button>
                        Read aloud
                    </div>
                }
                <div @onclick="() => PromptDeleteMessage(openMenuId)">
                    <button type="button" class="menu-button"><i class="cf-icon bi bi-trash3-fill"></i></button>
                    Delete message
                </div>
            }
            else
            {
                <div @onclick="() => OpenRenameConvoDialog(openMenuId)">
                    <button type="button" class="menu-button"><i class="cf-icon bi bi-pencil-square"></i></button>
                    Rename
                </div>
                @if (AuthService.IsAuthenticated && AuthService.HasPassword)
                {
                    var menuConvo = localConvos.FirstOrDefault(c => c.Id == openMenuId);
                    @if (menuConvo?.IsPasswordProtected == true)
                    {
                        <div @onclick="() => RemoveChatProtection(openMenuId)">
                            <button type="button" class="menu-button"><i class="bi bi-unlock"></i></button>
                            Remove password protection
                        </div>
                    }
                    else
                    {
                        <div @onclick="() => ProtectChat(openMenuId)">
                            <button type="button" class="menu-button"><i class="bi bi-lock-fill"></i></button>
                            Protect with password
                        </div>
                    }
                }
                <div @onclick="() => PromptDeleteConvo(openMenuId)">
                    <button class="menu-button"><i class="cf-icon bi bi-trash3-fill"></i></button>
                    Delete
                </div>
            }
        </div>
        <div class="menu-overlay" @onclick="CloseMenu"></div>
    }

    @if (showChatUnlockDialog)
    {
        <div class="newnote-overlay" @onclick="CancelChatUnlockDialog">
            <div class="newnote-modal" @onclick:stopPropagation>
                <h4 style="margin:0 0 12px 0;font-size:1.1rem;color:var(--color-text);">
                    <i class="cf-icon bi bi-lock-fill" style="margin-right:6px;"></i>
                    @(pendingRemoveChatProtectionId != null ? "Remove password protection" : "Unlock chat")
                </h4>
                <p style="font-size:0.85rem;color:var(--cf-text-muted);margin:0 0 12px 0;">
                    @(pendingRemoveChatProtectionId != null
                        ? "Enter your account password to remove protection from this chat."
                        : "Enter your account password to open this chat.")
                </p>
                @if (!string.IsNullOrEmpty(chatUnlockError))
                {
                    <div style="color: var(--cf-error-fg); margin: 0 0 0.5rem; font-size:0.9em;">@chatUnlockError</div>
                }
                <input type="password"
                       @bind="chatUnlockPassword"
                       @bind:event="oninput"
                       placeholder="Password"
                       class="newnote-input"
                       autocomplete="current-password"
                       @onkeydown="ChatUnlockDialogKeyHandler" />
                <div style="margin-top:12px;display:flex;gap:8px;justify-content:flex-end;">
                    <button type="button" class="newnote-btn newnote-btn-secondary" @onclick="CancelChatUnlockDialog" disabled="@chatUnlockBusy">Cancel</button>
                    <button type="button" class="newnote-btn newnote-btn-primary" @onclick="ConfirmChatUnlockDialog" disabled="@(chatUnlockBusy || string.IsNullOrWhiteSpace(chatUnlockPassword))">
                        @(pendingRemoveChatProtectionId != null ? "Remove protection" : "Unlock")

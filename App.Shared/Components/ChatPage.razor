            openMenuId = menuKey;
            _botMenuMessageIndex = index;
            _ = PositionPopupAtButton($"bot-menu-btn-{index}", alignMessageMenu: AppEnvironment.IsMaui);
        }
    }

    async Task DeleteMessageFromMenu(string? menuKey)
    {
        if (string.IsNullOrEmpty(menuKey))
            return;

        int? index = null;
        if (menuKey.StartsWith(BotMenuPrefix, StringComparison.Ordinal))
            index = int.TryParse(menuKey.Substring(BotMenuPrefix.Length), out var botIdx) ? botIdx : null;
        else if (menuKey.StartsWith(UserMenuPrefix, StringComparison.Ordinal))
            index = int.TryParse(menuKey.Substring(UserMenuPrefix.Length), out var userIdx) ? userIdx : null;

        if (index is null || index < 0 || index >= messages.Count)
            return;

        var i = index.Value;
        messages[i] = ChatMessageHelper.SoftDelete(messages[i]);
        await SaveCurrentConvo();
        StateHasChanged();
    }

    async Task OpenAddToNotesFromMenu(string? menuKey)
    {
        await NoteDebugLog($"OpenAddToNotesFromMenu called menuKey={menuKey ?? "null"}");

        if (string.IsNullOrEmpty(menuKey) || !menuKey.StartsWith(BotMenuPrefix, StringComparison.Ordinal))
        {
            await NoteDebugLog("ABORT: not a bot menu key");
            return;
        }

        if (!int.TryParse(menuKey.AsSpan(BotMenuPrefix.Length), out var index))
        {
            await NoteDebugLog("ABORT: could not parse message index from menu key");
            return;
        }

        if (index < 0 || index >= messages.Count)
        {
            await NoteDebugLog($"ABORT: index {index} out of range (messages.Count={messages.Count})");
            return;
        }

        _noteSourceMessage = messages[index];
        _noteSelectedId = "";
        _newNoteName = "";
        _noteTargetId = "";
        _noteTargetName = "";
        _noteConfirming = false;
        _noteShowExisting = false;
        _noteShowNewInput = false;
        _noteDialogNotes = new();

        showNewNote = true;
        await NoteDebugLog($"showNewNote=true, message length={_noteSourceMessage.Content?.Length ?? 0}");
        StateHasChanged();

        _ = LoadNoteDialogAsync();
    }

    async Task NoteDebugLog(string message)
    {
        Console.WriteLine($"[Chat.AddToNotes] {message}");
        try { await JS.InvokeVoidAsync("console.log", $"[Chat.AddToNotes] {message}"); } catch { }
    }

    async Task LoadNoteDialogAsync()
    {
        await NoteDebugLog("LoadNoteDialogAsync started");
        try
        {
            _noteDialogNotes = await NoteStore.LoadIndexAsync();
            await NoteDebugLog($"LoadNoteDialogAsync loaded {_noteDialogNotes.Count} notes");
        }
        catch (Exception ex)
        {
            await NoteDebugLog($"LoadNoteDialogAsync FAILED: {ex.Message}");
            _noteDialogNotes = new();
        }

        if (_noteDialogNotes.Any())
        {
            _noteSelectedId = "";
            _noteShowNewInput = false;
            _noteShowExisting = true;
        }
        else
        {
            _noteShowExisting = false;
            _noteShowNewInput = true;
        }

        await InvokeAsync(StateHasChanged);
        await NoteDebugLog($"LoadNoteDialogAsync done showExisting={_noteShowExisting} showNewInput={_noteShowNewInput}");
    }

    void NotePickExisting()
    {
        if (string.IsNullOrEmpty(_noteSelectedId)) return;
        var note = _noteDialogNotes.FirstOrDefault(n => n.Id == _noteSelectedId);
        _noteTargetId = _noteSelectedId;
        _noteTargetName = note?.Title ?? "this note";
        _noteShowExisting = false;
        _noteConfirming = true;
        StateHasChanged();
    }

    void NoteShowNewInput()
    {
        _noteShowExisting = false;
        _noteShowNewInput = true;
        StateHasChanged();
    }

    void NoteBackToPicker()
    {
        _noteSelectedId = "";
        _newNoteName = "";
        _noteShowNewInput = false;
        _noteShowExisting = true;
        StateHasChanged();
    }

    async Task NoteConfirmAdd()
    {
        if (_noteSourceMessage == null || string.IsNullOrEmpty(_noteTargetId)) return;
        var entries = await NoteStore.LoadNoteAsync(_noteTargetId);
        entries.Add(_noteSourceMessage);
        await NoteStore.SaveNoteAsync(_noteTargetId, entries);
        var note = _noteDialogNotes.FirstOrDefault(n => n.Id == _noteTargetId);
        await NoteStore.UpdateIndexAfterSaveAsync(_noteTargetId, note?.Title ?? _noteTargetName);
        CloseNewNote();
    }

    async Task NoteCreateAndSave()
    {
        if (_noteSourceMessage == null || string.IsNullOrWhiteSpace(_newNoteName)) return;
        var id = Guid.NewGuid().ToString();
        var title = _newNoteName.Trim();
        await NoteStore.SaveNoteAsync(id, new List<ChatMessage> { _noteSourceMessage });
        await NoteStore.UpdateIndexAfterSaveAsync(id, title, titleChangedTicks: DateTime.UtcNow.Ticks);
        CloseNewNote();
    }

    async Task NoteNameKeyHandler(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_newNoteName))
            await NoteCreateAndSave();
    }

    void CloseNewNote()
    {
        showNewNote = false;
        _noteSourceMessage = null;
        _noteShowExisting = false;
        _noteShowNewInput = false;
        _noteConfirming = false;
        _noteSelectedId = "";
        _newNoteName = "";
        _noteTargetId = "";
        _noteTargetName = "";
        StateHasChanged();
    }

    private async Task PositionPopupAtButton(string buttonId, bool alignMessageMenu = false)
    {
        try
        {
            // Message ⋮ menus on MAUI use right-edge alignment under the button.
            // Sidebar/other menus (and all WASM menus) keep getMenuPopupPosition.
            var fn = alignMessageMenu ? "getBotMenuPopupPosition" : "getMenuPopupPosition";
            var pos = await JS.InvokeAsync<PopupPosition>(fn, buttonId);
            activePopupStyle = $"position: fixed; top: {pos.top}px; left: {pos.left}px; z-index: 10000;";
            StateHasChanged();
        }
        catch
        {
            activePopupStyle = "position: fixed; top: 120px; left: 260px; z-index: 10000;";
            StateHasChanged();
        }
    }

}

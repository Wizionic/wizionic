                <div style="font-size:0.75em; color:var(--cf-text-muted); margin-bottom:4px;">Source</div>
                <img src="@imageEditPreviewUrl" alt="Source" style="max-width:100%; max-height:160px; border-radius:8px; border:1px solid var(--cf-border,#ddd);" />

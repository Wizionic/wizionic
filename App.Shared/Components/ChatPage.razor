    [JSInvokable]
    public async Task OnReorderDrop(string sourceId, string targetId)
    {
        _dragConvoId = null;
        _dragOverConvoId = null;

        if (string.IsNullOrEmpty(sourceId) || string.IsNullOrEmpty(targetId) || sourceId == targetId)
        {
            await InvokeAsync(StateHasChanged);
            return;
        }

        var ordered = localConvos
            .OrderBy(c => c.SortOrder)
            .ThenByDescending(c => c.LastUpdated)
            .ToList();

        var from = ordered.FindIndex(c => c.Id == sourceId);
        var to = ordered.FindIndex(c => c.Id == targetId);
        if (from < 0 || to < 0)
        {
            await InvokeAsync(StateHasChanged);
            return;
        }

        var item = ordered[from];
        ordered.RemoveAt(from);
        ordered.Insert(to, item);

        await ConversationStore.ReorderConversationsAsync(ordered.Select(c => c.Id).ToList());
        localConvos = await ConversationStore.LoadIndexAsync();
        await InvokeAsync(StateHasChanged);
    }


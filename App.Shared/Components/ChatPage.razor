    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        const long maxSize = 15 * 1024 * 1024; // 15 MB limit for attachments for now
        if (file.Size > maxSize)
        {
            SetAttachStatus($"File is too large ({file.Size / 1024 / 1024}MB). Max 15MB supported for attachments currently.", isError: true);
            return;
        }

        try
        {
            using var stream = file.OpenReadStream(maxAllowedSize: maxSize + 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            var bytes = ms.ToArray();
            var contentType = ChatAttachmentClassifier.GuessContentType(file.Name, file.ContentType);
            var kind = ChatAttachmentClassifier.Classify(file.Name, contentType, bytes);

            if (kind == ChatAttachmentKind.Unsupported)
            {
                SetAttachStatus(ChatAttachmentClassifier.UnsupportedMessage(), isError: true);
                return;
            }

            var att = new Attachment(
                Name: file.Name,
                ContentType: contentType,
                DataBase64: Convert.ToBase64String(bytes),
                Size: file.Size
            );

            pendingFiles.Add(att);
            if (kind == ChatAttachmentKind.Text && ChatAttachmentClassifier.WouldTruncate(bytes))
            {
                SetAttachStatus(
                    $"Only the first {ChatAttachmentClassifier.MaxInlinedChars:N0} characters of {file.Name} will be sent to the model.",
                    isError: false);
            }
            else
            {
                attachStatusMessage = null;
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            SetAttachStatus("Could not read file: " + ex.Message, isError: true);
        }
    }

    void SetAttachStatus(string message, bool isError)
    {
        attachStatusMessage = message;
        attachStatusIsError = isError;
        StateHasChanged();
    }

    void OpenTextPreview(Attachment att)
    {
        if (ChatAttachmentClassifier.Classify(att) == ChatAttachmentKind.Pdf)
        {
            SetAttachStatus("PDF preview is not available here. Send the message and a vision-capable model can read it.", isError: false);
            return;
        }

        if (!ChatAttachmentClassifier.TryDecodeText(att.DataBase64, out var text))
        {
            SetAttachStatus($"Could not read {att.Name} as text.", isError: true);
            return;
        }

        const int previewCap = 200_000;
        textPreviewNote = text.Length > previewCap
            ? $"Showing the first {previewCap:N0} of {text.Length:N0} characters."
            : null;
        textPreviewBody = text.Length > previewCap ? text[..previewCap] : text;
        textPreviewAttachment = att;
        StateHasChanged();
    }

    void CloseTextPreview()
    {
        textPreviewAttachment = null;
        textPreviewBody = "";
        textPreviewNote = null;
    }

    void RemovePendingFile(Attachment att)
    {
        pendingFiles.Remove(att);
        StateHasChanged();
    }

    [JSInvokable]
    public void OnImagePasted(string base64, string mimeType, string? fileName, long size)
    {
        if (string.IsNullOrWhiteSpace(base64)) return;

        // Normalize to a proper image content type. Some paste sources (especially "copy image")
        // can report odd types or the interop can be picky.
        string contentType = mimeType;
        if (string.IsNullOrWhiteSpace(contentType) || !contentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase))
        {
            contentType = "image/png";
        }

        var name = string.IsNullOrWhiteSpace(fileName)
            ? $"pasted-image.{(contentType.Split('/').LastOrDefault() ?? "png")}"
            : fileName;

        var att = new Attachment(
            Name: name,
            ContentType: contentType,
            DataBase64: base64,
            Size: size > 0 ? size : (long)(base64.Length * 0.75)
        );

        pendingFiles.Add(att);
        StateHasChanged();
    }

    async Task LoadConversation(string id)
    {
        activeConvoId = id;
        await ConversationStore.SetLastConvoIdAsync(id);
        pendingFiles.Clear();
        contextStatusMessage = null;

        var meta = localConvos.FirstOrDefault(c => c.Id == id);
        if (meta?.IsPasswordProtected == true && !unlockedChatIds.Contains(id))
        {
            // Do not decrypt/load body until unlocked this session.
            messages = new();
            RequestScrollToBottom();
            StateHasChanged();
            return;
        }

        messages = await ConversationStore.LoadConversationAsync(id);
        RefreshContextEstimate(preferServerUsage: false);
        RequestScrollToBottom();
        StateHasChanged();
    }

    void RequestScrollToBottom() => _pendingScroll = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        _hasRendered = true;

        if (firstRender)
        {
            if (KeyStore.ModelProfiles.Count > 0 &&
                !modelList.Any(m => m.ProviderName == "Profiles"))
            {
                ReloadModelListFromCatalog(preferRemote: false);
                EnsureValidModelSelection();
                StateHasChanged();
            }

            try
            {
                var collapsedForMobile = await JS.InvokeAsync<bool>("appSidebar.initForViewport");
                if (collapsedForMobile)
                {
                    SidebarState.SetCollapsedSilently(true);
                    StateHasChanged();
                }
            }
            catch { /* ignore if host script not ready */ }

            dotNetRef ??= DotNetObjectReference.Create<object>(this);
            try { await JS.InvokeVoidAsync("setupChatImagePaste", dotNetRef, messageTextarea); } catch { /* host script may not be ready */ }
            try { await JS.InvokeVoidAsync("setupChatEnterToSend", messageTextarea); } catch { /* host script may not be ready */ }
        }

        if (_pendingScroll)
        {
            _pendingScroll = false;
            await Task.Delay(80);
            try { await JS.InvokeVoidAsync("scrollChatToBottom"); } catch { }
        }

    }


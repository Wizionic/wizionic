@if (showNewNote)
{
    <div class="newnote-overlay" @onclick="CloseNewNote">
        <div class="newnote-modal" @onclick:stopPropagation>
                @if (_noteShowExisting && _noteDialogNotes.Any())
                {
                    <h4 style="margin:0 0 12px 0;font-size:1.1rem;color:var(--color-text);">Add to Note</h4>
                    <p style="font-size:0.85rem;color:var(--cf-text-muted);margin-bottom:12px;">Select an existing note or create a new one:</p>
                    <select @bind="_noteSelectedId" class="newnote-select">
                        <option value="">— New note —</option>
                        @foreach (var n in _noteDialogNotes.OrderByDescending(x => x.LastUpdated))
                        {
                            <option value="@n.Id">@n.Title (@n.LastUpdated.ToLocalTime().ToString("MMM d"))</option>
                        }
                    </select>
                    <div style="margin-top:12px;display:flex;gap:8px;justify-content:flex-end;">
                        @if (string.IsNullOrEmpty(_noteSelectedId))
                        {
                            <button class="newnote-btn newnote-btn-primary" @onclick="NoteShowNewInput">Create new note</button>
                        }
                        else
                        {
                            <button class="newnote-btn newnote-btn-primary" @onclick="NotePickExisting">Add to this note</button>
                        }
                    </div>
                    <div style="margin-top:12px;text-align:right;">
                        <button class="newnote-btn newnote-btn-ghost" @onclick="CloseNewNote">Cancel</button>
                    </div>
                }
                else if (_noteShowNewInput)
                {
                    <h4 style="margin:0 0 12px 0;font-size:1.1rem;color:var(--color-text);">Create New Note</h4>
                    <p style="font-size:0.85rem;color:var(--cf-text-muted);margin-bottom:12px;">
                        @if (!_noteDialogNotes.Any())
                        {
                            <span>You don't have any notes yet. Enter a name for your first note:</span>
                        }
                        else
                        {
                            <span>Enter a name for the new note:</span>
                        }
                    </p>
                    <input type="text" @bind="_newNoteName" @bind:event="oninput" placeholder="Note name..." class="newnote-input" @onkeydown="NoteNameKeyHandler" />
                    <div style="margin-top:12px;display:flex;gap:8px;justify-content:flex-end;">
                        @if (_noteDialogNotes.Any())
                        {
                            <button class="newnote-btn newnote-btn-secondary" @onclick="NoteBackToPicker">Back</button>
                        }
                        <button class="newnote-btn newnote-btn-secondary" @onclick="CloseNewNote">Cancel</button>
                        <button class="newnote-btn newnote-btn-primary" @onclick="NoteCreateAndSave" disabled="@(string.IsNullOrWhiteSpace(_newNoteName))">Create &amp; Save</button>
                    </div>
                }
                else if (_noteConfirming)
                {
                    <h4 style="margin:0 0 12px 0;font-size:1.1rem;color:var(--color-text);">Add to Note</h4>
                    <p style="font-size:0.85rem;color:var(--cf-text-muted);margin-bottom:12px;">Add this message to <strong>@_noteTargetName</strong>?</p>
                    @if (_noteSourceMessage != null && !string.IsNullOrEmpty(_noteSourceMessage.Content))
                    {
                        <div style="background:#f1f5f9;padding:8px 12px;border-radius:6px;margin-bottom:12px;font-size:0.8rem;color:#475569;max-height:120px;overflow-y:auto;">
                            @_noteSourceMessage.Content.Substring(0, Math.Min(_noteSourceMessage.Content.Length, 200))
                            @(_noteSourceMessage.Content.Length > 200 ? "..." : "")
                        </div>
                    }
                    <div style="display:flex;gap:8px;justify-content:flex-end;">
                        <button class="newnote-btn newnote-btn-secondary" @onclick="CloseNewNote">Cancel</button>
                        <button class="newnote-btn newnote-btn-primary" @onclick="NoteConfirmAdd">Yes, add</button>
                    </div>
                }
                else
                {
                    <p style="margin:0;font-size:0.9rem;color:var(--cf-text-muted);">Loading notes...</p>
                }
            </div>
        </div>
}

@code {
    string currentUser = "LocalUser";
    string selectedModel = ""; // will be set to a valid model from the current list in OnInitializedAsync
    bool isTyping = false;
    bool isSending = false;
    string typingLabel = "Wizionic is thinking…";

    // Lemonade image gen / edit panel
    bool showImagePanel;
    string imagePanelMode = "generate"; // generate | edit
    string imagePrompt = "";
    string imageModel = "";
    int imageSteps = 4;
    double imageCfg = 1.0;
    string imageWidth = "512";
    string imageHeight = "512";
    string imageSeedText = "";
    string imageUpscale = "off";
    bool imageBusy;
    string? imagePanelError;
    byte[]? imageEditSourceBytes;
    string? imageEditPreviewUrl;
    // Save chat attachment → Gallery
    bool showSaveToGalleryDialog;
    bool saveToGalleryBusy;
    string? saveToGalleryError;
    string saveToGalleryNewTitle = "";

    async Task SwitchConvo(string id)
    {
        if (activeConvoId != id)
        {
            await SaveCurrentConvo(); // save current first
            await LoadConversation(id);
        }
        await SidebarState.CollapseIfMobileAsync(JS);
    }

    async Task ProtectChat(string? chatId)
    {
        CloseMenu();
        if (string.IsNullOrEmpty(chatId))
            return;
        if (!AuthService.IsAuthenticated || !AuthService.HasPassword)
            return;

        await ConversationStore.SetPasswordProtectedAsync(chatId, true);
        localConvos = await ConversationStore.LoadIndexAsync();
        if (activeConvoId == chatId)
            unlockedChatIds.Add(chatId);
        SyncService.ScheduleAutoSyncConvoAfterLocalSave(
            chatId,
            localConvos.FirstOrDefault(c => c.Id == chatId)?.Title ?? "");
        StateHasChanged();
    }

    void RemoveChatProtection(string? chatId)
    {
        CloseMenu();
        if (string.IsNullOrEmpty(chatId))
            return;

        unlockTargetChatId = chatId;
        chatUnlockPassword = "";
        chatUnlockError = null;
        chatUnlockBusy = false;
        pendingRemoveChatProtectionId = chatId;
        showChatUnlockDialog = true;
    }

    void PromptUnlockChat(string? chatId)
    {
        if (string.IsNullOrEmpty(chatId))
            return;
        unlockTargetChatId = chatId;
        chatUnlockPassword = "";
        chatUnlockError = null;
        chatUnlockBusy = false;
        pendingRemoveChatProtectionId = null;
        showChatUnlockDialog = true;
    }

    void CancelChatUnlockDialog()
    {
        showChatUnlockDialog = false;
        unlockTargetChatId = null;
        chatUnlockPassword = "";
        chatUnlockError = null;
        chatUnlockBusy = false;
        pendingRemoveChatProtectionId = null;
    }

    async Task ChatUnlockDialogKeyHandler(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !chatUnlockBusy && !string.IsNullOrWhiteSpace(chatUnlockPassword))
            await ConfirmChatUnlockDialog();
        else if (e.Key == "Escape")
            CancelChatUnlockDialog();
    }

    async Task ConfirmChatUnlockDialog()
    {
        if (string.IsNullOrEmpty(unlockTargetChatId) || string.IsNullOrWhiteSpace(chatUnlockPassword))
            return;

        chatUnlockBusy = true;
        chatUnlockError = null;
        StateHasChanged();
        try
        {
            var (success, err) = await AuthService.VerifyPasswordAsync(chatUnlockPassword);
            if (!success)
            {
                chatUnlockError = err ?? "Incorrect password.";
                return;
            }

            var chatId = unlockTargetChatId;
            var remove = pendingRemoveChatProtectionId != null;
            CancelChatUnlockDialog();

            if (remove)
            {
                await ConversationStore.SetPasswordProtectedAsync(chatId, false);
                localConvos = await ConversationStore.LoadIndexAsync();
                unlockedChatIds.Remove(chatId);
                SyncService.ScheduleAutoSyncConvoAfterLocalSave(
                    chatId,
                    localConvos.FirstOrDefault(c => c.Id == chatId)?.Title ?? "");
            }
            else
            {
                unlockedChatIds.Add(chatId);
                if (activeConvoId == chatId)
                    await LoadConversation(chatId);
            }

            StateHasChanged();
        }
        finally
        {
            chatUnlockBusy = false;
        }
    }


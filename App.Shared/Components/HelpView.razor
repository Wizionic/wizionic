@using App.Core.Help
@using Markdig
@inject IHelpCatalog Catalog
@inject NavigationManager Nav

<div class="help-view">
    <div class="help-view-sidebar">
        <input type="search"
               class="form-control help-view-search"
               placeholder="Search help"
               @bind="query"
               @bind:event="oninput"
               @bind:after="OnQueryChanged" />
        <nav class="help-view-toc" aria-label="Help topics">
            @foreach (var topic in visible)
            {
                <button type="button"
                        class="help-view-toc-item @(topic.Id == CurrentId ? "is-active" : "")"
                        @onclick="() => Select(topic.Id)">
                    @topic.Title
                </button>
            }
            @if (visible.Count == 0)
            {
                <div class="help-view-empty">No matching topics.</div>
            }
        </nav>
    </div>
    <article class="help-view-article">
        @if (busy)
        {
            <p class="help-view-muted">Loading…</p>
        }
        else
        {
            @((MarkupString)html)
        }
    </article>
</div>

@code {
    [Parameter] public string? TopicId { get; set; }
    [Parameter] public EventCallback<string> TopicIdChanged { get; set; }

    private static readonly MarkdownPipeline Pipeline = new MarkdownPipelineBuilder()
        .UseAdvancedExtensions()
        .Build();

    private string query = "";
    private string html = "";
    private string? CurrentId;
    private bool busy = true;
    private List<HelpTopic> visible = new();

    protected override async Task OnParametersSetAsync()
    {
        await Catalog.EnsureLoadedAsync();
        RefreshList();
        var id = TopicId;
        if (string.IsNullOrWhiteSpace(id))
        {
            var path = new Uri(Nav.Uri).AbsolutePath;
            id = Catalog.FindByRoute(path)?.Id ?? "start";
        }

        if (!string.Equals(CurrentId, id, StringComparison.OrdinalIgnoreCase) || string.IsNullOrEmpty(html))
            await LoadArticle(id!);
    }

    private void RefreshList()
    {
        visible = Catalog.Search(query).ToList();
    }

    private void OnQueryChanged()
    {
        RefreshList();
    }

    private async Task Select(string id)
    {
        await LoadArticle(id);
        await TopicIdChanged.InvokeAsync(id);
    }

    private async Task LoadArticle(string id)
    {
        CurrentId = id;
        busy = true;
        var markdown = await Catalog.GetMarkdownAsync(id);
        html = Markdown.ToHtml(markdown, Pipeline);
        busy = false;
    }
}

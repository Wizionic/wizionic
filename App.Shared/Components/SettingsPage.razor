    private void ShowAddMemoryForm()
    {
        showAddMemory = true;
        newMemoryText = "";
        editingMemoryId = null;
    }

    private void CancelAddMemory()
    {
        showAddMemory = false;
        newMemoryText = "";
    }

    private async Task AddMemory()
    {
        var text = newMemoryText.Trim();
        if (string.IsNullOrEmpty(text))
        {
            await ShowSaveFeedbackAsync("Enter some text for the memory.", isError: true);
            return;
        }

        try
        {
            await KeyStore.AddMemoryAsync( text);
            await SettingsSyncHooks.AfterLocalSaveAsync(SettingsSync, SyncService, SettingsSyncCategory.Memories);
            ReloadMemories();
            showAddMemory = false;
            newMemoryText = "";
            await ShowSaveFeedbackAsync("Memory added.", isError: false);
        }
        catch (Exception ex)
        {
            await ShowSaveFeedbackAsync($"Could not add memory: {ex.Message}", isError: true);
        }
    }

    private void StartMemoryEdit(App.Core.Storage.UserMemory memory)
    {
        editingMemoryId = memory.Id;
        editingMemoryText = memory.Text;
        showAddMemory = false;
    }

    private void CancelMemoryEdit()
    {
        editingMemoryId = null;
        editingMemoryText = "";
    }

    private async Task SaveMemoryEdit(string id)
    {
        try
        {
            await KeyStore.UpdateMemoryAsync( id, editingMemoryText);
            await SettingsSyncHooks.AfterLocalSaveAsync(SettingsSync, SyncService, SettingsSyncCategory.Memories);
            ReloadMemories();
            CancelMemoryEdit();
            await ShowSaveFeedbackAsync("Memory updated.", isError: false);
        }
        catch (Exception ex)
        {
            await ShowSaveFeedbackAsync($"Could not update memory: {ex.Message}", isError: true);
        }
    }

    private async Task DeleteMemory(string id)
    {
        try
        {
            await KeyStore.RemoveMemoryAsync( id);
            await SettingsSyncHooks.AfterLocalSaveAsync(SettingsSync, SyncService, SettingsSyncCategory.Memories);
            ReloadMemories();
            if (editingMemoryId == id)
                CancelMemoryEdit();
            await ShowSaveFeedbackAsync("Memory deleted.", isError: false);
        }
        catch (Exception ex)
        {
            await ShowSaveFeedbackAsync($"Could not delete memory: {ex.Message}", isError: true);
        }
    }

    private void ConfirmDeleteAllMemories() => showDeleteAllConfirm = true;

    private async Task DeleteAllMemories()
    {
        showDeleteAllConfirm = false;
        try
        {
            await KeyStore.ClearMemoriesAsync();
            await SettingsSyncHooks.AfterLocalSaveAsync(SettingsSync, SyncService, SettingsSyncCategory.Memories);
            ReloadMemories();
            CancelMemoryEdit();
            CancelAddMemory();
            await ShowSaveFeedbackAsync("All memories deleted.", isError: false);
        }
        catch (Exception ex)
        {
            await ShowSaveFeedbackAsync($"Could not delete memories: {ex.Message}", isError: true);
        }
    }

    private async Task HandleNewMemoryKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await AddMemory();
        else if (e.Key == "Escape")
            CancelAddMemory();
    }

    private async Task HandleMemoryEditKey(KeyboardEventArgs e, string id)
    {
        if (e.Key == "Enter")
            await SaveMemoryEdit(id);
        else if (e.Key == "Escape")
            CancelMemoryEdit();
    }



@inject App.Core.Storage.IKeyStore KeyStore
@inject App.Core.Storage.ISettingsSyncStore SettingsSync
@inject App.Core.Sync.ISyncService SyncService
@inject App.Core.Update.IUpdateService UpdateService
@inject App.Core.Homeserver.IHomeserverInstallService Homeserver
@inject App.Core.Configuration.IAppServerEndpoint ServerEndpoint
@inject App.Core.UI.IAppRestartService AppRestart
@inject App.Core.UI.IDesktopShellService DesktopShell
@inject App.Core.Setup.ISetupWizardHost SetupWizard
@inject App.Shared.Services.ThemeService Theme
@inject INavLayoutState NavLayout
@inject App.Core.Auth.IAuthService Auth
@inject App.Core.Chat.IChatModelCatalog ModelCatalog
@inject App.Shared.Services.Tools.IRequestRouter RequestRouter
@inject App.Shared.Services.Tools.IToolProvider ToolProvider
@inject App.Core.Help.IHelpAskService HelpAsk
@inject IJSRuntime JS
@inject NavigationManager Nav
@using App.Core.Update
@using App.Core.Homeserver
@using App.Core.Sync
@using App.Core.Chat
@using App.Core.Tools
@using App.Shared.Services
@using App.Shared.Services.Tools
@implements IDisposable

<div class="settings-content" style="padding: 1rem 2rem; max-width: 860px; margin: 0 auto;">
    <h4 style="margin: 0;">Settings</h4>

    <!-- Login server (MAUI only — WASM always uses the page origin) -->
    @if (AppEnvironment.IsMaui)
    {
        <div class="settings-card" style="margin-top: 1rem;">
            <h3 class="help-heading" style="margin: 0 0 0.25rem;">Login server <HelpGlyph Topic="settings-login-server" /></h3>
            <p style="color: var(--color-text-muted); font-size: 0.85em; margin: 0 0 0.75rem;">
                Where this app authenticates and syncs device presence. Installing a Home Server sets this to
                <code>http://localhost:5150</code>. </p>
            <label>Server URL</label>
            <input type="text" class="form-control" @bind="loginServerDraft" placeholder="https://wizionic.com" />
            <div style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.5rem;">
                <button type="button" class="btn btn-primary btn-sm" @onclick="SaveLoginServer" disabled="@loginServerBusy">
                    @(loginServerBusy ? "Saving…" : "Save login server")
                </button>
                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick='() => ApplyLoginServerPreset("https://wizionic.com")' disabled="@loginServerBusy">
                    Public (wizionic.com)
                </button>
                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick='() => ApplyLoginServerPreset("http://localhost:5150")' disabled="@loginServerBusy">
                    Local homeserver
                </button>
            </div>
            @if (!string.IsNullOrEmpty(loginServerMessage))
            {
                <div style="margin-top: 0.5rem; font-size: 0.9em; color: @(loginServerIsError ? "var(--cf-error-fg, #c00)" : "var(--cf-success-fg, #22c55e)");">
                    @loginServerMessage
                    @if (loginServerRestartPending && AppRestart.CanRestart)
                    {
                        <button type="button" class="btn btn-primary btn-sm" style="margin-left: 0.5rem;" @onclick="RestartForLoginServer">
                            Restart now
                        </button>
                    }
                </div>
            }
            @if (Homeserver.IsSupported)
            {
                <div style="margin-top: 1rem; padding-top: 0.75rem; border-top: 1px solid var(--cf-border, #eee);">
                    <button type="button" class="btn btn-outline-primary btn-sm" @onclick="OpenSetupWizard">
                        Run setup wizard
                    </button>
                    <span style="font-size: 0.85em; color: var(--color-text-muted); margin-left: 0.5rem;">
                        To install the Home Login Server, Lemonade AI server, and Ollama AI server
                    </span>
                </div>
            }
        </div>
    }

    <!-- Appearance -->
    <div class="settings-card">
        <h3 class="help-heading" style="margin: 0 0 0.25rem;">Appearance <HelpGlyph Topic="settings-appearance" /></h3>

        <div class="theme-setting-row">
            <div class="theme-setting-info">
                <p class="theme-setting-label">Theme</p>
                <p class="theme-setting-desc">
                    Pick a color palette. "System default" follows your OS light/dark preference.
                </p>
            </div>
            <select class="form-select form-select-sm theme-setting-select"
                    @onchange="OnThemeChanged">
                @foreach (var theme in Theme.AvailableThemes)
                {
                    <option value="@theme.Id" selected="@(theme.Id == Theme.Theme)">
                        @theme.DisplayName
                    </option>
                }
            </select>
        </div>

        @if (AppEnvironment.IsMaui)
        {
            <div class="theme-setting-row">
                <div class="theme-setting-info">
                    <p class="theme-setting-label">Navigation bar position</p>
                    <p class="theme-setting-desc">
                        Show the main navigation across the top, or as a vertical icon rail on the left.
                    </p>
                </div>
                <select class="form-select form-select-sm theme-setting-select"
                        value="@NavLayoutModeValue"
                        @onchange="OnNavLayoutChanged">
                    <option value="top">Top (default)</option>
                    <option value="left">Left (vertical)</option>
                </select>
            </div>
        }
    </div>

    @if (DesktopShell.IsSupported)
    {
        <div class="settings-card">
            <h3 class="help-heading" style="margin: 0 0 0.25rem;">Desktop <HelpGlyph Topic="settings-desktop" /></h3>
            <p style="color: var(--color-text-muted); font-size: 0.85em; margin: 0 0 0.75rem;">
                Sync and scheduled workflows keep running until you Quit. The Home Server service is separate.
            </p>

            <div class="ollama-toggle-row" style="border-top: none; margin-top: 0; padding-top: 0;">
                <div>
                    <label class="ollama-toggle-label">Close window to system tray</label>
                    <p class="theme-setting-desc" style="margin: 0.15rem 0 0;">
                        @if (!DesktopShell.CanHideToTray)
                        {
                            <text>No system tray service on this desktop (close will quit).</text>
                        }
                        else
                        {
                            <text>The close button hides Wizionic. Use Quit to stop sync and workflows.</text>
                        }
                    </p>
                </div>
                <label class="ollama-toggle">
                    <input type="checkbox"
                           checked="@DesktopShell.CloseToTray"
                           disabled="@(!DesktopShell.CanHideToTray)"
                           @onchange="OnCloseToTrayChanged" />
                    <span class="ollama-toggle-slider"></span>
                </label>
            </div>

            <div class="ollama-toggle-row">
                <div>
                    <label class="ollama-toggle-label">@(OperatingSystem.IsLinux() ? "Start with session" : "Start with Windows")</label>
                    <p class="theme-setting-desc" style="margin: 0.15rem 0 0;">
                        Launch at login so this PC can stay online for other devices.
                    </p>
                </div>
                <label class="ollama-toggle">
                    <input type="checkbox" checked="@DesktopShell.StartWithWindows" @onchange="OnStartWithWindowsChanged" />
                    <span class="ollama-toggle-slider"></span>
                </label>
            </div>

            <div class="ollama-toggle-row">
                <div>
                    <label class="ollama-toggle-label">Start minimized at logon</label>
                    <p class="theme-setting-desc" style="margin: 0.15rem 0 0;">
                        @if (OperatingSystem.IsLinux())
                        {
                            <text>Only used with Start with session. The app launcher always shows the window.</text>
                        }
                        else
                        {
                            <text>Only used with Start with Windows. The Start menu icon always shows the window.</text>
                        }
                    </p>
                </div>
                <label class="ollama-toggle">
                    <input type="checkbox"
                           checked="@DesktopShell.StartMinimized"
                           disabled="@(!DesktopShell.StartWithWindows)"
                           @onchange="OnStartMinimizedChanged" />
                    <span class="ollama-toggle-slider"></span>
                </label>
            </div>

            <div style="margin-top: 1rem; display: flex; flex-wrap: wrap; gap: 0.5rem;">
                @if (OperatingSystem.IsWindows())
                {
                    <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="OpenNewDesktopWindow">
                        New window
                    </button>
                }
                <button type="button" class="btn btn-outline-danger btn-sm" @onclick="QuitDesktop">
                    Quit Wizionic
                </button>
            </div>
        </div>
    }

    <!-- About you -->
    <div class="settings-card">
        <h3 class="help-heading" style="margin: 0 0 0.25rem;">About you <HelpGlyph Topic="settings-about-you" /></h3>
        <p style="color: var(--color-text-muted); font-size: 0.85em; margin: 0 0 1rem;">
            Tell Wizionic about yourself to get more personalized answers.
        </p>

        <div class="ollama-toggle-row" style="border-top: none; margin-top: 0; padding-top: 0;">
            <div>
                <label class="ollama-toggle-label">Enable Wizionic Customization about you</label>
            </div>
            <label class="ollama-toggle">
                <input type="checkbox" @bind="profileDraft.CustomizationEnabled" />
                <span class="ollama-toggle-slider"></span>
            </label>
        </div>

        @if (profileDraft.CustomizationEnabled)
        {
            <div style="margin-top: 1rem;">
                <label>What should Wizionic call you?</label>
                <input type="text"
                       @bind="profileDraft.PreferredName"
                       class="form-control"
                       />

                <label style="margin-top: 0.75rem;">What do you do?</label>
                <input type="text"
                       @bind="profileDraft.Occupation"
                       class="form-control"
                        />
            </div>
        }

        <div style="margin-top: 1rem;">
            <button @onclick="SaveProfile" class="btn btn-outline-secondary btn-sm">Save changes</button>
        </div>
    </div>

    <!-- Memories -->
    <div class="settings-card">
        <h3 class="help-heading" style="margin: 0 0 0.25rem;">Memories <HelpGlyph Topic="settings-memories" /></h3>
        <p style="color: var(--color-text-muted); font-size: 0.85em; margin: 0 0 1rem;">
            Facts Wizionic should remember across conversations. Each memory is sent with your system prompt.
        </p>

        <div class="memory-search-wrap">
            <i class="bi bi-search memory-search-icon"></i>
            <input type="text"
                   @bind="memorySearch"
                   @bind:event="oninput"
                   class="form-control memory-search-input"
                   placeholder="Search for a memory" />
        </div>

        @if (FilteredMemories.Any())
        {
            <div class="memory-list">
                @foreach (var memory in FilteredMemories)
                {
                    <div class="memory-row">
                        @if (editingMemoryId == memory.Id)
                        {
                            <input type="text"
                                   @bind="editingMemoryText"
                                   class="form-control"
                                   @onkeydown="(e) => HandleMemoryEditKey(e, memory.Id)" />
                            <div class="memory-row-actions">
                                <button type="button" class="memory-icon-btn" title="Save" @onclick="() => SaveMemoryEdit(memory.Id)">
                                    <i class="bi bi-check-lg"></i>
                                </button>
                                <button type="button" class="memory-icon-btn" title="Cancel" @onclick="CancelMemoryEdit">
                                    <i class="bi bi-x-lg"></i>
                                </button>
                            </div>
                        }
                        else
                        {
                            <span class="memory-text">@memory.Text</span>
                            <div class="memory-row-actions">
                                <button type="button" class="memory-icon-btn" title="Edit" @onclick="() => StartMemoryEdit(memory)">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button type="button" class="memory-icon-btn memory-icon-btn-danger" title="Delete" @onclick="() => DeleteMemory(memory.Id)">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        }
                    </div>
                }
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(memorySearch))
        {
            <div style="color: var(--color-text-muted); font-size: 0.9em; padding: 0.75rem 0;">No memories match your search.</div>
        }
        else
        {
            <div style="color: var(--color-text-muted); font-size: 0.9em; padding: 0.75rem 0;">No memories yet. Add one below.</div>
        }

        @if (showAddMemory)
        {
            <div style="margin-top: 0.75rem;">
                <input type="text"
                       @bind="newMemoryText"
                       class="form-control"
                      
                       @onkeydown="HandleNewMemoryKey" />
                <div style="margin-top: 0.5rem; display: flex; gap: 0.5rem;">
                    <button @onclick="AddMemory" class="btn btn-primary btn-sm">Save memory</button>
                    <button @onclick="CancelAddMemory" class="btn btn-outline-secondary btn-sm">Cancel</button>
                </div>
            </div>
        }

        <div class="memory-footer-actions">
            <button @onclick="ShowAddMemoryForm" class="btn btn-outline-primary btn-sm" disabled="@showAddMemory">Add new memory</button>
            <button @onclick="ConfirmDeleteAllMemories"
                    class="btn btn-outline-danger btn-sm"
                    disabled="@(!memories.Any())">
                Delete all memories
            </button>
        </div>
    </div>

    <!-- Reply length -->
    <div class="settings-card" style="margin-top: 1rem;">
        <h3 class="help-heading" style="margin: 0 0 0.25rem;">Reply length <HelpGlyph Topic="settings-reply-length" /></h3>
        <p style="color: var(--color-text-muted); font-size: 0.85em; margin: 0 0 0.75rem;">
            Maximum new tokens the model may generate in one chat reply (includes hidden thinking on models that reason first).
            This is an app limit, not the model’s context window. Default is 16,384.
        </p>
        <label>Max output tokens</label>
        <input type="number"
               class="form-control form-control-sm"
               style="max-width: 10rem;"
               min="@App.Core.Storage.KeyStoreDefaults.MinMaxOutputTokens"
               max="@App.Core.Storage.KeyStoreDefaults.MaxMaxOutputTokens"
               step="1024"
               @bind="maxOutputDraft" />
        <p style="color: var(--color-text-muted); font-size: 0.8em; margin: 0.35rem 0 0;">
            Allowed range @App.Core.Storage.KeyStoreDefaults.MinMaxOutputTokens.ToString("N0")–
            @App.Core.Storage.KeyStoreDefaults.MaxMaxOutputTokens.ToString("N0").
        </p>
        <div style="margin-top: 0.75rem; display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center;">
            <button type="button" class="btn btn-primary btn-sm" @onclick="SaveMaxOutputTokens" disabled="@maxOutputBusy">
                @(maxOutputBusy ? "Saving…" : "Save reply length")
            </button>
            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="ResetMaxOutputTokens" disabled="@maxOutputBusy">
                Reset to 16,384
            </button>
        </div>
        @if (!string.IsNullOrEmpty(maxOutputSaveMessage))
        {
            <div style="margin-top: 0.5rem; font-size: 0.9em; color: @(maxOutputSaveIsError ? "var(--cf-error-fg, #c00)" : "var(--cf-success-fg, #22c55e)");">
                @maxOutputSaveMessage
            </div>
        }
    </div>

    <!-- Tool routing -->
    <div class="settings-card" style="margin-top: 1rem;">
        <h3 class="help-heading" style="margin: 0 0 0.25rem;">Tool routing <HelpGlyph Topic="tool-routing" /></h3>
        <p style="color: var(--color-text-muted); font-size: 0.85em; margin: 0 0 0.75rem;">
            Decides which tool modules (Native, Lemonade, Gallery, etc.) are attached before the chat model runs.
            <strong>Rules</strong> is instant and free.
            <strong>Hybrid</strong> uses rules for clear cases and a small model for ambiguous multi-intent messages.
            <strong>AI Router</strong> always classifies with the routing model (falls back to rules on failure).
        </p>

        <label>Mode</label>
        <select class="form-select form-select-sm" style="max-width: 20rem;" @bind="routingModeDraft">
            <option value="Rules">Rules only (default)</option>
            <option value="Hybrid">Hybrid (rules + AI when weak)</option>
            <option value="Ai">AI router</option>
        </select>

        <label style="margin-top: 0.75rem;">Routing model</label>
        <select class="form-select form-select-sm" style="max-width: 28rem;" @bind="routingModelDraft">
            <option value="">— none (Rules only) —</option>
            @foreach (var m in routingModelOptions)
            {
                <option value="@m.Id">@m.Label</option>
            }
        </select>
        <p style="color: var(--color-text-muted); font-size: 0.8em; margin: 0.35rem 0 0;">
            Prefer a small local model (Lemonade / Ollama). Not used when mode is Rules or model is empty.
        </p>

        <div style="margin-top: 0.75rem; display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center;">
            <button type="button" class="btn btn-primary btn-sm" @onclick="SaveToolRouting" disabled="@routingBusy">
                @(routingBusy ? "Saving…" : "Save tool routing")
            </button>
        </div>
        @if (!string.IsNullOrEmpty(routingSaveMessage))
        {
            <div style="margin-top: 0.5rem; font-size: 0.9em; color: @(routingSaveIsError ? "var(--cf-error-fg, #c00)" : "var(--cf-success-fg, #22c55e)");">
                @routingSaveMessage
            </div>
        }

        <div style="margin-top: 1rem; padding-top: 0.75rem; border-top: 1px solid var(--cf-border, #eee);">
            <label>Test routing</label>
            <textarea class="form-control" rows="2" style="font-size: 0.9em;"
                      @bind="routingTestMessage"
                      placeholder="e.g. create a purple fruit and save it to the Fruits album"></textarea>
            <button type="button" class="btn btn-outline-secondary btn-sm" style="margin-top: 0.5rem;"
                    @onclick="RunRoutingTest" disabled="@routingTestBusy">
                @(routingTestBusy ? "Classifying…" : "Classify this message")
            </button>
            @if (!string.IsNullOrEmpty(routingTestResult))
            {
                <pre style="margin-top: 0.5rem; padding: 0.5rem 0.75rem; background: var(--cf-bg-muted, #f5f5f5);
                            border-radius: 6px; font-size: 0.8em; white-space: pre-wrap;">@routingTestResult</pre>
            }
        </div>
    </div>

    <div class="settings-card" style="margin-top: 1rem;">
        <h3 class="help-heading" style="margin: 0 0 0.25rem;">Model profiles <HelpGlyph Topic="settings-model-profiles" /></h3>
        <p style="color: var(--color-text-muted); font-size: 0.85em; margin: 0 0 0.75rem;">
            A profile is a named stack: chat model plus image, edit, speech, routing, and vision proxy.
            Chat lists profiles at the top of the model menu. Palette, mic, and Speak use these slots — not “whatever provider the chat model belongs to.”
        </p>

        <div style="display:flex; flex-wrap:wrap; gap:0.5rem; align-items:center; margin-bottom:0.75rem;">
            <select class="form-select form-select-sm" style="max-width: 16rem;" @bind="profileEditId" @bind:after="LoadProfileDraft">
                <option value="">— new profile —</option>
                @foreach (var p in modelProfiles)
                {
                    <option value="@p.Id">@p.Name</option>
                }
            </select>
            <button type="button" class="btn btn-outline-primary btn-sm" @onclick="StartNewProfile">New</button>
            <button type="button" class="btn btn-primary btn-sm" @onclick="SaveModelProfile" disabled="@profileBusy">
                @(profileBusy ? "Saving…" : "Save profile")
            </button>
            @if (!string.IsNullOrEmpty(profileEditId))
            {
                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="DeleteModelProfile" disabled="@profileBusy">Delete</button>
                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="ActivateModelProfile" disabled="@profileBusy">
                    Use in Chat
                </button>
            }
        </div>

        <div style="display:grid; gap:0.5rem; max-width:32rem;">
            <div>
                <label>Name</label>
                <input class="form-control form-control-sm" @bind="profileNameDraft" placeholder="Daily Grok" />
            </div>
            <div>
                <label>Chat model</label>
                <select class="form-select form-select-sm" @bind="profileChatDraft">
                    <option value="">— none —</option>
                    @foreach (var m in profileChatOptions)
                    {
                        <option value="@m.Id">@m.Label</option>
                    }
                </select>
            </div>
            <div>
                <label>Routing model (optional override)</label>
                <select class="form-select form-select-sm" @bind="profileRoutingDraft">
                    <option value="">Use Settings → Tool routing</option>
                    @foreach (var m in routingModelOptions)
                    {
                        <option value="@m.Id">@m.Label</option>
                    }
                </select>
            </div>
            <div>
                <label>Image generation</label>
                <select class="form-select form-select-sm" @bind="profileImageDraft">
                    <option value="">— none —</option>
                    @foreach (var m in profileImageOptions)
                    {
                        <option value="@m.Id">@m.Label</option>
                    }
                </select>
            </div>
            <div>
                <label>Image edit</label>
                <select class="form-select form-select-sm" @bind="profileEditDraft">
                    <option value="">— none —</option>
                    @foreach (var m in profileEditOptions)
                    {
                        <option value="@m.Id">@m.Label</option>
                    }
                </select>
            </div>
            <div>
                <label>Text-to-speech</label>
                <select class="form-select form-select-sm" @bind="profileTtsDraft">
                    <option value="">— none —</option>
                    @foreach (var m in profileTtsOptions)
                    {
                        <option value="@m.Id">@m.Label</option>
                    }
                </select>
            </div>
            <div>
                <label>Speech-to-text</label>
                <select class="form-select form-select-sm" @bind="profileSttDraft">
                    <option value="">— none —</option>
                    @foreach (var m in profileSttOptions)
                    {
                        <option value="@m.Id">@m.Label</option>
                    }
                </select>
            </div>
            <div>
                <label>Voice</label>
                <input class="form-control form-control-sm" @bind="profileVoiceDraft" placeholder="eve" />
            </div>
            <div>
                <label>Vision proxy (optional)</label>
                <select class="form-select form-select-sm" @bind="profileVisionDraft">
                    <option value="">None — only the chat model’s vision</option>
                    @foreach (var m in profileVisionOptions)
                    {
                        <option value="@m.Id">@m.Label</option>
                    }
                </select>
            </div>
        </div>
        @if (!string.IsNullOrEmpty(profileSaveMessage))
        {
            <div style="margin-top: 0.5rem; font-size: 0.9em; color: @(profileSaveIsError ? "var(--cf-error-fg, #c00)" : "var(--cf-success-fg, #22c55e)");">
                @profileSaveMessage
            </div>
        }
        @if (!string.IsNullOrEmpty(KeyStore.ActiveModelProfileId))
        {
            <p style="margin: 0.6rem 0 0; font-size: 0.8em; color: var(--color-text-muted);">
                Active in Chat: <strong>@(KeyStore.GetModelProfile(KeyStore.ActiveModelProfileId)?.Name ?? KeyStore.ActiveModelProfileId)</strong>
            </p>
        }
    </div>

    <div class="settings-card" style="margin-top: 1rem;">
        <h3 class="help-heading" style="margin: 0 0 0.25rem;">Help answers <HelpGlyph Topic="settings-help-answers" /></h3>
        <p style="color: var(--color-text-muted); font-size: 0.85em; margin: 0 0 0.75rem;">
            Optional. Ask in Help uses this chat model and shipped help articles only.
            A cloud model will send those excerpts and your question to that provider.
            Browse still works with the model off.
        </p>
        <label>Answer model</label>
        <select class="form-select form-select-sm" style="max-width: 28rem;" @bind="helpAnswerDraft">
            <option value="">Off — browse only</option>
            @foreach (var m in helpAnswerOptions)
            {
                <option value="@m.Id">@m.Label</option>
            }
        </select>
        <label style="margin-top: 0.75rem;">Embeddings model (optional)</label>
        <select class="form-select form-select-sm" style="max-width: 28rem;" @bind="helpEmbedDraft">
            <option value="">None — keyword retrieval</option>
            @foreach (var m in helpEmbedOptions)
            {
                <option value="@m.Id">@m.Label</option>
            }
        </select>
        <p style="color: var(--color-text-muted); font-size: 0.8em; margin: 0.35rem 0 0;">
            Local Ollama or Lemonade embeddings only. Changing this rebuilds the help index on this device.
        </p>
        <p class="help-index-status">@helpIndexStatusText</p>
        <div style="margin-top: 0.75rem; display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center;">
            <button type="button" class="btn btn-primary btn-sm" @onclick="SaveHelpModels" disabled="@helpBusy">
                @(helpBusy ? "Saving…" : "Save help models")
            </button>
            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="RebuildHelpIndex" disabled="@helpBusy">
                Rebuild help index
            </button>
        </div>
        @if (!string.IsNullOrEmpty(helpSaveMessage))
        {
            <div style="margin-top: 0.5rem; font-size: 0.9em; color: @(helpSaveIsError ? "var(--cf-error-fg, #c00)" : "var(--cf-success-fg, #22c55e)");">
                @helpSaveMessage
            </div>
        }
    </div>

    <!-- System prompt -->
    <h3 class="help-heading" style="margin: 1.25rem 0 0.5rem;">System prompt <HelpGlyph Topic="settings-system-prompt" /></h3>
    <p style="color: var(--color-text-muted); font-size: 0.85em; margin-bottom: 0.5rem;">
        Sent as a system message at the start of each chat request. It is not saved in conversation history or synced to other devices.
        Use <code>{{datetime}}</code> to insert the current local date and time when a message is sent.
    </p>

    <textarea @bind="systemPromptDraft"
              rows="18"
              class="form-control"
              style="font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 0.85em; line-height: 1.45;"
              placeholder="Enter a system prompt for the model..."></textarea>

    <div style="margin-top: 0.75rem; display: flex; gap: 0.5rem; flex-wrap: wrap; align-items: center;">
        <button @onclick="SavePrompt" class="btn btn-primary btn-sm">Save</button>
        <button @onclick="ResetPrompt" class="btn btn-outline-secondary btn-sm">Reset to default</button>
        <button @onclick="@(() => Nav.NavigateTo("/chat"))" class="btn btn-outline-secondary btn-sm">Back to Chat</button>
    </div>

    @if (!string.IsNullOrEmpty(saveFeedback))
    {
        <div style="margin-top: 0.75rem; padding: 0.5rem 0.75rem; border-radius: 4px; font-size: 0.9em;
                    background: @(saveFeedbackIsError ? "#fff0f0" : "#e6f2ff");
                    border: 1px solid @(saveFeedbackIsError ? "#f5c2c7" : "#b3d9ff");
                    color: @(saveFeedbackIsError ? "#c00" : "inherit");">
            @saveFeedback
        </div>
    }

    <!-- Home Server status (Windows / Linux MAUI) -->
    @if (AppEnvironment.IsMaui && Homeserver.IsSupported)
    {
        <div style="margin-top: 1.5rem; padding-top: 1rem; border-top: 1px solid var(--color-border);">
            <h4>Home Server</h4>
            <p style="color: var(--color-text-muted); font-size: 0.85em; margin: 0 0 0.5rem;">
                Optional local login server and website. Updates replace program files only —
                your SQLite login database (stable app data path) is never overwritten.
            </p>
            <div style="margin: 0.5rem 0; color: var(--color-text-muted); font-size: 0.95em;">
                Status: <strong>@(homeserverStatusText ?? "…")</strong>
            </div>
            @if (!string.IsNullOrEmpty(homeserverActionMessage))
            {
                <div style="margin: 0.5rem 0; padding: 0.5rem 0.75rem; border-radius: 4px; font-size: 0.9em;
                            background: @(homeserverActionIsError ? "#fff0f0" : "#e6f2ff");
                            border: 1px solid @(homeserverActionIsError ? "#f5c2c7" : "#b3d9ff");">
                    @homeserverActionMessage
                </div>
            }
            <div style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.5rem;">
                @if (homeserverState is { IsInstalled: false, InstallMode: not HomeserverInstallMode.Declined })
                {
                    <button class="btn btn-outline-primary btn-sm" @onclick="InstallHomeserver" disabled="@homeserverBusy">
                        @(homeserverBusy ? "Installing…" : "Install Home Server")
                    </button>
                }
                @if (homeserverState is { InstallMode: HomeserverInstallMode.Declined })
                {
                    <button class="btn btn-outline-primary btn-sm" @onclick="InstallHomeserver" disabled="@homeserverBusy">
                        @(homeserverBusy ? "Installing…" : "Install Home Server")
                    </button>
                }
                @if (homeserverState is { IsInstalled: true })
                {
                    <button class="btn btn-outline-secondary btn-sm" @onclick="UpdateHomeserver" disabled="@homeserverBusy">
                        @(homeserverBusy ? "Working…" : "Check Home Server update")
                    </button>
                }
            </div>
        </div>
    }

    <!-- App Updates (MAUI only) -->
    @if (AppEnvironment.IsMaui)
    {
        <div style="margin-top: 1.5rem; padding-top: 1rem; border-top: 1px solid var(--color-border);">
            <h4>App Updates</h4>

            <div style="margin: 0.5rem 0; color: var(--color-text-muted); font-size: 0.95em;">
                Installed version:
                <strong>@(installedVersion ?? "unknown")</strong>
                @if (!string.IsNullOrEmpty(latestFeedVersion))
                {
                    <span> · Latest on GitHub: <strong>@latestFeedVersion</strong></span>
                }
            </div>

            @if (updateCheckResult?.Status == UpdateCheckStatus.UpdateAvailable && updateCheckResult.Update != null)
            {
                <div class="cf-success-box" style="margin: 0.75rem 0; padding: 0.75rem 1rem;">
                    @if (!string.IsNullOrEmpty(updateCheckResult.Message))
                    {
                        <div>@updateCheckResult.Message</div>
                    }
                    else
                    {
                        <div>Version @updateCheckResult.Update.Version is available!</div>
                    }
                </div>

                @if (updateCheckResult.RequiresManualInstall)
                {
                    <a class="btn btn-primary" href="@installerDownloadUrl" target="_blank" style="display: inline-block; margin-top: 0.25rem;">
                        Download Installer
                    </a>
                }
                else
                {
                    <button class="btn btn-primary" @onclick="InstallUpdate" disabled="@busy">
                        @(busy ? "Installing..." : "Install and Restart")
                    </button>
                }
            }
            else if (hasChecked && updateCheckResult != null)
            {
                <div style="margin: 0.75rem 0; padding: 0.75rem 1rem; border-radius: 6px;
                            background: @(updateCheckResult.Status == UpdateCheckStatus.CheckFailed || updateCheckResult.Status == UpdateCheckStatus.NotInstalled ? "var(--color-warning-bg, #fff8e6)" : "transparent");
                            border: @(updateCheckResult.Status == UpdateCheckStatus.CheckFailed || updateCheckResult.Status == UpdateCheckStatus.NotInstalled ? "1px solid var(--color-warning-bdr, #e6c200)" : "none");
                            color: var(--color-text-muted);">
                    @updateStatusMessage
                </div>
            }

            @if (!busy)
            {
                <button class="btn btn-outline-secondary" style="margin-top: 0.5rem;"
                        @onclick="CheckForUpdate" disabled="@busy">
                    @(busy ? "Checking..." : "Check for Updates")
                </button>
            }
        </div>
    }
</div>

<ConfirmDialog IsVisible="@showDeleteAllConfirm"
               Title="Delete all memories?"
               Message="This permanently removes every saved memory from this browser. This cannot be undone."
               ConfirmText="Delete all"
               OnConfirm="DeleteAllMemories"
               OnCancel="() => showDeleteAllConfirm = false" />

<ConfirmDialog IsVisible="@showRestartConfirm"

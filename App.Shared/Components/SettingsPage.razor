                string.IsNullOrWhiteSpace(helpEmbedDraft) ? null : helpEmbedDraft);
            helpSaveMessage = string.IsNullOrWhiteSpace(helpAnswerDraft)
                ? "Help answers off. Browse still works."
                : "Help models saved.";
            helpSaveIsError = false;
        }
        catch (Exception ex)
        {
            helpSaveMessage = ex.Message;
            helpSaveIsError = true;
        }
        finally
        {
            helpBusy = false;
        }
    }

    private async Task RebuildHelpIndex()
    {
        helpBusy = true;
        helpSaveMessage = null;
        StateHasChanged();
        try
        {
            await KeyStore.SetHelpModelsAsync(
                string.IsNullOrWhiteSpace(helpAnswerDraft) ? null : helpAnswerDraft,
                string.IsNullOrWhiteSpace(helpEmbedDraft) ? null : helpEmbedDraft);
            await HelpAsk.RebuildIndexAsync();
            var status = await HelpAsk.GetIndexStatusAsync();
            helpIndexStatusText = FormatHelpIndexStatus(status);
            helpSaveMessage = "Help index rebuilt.";

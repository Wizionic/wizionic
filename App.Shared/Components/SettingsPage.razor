    private async Task SaveMaxOutputTokens()
    {
        maxOutputBusy = true;
        maxOutputSaveMessage = null;
        try
        {
            await KeyStore.SetMaxOutputTokensAsync(maxOutputDraft);
            maxOutputDraft = KeyStore.MaxOutputTokens;
            maxOutputSaveIsError = false;
            maxOutputSaveMessage = $"Saved. Chat replies may use up to {maxOutputDraft:N0} output tokens.";
        }
        catch (Exception ex)
        {
            maxOutputSaveIsError = true;
            maxOutputSaveMessage = ex.Message;
        }
        finally
        {
            maxOutputBusy = false;
        }
    }

    private async Task ResetMaxOutputTokens()
    {
        maxOutputDraft = App.Core.Storage.KeyStoreDefaults.DefaultMaxOutputTokens;
        await SaveMaxOutputTokens();
    }

    private void LoadToolRoutingDraft()
    {
        routingModeDraft = KeyStore.ToolRoutingMode switch
        {
            ToolRoutingMode.Ai => "Ai",
            ToolRoutingMode.Hybrid => "Hybrid",
            _ => "Rules"
        };
        routingModelDraft = KeyStore.ToolRoutingModelId ?? "";
        try
        {
            routingModelOptions = ModelCatalog.GetAvailableModels()
                .Where(m => !string.IsNullOrWhiteSpace(m.Id) && !m.IsImageGeneration)
                .Select(m => (m.Id, string.IsNullOrWhiteSpace(m.Label) ? m.Id : $"{m.Label} ({m.Id})"))
                .OrderBy(m => m.Item2, StringComparer.OrdinalIgnoreCase)
                .ToList();
        }
        catch
        {
            routingModelOptions = new();
        }
    }

    private async Task LoadHelpModelsDraft()
    {
        helpAnswerDraft = KeyStore.HelpAnswerModelId ?? "";
        helpEmbedDraft = KeyStore.HelpEmbedModelId ?? "";
        try
        {
            helpAnswerOptions = ModelCatalog.GetAvailableModels()
                .Where(m => !string.IsNullOrWhiteSpace(m.Id) && !m.IsImageGeneration)
                .Select(m => (m.Id, string.IsNullOrWhiteSpace(m.Label) ? m.Id : m.Label))
                .OrderBy(m => m.Item2, StringComparer.OrdinalIgnoreCase)
                .ToList();
        }
        catch
        {
            helpAnswerOptions = new();
        }

        helpEmbedOptions = new();
        foreach (var m in KeyStore.LemonadeModelSettingsList.Where(x => x.IsEmbeddings))
        {
            var id = "lemonade/" + m.Name;
            var label = string.IsNullOrWhiteSpace(m.Label) ? m.Name : m.Label;
            helpEmbedOptions.Add((id, label + " (Lemonade)"));
        }

        foreach (var m in KeyStore.OllamaModelSettingsList)
        {
            if (!LooksLikeEmbedModel(m.Name))
                continue;
            helpEmbedOptions.Add(("ollama/" + m.Name, (string.IsNullOrWhiteSpace(m.Label) ? m.Name : m.Label) + " (Ollama)"));
        }

        try
        {
            var status = await HelpAsk.GetIndexStatusAsync();
            helpIndexStatusText = FormatHelpIndexStatus(status);
        }
        catch (Exception ex)
        {
            helpIndexStatusText = "Index: " + ex.Message;
        }
    }

    private static bool LooksLikeEmbedModel(string name)
    {
        var n = name ?? "";
        return n.Contains("embed", StringComparison.OrdinalIgnoreCase)
            || n.Contains("nomic", StringComparison.OrdinalIgnoreCase)
            || n.Contains("minilm", StringComparison.OrdinalIgnoreCase)
            || n.Contains("bge-", StringComparison.OrdinalIgnoreCase)
            || n.Contains("e5-", StringComparison.OrdinalIgnoreCase);
    }

    private static string FormatHelpIndexStatus(App.Core.Help.HelpIndexStatus status)
    {
        if (!status.Ready)
            return "Index: empty (keyword retrieval until you rebuild with an embeddings model).";
        var mode = status.HasVectors ? (status.EmbedModelId ?? "vectors") : "keyword chunks only";
        var when = status.BuiltAtUtc.HasValue ? status.BuiltAtUtc.Value.ToLocalTime().ToString("g") : "unknown time";
        return $"Index ready · {status.ChunkCount} chunks · {mode} · {when}";
    }


    private async Task ShowSaveFeedbackAsync(string message, bool isError)
    {
        _saveFeedbackCts?.Cancel();
        _saveFeedbackCts?.Dispose();
        _saveFeedbackCts = new CancellationTokenSource();
        var token = _saveFeedbackCts.Token;

        saveFeedback = message;
        saveFeedbackIsError = isError;
        StateHasChanged();

        try
        {
            await Task.Delay(4000, token);
            saveFeedback = null;
            StateHasChanged();
        }
        catch (TaskCanceledException)
        {
        }
    }

    private async Task CheckForUpdate()
    {
        if (UpdateService == null) return;
        busy = true;
        hasChecked = false;
        updateCheckResult = null;
        StateHasChanged();
        try
        {
            updateCheckResult = await UpdateService.CheckForUpdateAsync();
            hasChecked = true;
            installedVersion = updateCheckResult.CurrentVersion ?? UpdateService.GetInstalledVersion();
            latestFeedVersion = updateCheckResult.LatestFeedVersion;
        }
        finally
        {
            busy = false;
            StateHasChanged();
        }
    }

    private async Task InstallUpdate()
    {
        if (updateCheckResult?.Update == null || UpdateService == null) return;
        busy = true;
        StateHasChanged();
        await UpdateService.DownloadAndInstallAsync(updateCheckResult.Update);
        // ApplyUpdatesAndRestart won't return — app restarts with new version
    }
}
    private string NavLayoutModeValue =>
        NavLayout.Mode == NavLayoutMode.Left ? "left" : "top";

    protected override async Task OnInitializedAsync()
    {
        Theme.OnChanged += OnThemeChangedFromService;
        if (AppEnvironment.IsMaui)
            NavLayout.OnChanged += OnNavLayoutChangedFromService;
        if (DesktopShell.IsSupported)
        {
            DesktopShell.OnChanged += OnDesktopShellChanged;
            await DesktopShell.AcknowledgeTrayHintAsync();
        }
        await KeyStore.LoadAsync();
        systemPromptDraft = KeyStore.GetSystemPrompt();
        profileDraft = KeyStore.GetUserProfile();
        ReloadMemories();
        maxOutputDraft = KeyStore.MaxOutputTokens;
        LoadToolRoutingDraft();
        LoadModelProfilesDraft();
        await LoadHelpModelsDraft();

        if (AppEnvironment.IsMaui)
        {
            loginServerDraft = ServerEndpoint.BaseUrl;
            if (string.IsNullOrWhiteSpace(loginServerDraft))
                loginServerDraft = "https://wizionic.com";
            LoadInstalledVersion();
            RefreshHomeserverStatus();
        }

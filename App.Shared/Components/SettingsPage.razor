    private void LoadModelProfilesDraft()
    {
        modelProfiles = KeyStore.ModelProfiles.ToList();
        BuildProfileSlotOptions();
        var active = KeyStore.ActiveModelProfileId;
        if (!string.IsNullOrWhiteSpace(active) && modelProfiles.Any(p => p.Id == active))
            profileEditId = active;
        else
            profileEditId = modelProfiles.FirstOrDefault()?.Id ?? "";
        LoadProfileDraft();
    }

    private void BuildProfileSlotOptions()
    {
        List<ChatModelInfo> catalog;
        try { catalog = ModelCatalog.GetAvailableModels(); }
        catch { catalog = new(); }

        profileChatOptions = catalog
            .Where(m => !m.IsImageGeneration && !string.IsNullOrWhiteSpace(m.Id))
            .Select(m => (m.Id, string.IsNullOrWhiteSpace(m.Label) ? m.Id : $"{m.Label}"))
            .OrderBy(x => x.Item2, StringComparer.OrdinalIgnoreCase)
            .ToList();

        profileImageOptions = catalog
            .Where(m => m.IsImageGeneration)
            .Select(m => (m.Id, m.Label))
            .ToList();
        profileEditOptions = catalog
            .Where(m => m.SupportsImageEdit || m.IsImageGeneration)
            .Select(m => (m.Id, m.Label))
            .ToList();

        profileVisionOptions = catalog
            .Where(m => m.SupportsVision && !m.IsImageGeneration)
            .Select(m => (m.Id, m.Label))
            .ToList();

        profileTtsOptions = new();
        profileSttOptions = new();
        foreach (var m in KeyStore.LemonadeModelSettingsList.Where(x => x.IsTts))
            profileTtsOptions.Add(("lemonade/" + m.Name, (string.IsNullOrWhiteSpace(m.Label) ? m.Name : m.Label) + " (Lemonade)"));
        foreach (var m in KeyStore.LemonadeModelSettingsList.Where(x => x.IsTranscription))
            profileSttOptions.Add(("lemonade/" + m.Name, (string.IsNullOrWhiteSpace(m.Label) ? m.Name : m.Label) + " (Lemonade)"));
        foreach (var p in KeyStore.CloudProviders)
        {
            if (p.HasXaiTts || p.HasOpenAiAudio || p.Models.Any(m => m.IsTts))
                profileTtsOptions.Add(("cloud/" + p.Id, p.DisplayName + " (TTS API)"));
            if (p.HasXaiStt || p.HasOpenAiAudio || p.Models.Any(m => m.IsTranscription))
                profileSttOptions.Add(("cloud/" + p.Id, p.DisplayName + " (STT API)"));
        }
    }

    private void LoadProfileDraft()
    {
        var p = string.IsNullOrWhiteSpace(profileEditId) ? null : KeyStore.GetModelProfile(profileEditId);
        profileNameDraft = p?.Name ?? "";
        profileChatDraft = p?.ChatModelId ?? "";
        profileRoutingDraft = p?.RoutingModelId ?? "";
        profileImageDraft = p?.ImageModelId ?? "";
        profileEditDraft = p?.EditModelId ?? "";
        profileTtsDraft = p?.TtsModelId ?? "";
        profileSttDraft = p?.SttModelId ?? "";
        profileVoiceDraft = p?.Voice ?? "";
        profileVisionDraft = p?.VisionProxyModelId ?? "";
        profileSaveMessage = null;
    }

    private void StartNewProfile()
    {
        profileEditId = "";
        profileNameDraft = "";
        profileChatDraft = "";
        profileRoutingDraft = "";
        profileImageDraft = "";
        profileEditDraft = "";
        profileTtsDraft = "";
        profileSttDraft = "";
        profileVoiceDraft = "";
        profileVisionDraft = "";
        profileSaveMessage = null;
    }

    private async Task SaveModelProfile()
    {
        profileBusy = true;
        profileSaveMessage = null;
        try
        {
            var name = (profileNameDraft ?? "").Trim();
            if (string.IsNullOrWhiteSpace(name))
            {
                profileSaveIsError = true;
                profileSaveMessage = "Name is required.";
                return;
            }

            var id = string.IsNullOrWhiteSpace(profileEditId)
                ? App.Core.Cloud.CloudModelCatalogResolver.MakeProviderId(name, modelProfiles.Select(p => p.Id))
                : profileEditId;
            var profile = new App.Core.Storage.ModelProfile
            {
                Id = id,
                Name = name,
                ChatModelId = EmptyToNull(profileChatDraft),
                RoutingModelId = EmptyToNull(profileRoutingDraft),
                ImageModelId = EmptyToNull(profileImageDraft),
                EditModelId = EmptyToNull(profileEditDraft),
                TtsModelId = EmptyToNull(profileTtsDraft),
                SttModelId = EmptyToNull(profileSttDraft),
                Voice = EmptyToNull(profileVoiceDraft),
                VisionProxyModelId = EmptyToNull(profileVisionDraft)
            };
            await KeyStore.UpsertModelProfileAsync(profile);
            await SettingsSyncHooks.AfterLocalSaveAsync(SettingsSync, SyncService, SettingsSyncCategory.ModelProfiles);
            profileEditId = id;
            modelProfiles = KeyStore.ModelProfiles.ToList();
            profileSaveIsError = false;
            profileSaveMessage = "Profile saved. Pick it at the top of the Chat model menu.";
        }
        catch (Exception ex)
        {
            profileSaveIsError = true;
            profileSaveMessage = ex.Message;
        }
        finally
        {
            profileBusy = false;
        }
    }

    private async Task DeleteModelProfile()
    {
        if (string.IsNullOrWhiteSpace(profileEditId))
            return;
        profileBusy = true;
        try
        {
            await KeyStore.RemoveModelProfileAsync(profileEditId);
            await SettingsSyncHooks.AfterLocalSaveAsync(SettingsSync, SyncService, SettingsSyncCategory.ModelProfiles);
            StartNewProfile();
            modelProfiles = KeyStore.ModelProfiles.ToList();
            profileSaveIsError = false;
            profileSaveMessage = "Profile deleted.";
        }
        catch (Exception ex)
        {
            profileSaveIsError = true;
            profileSaveMessage = ex.Message;
        }
        finally
        {
            profileBusy = false;
        }
    }

    private async Task ActivateModelProfile()
    {
        if (string.IsNullOrWhiteSpace(profileEditId))
            return;
        await KeyStore.SetActiveModelProfileIdAsync(profileEditId);
        await KeyStore.SetLastSelectedModelAsync(App.Core.Storage.ModelProfileId.ForPicker(profileEditId));
        await SettingsSyncHooks.AfterLocalSaveAsync(SettingsSync, SyncService, SettingsSyncCategory.ModelProfiles);
        profileSaveIsError = false;
        profileSaveMessage = "This profile is now selected in Chat.";
    }

    private static string? EmptyToNull(string? value) =>
        string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private async Task SaveToolRouting()
    {
        routingBusy = true;
        routingSaveMessage = null;
        StateHasChanged();
        try
        {
            var mode = routingModeDraft switch
            {
                "Ai" => ToolRoutingMode.Ai,
                "Hybrid" => ToolRoutingMode.Hybrid,
                _ => ToolRoutingMode.Rules
            };
            var modelId = string.IsNullOrWhiteSpace(routingModelDraft) ? null : routingModelDraft.Trim();
            if (mode != ToolRoutingMode.Rules && string.IsNullOrEmpty(modelId))
            {
                routingSaveMessage = "Pick a routing model for AI or Hybrid mode (or switch to Rules only).";
                routingSaveIsError = true;
                return;
            }

            await KeyStore.SetToolRoutingAsync(mode, modelId);
            routingSaveMessage = mode == ToolRoutingMode.Rules
                ? "Tool routing saved: Rules only."
                : $"Tool routing saved: {mode} with {modelId}.";
            routingSaveIsError = false;
        }
        catch (Exception ex)
        {
            routingSaveMessage = ex.Message;
            routingSaveIsError = true;
        }
        finally
        {
            routingBusy = false;
            StateHasChanged();
        }
    }

    private async Task RunRoutingTest()
    {
        if (string.IsNullOrWhiteSpace(routingTestMessage))
        {
            routingTestResult = "Enter a sample user message first.";
            return;
        }

        routingTestBusy = true;
        routingTestResult = null;
        StateHasChanged();
        try
        {
            // Persist draft so the test uses the same mode/model the user selected (even if not saved).
            var mode = routingModeDraft switch
            {
                "Ai" => ToolRoutingMode.Ai,
                "Hybrid" => ToolRoutingMode.Hybrid,
                _ => ToolRoutingMode.Rules
            };
            await KeyStore.SetToolRoutingAsync(
                mode,
                string.IsNullOrWhiteSpace(routingModelDraft) ? null : routingModelDraft.Trim());

            var modules = ToolProvider.GetActiveModules();
            var route = await RequestRouter.ClassifyRequestAsync(routingTestMessage.Trim(), modules);
            var modStr = route.HasTools ? string.Join(", ", route.Modules) : "(none)";
            routingTestResult =
                $"Source: {route.Source ?? "?"}\n" +
                $"Type: {route.Type}\n" +
                $"Modules: {modStr}\n" +
                $"Target: {route.TargetModule ?? "—"}\n" +
                $"MCP: {route.IncludeMcp}\n" +
                $"Reason: {route.Reason ?? "—"}";
        }
        catch (Exception ex)
        {
            routingTestResult = "Error: " + ex.Message;
        }
        finally
        {
            routingTestBusy = false;
            StateHasChanged();
        }
    }

    private Task ApplyLoginServerPreset(string url)
    {
        loginServerDraft = url;
        return SaveLoginServer();
    }

    private async Task SaveLoginServer()
    {
        loginServerBusy = true;
        loginServerMessage = null;
        loginServerRestartPending = false;
        showRestartConfirm = false;
        StateHasChanged();
        try
        {
            var restartRequired = await ServerEndpoint.SetBaseUrlAsync(loginServerDraft);
            loginServerDraft = ServerEndpoint.BaseUrl;
            loginServerIsError = false;
            if (restartRequired)
            {
                loginServerRestartPending = true;
                loginServerMessage = $"Login server saved as {ServerEndpoint.BaseUrl}. Restart Wizionic to connect.";
                restartConfirmMessage =
                    $"Wizionic must restart to use {ServerEndpoint.BaseUrl}. " +
                    "The new address is already saved.";
                if (AppRestart.CanRestart)
                    showRestartConfirm = true;
            }
            else
            {
                loginServerMessage = $"Login server is {ServerEndpoint.BaseUrl}.";
            }
        }
        catch (Exception ex)
        {
            loginServerMessage = ex.Message;
            loginServerIsError = true;
        }
        finally
        {
            loginServerBusy = false;
            StateHasChanged();
        }
    }

    private void RestartForLoginServer()
    {
        showRestartConfirm = false;
        if (!AppRestart.CanRestart)
            return;
        AppRestart.Restart();
    }


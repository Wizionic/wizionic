    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await UiStorageNamespace.ApplyAsync(JS, Auth);
        await Theme.SyncFromStorageAndApplyAsync(JS);
        if (AppEnvironment.IsMaui)
            await NavLayout.SyncFromStorageAndApplyAsync(JS);
    }

    private void OnThemeChangedFromService() => InvokeAsync(StateHasChanged);
    private void OnNavLayoutChangedFromService() => InvokeAsync(StateHasChanged);
    private void OnDesktopShellChanged() => InvokeAsync(StateHasChanged);



    private async Task OnThemeChanged(ChangeEventArgs e)
    {
        var theme = e.Value?.ToString() ?? ThemeService.DefaultThemeId;
        await UiStorageNamespace.ApplyAsync(JS, Auth);
        await Theme.SetThemeAsync(theme, JS);
        await SettingsSyncHooks.AfterLocalSaveAsync(SettingsSync, SyncService, SettingsSyncCategory.Appearance);
    }

    private async Task OnNavLayoutChanged(ChangeEventArgs e)
    {
        await UiStorageNamespace.ApplyAsync(JS, Auth);
        var mode = string.Equals(e.Value?.ToString(), "left", StringComparison.OrdinalIgnoreCase)
            ? NavLayoutMode.Left
            : NavLayoutMode.Top;
        await NavLayout.SetModeAsync(mode, JS);
        await SettingsSyncHooks.AfterLocalSaveAsync(SettingsSync, SyncService, SettingsSyncCategory.Appearance);
    }

    public void Dispose()
    {
        Theme.OnChanged -= OnThemeChangedFromService;
        if (AppEnvironment.IsMaui)
            NavLayout.OnChanged -= OnNavLayoutChangedFromService;
        if (DesktopShell.IsSupported)
            DesktopShell.OnChanged -= OnDesktopShellChanged;
    }

    private async Task OnCloseToTrayChanged(ChangeEventArgs e)
        => await DesktopShell.SetCloseToTrayAsync(IsChecked(e));

    private async Task OnStartWithWindowsChanged(ChangeEventArgs e)
        => await DesktopShell.SetStartWithWindowsAsync(IsChecked(e));

    private async Task OnStartMinimizedChanged(ChangeEventArgs e)
        => await DesktopShell.SetStartMinimizedAsync(IsChecked(e));

    private void QuitDesktop() => DesktopShell.RequestQuit();

    private void OpenNewDesktopWindow() => DesktopShell.OpenNewWindow();

    private static bool IsChecked(ChangeEventArgs e)
        => e.Value is bool b ? b : string.Equals(e.Value?.ToString(), "true", StringComparison.OrdinalIgnoreCase);

    private void ReloadMemories() => memories = KeyStore.GetMemories().ToList();

    private async Task SaveProfile()
    {
        try
        {
            await KeyStore.SetUserProfileAsync( profileDraft);
            await SettingsSyncHooks.AfterLocalSaveAsync(SettingsSync, SyncService, SettingsSyncCategory.Profile);
            await ShowSaveFeedbackAsync("About-you settings saved.", isError: false);
        }
        catch (Exception ex)
        {
            await ShowSaveFeedbackAsync($"Could not save profile: {ex.Message}", isError: true);

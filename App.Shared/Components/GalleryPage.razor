        var index = await ConversationStore.LoadIndexAsync();
        foreach (var c in index.OrderByDescending(x => x.LastUpdated))
        {
            var msgs = await ConversationStore.LoadConversationAsync(c.Id);
            var count = msgs
                .Where(m => m.DeletedAt is null && m.Attachments != null)
                .SelectMany(m => m.Attachments!)
                .Count(a => a.ContentType != null && a.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase)
                            && !string.IsNullOrWhiteSpace(a.DataBase64));
            if (count > 0)
                chatConvosWithImages.Add(new ChatConvoPick(c.Id, c.Title, count));
        }
        StateHasChanged();

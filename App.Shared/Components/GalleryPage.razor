    private async Task NameDialogKeyHandler(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(nameDialogTitle))
            await ConfirmNameDialog();
        else if (e.Key == "Escape")
            CancelNameDialog();
    }

    private async Task DeleteAlbum(string id)
    {
        var deletedAt = await GalleryStore.DeleteAlbumAsync(id);
        albums = await EnsureMyMediaAndLoadIndexAsync();
        SyncBridge.ScheduleAutoSyncAlbumDeleteAfterLocalDelete(id, deletedAt);
        unlockedAlbumIds.Remove(id);

        // Drop SQLite freelist / legacy blobs so the storage meter falls.
        try { await StorageQuota.CompactAsync(); } catch { /* non-fatal */ }

        if (activeAlbumId == id)
        {
            activeAlbumId = null;
            currentImages = new();
            InvalidateLiveImages();
            await ClearLightboxAsync();
            if (albums.Any())
            {
                activeAlbumId = albums.OrderByDescending(n => n.LastUpdated).First().Id;
                await LoadAlbum(activeAlbumId);
            }
        }
        StateHasChanged();
    }

    private void OpenUnlockDialog(string albumId, bool thenLoad = false)
    {
        unlockTargetAlbumId = albumId;
        unlockPassword = "";
        unlockError = null;
        unlockBusy = false;
        unlockThenLoad = thenLoad;
        pendingRemoveProtectionAlbumId = null;
        showUnlockDialog = true;
    }

    private void CancelUnlockDialog()
    {
        showUnlockDialog = false;
        unlockTargetAlbumId = null;
        unlockPassword = "";
        unlockError = null;
        unlockBusy = false;
        unlockThenLoad = false;
        pendingRemoveProtectionAlbumId = null;
    }

    private async Task UnlockDialogKeyHandler(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !unlockBusy && !string.IsNullOrWhiteSpace(unlockPassword))
            await ConfirmUnlockDialog();
        else if (e.Key == "Escape")
            CancelUnlockDialog();
    }

    private async Task ConfirmUnlockDialog()
    {
        if (string.IsNullOrEmpty(unlockTargetAlbumId) || string.IsNullOrWhiteSpace(unlockPassword))
            return;

        unlockBusy = true;
        unlockError = null;
        try
        {
            var (success, err) = await AuthService.VerifyPasswordAsync(unlockPassword);
            if (!success)
            {
                unlockError = err ?? "Incorrect password.";
                return;
            }

            var albumId = unlockTargetAlbumId;
            var shouldLoad = unlockThenLoad;
            var removeProtection = pendingRemoveProtectionAlbumId != null
                && string.Equals(pendingRemoveProtectionAlbumId, albumId, StringComparison.OrdinalIgnoreCase);

            CancelUnlockDialog();

            if (removeProtection)
            {
                await GalleryStore.SetPasswordProtectedAsync(albumId, false);
                albums = await EnsureMyMediaAndLoadIndexAsync();
                unlockedAlbumIds.Remove(albumId);
                SyncBridge.ScheduleAutoSyncAlbumMetaAfterLocalSave(
                    albumId,
                    albums.FirstOrDefault(n => n.Id == albumId)?.Title ?? "");
            }
            else
            {
                unlockedAlbumIds.Add(albumId);
                if (shouldLoad)
                {
                    activeAlbumId = albumId;
                    currentImages = await GalleryStore.LoadAlbumThumbsAsync(albumId);
                    InvalidateLiveImages();
                }
            }

            StateHasChanged();
        }
        finally
        {
            unlockBusy = false;
        }
    }

    private async Task ProtectAlbum(string? albumId)
    {
        CloseMenu();
        if (string.IsNullOrEmpty(albumId)) return;
        if (!AuthService.IsAuthenticated || !AuthService.HasPassword) return;

        await GalleryStore.SetPasswordProtectedAsync(albumId, true);
        albums = await EnsureMyMediaAndLoadIndexAsync();
        SyncBridge.ScheduleAutoSyncAlbumMetaAfterLocalSave(
            albumId,
            albums.FirstOrDefault(n => n.Id == albumId)?.Title ?? "");

        if (activeAlbumId == albumId)
            unlockedAlbumIds.Add(albumId);

        StateHasChanged();
    }

    private void RemoveAlbumProtection(string? albumId)
    {
        CloseMenu();
        if (string.IsNullOrEmpty(albumId)) return;
        unlockTargetAlbumId = albumId;
        unlockPassword = "";
        unlockError = null;
        unlockBusy = false;
        unlockThenLoad = false;
        pendingRemoveProtectionAlbumId = albumId;
        showUnlockDialog = true;
    }

    private async Task ExportAlbum(string? albumId)
    {
        CloseMenu();
        if (string.IsNullOrEmpty(albumId)) return;

        var album = albums.FirstOrDefault(a => a.Id == albumId);
        if (album == null) return;

        if (album.IsPasswordProtected && !unlockedAlbumIds.Contains(album.Id))
        {
            OpenUnlockDialog(album.Id, thenLoad: true);
            return;
        }

        List<GalleryImage> images;
        if (GalleryConstants.IsMyMediaAlbum(albumId))
        {
            var thumbs = await ChatMedia.LoadThumbsAsync();
            images = new List<GalleryImage>();
            foreach (var t in thumbs)
            {
                var full = await ChatMedia.LoadImageAsync(t.Id);
                if (full != null && !string.IsNullOrEmpty(full.DataBase64))
                    images.Add(full);
            }
        }
        else
        {
            images = (await GalleryStore.LoadAlbumAsync(album.Id)).Where(i => i.DeletedAt is null).ToList();
        }

        if (!images.Any()) return;
        await DownloadGalleryHtml(album.Title, images, SanitizeFileName(album.Title) + ".html");
    }

    private async Task ExportAllAlbums()
    {
        CloseExportAllMenu();
        var sb = new StringBuilder();
        sb.Append("<!DOCTYPE html><html><head><meta charset=\"utf-8\"/><title>Gallery Export</title>");
        sb.Append("<style>body{font-family:system-ui,sans-serif;margin:24px;background:#111;color:#eee}");
        sb.Append("h1,h2{margin:1.2rem 0 0.5rem} .grid{display:flex;flex-wrap:wrap;gap:8px}");
        sb.Append("img{max-width:240px;max-height:240px;object-fit:cover;border-radius:8px}</style></head><body>");
        sb.Append("<h1>Gallery Export</h1>");

        var any = false;
        foreach (var a in albums.OrderBy(x => GalleryConstants.IsMyMediaAlbum(x.Id) ? 0 : 1)
                                .ThenByDescending(x => x.LastUpdated))
        {
            if (a.IsPasswordProtected && !unlockedAlbumIds.Contains(a.Id))
                continue;

            List<GalleryImage> images;
            if (GalleryConstants.IsMyMediaAlbum(a.Id))
            {
                images = new List<GalleryImage>();
                foreach (var t in await ChatMedia.LoadThumbsAsync())
                {
                    var full = await ChatMedia.LoadImageAsync(t.Id);
                    if (full != null && !string.IsNullOrEmpty(full.DataBase64))
                        images.Add(full);
                }
            }
            else
            {
                images = (await GalleryStore.LoadAlbumAsync(a.Id)).Where(i => i.DeletedAt is null).ToList();
            }

            if (!images.Any()) continue;
            any = true;
            sb.Append("<h2>").Append(EncodeHtml(a.Title)).Append("</h2><div class=\"grid\">");
            foreach (var img in images)
            {
                if (string.IsNullOrEmpty(img.DataUrl)) continue;
                sb.Append("<img src=\"").Append(img.DataUrl).Append("\" alt=\"").Append(EncodeHtml(img.Name)).Append("\"/>");
            }
            sb.Append("</div>");
        }

        sb.Append("</body></html>");
        if (!any) return;

        var b64 = Convert.ToBase64String(Encoding.UTF8.GetBytes(sb.ToString()));
        try
        {
            await JS.InvokeAsync<bool>("downloadBase64File", b64, "gallery-export.html", "text/html");
        }
        catch { /* ignore */ }
    }

    private async Task DownloadGalleryHtml(string title, List<GalleryImage> images, string fileName)
    {
        var sb = new StringBuilder();
        sb.Append("<!DOCTYPE html><html><head><meta charset=\"utf-8\"/><title>").Append(EncodeHtml(title)).Append("</title>");
        sb.Append("<style>body{font-family:system-ui,sans-serif;margin:24px;background:#111;color:#eee}");
        sb.Append("h1{margin:0 0 1rem}.grid{display:flex;flex-wrap:wrap;gap:8px}");
        sb.Append("img{max-width:320px;max-height:320px;object-fit:cover;border-radius:8px}</style></head><body>");
        sb.Append("<h1>").Append(EncodeHtml(title)).Append("</h1><div class=\"grid\">");
        foreach (var img in images)
        {
            if (string.IsNullOrEmpty(img.DataUrl)) continue;
            sb.Append("<img src=\"").Append(img.DataUrl).Append("\" alt=\"").Append(EncodeHtml(img.Name)).Append("\"/>");
        }
        sb.Append("</div></body></html>");
        var b64 = Convert.ToBase64String(Encoding.UTF8.GetBytes(sb.ToString()));
        try
        {
            await JS.InvokeAsync<bool>("downloadBase64File", b64, fileName, "text/html");
        }
        catch { /* ignore */ }
    }

    private static string EncodeHtml(string s) =>
        s.Replace("&", "&amp;").Replace("<", "&lt;").Replace(">", "&gt;").Replace("\"", "&quot;");

    private static readonly char[] InvalidFileNameChars = { '<', '>', ':', '"', '|', '?', '*', '\\', '/' };

    private static string SanitizeFileName(string name) =>
        new string(name.Select(c => InvalidFileNameChars.Contains(c) ? '_' : c).ToArray())
            .Replace(" ", "_");

    public ValueTask DisposeAsync()
    {
        if (_sidebarStateChangedHandler is not null)
            SidebarState.OnChanged -= _sidebarStateChangedHandler;
        if (_gallerySyncChangedHandler is not null)
            SyncBridge.OnGalleryChanged -= _gallerySyncChangedHandler;
        return ValueTask.CompletedTask;
    }
}

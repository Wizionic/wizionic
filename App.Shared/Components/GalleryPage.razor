    private async Task OnFilesSelected(InputFileChangeEventArgs e)
    {
        if (string.IsNullOrEmpty(activeAlbumId) || IsActiveAlbumLocked)
            return;

        var files = e.GetMultipleFiles(50).ToList();
        if (files.Count == 0) return;

        // One cheap quota check for the whole batch (never decrypts existing albums).
        long totalBytes = 0;
        foreach (var f in files)
            totalBytes += f.Size;
        if (totalBytes > 0 && !await StorageQuota.CanAcceptBytesAsync(totalBytes))
        {
            try { await JS.InvokeVoidAsync("alert", "Not enough space under your storage limit. Raise the limit on the Sync page."); } catch { }
            return;
        }

        var added = false;
        foreach (var file in files)
        {
            if (file.Size > MaxImageBytes)
            {
                try { await JS.InvokeVoidAsync("alert", $"File {file.Name} is too large (max 15MB)."); } catch { }
                continue;
            }
            if (!string.IsNullOrEmpty(file.ContentType) && !file.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase))
                continue;

            try
            {
                using var stream = file.OpenReadStream(maxAllowedSize: MaxImageBytes + 1024);
                using var ms = new MemoryStream();
                await stream.CopyToAsync(ms);
                var bytes = ms.ToArray();
                var contentType = string.IsNullOrWhiteSpace(file.ContentType) ? "image/jpeg" : file.ContentType;
                var imageId = Guid.NewGuid().ToString("N");

                // WASM: one JS hop (thumb + encrypt + IDB). MAUI: native encrypt.
                // Avoid multi-MB base64 round-trips through Blazor interop.
                var gi = await GalleryStore.UpsertImageFromRawBytesAsync(
                    activeAlbumId!, imageId, file.Name, contentType, bytes);
                SyncBridge.ScheduleAutoSyncAlbumImageAfterLocalSave(activeAlbumId!, gi.Id);
                currentImages.Add(gi with { DataBase64 = "" });
                InvalidateLiveImages();
                added = true;
                await Task.Yield();
                StateHasChanged();
            }
            catch (Exception ex)
            {
                try { await JS.InvokeVoidAsync("alert", "Could not read file: " + ex.Message); } catch { }
            }
        }

        if (added && !string.IsNullOrEmpty(activeAlbumId))
        {
            var album = albums.FirstOrDefault(a => a.Id == activeAlbumId);
            SyncBridge.ScheduleAutoSyncAlbumMetaAfterLocalSave(activeAlbumId, album?.Title ?? "Untitled");
            albums = await EnsureMyMediaAndLoadIndexAsync();
            InvalidateLiveImages();
            StateHasChanged();
        }
    }


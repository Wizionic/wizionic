    private async Task ClearLightboxAsync()
    {
        lightboxImageId = null;
        lightboxLoading = false;
        if (!string.IsNullOrEmpty(lightboxBlobUrl))
        {
            var old = lightboxBlobUrl;
            lightboxBlobUrl = null;
            try { await GalleryStore.RevokeDisplayUrlAsync(old); } catch { /* ignore */ }
        }
    }

    private async Task EnsureLightboxBlobAsync(string imageId)
    {
        if (string.IsNullOrEmpty(activeAlbumId) || string.IsNullOrEmpty(imageId))
            return;

        // Revoke previous blob URL before loading next.
        if (!string.IsNullOrEmpty(lightboxBlobUrl))
        {
            var old = lightboxBlobUrl;
            lightboxBlobUrl = null;
            try { await GalleryStore.RevokeDisplayUrlAsync(old); } catch { /* ignore */ }
            try { await JS.InvokeVoidAsync("galleryRevokeObjectUrl", old); } catch { /* ignore */ }
        }

        lightboxLoading = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            string? url = null;
            if (IsMyMediaActive)
            {
                var img = await ChatMedia.LoadImageAsync(imageId);
                if (img != null && !string.IsNullOrEmpty(img.DataBase64))
                {
                    try
                    {
                        url = await JS.InvokeAsync<string?>(
                            "galleryObjectUrlFromBase64", img.DataBase64, img.ContentType);
                    }
                    catch { /* ignore */ }
                }
            }
            else
            {
                url = await GalleryStore.CreateDisplayUrlAsync(activeAlbumId, imageId);
            }

            if (lightboxImageId != imageId)
            {
                if (!string.IsNullOrEmpty(url))
                {
                    try { await GalleryStore.RevokeDisplayUrlAsync(url); } catch { /* ignore */ }
                    try { await JS.InvokeVoidAsync("galleryRevokeObjectUrl", url); } catch { /* ignore */ }
                }
                return;
            }
            lightboxBlobUrl = url;
        }
        finally
        {
            if (lightboxImageId == imageId)
                lightboxLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void LightboxPrev()
    {
        var live = LiveImages;
        var idx = live.FindIndex(i => i.Id == lightboxImageId);
        if (idx > 0)
        {
            lightboxImageId = live[idx - 1].Id;
            _ = EnsureLightboxBlobAsync(lightboxImageId!);
        }
    }

    private void LightboxNext()
    {
        var live = LiveImages;
        var idx = live.FindIndex(i => i.Id == lightboxImageId);
        if (idx >= 0 && idx < live.Count - 1)
        {
            lightboxImageId = live[idx + 1].Id;
            _ = EnsureLightboxBlobAsync(lightboxImageId!);
        }
    }

    private void OnLightboxKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
            CloseLightbox();
        else if (e.Key == "ArrowLeft")
            LightboxPrev();
        else if (e.Key == "ArrowRight")
            LightboxNext();
    }


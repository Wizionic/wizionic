    private async Task ConfirmPendingDelete()
    {
        showDeleteConfirm = false;
        if (!string.IsNullOrEmpty(pendingDeleteImageId))
        {
            var id = pendingDeleteImageId;
            pendingDeleteImageId = null;
            var idx = currentImages.FindIndex(i => i.Id == id);
            if (idx >= 0)
            {
                if (IsMyMediaActive)
                {
                    await ChatMedia.DeletePointerAsync(id);
                }
                else
                {
                    await GalleryStore.SoftDeleteImageAsync(activeAlbumId!, id);
                    SyncBridge.ScheduleAutoSyncAlbumImageDeleteAfterLocalDelete(activeAlbumId!, id, DateTime.UtcNow);
                    var album = albums.FirstOrDefault(a => a.Id == activeAlbumId);
                    SyncBridge.ScheduleAutoSyncAlbumMetaAfterLocalSave(activeAlbumId!, album?.Title ?? "Untitled");
                }

                if (lightboxImageId == id)
                    ClearLightbox();
                await LoadAlbum(activeAlbumId!);
                albums = await EnsureMyMediaAndLoadIndexAsync();
                StateHasChanged();
            }
        }
        else if (!string.IsNullOrEmpty(pendingDeleteAlbumId))
        {
            var id = pendingDeleteAlbumId;
            pendingDeleteAlbumId = null;
            if (!GalleryConstants.IsMyMediaAlbum(id))
                await DeleteAlbum(id);
        }
    }


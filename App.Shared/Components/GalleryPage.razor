    private async Task SelectChatConvo(string convoId)
    {
        chatPickAttachments.Clear();
        chatSelectedKeys.Clear();
        var msgs = await ConversationStore.LoadConversationAsync(convoId);
        var n = 0;
        foreach (var m in msgs.Where(m => m.DeletedAt is null && m.Attachments != null))
        {
            foreach (var a in m.Attachments!)
            {
                if (a.ContentType == null || !a.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase))
                    continue;
                if (string.IsNullOrWhiteSpace(a.DataBase64))
                    continue;
                var key = $"{convoId}:{n++}:{a.Name}";
                chatPickAttachments.Add(new ChatAttPick(
                    key,
                    a.Name,
                    a.ContentType,
                    a.DataBase64,
                    a.Size,
                    a.DataUrl));
            }
        }
        chatPickStep = ChatPickStep.Images;
        StateHasChanged();
    }


    private async Task ConfirmMoveImage(string targetAlbumId)
    {
        if (string.IsNullOrEmpty(moveImageId) || string.IsNullOrEmpty(activeAlbumId)
            || GalleryConstants.IsMyMediaAlbum(targetAlbumId))
        {
            CloseMoveDialog();
            return;
        }

        var idx = currentImages.FindIndex(i => i.Id == moveImageId);
        if (idx < 0)
        {
            CloseMoveDialog();
            return;
        }

        var img = currentImages[idx];
        if (IsMyMediaActive)
        {
            // Materialize into a real album, then remove the chat attachment (true move).
            var newId = await ChatMedia.CopyToAlbumAsync(img.Id, targetAlbumId);
            await ChatMedia.DeletePointerAsync(img.Id);
            SyncBridge.ScheduleAutoSyncAlbumImageAfterLocalSave(targetAlbumId, newId);
            var targetTitle = albums.FirstOrDefault(a => a.Id == targetAlbumId)?.Title ?? "Untitled";
            SyncBridge.ScheduleAutoSyncAlbumMetaAfterLocalSave(targetAlbumId, targetTitle);
            if (lightboxImageId == img.Id)
                ClearLightbox();
            await LoadAlbum(activeAlbumId!);
        }
        else
        {
            await GalleryStore.MoveImageAsync(activeAlbumId!, targetAlbumId, img.Id);
            SyncBridge.ScheduleAutoSyncAlbumImageDeleteAfterLocalDelete(activeAlbumId!, img.Id, DateTime.UtcNow);
            SyncBridge.ScheduleAutoSyncAlbumImageAfterLocalSave(targetAlbumId, img.Id);
            var srcTitle = albums.FirstOrDefault(a => a.Id == activeAlbumId)?.Title ?? "Untitled";
            var targetTitle = albums.FirstOrDefault(a => a.Id == targetAlbumId)?.Title ?? "Untitled";
            SyncBridge.ScheduleAutoSyncAlbumMetaAfterLocalSave(activeAlbumId!, srcTitle);
            SyncBridge.ScheduleAutoSyncAlbumMetaAfterLocalSave(targetAlbumId, targetTitle);
            await LoadAlbum(activeAlbumId!);
        }

        albums = await EnsureMyMediaAndLoadIndexAsync();
        CloseMoveDialog();
        StateHasChanged();
    }

    private async Task OpenAddFromChat()

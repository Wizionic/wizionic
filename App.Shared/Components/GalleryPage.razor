@implements IAsyncDisposable
@using App.Core.Auth
@using App.Core.Storage
@using App.Core.UI
@using App.Shared.Services
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.Components.Web
@using System.Text
@using System.Text.Json

@inject IJSRuntime JS
@inject NavigationManager Nav
@inject IGalleryStore GalleryStore
@inject IConversationStore ConversationStore
@inject IChatMediaLibrary ChatMedia
@inject IAuthService AuthService
@inject IGuestDataMigrationService GuestMigration
@inject IGallerySyncBridge SyncBridge
@inject IStorageQuotaService StorageQuota
@inject ISidebarState SidebarState
@inject IChatPanelState ChatPanel
@inject IGalleryChatHandoff GalleryChatHandoff

<WasmSidebarSync />

<div class="page @(SidebarState.IsCollapsed ? "sidebar-collapsed" : "")">
    <div class="sidebar">
        <nav class="cf-nav cf-column">
            <div class="cf-item">
                <span class="cf-link small">
                   <h4>Gallery</h4>
                    <div class="menu" @onclick:stopPropagation>
                        <button id="gallery-menu-btn" class="menu-button" @onclick:stopPropagation @onclick="ToggleExportAllMenu" title="Gallery options">⋮</button>
                    </div>
                    <button class="menu-button" @onclick="OpenCreateAlbumDialog" title="New album">
                        <i class="cf-icon bi bi-plus-circle" style="font-size: 30px;"></i>
                    </button>
                </span>
            </div>

            @foreach (var a in albums.OrderBy(x => GalleryConstants.IsMyMediaAlbum(x.Id) ? -1 : 0)
                                     .ThenBy(x => x.SortOrder)
                                     .ThenByDescending(x => x.LastUpdated))
            {
                var isActive = activeAlbumId == a.Id;
                var isMyMedia = GalleryConstants.IsMyMediaAlbum(a.Id);
                <div class="conversation-item @(isActive ? "active" : "")"
                     @onclick="() => SelectAlbum(a.Id)">
                    <div class="row-top">
                        <div class="title">
                            @if (a.IsPasswordProtected)
                            {
                                <i class="cf-icon bi bi-lock-fill" style="font-size:0.85em; margin-right:4px; opacity:0.85;" title="Password protected"></i>
                            }
                            @if (isMyMedia)
                            {
                                <i class="cf-icon bi bi-collection-play" style="font-size:0.85em; margin-right:4px; opacity:0.85;" title="Chat media library"></i>
                            }
                            @a.Title
                        </div>
                        <div class="menu" @onclick:stopPropagation>
                            <button id="menu-btn-@a.Id" class="menu-button" @onclick:stopPropagation @onclick="() => ToggleMenu(a.Id)">⋮</button>
                        </div>
                    </div>
                    <div class="date">@(isMyMedia ? "Library" : a.LastUpdated.ToLocalTime().ToString("MMM d"))</div>
                </div>
            }
            @if (!albums.Any())
            {
                <div class="cf-item" style="font-size:0.75em; color:var(--cf-text-muted); padding-left:12px;">No albums yet.</div>
            }
        </nav>
    </div>

    <main>
        <div class="chat-wrapper" style="flex: 1; display: flex; flex-direction: column;">
            @if (string.IsNullOrEmpty(activeAlbumId))
            {
                <div class="gallery-empty">
                    <i class="bi bi-images" style="font-size:2.5rem; opacity:0.5;"></i>
                    <p style="margin-top:0.75rem;">Create an album to get started.</p>
                </div>
            }
            else if (IsActiveAlbumLocked)
            {
                <div style="flex:1; display:flex; align-items:center; justify-content:center; padding:2rem; text-align:center;">
                    <div style="max-width:360px;">
                        <i class="cf-icon bi bi-lock-fill" style="font-size:2.5rem; color:var(--cf-text-muted); opacity:0.8;"></i>
                        <h3 style="margin:0.75rem 0 0.35rem 0; font-size:1.15rem; color:var(--color-text);">Album locked</h3>
                        <p style="margin:0; font-size:0.9rem; color:var(--cf-text-muted);">
                            Enter your account password to view this album.
                        </p>
                        <button type="button" class="newnote-btn newnote-btn-primary" style="margin-top:1rem;" @onclick="() => OpenUnlockDialog(activeAlbumId!)">
                            Unlock
                        </button>
                    </div>
                </div>
            }
            else if (lightboxImageId != null)
            {
                var live = LiveImages;
                var idx = live.FindIndex(i => i.Id == lightboxImageId);
                var current = idx >= 0 ? live[idx] : null;
                <div class="gallery-lightbox" @onkeydown="OnLightboxKeyDown" tabindex="0" @ref="lightboxRoot">
                    <div class="gallery-lightbox-top">
                        <button type="button" class="menu-button" title="Back to album" @onclick="CloseLightbox">
                            <i class="bi bi-arrow-left" style="font-size:1.35rem;"></i>
                        </button>
                        <span style="font-size:0.9rem; color:var(--cf-text-muted);">
                            @(current?.Name ?? "Photo") @(live.Count > 0 ? $"({Math.Max(idx, 0) + 1} / {live.Count})" : "")
                        </span>
                    </div>
                    <div class="gallery-lightbox-stage">
                        <button type="button" class="gallery-nav-btn gallery-nav-btn--prev" disabled="@(idx <= 0)" @onclick="LightboxPrev" title="Previous">
                            <i class="bi bi-chevron-left" style="font-size:1.4rem;"></i>
                        </button>
                        @if (!string.IsNullOrEmpty(lightboxBlobUrl))
                        {
                            <img src="@lightboxBlobUrl" alt="@(current?.Name ?? "Photo")" />
                        }
                        else if (!string.IsNullOrEmpty(current?.ThumbnailUrl))
                        {
                            <img src="@current.ThumbnailUrl" alt="@(current?.Name ?? "Photo")" />
                        }
                        else if (lightboxLoading)
                        {
                            <span style="color:var(--cf-text-muted);">Loading…</span>
                        }
                        <button type="button" class="gallery-nav-btn gallery-nav-btn--next" disabled="@(idx < 0 || idx >= live.Count - 1)" @onclick="LightboxNext" title="Next">
                            <i class="bi bi-chevron-right" style="font-size:1.4rem;"></i>
                        </button>
                    </div>
                </div>
            }
            else
            {
                <div class="gallery-toolbar">
                    <div class="gallery-layout-toggle" title="Layout">
                        <button type="button" class="@(layoutMode == LayoutMode.Masonry ? "active" : "")" @onclick="() => SetLayout(LayoutMode.Masonry)">Masonry</button>
                        <button type="button" class="@(layoutMode == LayoutMode.Square ? "active" : "")" @onclick="() => SetLayout(LayoutMode.Square)">Square</button>
                    </div>
                    <span style="font-size:0.8rem; color:var(--cf-text-muted);">@LiveImages.Count image(s)</span>
                </div>
                <div class="gallery-content">
                    @if (!LiveImages.Any())
                    {
                        <div class="gallery-empty">
                            <i class="bi bi-image" style="font-size:2rem; opacity:0.5;"></i>
                            <p style="margin-top:0.5rem;">
                                @if (IsMyMediaActive)
                                {
                                    <text>No chat images yet. Generate or upload images in Chat to see them here.</text>
                                }
                                else
                                {
                                    <text>No images yet. Tap + to upload or add from chat.</text>
                                }
                            </p>
                        </div>
                    }
                    else
                    {
                        <div class="@(layoutMode == LayoutMode.Square ? "gallery-grid--square" : "gallery-grid--masonry")">
                            @foreach (var img in LiveImages)
                            {
                                var captured = img;
                                var aspect = captured.Width is > 0 && captured.Height is > 0
                                    ? $"aspect-ratio:{captured.Width}/{captured.Height};"
                                    : "";
                                <div class="gallery-tile" style="@(layoutMode == LayoutMode.Masonry ? aspect : "")" @onclick="() => OpenLightbox(captured.Id)">
                                    <img src="@(captured.ThumbnailUrl ?? captured.DataUrl)" alt="@captured.Name" loading="lazy" />
                                    <div class="gallery-tile-menu" @onclick:stopPropagation>
                                        <button type="button" id="tile-menu-@captured.Id" class="menu-button" @onclick="() => ToggleTileMenu(captured.Id)" title="Image options">⋮</button>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </main>

    @if (!string.IsNullOrEmpty(activeAlbumId) && nameDialogMode == NameDialogMode.None && !IsActiveAlbumLocked
         && lightboxImageId == null && !IsMyMediaActive)
    {
        <button type="button"
                class="menu-button notes-fab"
                title="Add images"
                @onclick="OpenAddMenu">
            <i class="cf-icon bi bi-plus-circle"></i>
        </button>
    }

    <InputFile id="gallery-file-input" style="display:none;" OnChange="OnFilesSelected" multiple accept="image/*" />

    @if (openMenuId != null)
    {
        var menuIsMyMedia = GalleryConstants.IsMyMediaAlbum(openMenuId);
        <div class="menu-popup" style="@activePopupStyle" @onclick:stopPropagation>
            @if (!menuIsMyMedia)
            {
                <div @onclick="() => { CloseMenu(); OpenAddMenuForAlbum(openMenuId); }">
                    <button type="button" class="menu-button"><i class="cf-icon bi bi-plus-lg"></i></button>
                    Add
                </div>
                <div @onclick="() => OpenRenameDialog(openMenuId)">
                    <button type="button" class="menu-button"><i class="cf-icon bi bi-pencil-square"></i></button>
                    Rename
                </div>
            }
            <div @onclick="() => ExportAlbum(openMenuId)">
                <button type="button" class="menu-button"><i class="cf-icon bi bi-file-earmark-arrow-down"></i></button>
                Export
            </div>
            @if (AuthService.IsAuthenticated && AuthService.HasPassword)
            {
                var menuAlbum = albums.FirstOrDefault(n => n.Id == openMenuId);
                @if (menuAlbum?.IsPasswordProtected == true)
                {
                    <div @onclick="() => RemoveAlbumProtection(openMenuId)">
                        <button type="button" class="menu-button"><i class="cf-icon bi bi-unlock"></i></button>
                        Remove password protection
                    </div>
                }
                else
                {
                    <div @onclick="() => ProtectAlbum(openMenuId)">
                        <button type="button" class="menu-button"><i class="cf-icon bi bi-lock-fill"></i></button>
                        Protect with password
                    </div>
                }
            }
            @if (!menuIsMyMedia)
            {
                <div @onclick="() => PromptDeleteAlbum(openMenuId)">
                    <button type="button" class="menu-button"><i class="cf-icon bi bi-trash3-fill"></i></button>
                    Delete Album
                </div>
            }
        </div>
        <div class="menu-overlay" @onclick="CloseMenu"></div>
    }

    @if (openExportAllMenu)
    {
        <div class="menu-popup" style="@exportAllPopupStyle" @onclick:stopPropagation>
            <div @onclick="ExportAllAlbums">
                <button type="button" class="menu-button"><i class="cf-icon bi bi-file-earmark-arrow-down"></i></button>
                Export all
            </div>
        </div>
        <div class="menu-overlay" @onclick="CloseExportAllMenu"></div>
    }

    @if (openAddMenu)
    {
        <div class="menu-popup" style="@addMenuPopupStyle" @onclick:stopPropagation>
            <div @onclick="TriggerUpload">
                <button type="button" class="menu-button"><i class="cf-icon bi bi-upload"></i></button>
                Upload
            </div>
            <div @onclick="OpenAddFromChat">
                <button type="button" class="menu-button"><i class="cf-icon bi bi-chat-left-text"></i></button>
                Add from chat
            </div>
        </div>
        <div class="menu-overlay" @onclick="CloseAddMenu"></div>
    }

    @if (openTileMenuId != null)
    {
        <div class="menu-popup" style="@tilePopupStyle" @onclick:stopPropagation>
            <div @onclick="() => EditImageWithAi(openTileMenuId)">
                <button type="button" class="menu-button"><i class="cf-icon bi bi-magic"></i></button>
                Edit with AI
            </div>
            <div @onclick="() => DownloadImage(openTileMenuId)">
                <button type="button" class="menu-button"><i class="cf-icon bi bi-download"></i></button>
                Download
            </div>
            <div @onclick="() => OpenMoveImageDialog(openTileMenuId)">
                <button type="button" class="menu-button"><i class="cf-icon bi bi-arrow-right-square"></i></button>
                Move to album
            </div>
            <div @onclick="() => PromptDeleteImage(openTileMenuId)">
                <button type="button" class="menu-button"><i class="cf-icon bi bi-trash3-fill"></i></button>
                @(IsMyMediaActive ? "Delete from chat" : "Delete")
            </div>
        </div>
        <div class="menu-overlay" @onclick="CloseTileMenu"></div>
    }

    @if (showMoveDialog)
    {
        <div class="newnote-overlay" @onclick="CloseMoveDialog">
            <div class="newnote-modal move-notebook-modal" @onclick:stopPropagation>
                <h4 style="margin:0 0 12px 0;font-size:1.1rem;color:var(--color-text);">Move to album</h4>
                @if (moveTargetAlbums.Count == 0)
                {
                    <p style="font-size:0.85rem;color:var(--cf-text-muted);margin:12px 0 0 0;">No other albums available.</p>
                }
                else
                {
                    @foreach (var target in moveTargetAlbums)
                    {
                        var t = target;
                        <div class="move-notebook-item" @onclick="() => ConfirmMoveImage(t.Id)" @onclick:stopPropagation>
                            <i class="cf-icon bi bi-images" style="font-size:1.1em;color:var(--cf-text-muted);margin-right:8px;"></i>
                            <span>@t.Title</span>
                        </div>
                    }
                }
                <div style="margin-top:16px;display:flex;gap:8px;justify-content:flex-end;">
                    <button type="button" class="newnote-btn newnote-btn-secondary" @onclick="CloseMoveDialog">Cancel</button>
                </div>
            </div>
        </div>
    }

    @if (showAddFromChat)
    {
        <div class="newnote-overlay" @onclick="CloseAddFromChat">
            <div class="newnote-modal" style="max-width:480px; width:92%;" @onclick:stopPropagation>
                <h4 style="margin:0 0 12px 0;font-size:1.1rem;color:var(--color-text);">Add from chat</h4>
                @if (chatPickStep == ChatPickStep.Conversations)
                {
                    <p style="font-size:0.85rem;color:var(--cf-text-muted);margin:0 0 8px 0;">Choose a conversation that has images.</p>
                    <div class="gallery-chat-pick-list">
                        @if (!chatConvosWithImages.Any())
                        {
                            <p style="font-size:0.85rem;color:var(--cf-text-muted);">No chat images found.</p>
                        }
                        @foreach (var c in chatConvosWithImages)
                        {
                            var capt = c;
                            <div class="gallery-chat-pick-item" @onclick="() => SelectChatConvo(capt.Id)">
                                <i class="bi bi-chat-dots" style="font-size:1.2rem;color:var(--cf-text-muted);"></i>
                                <div>
                                    <div style="font-weight:500;">@capt.Title</div>
                                    <div style="font-size:0.75rem;color:var(--cf-text-muted);">@capt.ImageCount image(s)</div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p style="font-size:0.85rem;color:var(--cf-text-muted);margin:0 0 8px 0;">Select images to add.</p>
                    <div class="gallery-chat-pick-list">
                        @foreach (var att in chatPickAttachments)
                        {
                            var a = att;
                            var selected = chatSelectedKeys.Contains(a.Key);
                            <div class="gallery-chat-pick-item @(selected ? "selected" : "")" @onclick="() => ToggleChatAttachment(a.Key)">
                                @if (!string.IsNullOrEmpty(a.ThumbUrl))
                                {
                                    <img src="@a.ThumbUrl" alt="@a.Name" />
                                }
                                else
                                {
                                    <i class="bi bi-image" style="font-size:1.5rem;"></i>
                                }
                                <span style="font-size:0.85rem; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">@a.Name</span>
                            </div>
                        }
                    </div>
                    <div style="margin-top:12px;display:flex;gap:8px;justify-content:space-between;">
                        <button type="button" class="newnote-btn newnote-btn-secondary" @onclick="() => chatPickStep = ChatPickStep.Conversations">Back</button>
                        <div style="display:flex;gap:8px;">
                            <button type="button" class="newnote-btn newnote-btn-secondary" @onclick="CloseAddFromChat">Cancel</button>
                            <button type="button" class="newnote-btn newnote-btn-primary" disabled="@(!chatSelectedKeys.Any())" @onclick="ConfirmAddFromChat">
                                Add (@chatSelectedKeys.Count)
                            </button>
                        </div>
                    </div>
                }
                @if (chatPickStep == ChatPickStep.Conversations)
                {
                    <div style="margin-top:12px;display:flex;gap:8px;justify-content:flex-end;">
                        <button type="button" class="newnote-btn newnote-btn-secondary" @onclick="CloseAddFromChat">Cancel</button>
                    </div>
                }
            </div>
        </div>
    }

    <ConfirmDialog IsVisible="showDeleteConfirm"
                   Title="@deleteConfirmTitle"
                   Message="@deleteConfirmMessage"
                   OnConfirm="ConfirmPendingDelete"
                   OnCancel="CancelPendingDelete" />

    @if (nameDialogMode != NameDialogMode.None)
    {
        <div class="newnote-overlay" @onclick="CancelNameDialog">
            <div class="newnote-modal" @onclick:stopPropagation>
                <h4 style="margin:0 0 12px 0;font-size:1.1rem;color:var(--color-text);">
                    @(nameDialogMode == NameDialogMode.Create ? "New Album" : "Rename Album")
                </h4>
                <input type="text"
                       @bind="nameDialogTitle"
                       @bind:event="oninput"
                       placeholder="Album name..."
                       class="newnote-input"
                       @onkeydown="NameDialogKeyHandler" />
                <div style="margin-top:12px;display:flex;gap:8px;justify-content:flex-end;">
                    <button type="button" class="newnote-btn newnote-btn-secondary" @onclick="CancelNameDialog">Cancel</button>
                    <button type="button" class="newnote-btn newnote-btn-primary" @onclick="ConfirmNameDialog" disabled="@(string.IsNullOrWhiteSpace(nameDialogTitle))">
                        @(nameDialogMode == NameDialogMode.Create ? "Create" : "Save")
                    </button>
                </div>
            </div>
        </div>
    }

    @if (showUnlockDialog)
    {
        <div class="newnote-overlay" @onclick="CancelUnlockDialog">
            <div class="newnote-modal" @onclick:stopPropagation>
                <h4 style="margin:0 0 12px 0;font-size:1.1rem;color:var(--color-text);">
                    <i class="cf-icon bi bi-lock-fill" style="margin-right:6px;"></i>
                    @(pendingRemoveProtectionAlbumId != null ? "Remove password protection" : "Unlock album")
                </h4>
                <p style="font-size:0.85rem;color:var(--cf-text-muted);margin:0 0 12px 0;">
                    @(pendingRemoveProtectionAlbumId != null
                        ? "Enter your account password to remove protection from this album."
                        : "Enter your account password to open this album.")
                </p>
                @if (!string.IsNullOrEmpty(unlockError))
                {
                    <div style="color: var(--cf-error-fg); margin: 0 0 0.5rem; font-size:0.9em;">@unlockError</div>
                }
                <input type="password"
                       @bind="unlockPassword"
                       @bind:event="oninput"
                       placeholder="Password"
                       class="newnote-input"
                       autocomplete="current-password"
                       @onkeydown="UnlockDialogKeyHandler" />
                <div style="margin-top:12px;display:flex;gap:8px;justify-content:flex-end;">
                    <button type="button" class="newnote-btn newnote-btn-secondary" @onclick="CancelUnlockDialog" disabled="@unlockBusy">Cancel</button>
                    <button type="button" class="newnote-btn newnote-btn-primary" @onclick="ConfirmUnlockDialog" disabled="@(unlockBusy || string.IsNullOrWhiteSpace(unlockPassword))">
                        @(pendingRemoveProtectionAlbumId != null ? "Remove protection" : "Unlock")
                    </button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<LocalAlbum> albums = new();
    private string? activeAlbumId;
    private List<GalleryImage> currentImages = new();
    private List<GalleryImage>? _liveImagesCache;
    private List<GalleryImage> LiveImages
    {
        get
        {
            _liveImagesCache ??= currentImages.Where(i => i.DeletedAt is null).ToList();
            return _liveImagesCache;
        }
    }

    private void InvalidateLiveImages() => _liveImagesCache = null;

    private string? openMenuId;
    private bool openExportAllMenu;
    private bool openAddMenu;
    private string? openTileMenuId;
    private string activePopupStyle = "";
    private string exportAllPopupStyle = "";
    private string addMenuPopupStyle = "";
    private string tilePopupStyle = "";

    private string? lightboxImageId;
    /// <summary>Short blob: URL for full-res lightbox — never multi-MB data: URLs in markup.</summary>
    private string? lightboxBlobUrl;
    private bool lightboxLoading;
    private ElementReference lightboxRoot;

    private enum LayoutMode { Masonry, Square }
    private LayoutMode layoutMode = LayoutMode.Masonry;

    private enum NameDialogMode { None, Create, Rename }
    private NameDialogMode nameDialogMode = NameDialogMode.None;
    private string? nameDialogAlbumId;
    private string nameDialogTitle = "";

    private bool showDeleteConfirm;
    private string deleteConfirmTitle = "";
    private string deleteConfirmMessage = "";
    private string? pendingDeleteAlbumId;
    private string? pendingDeleteImageId;

    private bool showMoveDialog;
    private string? moveImageId;
    private List<LocalAlbum> moveTargetAlbums = new();

    private readonly HashSet<string> unlockedAlbumIds = new(StringComparer.OrdinalIgnoreCase);

    private bool showUnlockDialog;
    private string? unlockTargetAlbumId;
    private string unlockPassword = "";
    private string? unlockError;
    private bool unlockBusy;
    private bool unlockThenLoad;
    private string? pendingRemoveProtectionAlbumId;

    private bool showAddFromChat;
    private enum ChatPickStep { Conversations, Images }
    private ChatPickStep chatPickStep = ChatPickStep.Conversations;
    private List<ChatConvoPick> chatConvosWithImages = new();
    private List<ChatAttPick> chatPickAttachments = new();
    private HashSet<string> chatSelectedKeys = new(StringComparer.Ordinal);
    private string? addTargetAlbumId;

    private const long MaxImageBytes = 15 * 1024 * 1024;

    private bool IsActiveAlbumLocked =>
        !string.IsNullOrEmpty(activeAlbumId)
        && albums.FirstOrDefault(n => n.Id == activeAlbumId)?.IsPasswordProtected == true
        && !unlockedAlbumIds.Contains(activeAlbumId);

    private bool IsMyMediaActive => GalleryConstants.IsMyMediaAlbum(activeAlbumId);

    private class PopupPosition
    {
        public double top { get; set; }
        public double left { get; set; }
    }

    private sealed record ChatConvoPick(string Id, string Title, int ImageCount);
    private sealed record ChatAttPick(string Key, string Name, string ContentType, string DataBase64, long Size, string? ThumbUrl);

    private sealed class ImagePrepResult
    {
        public int width { get; set; }
        public int height { get; set; }
        public string? thumbnailBase64 { get; set; }
    }

    private Action? _sidebarStateChangedHandler;
    private Action? _gallerySyncChangedHandler;

    protected override async Task OnInitializedAsync()
    {
        await AuthService.LoadAsync();
        if (AuthService.IsAuthenticated)
            await GuestMigration.MigrateIfNeededAsync();

        albums = await EnsureMyMediaAndLoadIndexAsync();

        try
        {
            var pref = await JS.InvokeAsync<string?>("eval", "localStorage.getItem('gallery-layout-mode')");
            if (string.Equals(pref, "square", StringComparison.OrdinalIgnoreCase))
                layoutMode = LayoutMode.Square;
        }
        catch { /* ignore */ }

        if (albums.Any())
        {
            // Prefer My Media as default landing when present.
            activeAlbumId = albums.FirstOrDefault(a => GalleryConstants.IsMyMediaAlbum(a.Id))?.Id
                            ?? albums.OrderByDescending(n => n.LastUpdated).First().Id;
            await LoadAlbum(activeAlbumId);
        }

        _sidebarStateChangedHandler = () => InvokeAsync(StateHasChanged);
        SidebarState.OnChanged += _sidebarStateChangedHandler;

        _gallerySyncChangedHandler = () => _ = RefreshFromSyncAsync();
        SyncBridge.OnGalleryChanged += _gallerySyncChangedHandler;
    }

    private async Task RefreshFromSyncAsync()
    {
        albums = await EnsureMyMediaAndLoadIndexAsync();
        if (!string.IsNullOrEmpty(activeAlbumId))
        {
            if (albums.All(a => a.Id != activeAlbumId))
            {
                activeAlbumId = albums.OrderByDescending(a => a.LastUpdated).FirstOrDefault()?.Id;
                currentImages = new();
                InvalidateLiveImages();
                ClearLightbox();
            }
            if (!string.IsNullOrEmpty(activeAlbumId) && !IsActiveAlbumLocked)
            {
                if (GalleryConstants.IsMyMediaAlbum(activeAlbumId))
                    currentImages = await ChatMedia.LoadThumbsAsync();
                else
                    currentImages = await GalleryStore.LoadAlbumThumbsAsync(activeAlbumId);
                InvalidateLiveImages();
            }
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task SelectAlbum(string id)
    {
        ClearLightbox();
        if (activeAlbumId == id)
        {
            if (IsActiveAlbumLocked)
                OpenUnlockDialog(id, thenLoad: true);
            return;
        }
        activeAlbumId = id;
        await LoadAlbum(id);
    }

    private async Task LoadAlbum(string id)
    {
        activeAlbumId = id;
        ClearLightbox();

        var album = albums.FirstOrDefault(a => a.Id == id);
        if (album?.IsPasswordProtected == true && !unlockedAlbumIds.Contains(id))
        {
            currentImages = new();
            InvalidateLiveImages();
            OpenUnlockDialog(id, thenLoad: true);
            StateHasChanged();
            return;
        }

        if (GalleryConstants.IsMyMediaAlbum(id))
        {
            // Virtual album: thumbs from chat attachments (pointers).
            currentImages = await ChatMedia.LoadThumbsAsync();
        }
        else
        {
            // Thumbs only — never bind full multi-MB DataBase64 into the tile grid (freezes WASM).
            currentImages = await GalleryStore.LoadAlbumThumbsAsync(id);
        }
        InvalidateLiveImages();
        StateHasChanged();
    }

    /// <summary>Ensure reserved My Media meta exists (for password protection) and is listed.</summary>
    private async Task<List<LocalAlbum>> EnsureMyMediaAndLoadIndexAsync()
    {
        var list = await GalleryStore.LoadIndexAsync();
        if (!list.Any(a => GalleryConstants.IsMyMediaAlbum(a.Id)))
        {
            try
            {
                await GalleryStore.CreateAlbumAsync(
                    GalleryConstants.MyMediaAlbumId,
                    GalleryConstants.MyMediaAlbumTitle);
            }
            catch { /* may already exist race */ }
            list = await GalleryStore.LoadIndexAsync();
        }

        // Always show canonical title; pin sort visually even if meta is stale.
        return list
            .Select(a => GalleryConstants.IsMyMediaAlbum(a.Id)
                ? a with { Title = GalleryConstants.MyMediaAlbumTitle, SortOrder = -1 }
                : a)
            .ToList();
    }


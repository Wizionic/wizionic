    private async Task ConfirmAddFromChat()
    {
        if (string.IsNullOrEmpty(activeAlbumId) || IsActiveAlbumLocked)
        {
            CloseAddFromChat();
            return;
        }

        var selected = chatPickAttachments.Where(a => chatSelectedKeys.Contains(a.Key)).ToList();
        foreach (var a in selected)
        {
            int? w = null, h = null;
            string? thumb = null;
            try
            {
                var prep = await JS.InvokeAsync<ImagePrepResult>("galleryPrepareImage", a.DataBase64, a.ContentType, 400);
                if (prep != null)
                {
                    if (prep.width > 0) w = prep.width;
                    if (prep.height > 0) h = prep.height;
                    thumb = prep.thumbnailBase64;
                }
            }
            catch { /* optional */ }

            var now = DateTime.UtcNow;
            var gi = new GalleryImage(
                Id: Guid.NewGuid().ToString("N"),
                Name: a.Name,
                ContentType: a.ContentType,
                DataBase64: a.DataBase64,
                Size: a.Size,
                ThumbnailBase64: thumb,
                Width: w,
                Height: h,
                Timestamp: now,
                ModifiedAt: now);
            await GalleryStore.UpsertImageAsync(activeAlbumId, gi);
            SyncBridge.ScheduleAutoSyncAlbumImageAfterLocalSave(activeAlbumId, gi.Id);
            currentImages.Add(gi with { DataBase64 = "" });
        }

        CloseAddFromChat();
        if (selected.Count > 0)
        {
            var album = albums.FirstOrDefault(x => x.Id == activeAlbumId);
            SyncBridge.ScheduleAutoSyncAlbumMetaAfterLocalSave(activeAlbumId, album?.Title ?? "Untitled");
            albums = await EnsureMyMediaAndLoadIndexAsync();
            StateHasChanged();
        }
    }


        // One-shot WASM upload: thumb + encrypt + IDB in JS (no multi-MB base64 round-trips).
        // plainBytes = Uint8Array from .NET byte[]. Returns { width, height, thumbnailBase64, size, contentSha256Base64 }.
        window.galleryIngestUpload = async (contentKey, encKeyB64, plainBytes, contentType, maxEdge) => {
            maxEdge = maxEdge || 400;
            const plain = plainBytes instanceof Uint8Array ? plainBytes : new Uint8Array(plainBytes);
            const mime = (contentType && contentType.indexOf("image/") === 0) ? contentType : "image/jpeg";

            // Thumb via blob URL (faster than multi-MB data: URL + avoids second base64).
            let width = 0, height = 0, thumbnailBase64 = null;
            try {
                const blob = new Blob([plain], { type: mime });
                const objUrl = URL.createObjectURL(blob);
                try {
                    const img = await new Promise((resolve, reject) => {
                        const el = new Image();
                        el.onload = () => resolve(el);
                        el.onerror = () => reject(new Error("decode failed"));
                        el.src = objUrl;
                    });
                    width = img.naturalWidth || img.width || 0;
                    height = img.naturalHeight || img.height || 0;
                    if (width > 0 && height > 0) {
                        const scale = Math.min(1, maxEdge / Math.max(width, height));
                        const tw = Math.max(1, Math.round(width * scale));
                        const th = Math.max(1, Math.round(height * scale));
                        const canvas = document.createElement("canvas");
                        canvas.width = tw;
                        canvas.height = th;
                        canvas.getContext("2d").drawImage(img, 0, 0, tw, th);
                        const dataUrl = canvas.toDataURL("image/jpeg", 0.72);
                        const comma = dataUrl.indexOf(",");
                        thumbnailBase64 = comma >= 0 ? dataUrl.substring(comma + 1) : null;
                    }
                } finally {
                    URL.revokeObjectURL(objUrl);
                }
            } catch (e) {
                console.warn("galleryIngestUpload thumb failed", e);
            }

            // Content hash for fingerprint (does not require serializing multi-MB JSON in .NET).
            let contentSha256Base64 = "";
            try {
                const digest = await crypto.subtle.digest("SHA-256", plain);
                contentSha256Base64 = uint8ToBase64(new Uint8Array(digest));
            } catch (e) {
                contentSha256Base64 = plain.length + ":" + (plain[0] || 0);
            }

            // Encrypt + store binary while still in JS.
            let toStore = plain;
            if (encKeyB64)
                toStore = await window.encryptLocalBytes(encKeyB64, plain);
            await window.idbPutAlbumImageContent(contentKey, toStore, "bin-v1");

            return {
                width,
                height,
                thumbnailBase64,
                size: plain.byteLength,
                contentSha256Base64
            };
        };

        /// Decrypt bin-v1/legacy content → base64 of raw image bytes (for sync / rare full load).
        window.galleryLoadImageBase64FromIdb = async (contentKey, encKeyB64) => {
            try {
                const rec = await window.idbGetAlbumImageContent(contentKey);
                if (!rec || rec.content == null) return null;
                let plainBytes;
                if (rec.format === "bin-v1" || rec.content instanceof ArrayBuffer || ArrayBuffer.isView(rec.content)) {
                    const cipher = rec.content instanceof Uint8Array
                        ? rec.content
                        : new Uint8Array(rec.content);
                    plainBytes = encKeyB64
                        ? await window.decryptLocalBytes(encKeyB64, cipher)
                        : cipher;
                } else if (typeof rec.content === "string") {
                    let json = rec.content;
                    if (encKeyB64)
                        json = await window.decryptLocalData(encKeyB64, rec.content);
                    if (!json || (json[0] !== "{" && json[0] !== "[")) return null;
                    const obj = JSON.parse(json);
                    return obj.DataBase64 || obj.dataBase64 || null;
                } else {
                    return null;
                }
                return uint8ToBase64(plainBytes);
            } catch (e) {
                console.warn("galleryLoadImageBase64FromIdb failed", e);
                return null;

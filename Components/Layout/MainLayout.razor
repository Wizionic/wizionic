@inherits LayoutComponentBase

<div class="page">

    <main>
        <div class="top-row px-4">

            <div class="top-left">
                <a class="cf-brand" href=""><img width="50" src="/images/chatfish.png" title="Chatfish" alt="Chatfish" /></a>
                <a href="/roadmap" title="Roadmap" style="margin-left: 0.35rem;">
                    <i class="bi bi-map" style="font-size: 1.35rem;"></i>
                </a>
            </div>
        </div>

        <article class="content px-1">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <!-- Unified custom CSS (design tokens + common components + chat/WASM UI). Single source for client + server. -->
    <link rel="stylesheet" href="css/chatfish.css" />
    <link rel="stylesheet" href="@Assets["ChatfishApp.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="/images/favicon.png" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <link href="https://cdn.jsdelivr.net/npm/quill@2/dist/quill.snow.css" rel="stylesheet" />

    <HeadOutlet />
</head>

<body>  
    <Routes />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script>
        // Helper functions for WASM chat pages (e.g. /chat) that run with InteractiveWebAssembly render mode.
        // These are defined here in the host shell so they are available when WASM components are active.
        // (The Client project's own index.html only applies when running the Client project standalone.)
        window.scrollChatToBottom = () => {
            const container = document.getElementById('chat-container');
            if (container) {
                container.scrollTop = container.scrollHeight;
            }
        };

        window.isMobileViewport = () => window.innerWidth <= 640.98;

        window.getChatTextareaValue = (el) => (el && typeof el.value === 'string') ? el.value : '';

        window.resetChatTextarea = (el) => {
            if (!el) return;
            el.value = '';
        };

        // Enter sends; Shift+Enter adds a newline. No work on ordinary keystrokes.
        window.setupChatEnterToSend = function (textareaEl) {
            if (!textareaEl || textareaEl.__chatfishEnterBound) return;
            textareaEl.__chatfishEnterBound = true;
            textareaEl.addEventListener('keydown', function (ev) {
                if (ev.key === 'Enter' && !ev.shiftKey) {
                    ev.preventDefault();
                    const btn = document.getElementById('chat-send-btn');
                    if (btn) btn.click();
                }
            });
        };

        // On mobile, start with the conversation sidebar collapsed so chat content is full width.
        window.initWasmSidebarForViewport = function () {
            if (!window.isMobileViewport()) return false;
            window.toggleWasmSidebar(true);
            return true;
        };

        // WASM sidebar toggle (for /chat page). Button + handler colocated in Chat.razor (owns the .page).
        // JS receives desired collapsed state and *sets* the class on .page (plus clears inlines); Blazor binding also updates class attr.
        // CSS rules (.page.sidebar-collapsed .sidebar {display:none!important} etc) do the actual hide + margin shift.
        window.toggleWasmSidebar = function (collapsed) {
            console.log('[WasmSidebar] toggleWasmSidebar called, collapsed=', collapsed);
            const pageEl = document.querySelector('.page');
            const sidebar = document.querySelector('.sidebar');
            const mainEl = document.querySelector('main');
            if (pageEl) {
                if (collapsed) {
                    pageEl.classList.add('sidebar-collapsed');
                } else {
                    pageEl.classList.remove('sidebar-collapsed');
                }
            }
            // Clear any previous inline styles so CSS (base + !important collapsed) fully controls computed display/margin.
            if (sidebar) {
                sidebar.style.display = '';
            }
            if (mainEl) {
                mainEl.style.marginLeft = '';
            }
            // Log resulting state for easy diagnosis in DevTools console
            console.log('[WasmSidebar] after: page has sidebar-collapsed?', !!(pageEl && pageEl.classList.contains('sidebar-collapsed')),
                'sidebar display=', sidebar ? sidebar.style.display : 'n/a',
                'main marginLeft=', mainEl ? mainEl.style.marginLeft : 'n/a');
        };

        window.getMenuPopupPosition = function (buttonId) {
            const btn = document.getElementById(buttonId);
            if (!btn) return { top: 120, left: 260 };
            const rect = btn.getBoundingClientRect();
            const popupWidth = 120;
            let left = rect.right + 5;
            if (left + popupWidth > window.innerWidth) {
                left = rect.left - popupWidth - 5;
            }
            return {
                top: rect.bottom + 2,
                left: left
            };
        };

        // Align popup below the ⋮ button, right edges flush (for bot message menus).
        window.getBotMenuPopupPosition = function (buttonId) {
            const btn = document.getElementById(buttonId);
            if (!btn) return { top: 120, left: 260 };
            const rect = btn.getBoundingClientRect();
            const popupWidth = 160;
            let left = rect.right - popupWidth;
            if (left < 8) left = 8;
            return {
                top: rect.bottom + 2,
                left: left
            };
        };

        // --------------------------------------------------------------------
        // AES-GCM helpers for WASM localStorage / IndexedDB encryption and for
        // encrypting live-sync payloads (Brave-style: server does auth + signaling
        // only; the actual history blobs are encrypted with a key the client
        // fetches from the DB so the relay never sees plaintext).
        // These are called from WasmCryptoService via IJSRuntime.
        // --------------------------------------------------------------------
        async function getAesGcmKey(base64Key) {
            const keyData = Uint8Array.from(atob(base64Key), c => c.charCodeAt(0));
            return await crypto.subtle.importKey(
                "raw",
                keyData,
                { name: "AES-GCM" },
                false,
                ["encrypt", "decrypt"]
            );
        }

        window.encryptLocalData = async (base64Key, plaintext) => {
            if (!base64Key || !plaintext) return plaintext || "";
            try {
                const key = await getAesGcmKey(base64Key);
                const iv = crypto.getRandomValues(new Uint8Array(12)); // 96-bit IV for GCM
                const encoded = new TextEncoder().encode(plaintext);
                const ciphertext = await crypto.subtle.encrypt(
                    { name: "AES-GCM", iv },
                    key,
                    encoded
                );
                const combined = new Uint8Array(iv.length + ciphertext.byteLength);
                combined.set(iv, 0);
                combined.set(new Uint8Array(ciphertext), iv.length);
                // Return a single base64 string (IV || ciphertext) for easy storage.
                return btoa(String.fromCharCode.apply(null, combined));
            } catch (e) {
                console.warn("encryptLocalData failed, returning plaintext", e);
                return plaintext;
            }
        };

        window.decryptLocalData = async (base64Key, combinedBase64) => {
            if (!base64Key || !combinedBase64) return combinedBase64 || "";
            try {
                const key = await getAesGcmKey(base64Key);
                const combined = Uint8Array.from(atob(combinedBase64), c => c.charCodeAt(0));
                const iv = combined.slice(0, 12);
                const ciphertext = combined.slice(12);
                const decrypted = await crypto.subtle.decrypt(
                    { name: "AES-GCM", iv },
                    key,
                    ciphertext
                );
                return new TextDecoder().decode(decrypted);
            } catch (e) {
                // Probably a legacy plaintext value or the key changed.
                console.warn("decryptLocalData failed (legacy data?), returning as-is", e);
                return combinedBase64;
            }
        };

        // --------------------------------------------------------------------
        // IndexedDB helpers for WASM chat history (replaces localStorage for
        // the conversation blobs and metadata).
        //
        // All *content* (the serialized List<ChatMessage> JSON) is *always*
        // encrypted with AES-GCM before being written to convoContents:
        //   - When the user is logged in we use the server-provided
        //     LocalEncryptionKey (so other devices of the same account can
        //     decrypt for live sync).
        //   - For completely unauthenticated/guest use we generate a local
        //     (device-only) 256-bit key the first time and store it in the
        //     settings store. This gives at-rest protection for guest history
        //     without any server involvement.
        //
        // The lightweight meta (title, lastUpdated, syncEnabled flag) is
        // stored in cleartext in convoMetas so the list of conversations is
        // always visible even before the encryption key is available.
        //
        // This also gives us a clean place for the per-conversation
        // "syncEnabled" flag so future sync code can do "all or only some".
        // --------------------------------------------------------------------
        let _chatfishDbPromise = null;

        async function getChatfishDb() {
            if (_chatfishDbPromise) return _chatfishDbPromise;
            _chatfishDbPromise = new Promise((resolve, reject) => {
                const req = indexedDB.open("chatfish-conversations", 2);
                req.onupgradeneeded = (ev) => {
                    const db = ev.target.result;
                    if (!db.objectStoreNames.contains("convoMetas")) {
                        const meta = db.createObjectStore("convoMetas", { keyPath: "key" });
                        meta.createIndex("byNamespace", "namespace", { unique: false });
                    }
                    if (!db.objectStoreNames.contains("convoContents")) {
                        db.createObjectStore("convoContents", { keyPath: "key" });
                    }
                    if (!db.objectStoreNames.contains("settings")) {
                        db.createObjectStore("settings", { keyPath: "key" });
                    }
                    if (!db.objectStoreNames.contains("noteMetas")) {
                        const nmeta = db.createObjectStore("noteMetas", { keyPath: "key" });
                        nmeta.createIndex("byNamespace", "namespace", { unique: false });
                    }
                    if (!db.objectStoreNames.contains("noteContents")) {
                        db.createObjectStore("noteContents", { keyPath: "key" });
                    }
                };
                req.onsuccess = () => resolve(req.result);
                req.onerror = () => reject(req.error);
            });
            return _chatfishDbPromise;
        }

        window.idbGetMetasByNamespace = async (namespace) => {
            const db = await getChatfishDb();
            return new Promise((resolve, reject) => {
                const tx = db.transaction("convoMetas", "readonly");
                const store = tx.objectStore("convoMetas");
                const idx = store.index("byNamespace");
                const req = idx.getAll(namespace || "");
                req.onsuccess = () => resolve(req.result || []);
                req.onerror = () => reject(req.error);
            });
        };

        window.idbPutMeta = async (meta) => {
            const db = await getChatfishDb();
            return new Promise((resolve, reject) => {
                const tx = db.transaction("convoMetas", "readwrite");
                tx.objectStore("convoMetas").put(meta);
                tx.oncomplete = () => resolve();
                tx.onerror = () => reject(tx.error);
            });
        };

        window.idbGetContent = async (key) => {
            const db = await getChatfishDb();
            return new Promise((resolve, reject) => {
                const tx = db.transaction("convoContents", "readonly");
                const req = tx.objectStore("convoContents").get(key);
                req.onsuccess = () => resolve(req.result ? req.result.content : null);
                req.onerror = () => reject(req.error);
            });
        };

        window.idbPutContent = async (key, content) => {
            const db = await getChatfishDb();
            return new Promise((resolve, reject) => {
                const tx = db.transaction("convoContents", "readwrite");
                tx.objectStore("convoContents").put({ key, content });
                tx.oncomplete = () => resolve();
                tx.onerror = () => reject(tx.error);
            });
        };

        window.idbDeleteByKey = async (key) => {
            const db = await getChatfishDb();
            return new Promise((resolve, reject) => {
                const tx = db.transaction(["convoMetas", "convoContents"], "readwrite");
                tx.objectStore("convoMetas").delete(key);
                tx.objectStore("convoContents").delete(key);
                tx.oncomplete = () => resolve();
                tx.onerror = () => reject(tx.error);
            });
        };

        window.idbDeleteConvoContent = async (key) => {
            const db = await getChatfishDb();
            return new Promise((resolve, reject) => {
                const tx = db.transaction("convoContents", "readwrite");
                tx.objectStore("convoContents").delete(key);
                tx.oncomplete = () => resolve();
                tx.onerror = () => reject(tx.error);
            });
        };

        window.idbGetSetting = async (key) => {
            const db = await getChatfishDb();
            return new Promise((resolve, reject) => {
                const tx = db.transaction("settings", "readonly");
                const req = tx.objectStore("settings").get(key);
                req.onsuccess = () => resolve(req.result ? req.result.value : null);
                req.onerror = () => reject(req.error);
            });
        };

        window.idbPutSetting = async (key, value) => {
            const db = await getChatfishDb();
            return new Promise((resolve, reject) => {
                const tx = db.transaction("settings", "readwrite");
                tx.objectStore("settings").put({ key, value });
                tx.oncomplete = () => resolve();
                tx.onerror = () => reject(tx.error);
            });
        };

        window.idbGetAllMetas = async () => {
            const db = await getChatfishDb();
            return new Promise((resolve, reject) => {
                const tx = db.transaction("convoMetas", "readonly");
                const req = tx.objectStore("convoMetas").getAll();
                req.onsuccess = () => resolve(req.result || []);
                req.onerror = () => reject(req.error);
            });
        };

        // Ensures a per-browser guest encryption key exists (device-local only).
        // The key is a base64 32-byte value, stored in the settings store.
        // It is used exactly like the server key for AES-GCM of guest history.
        window.idbEnsureGuestKey = async () => {
            const existing = await window.idbGetSetting("guest-encryption-key");
            if (existing) return existing;
            const bytes = crypto.getRandomValues(new Uint8Array(32));
            const b64 = btoa(String.fromCharCode.apply(null, bytes));
            await window.idbPutSetting("guest-encryption-key", b64);
            return b64;
        };

        // --------------------------------------------------------------------
        // IndexedDB helpers for Notes (noteMetas + noteContents stores)
        // Parallel to convoMetas/convoContents but keyed with "n-" prefix.
        // --------------------------------------------------------------------
        window.idbGetNoteMetasByNamespace = async (namespace) => {
            const db = await getChatfishDb();
            return new Promise((resolve, reject) => {
                const tx = db.transaction("noteMetas", "readonly");
                const store = tx.objectStore("noteMetas");
                const idx = store.index("byNamespace");
                const req = idx.getAll(namespace || "");
                req.onsuccess = () => resolve(req.result || []);
                req.onerror = () => reject(req.error);
            });
        };

        window.idbPutNoteMeta = async (meta) => {
            const db = await getChatfishDb();
            return new Promise((resolve, reject) => {
                const tx = db.transaction("noteMetas", "readwrite");
                tx.objectStore("noteMetas").put(meta);
                tx.oncomplete = () => resolve();
                tx.onerror = () => reject(tx.error);
            });
        };

        window.idbGetNoteContent = async (key) => {
            const db = await getChatfishDb();
            return new Promise((resolve, reject) => {
                const tx = db.transaction("noteContents", "readonly");
                const req = tx.objectStore("noteContents").get(key);
                req.onsuccess = () => resolve(req.result ? req.result.content : null);
                req.onerror = () => reject(req.error);
            });
        };

        window.idbPutNoteContent = async (key, content) => {
            const db = await getChatfishDb();
            return new Promise((resolve, reject) => {
                const tx = db.transaction("noteContents", "readwrite");
                tx.objectStore("noteContents").put({ key, content });
                tx.oncomplete = () => resolve();
                tx.onerror = () => reject(tx.error);
            });
        };

        window.idbDeleteNoteByKey = async (key) => {
            const db = await getChatfishDb();
            return new Promise((resolve, reject) => {
                const tx = db.transaction(["noteMetas", "noteContents"], "readwrite");
                tx.objectStore("noteMetas").delete(key);
                tx.objectStore("noteContents").delete(key);
                tx.oncomplete = () => resolve();
                tx.onerror = () => reject(tx.error);
            });
        };

        window.idbDeleteNoteContent = async (key) => {
            const db = await getChatfishDb();
            return new Promise((resolve, reject) => {
                const tx = db.transaction("noteContents", "readwrite");
                tx.objectStore("noteContents").delete(key);
                tx.oncomplete = () => resolve();
                tx.onerror = () => reject(tx.error);
            });
        };

        window.idbGetAllNoteMetas = async () => {
            const db = await getChatfishDb();
            return new Promise((resolve, reject) => {
                const tx = db.transaction("noteMetas", "readonly");
                const req = tx.objectStore("noteMetas").getAll();
                req.onsuccess = () => resolve(req.result || []);
                req.onerror = () => reject(tx.error);
            });
        };

        // --------------------------------------------------------------------
        // WebRTC helpers for Phase 2 real peer-to-peer chat history sync (DataChannel).
        // Signaling (offer/answer/ICE + sync-start) goes through SyncHub.
        // The actual (encrypted) history blob travels directly over the RTCDataChannel.
        // --------------------------------------------------------------------
        window._webrtcConnections = {};

        window.webrtcCreatePeerConnection = async (dotnetRef, peerId) => {
            // Close any existing connection for this peer before starting a new handshake.
            // Suppress .NET callbacks so the teardown does not clear the newly queued sync item.
            if (window._webrtcConnections[peerId]) {
                window.webrtcClose(peerId, { suppressDotNetCallbacks: true });
            }

            const pc = new RTCPeerConnection({
                iceServers: [{ urls: 'stun:stun.l.google.com:19302' }]
            });
            window._webrtcConnections[peerId] = { pc, dotnetRef, dataChannel: null, iceQueue: [], remoteDescSet: false };

            pc.onicecandidate = (event) => {
                if (event.candidate) {
                    dotnetRef.invokeMethodAsync('OnIceCandidate', peerId, JSON.stringify(event.candidate));
                }
            };

            pc.ondatachannel = (event) => {
                const dc = event.channel;
                window._webrtcConnections[peerId].dataChannel = dc;
                dc.onopen = () => {
                    console.log('[WebRTC] DataChannel open (receiver)');
                    dotnetRef.invokeMethodAsync('OnDataChannelOpen', peerId);
                };
                dc.onmessage = (e) => {
                    dotnetRef.invokeMethodAsync('OnDataReceived', peerId, e.data);
                };
                dc.onclose = () => {
                    dotnetRef.invokeMethodAsync('OnDataChannelClose', peerId);
                };
            };

            pc.onconnectionstatechange = () => {
                console.log('[WebRTC] Connection state for', peerId, pc.connectionState);
                const state = pc.connectionState;
                if (state === 'failed' || state === 'disconnected' || state === 'closed') {
                    dotnetRef.invokeMethodAsync('OnWebRtcConnectionStateChange', peerId, state);
                }
            };
            return true;
        };

        window.webrtcCreateDataChannel = async (peerId, label) => {
            const entry = window._webrtcConnections[peerId];
            if (!entry) return;
            const dc = entry.pc.createDataChannel(label || 'chatfish-sync');
            entry.dataChannel = dc;
            dc.onopen = () => {
                console.log('[WebRTC] DataChannel open (sender)');
                entry.dotnetRef.invokeMethodAsync('OnDataChannelOpen', peerId);
            };
            dc.onmessage = (e) => {
                entry.dotnetRef.invokeMethodAsync('OnDataReceived', peerId, e.data);
            };
            dc.onclose = () => {
                entry.dotnetRef.invokeMethodAsync('OnDataChannelClose', peerId);
            };
        };

        window.webrtcCreateOffer = async (peerId) => {
            const entry = window._webrtcConnections[peerId];
            if (!entry) return null;
            const offer = await entry.pc.createOffer();
            await entry.pc.setLocalDescription(offer);
            return JSON.stringify(offer);
        };

        window.webrtcFlushIceQueue = async (peerId) => {
            const entry = window._webrtcConnections[peerId];
            if (!entry || !entry.iceQueue?.length) return;
            const queued = entry.iceQueue.splice(0);
            for (const candJson of queued) {
                try {
                    const cand = JSON.parse(candJson);
                    await entry.pc.addIceCandidate(new RTCIceCandidate(cand));
                } catch (e) { console.warn('[WebRTC] flush queued ICE', e); }
            }
        };

        window.webrtcSetRemoteDescription = async (peerId, sdpJson) => {
            const entry = window._webrtcConnections[peerId];
            if (!entry) return false;
            const desc = JSON.parse(sdpJson);
            if (desc.type === 'answer' && entry.pc.signalingState === 'stable' && entry.remoteDescSet) {
                return false;
            }
            await entry.pc.setRemoteDescription(new RTCSessionDescription(desc));
            entry.remoteDescSet = true;
            await window.webrtcFlushIceQueue(peerId);
            return true;
        };

        window.webrtcIsDataChannelOpen = (peerId) => {
            const entry = window._webrtcConnections[peerId];
            return !!(entry?.dataChannel && entry.dataChannel.readyState === 'open');
        };

        window.webrtcCreateAnswer = async (peerId) => {
            const entry = window._webrtcConnections[peerId];
            if (!entry) return null;
            const answer = await entry.pc.createAnswer();
            await entry.pc.setLocalDescription(answer);
            return JSON.stringify(answer);
        };

        window.webrtcAddIceCandidate = async (peerId, candidateJson) => {
            const entry = window._webrtcConnections[peerId];
            if (!entry) {
                console.warn('[WebRTC] addIceCandidate: no connection for', peerId);
                return;
            }
            if (!entry.remoteDescSet) {
                entry.iceQueue = entry.iceQueue || [];
                entry.iceQueue.push(candidateJson);
                return;
            }
            try {
                const cand = JSON.parse(candidateJson);
                await entry.pc.addIceCandidate(new RTCIceCandidate(cand));
            } catch (e) { console.warn('[WebRTC] addIceCandidate', e); }
        };

        window.webrtcGetMaxMessageSize = (peerId) => {
            const entry = window._webrtcConnections[peerId];
            const max = entry?.dataChannel?.maxMessageSize;
            if (max && max > 0) return max;
            return 256 * 1024;
        };

        window.webrtcSendData = async (peerId, data) => {
            const entry = window._webrtcConnections[peerId];
            if (!entry?.dataChannel || entry.dataChannel.readyState !== 'open') return false;
            try {
                entry.dataChannel.send(data);
                return true;
            } catch (e) {
                console.warn('[WebRTC] send failed:', e?.message || e);
                return false;
            }
        };

        window.webrtcClose = (peerId, options) => {
            const entry = window._webrtcConnections[peerId];
            if (!entry) return;

            const suppress = options?.suppressDotNetCallbacks;
            if (entry.dataChannel) {
                if (suppress) entry.dataChannel.onclose = null;
                entry.dataChannel.close();
            }
            if (suppress) entry.pc.onconnectionstatechange = null;
            entry.pc.close();
            delete window._webrtcConnections[peerId];
        };
    </script>
    <script src="https://cdn.jsdelivr.net/npm/quill@2/dist/quill.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/quill-resize-image@1.0.11/dist/quill-resize-image.min.js"></script>
    <script src="js/quillInterop.js"></script>
</body>

</html>

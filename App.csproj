<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <RootNamespace>App</RootNamespace>
    <UserSecretsId>a8d4cf06-2e6d-4968-9752-b26c847c8502</UserSecretsId>
    <!--
      The host .csproj lives at the repo root, so default globs only exclude the root-level
      obj/ and bin/ folders. Leftover nested build outputs (e.g. an old App/obj from a
      prior project layout) would otherwise be compiled and cause CS0579 duplicate assembly
      attributes and CS0101 duplicate generated types.
    -->
    <!--
      Also exclude local publish/deploy artifact folders. Without this, publishing into a
      folder under the repo root re-includes that output on the next publish and nests
      recursively until Windows MAX_PATH is exceeded.
    -->
    <DefaultItemExcludes>$(DefaultItemExcludes);**/bin/**;**/obj/**;**/publish_output/**;**/maui_publish/**;**/maui_releases/**;**/homeserver_publish_win/**;**/homeserver_releases_win/**;**/homeserver_publish_linux/**;**/homeserver_releases_linux/**;**/linux_publish/**;**/linux_releases/**;**/artifacts/**</DefaultItemExcludes>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <!-- No debug symbols in production -->
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <!-- Host is not trim-safe (EF/Razor). WASM client sets its own PublishTrimmed. -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <!-- Exclude development config files from publish -->
  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <Content Remove="appsettings.Development.json" />
    <Content Remove="**\appsettings.Development.json" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="docs\privacy.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="docs\terms.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="appsettings*.json">
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>

  <!-- Exclude the supporting Client project sources from this main project's default globs.
       The main .csproj lives at repo root for flatter Railway-friendly publish commands.
       The Client project (sibling dir) is still referenced for its WASM components, services,
       and static web assets (css, etc.). Without this exclude, the root .csproj would
       compile the Client's *.cs + *.razor files as part of itself, causing duplicate type
       definitions (e.g. the App.Services.Tools copies) and top-level statement conflicts. -->
  <ItemGroup>
    <Compile Remove="App.Client\**" />
    <Content Remove="App.Client\**" />
    <EmbeddedResource Remove="App.Client\**" />
    <None Remove="App.Client\**" />
    <!-- Razor components, view imports, etc. from the Client must only be compiled by the Client project. -->
    <RazorComponent Remove="App.Client\**" />
    <RazorGenerate Remove="App.Client\**" />
    <Compile Remove="App.Maui\**" />
    <Content Remove="App.Maui\**" />
    <EmbeddedResource Remove="App.Maui\**" />
    <None Remove="App.Maui\**" />
    <RazorComponent Remove="App.Maui\**" />
    <RazorGenerate Remove="App.Maui\**" />
    <Compile Remove="App.Core\**" />
    <Content Remove="App.Core\**" />
    <EmbeddedResource Remove="App.Core\**" />
    <None Remove="App.Core\**" />
    <RazorComponent Remove="App.Core\**" />
    <RazorGenerate Remove="App.Core\**" />
    <Compile Remove="App.Shared\**" />
    <Content Remove="App.Shared\**" />
    <EmbeddedResource Remove="App.Shared\**" />
    <None Remove="App.Shared\**" />
    <RazorComponent Remove="App.Shared\**" />
    <RazorGenerate Remove="App.Shared\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.2.0" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.8" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.8">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.6.0" />
    <!-- For robust parsing of search results in the free web_search tool (DDG HTML) -->
    <PackageReference Include="HtmlAgilityPack" Version="1.11.70" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.8" />
    <!-- Real email sending for magic links (SMTP via MailKit). Configure in appsettings under "Email" section (use user-secrets for passwords in real deploys). -->
    <!-- 4.16+ fixes STARTTLS response injection (GHSA-9j88-vvj5-vhgr); pulls MimeKit ≥4.15.1 (GHSA-g7hc-96xr-gvvx). -->
    <PackageReference Include="MailKit" Version="4.17.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.8" />
    <PackageReference Include="SIPSorcery" Version="10.0.10" />
    <!-- Override transitive 2.1.11 (GHSA-2m69-gcr7-jv3q / CVE-2025-6965 in bundled SQLite). -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
    <ProjectReference Include="App.Client\App.Client.csproj" />
    <ProjectReference Include="App.Core\App.Core.csproj" />
    <ProjectReference Include="App.Shared\App.Shared.csproj" />
  </ItemGroup>

</Project>

@using App.Client.Services
@using ChatMessage = App.Core.Storage.ChatMessage
@inject IJSRuntime JS
@inject INoteStore NoteStore

@if (IsOpen)
{
    <div class="newnote-overlay" @onclick="OverlayClick">
        <div class="newnote-modal" @onclick:stopPropagation>
            @if (_showExistingNotes)
            {
                <h4 style="margin:0 0 12px 0;font-size:1.1rem;color:#1F2A37;">Add to Note</h4>
                <p style="font-size:0.85rem;color:#64748b;margin-bottom:12px;">Select an existing note or create a new one:</p>

                <select @bind="_selectedNoteId" class="newnote-select">
                    <option value="">— New note —</option>
                    @foreach (var n in _notes.OrderByDescending(x => x.LastUpdated))
                    {
                        <option value="@n.Id">@n.Title (@n.LastUpdated.ToLocalTime().ToString("MMM d"))</option>
                    }
                </select>

                <div style="margin-top:12px;display:flex;gap:8px;">
                    @if (!string.IsNullOrEmpty(_selectedNoteId))
                    {
                        <button class="newnote-btn newnote-btn-primary" @onclick="AddToExisting">
                            Add to this note
                        </button>
                    }
                </div>

                <div style="margin-top:8px;">
                    <button class="newnote-btn newnote-btn-secondary" @onclick="ShowNewNoteInput">
                        + Create new note
                    </button>
                </div>

                <div style="margin-top:12px;text-align:right;">
                    <button class="newnote-btn newnote-btn-ghost" @onclick="Cancel">Cancel</button>
                </div>
            }
            else if (_showNewNoteInput)
            {
                <h4 style="margin:0 0 12px 0;font-size:1.1rem;color:#1F2A37;">Create New Note</h4>
                <p style="font-size:0.85rem;color:#64748b;margin-bottom:12px;">Enter a name for the new note:</p>

                <input type="text" @bind="_newNoteName" @bind:event="oninput"
                       placeholder="Note name..." class="newnote-input" @onkeydown="NewNameKeyHandler" />

                <div style="margin-top:12px;display:flex;gap:8px;justify-content:flex-end;">
                    <button class="newnote-btn newnote-btn-secondary" @onclick="Cancel">Cancel</button>
                    <button class="newnote-btn newnote-btn-primary" @onclick="CreateAndSave" disabled="@(string.IsNullOrWhiteSpace(_newNoteName))">
                        Create &amp; Save
                    </button>
                </div>
            }
            else if (_confirming)
            {
                <h4 style="margin:0 0 12px 0;font-size:1.1rem;color:#1F2A37;">Add to Note</h4>
                <p style="font-size:0.85rem;color:#64748b;margin-bottom:12px;">
                    Add this message to <strong>@_targetNoteName</strong>?
                </p>

                @if (SourceMessage != null && !string.IsNullOrEmpty(SourceMessage.Content))
                {
                    <div style="background:#f1f5f9;padding:8px 12px;border-radius:6px;margin-bottom:12px;font-size:0.8rem;color:#475569;max-height:120px;overflow-y:auto;">
                        @SourceMessage.Content.Substring(0, Math.Min(SourceMessage.Content.Length, 200))
                        @(SourceMessage.Content.Length > 200 ? "..." : "")
                    </div>
                }

                <div style="display:flex;gap:8px;justify-content:flex-end;">
                    <button class="newnote-btn newnote-btn-secondary" @onclick="Cancel">Cancel</button>
                    <button class="newnote-btn newnote-btn-primary" @onclick="AddToExistingConfirm">Yes, add</button>
                </div>
            }
            else
            {
                <p style="margin:0;font-size:0.9rem;color:#64748b;">Loading notes...</p>
            }
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public ChatMessage? SourceMessage { get; set; }
    [Parameter] public string? ExistingNoteId { get; set; }

    private List<LocalNote> _notes = new();
    private bool _showExistingNotes;
    private bool _showNewNoteInput;
    private bool _confirming;
    private string _selectedNoteId = "";
    private string _newNoteName = "";
    private string _targetNoteName = "";
    private string _targetNoteId = "";

    protected override async Task OnParametersSetAsync()
    {
        if (!IsOpen)
        {
            ResetState();
            return;
        }

        if (SourceMessage == null) return;

        ResetState();
        try
        {
            _notes = await NoteStore.LoadIndexAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[NewNote] Failed to load notes: {ex.Message}");
            _notes = new();
        }

        if (!string.IsNullOrEmpty(ExistingNoteId))
        {
            _targetNoteId = ExistingNoteId;
            _confirming = true;
            var target = _notes.FirstOrDefault(n => n.Id == ExistingNoteId);
            _targetNoteName = target?.Title ?? "this note";
        }
        else if (_notes.Any())
        {
            _showExistingNotes = true;
        }
        else
        {
            _showNewNoteInput = true;
        }

        await InvokeAsync(StateHasChanged);
    }

    void ResetState()
    {
        _showExistingNotes = false;
        _showNewNoteInput = false;
        _confirming = false;
        _selectedNoteId = "";
        _newNoteName = "";
        _targetNoteName = "";
        _targetNoteId = "";
    }

    async Task OverlayClick(MouseEventArgs e)
    {
        await Cancel();
    }

    void ShowNewNoteInput()
    {
        _showExistingNotes = false;
        _showNewNoteInput = true;
        StateHasChanged();
        _ = InvokeAsync(async () =>
        {
            await Task.Delay(50);
            try { await JS.InvokeVoidAsync("eval", @"document.querySelector('.newnote-input')?.focus()"); } catch { }
        });
    }

    void AddToExisting()
    {
        if (string.IsNullOrEmpty(_selectedNoteId)) return;
        var note = _notes.FirstOrDefault(n => n.Id == _selectedNoteId);
        _targetNoteName = note?.Title ?? "this note";
        _targetNoteId = _selectedNoteId;
        _showExistingNotes = false;
        _confirming = true;
        StateHasChanged();
    }

    async Task AddToExistingConfirm()
    {
        if (SourceMessage == null || string.IsNullOrEmpty(_targetNoteId)) return;

        var messages = await NoteStore.LoadNoteAsync(_targetNoteId);
        messages.Add(SourceMessage);
        await NoteStore.SaveNoteAsync(_targetNoteId, messages);
        var note = _notes.FirstOrDefault(n => n.Id == _targetNoteId);
        await NoteStore.UpdateIndexAfterSaveAsync(_targetNoteId, note?.Title ?? _targetNoteName);

        await CloseDialog();
    }

    async Task CreateAndSave()
    {
        if (SourceMessage == null || string.IsNullOrWhiteSpace(_newNoteName)) return;

        var id = Guid.NewGuid().ToString();
        var title = _newNoteName.Trim();
        var messages = new List<ChatMessage> { SourceMessage };
        await NoteStore.SaveNoteAsync(id, messages);
        await NoteStore.UpdateIndexAfterSaveAsync(id, title, titleChangedTicks: DateTime.UtcNow.Ticks);

        await CloseDialog();
    }

    async Task Cancel()
    {
        ResetState();
        await CloseDialog();
    }

    async Task CloseDialog()
    {
        await OnClose.InvokeAsync();
    }

    async Task NewNameKeyHandler(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_newNoteName))
            await CreateAndSave();
    }
}